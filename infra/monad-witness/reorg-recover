#!/usr/bin/env bash
# reorg-recover — undo a reorg that stopped the replay, so real-time proving can resume unattended.
#
# WHY THIS EXISTS. At CONFIRMATIONS=0 the fetcher writes blocks that are still reorg-able. When one is
# replaced, the triedb has already applied it: the next canonical block then fails validation (observed twice
# in four hours, both times `block N failed with: bad nonce` — the replaced block had included a transaction,
# so the sender's nonce is one ahead of what the canonical chain expects). run_replay.py writes logs/ALERT and
# exits, and NOTHING restarts it. That is availability near zero, not a latency problem.
#
# Confirmations are the opposite of real-time proving — each one is 12 s of deliberate waiting against a 12 s
# slot. So the fix is recovery, not delay. This script is that recovery.
#
# WHAT IT DOES, and why in this order — every step was learned the hard way:
#   1. STOP THE FETCHER FIRST. It holds its next block in memory; if it keeps running while block_db is
#      trimmed it carries on writing at the tip and never fills the gap, and `existing_max_block()` takes the
#      MAX, so restarting it later does not fill it either. That mistake cost an hour: the replay sat with
#      `available == last_executed` and thousands of unreachable blocks above a hole.
#   2. REWIND THE TRIEDB. This is what un-applies the bad state; re-fetching alone does NOT work (verified —
#      the re-fetched canonical block failed with the identical error). The tool is
#      $MONAD_DIR/build/category/mpt/monad-mpt, NOT in build/cmd/ beside monad and monad-cli, and it takes
#      --storage, NOT --db.
#   3. TRIM block_db ABOVE THE REWIND POINT. Those blocks were fetched at CONFIRMATIONS=0 before the reorg
#      settled, so some of them ARE the non-canonical ones. Rewinding without trimming just re-applies them.
#   4. DROP THOSE BLOCKS FROM prove-farm.csv. A reorged block may already have been proved — the failure only
#      surfaces at a LATER block — so its proof describes an orphan, and prove-farm's is_proven() keys on the
#      block number alone: it would skip the canonical witness and leave the orphan's proof at that height.
#      Invalidating the prover's ledger over the same range is the other half of trimming block_db.
#   5. Remove the ALERT last, so a crash midway leaves the marker in place rather than a half-repaired db that
#      looks healthy.
#
# ESCALATING MARGIN. A single-slot reorg needs a handful of blocks; but the divergence can predate the block
# that reports it (the failure surfaces where a nonce first conflicts, not where the chain forked). Measured
# once: 10 blocks was not enough, 1000 was. So the margin starts at MARGIN and DOUBLES each time recovery is
# attempted for the same failing block, up to MAX_MARGIN. The attempt count lives in a state file next to the
# ALERT so it survives restarts.
#
#   ./reorg-recover [--dry-run]
#
# Exit 0 = repaired (caller should restart the fetcher and the replay). Exit 1 = refused, and it says why:
# no ALERT, an ALERT that is not a reorg, or the margin exhausted. It never guesses past MAX_MARGIN — beyond
# that the history window itself is the limit and a snapshot rebuild is the honest answer.
set -uo pipefail

MONAD_DIR="${MONAD_DIR:-$HOME/monad}"
BLOCK_DB="${BLOCK_DB:-$HOME/block_db}"
DB="${DB:-$HOME/triedb.db}"
MPT="${MPT:-$MONAD_DIR/build/category/mpt/monad-mpt}"
CLI="${CLI:-$MONAD_DIR/build/cmd/monad-cli}"
# DERIVED the way prove-farm derives it, never spelled out: it writes to $RUNDATA/prove-farm.csv with
# RUNDATA defaulting to <repo>/run-data. A hand-written path here silently targets the wrong file — and step 4
# reports "nothing to invalidate" when the file is absent, so a wrong path reads as a clean pass. Both spellings
# of this ledger exist on the box, one of them stale by hours; guessing picked the stale one.
REPO="${REPO:-$HOME/zkvm-bench}"
RUNDATA="${RUNDATA:-$REPO/run-data}"
FARM_CSV="${FARM_CSV:-$RUNDATA/prove-farm.csv}"
MARGIN="${MARGIN:-64}"
MAX_MARGIN="${MAX_MARGIN:-4096}"
ALERT="$MONAD_DIR/logs/ALERT"
STATE="$MONAD_DIR/logs/.reorg-recover-state"
DRY=0
[ "${1:-}" = "--dry-run" ] && DRY=1

log(){ printf '%s reorg-recover: %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ printf '%s reorg-recover: %s\n' "$(date +%H:%M:%S)" "$*" >&2; exit 1; }
run(){ if [ "$DRY" = 1 ]; then printf '   $ %s\n' "$*"; else eval "$@"; fi; }

[ -f "$ALERT" ] || die "no $ALERT — nothing to recover (the replay stopped for another reason, or is running)"
[ -x "$MPT" ]   || die "no monad-mpt at $MPT (look for it: find $MONAD_DIR -name '*mpt*' -type f -perm -u+x)"
[ -x "$CLI" ]   || die "no monad-cli at $CLI"

# Only reorg-shaped failures. Disk full, a crash or a missing block are different problems and a rewind makes
# them worse, not better — it would throw away good state to work around an unrelated fault.
failing="$(grep -oE 'block [0-9]+ failed with: [a-z ]+' "$ALERT" | tail -1)"
[ -n "$failing" ] || die "the ALERT does not name a failing block — read it yourself, this is not a reorg:
$(head -3 "$ALERT")"
fblock="$(printf '%s' "$failing" | grep -oE '[0-9]+' | head -1)"
# `excess blob gas` belongs here for the same reason `parent` does: EIP-4844 derives a block's excess blob gas
# from its PARENT's header (excess + blob_gas_used, against the active blob schedule), so a non-canonical parent
# sitting in block_db makes the canonical child fail validation on this field. Observed at block 25699795, where
# block_db held a 354-transaction 25699794 while the canonical one has 51 — a replaced block the fetcher wrote
# at CONFIRMATIONS=0 and the replay then applied.
#
# It is the one signature here that a rewind might NOT fix, because the same message is what a wrong blob
# schedule produces — and then rewinding discards good state for nothing. The two are told apart from outside
# this script, by asking the chain whether the block the client executed is the canonical one:
#   curl -s -X POST -H 'content-type: application/json' --data \
#     '{"jsonrpc":"2.0","id":1,"method":"eth_getBlockByNumber","params":["0x<parent-hex>",false]}' "$RPC"
# Compare its transaction count against the replay log's `__exec_block,bl=<parent>,...,tx=N`. Different counts
# mean a reorg and this recovery is right; identical means the client disagrees with a block it holds correctly,
# which is a consensus bug upstream of here and no rewind will help.
case "$failing" in
  *"bad nonce"*|*"root"*|*"parent"*|*"mismatch"*|*"excess blob gas"*)
    log "reorg-shaped failure: $failing" ;;
  *) die "'$failing' is not a reorg signature. A rewind will not fix it, and would discard good state." ;;
esac

# Escalate only for the SAME block: a new failing block is a new reorg and deserves a fresh, small margin.
prev_block=""; prev_margin=""
[ -f "$STATE" ] && read -r prev_block prev_margin < "$STATE"
margin="$MARGIN"
if [ "$prev_block" = "$fblock" ] && [ -n "$prev_margin" ]; then
  margin=$(( prev_margin * 2 ))
  log "same failing block as last attempt ($fblock) — the fork predates it, doubling the margin to $margin"
fi
[ "$margin" -le "$MAX_MARGIN" ] || die "margin $margin exceeds MAX_MARGIN=$MAX_MARGIN for block $fblock. The \
divergence is deeper than the history window can undo — rebuild the triedb from a snapshot. Not guessing further."

last="$("$CLI" --db "$DB" 2>/dev/null | grep -o 'latest_finalized_block_id=[0-9]*' | cut -d= -f2)"
[ -n "$last" ] || die "cannot read the triedb head from monad-cli"
earliest="$("$CLI" --db "$DB" 2>/dev/null | grep -o 'earliest_block_id=[0-9]*' | cut -d= -f2)"
target=$(( last - margin ))
# The rewind can only reach what the history window still holds. Below `earliest` the versions are gone and
# monad-mpt would fail (or worse, succeed into an unusable state).
if [ -n "$earliest" ] && [ "$target" -le "$earliest" ]; then
  die "rewinding $margin blocks would land at $target, at or below the earliest retained version $earliest. \
The history window cannot undo this — rebuild from a snapshot."
fi

log "failing block $fblock · triedb head $last · rewinding to $target (margin $margin, history from $earliest)"
# NOT under --dry-run. The escalation counter records that a recovery was ATTEMPTED and did not hold; a preview
# attempts nothing, so writing here would let repeated previews double the margin toward MAX_MARGIN until the
# script refuses outright and demands a snapshot rebuild. It also inflates the very next real run: each unspent
# doubling discards hundreds of good blocks and re-fetches the whole backlog for a divergence that is usually
# one block deep. A dry run has one contract, which is to change nothing, and this line was the exception.
if [ "$DRY" = 1 ]; then
  log "    (dry run — the escalation counter is left at $(cut -d' ' -f2 "$STATE" 2>/dev/null || echo unset))"
fi
# The counter is written at the END, not here. It records "a recovery RAN at this margin and the replay still
# failed on this block", and only a run that reaches step 5 has earned that claim. Written up front, any death
# mid-recovery — the supervisor's tmux server going away during step 1, seen once — inflates the margin without
# having rewound anything, so the next attempt discards hundreds of extra good blocks and re-fetches the whole
# backlog to undo a divergence that is usually one block deep.

srv_before=0; tmux ls >/dev/null 2>&1 && srv_before=1
log "1/5 stopping the fetcher (it must not write while block_db is trimmed)$([ "$srv_before" = 0 ] \
&& echo ' — no tmux server running, so there is nothing to stop')"
# NOT `pkill -f fetch_blocks.py`, and this is the whole reason the 2026-08-20 overnight run ended here.
# tmux 3.6 leaves the CREATING session's command in the SERVER process's argv, so a server born running the
# fetcher carries `fetch_blocks.py` in its own cmdline — and that pattern then kills the server, taking every
# session with it: the tap, prove-farm, and the supervisor running THIS script, mid-recovery. The log showed
# this step announcing itself and nothing after it ever running. Reproduced on the box: three sessions, one
# pkill, `no server running`. The bracket trick does not help — it only hides the pattern's own occurrence,
# never another process that happens to mention the same text.
#
# tmux knows the pane's pid, so ask it instead of matching a command line. The negative pid signals the
# pane's process GROUP, which is the shell and the python child together — the same reach the pkill had,
# without the collateral. run_replay.py/fetch_blocks.py still receive SIGTERM, so a clean stop stays clean.
run "for pid in \$(tmux list-panes -t fetch -F '#{pane_pid}' 2>/dev/null); do \
kill -TERM -\"\$pid\" 2>/dev/null || kill -TERM \"\$pid\" 2>/dev/null; done; \
tmux kill-session -t fetch 2>/dev/null; true"
run "sleep 2"
# DISAPPEARED, not merely absent — the distinction is the whole guard. Recovery normally runs when everything
# has already died, so no tmux server is the ordinary case here and must not be an error; only a server that
# was alive before step 1 and is gone after it means step 1 killed it. (When this script runs INSIDE tmux it
# dies with the server and never reaches this line; run from a plain ssh shell, it reports.)
if [ "$DRY" != 1 ] && [ "$srv_before" = 1 ] && ! tmux ls >/dev/null 2>&1; then
  die "the tmux server was alive before step 1 and is gone after it — step 1 killed it, so nothing below \
would have run. This is the 2026-08-20 failure mode; check that step 1 is not matching the server's own argv."
fi

log "2/5 rewinding the triedb"
# --allow-dirty because the replay died mid-batch, which is exactly when the dirty flag is set; without it the
# rewind refuses on the one occasion it is always needed.
run "'$MPT' --storage '$DB' --rewind-to $target --yes --allow-dirty" \
  || die "the rewind FAILED — the ALERT is untouched and the db is as it was. Read the output above."
if [ "$DRY" != 1 ]; then
  now="$("$CLI" --db "$DB" 2>/dev/null | grep -o 'latest_finalized_block_id=[0-9]*' | cut -d= -f2)"
  [ "$now" = "$target" ] || die "rewind reported success but the head is $now, not $target — stopping here"
  log "    head is now $now"
fi

# EVERYTHING above $target goes, and the cost of that is the point rather than an oversight: it can be tens of
# thousands of files and hours of re-fetching to undo a divergence one block deep. A bounded window looks like
# the obvious saving and does not work. fetch_blocks.py resumes at `existing_max_block(block_db) + 1` and that
# is a MAX over the directory, so leaving the settled backlog in place puts a HOLE between the trimmed range
# and it: the fetcher restarts above the hole, never fills it, and the replay sits at `available ==
# last_executed` with thousands of unreachable blocks stacked above a gap it cannot cross. Contiguity is what
# makes block_db usable at all, so the trim keeps it contiguous even when that is expensive.
log "3/5 trimming block_db above $target (they may be the non-canonical ones)"
if [ "$DRY" = 1 ]; then
  printf '   $ %s\n' "ls $BLOCK_DB | awk '\$1+0 > $target' | xargs rm -f   ($(ls "$BLOCK_DB" 2>/dev/null | awk -v t="$target" '$1+0 > t' | wc -l | tr -d ' ') file(s))"
else
  drop="$(mktemp)"; trap 'rm -f "$drop"' EXIT
  ls "$BLOCK_DB" 2>/dev/null | awk -v t="$target" '$1+0 > t' > "$drop"
  log "    $(wc -l < "$drop" | tr -d ' ') block(s) to re-fetch"
  [ -s "$drop" ] && ( cd "$BLOCK_DB" && xargs -a "$drop" rm -f )
fi

# A reorged block may ALREADY have been proved: the failure only surfaces at a later block, so the divergent
# one can be through the prover and on the leaderboard before anything looks wrong. Its proof describes an
# orphan. After the rewind, re-execution produces a NEW witness for the SAME block number — and prove-farm's
# is_proven() keys on the number alone, so it would skip the canonical version and leave the orphan's proof
# standing at that height. Against the real ethproofs, where a proof's identity is (cluster, block_number),
# that is a wrong proof at a given height, not merely untidy.
#
# So invalidate the same range in the prover's ledger that we just invalidated on disk. Those blocks become
# un-proved, the tap re-offers them, and the canonical witness is proved. The run records are left alone: they
# are an audit trail of what actually ran, and rewriting history there would hide the reorg rather than record
# it.
log "4/5 dropping blocks > $target from $FARM_CSV (their proofs describe orphaned blocks)"
if [ ! -f "$FARM_CSV" ]; then
  log "    no $FARM_CSV — nothing to invalidate"
elif [ "$DRY" = 1 ]; then
  printf '   $ %s\n' "awk -F, 'NR==1 || \$2+0 <= $target' $FARM_CSV   ($(awk -F, -v t="$target" 'NR>1 && $2+0 > t' "$FARM_CSV" 2>/dev/null | wc -l | tr -d ' ') row(s) would go)"
else
  dropped="$(awk -F, -v t="$target" 'NR>1 && $2+0 > t' "$FARM_CSV" | wc -l | tr -d ' ')"
  # Header always kept, and written via a temp file + mv so an interrupted run cannot leave a truncated ledger
  # — losing it would make every block look un-proved and re-prove thousands.
  awk -F, -v t="$target" 'NR==1 || $2+0 <= t' "$FARM_CSV" > "${FARM_CSV}.tmp" \
    && mv "${FARM_CSV}.tmp" "$FARM_CSV" \
    && log "    $dropped row(s) dropped — those blocks will be proved again from their canonical witness"
fi

# TELL THE DASHBOARD, before removing the evidence. Nothing else can: the mock sees submissions, never the
# rewind that invalidated some of them, so a run that pauses and then re-proves blocks it already proved reads
# as a prover bug. Best-effort by the same rule as the tap's heartbeat — a dashboard is never worth failing a
# recovery for. It goes to localhost on this box because the tunnel forwards that port to the operator's Mac.
if [ "$DRY" = 1 ]; then
  log "    (dry run — would POST the reorg to the dashboard on :${MOCK_PORT:-8547})"
else
  curl -sf -m 5 -X POST -H 'Content-Type: application/json' \
    -d "{\"failing_block\":$fblock,\"rewound_to\":$target,\"margin\":$margin,\
\"orphaned\":${dropped:-0},\"cluster_id\":\"${CLUSTER:-}\"}" \
    "http://localhost:${MOCK_PORT:-8547}/reorg" >/dev/null 2>&1 \
    && log "    dashboard notified" \
    || log "    dashboard not reachable on :${MOCK_PORT:-8547} — the marker is lost, the recovery is not"
fi

log "5/5 removing the ALERT"
run "rm -f '$ALERT'"

# Now that all five steps are through, record the margin this attempt used. If the replay fails on the SAME
# block again, the next run reads this and doubles — which is the only evidence that the fork predates what the
# failure reported. A run that died before here leaves no trace, so it is retried at the same margin.
if [ "$DRY" != 1 ]; then
  printf '%s %s\n' "$fblock" "$margin" > "${STATE}.tmp" && mv "${STATE}.tmp" "$STATE"
fi

log "repaired. The caller must now restart the fetcher (it was stopped in step 1) and the replay."
