#!/usr/bin/env bash
# rtp-watchdog — bring the tip pipeline back when the thing that was supposed to bring it back is gone too.
#
#   ./rtp-watchdog            check once, act if needed  (this is what cron runs)
#   ./rtp-watchdog --dry-run  say what it would do, touch nothing
#   ./rtp-watchdog --install  write the crontab entry (every 5 minutes) and exit
#
# WHY THIS EXISTS, and why `witness-follow supervise` is not enough. The supervisor recovers from a reorg
# perfectly well — it detects logs/ALERT, runs reorg-recover, restarts the producer. But it runs INSIDE the
# `replay-tip` tmux session, which means it is a peer of what it supervises rather than above it. When the tmux
# server itself goes away, the supervisor goes with it: no session, nobody watching, and the pipeline stays
# down until a human notices. Seen 2026-08-16: the supervisor had reached `reorg-recover: 1/5 stopping the
# fetcher` when the whole server vanished, and the pipeline sat idle for fourteen hours with the ALERT still in
# place and the rewind never performed.
#
# So this is deliberately OUT of process, out of tmux, and stateless: cron starts it, it looks, it acts, it
# exits. The only mechanism on this box that survives everything else is cron.
#
# WHAT IT REFUSES TO DO
#   * fight a deliberate stop — logs/STOP means a human stopped this on purpose, and it is left alone
#   * race a recovery — a reorg-recover already running holds a lock, and this exits rather than interleave
#     a second rewind with the first one's block_db trim
#   * loop on a hard failure — restarts are rate-limited, and past the budget it goes quiet rather than
#     restarting every five minutes forever against a cause it cannot fix
#   * touch the catch-up phase — this watches the TIP. A backlog drain is a deliberate, supervised operation.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MONAD_DIR="${MONAD_DIR:-$HOME/monad}"
STATE="${WATCHDOG_STATE:-$HOME/.rtp-watchdog-state}"
LOG="${WATCHDOG_LOG:-$HOME/rtp-watchdog.log}"
LOCK="${WATCHDOG_LOCK:-$HOME/.rtp-watchdog.lock}"
# Sessions the tip phase owns: asked of ./witness-follow below, because that is what creates them. `prove` is
# the farm and is started by rtp-up, not by witness-follow, so its absence is reported but not repaired from
# here — restarting a prover needs the Mac's environment. TIP_SESSIONS= overrides the list.
MAX_RESTARTS="${WATCHDOG_MAX_RESTARTS:-6}"      # inside the window below
WINDOW_SECS="${WATCHDOG_WINDOW_SECS:-3600}"
DRY=0
case "${1:-}" in
  --dry-run) DRY=1 ;;
  --install) INSTALL=1 ;;
  "") ;;
  *) echo "usage: rtp-watchdog [--dry-run|--install]" >&2; exit 2 ;;
esac

say(){ printf '%s rtp-watchdog: %s\n' "$(date +%FT%T)" "$*" | tee -a "$LOG"; }

if [ "${INSTALL:-0}" = 1 ]; then
  # Every 5 minutes: a tip block is 12 s, so five minutes of downtime is ~25 missed blocks — small against the
  # fourteen hours this exists to prevent, and infrequent enough that a flapping cause cannot spin.
  line="*/5 * * * * $HERE/rtp-watchdog >> $LOG 2>&1"
  if crontab -l 2>/dev/null | grep -qF "rtp-watchdog"; then
    echo "already installed:"; crontab -l | grep -F "rtp-watchdog"; exit 0
  fi
  { crontab -l 2>/dev/null; echo "$line"; } | crontab -
  echo "installed: $line"; exit 0
fi

# One watchdog at a time. Without this, a restart that takes longer than the cron interval gets a second
# watchdog starting the same sessions underneath it.
exec 9>"$LOCK" || exit 0
flock -n 9 || { [ "$DRY" = 1 ] && say "another watchdog holds the lock — would exit"; exit 0; }

# A recovery in flight is NOT a dead pipeline. reorg-recover stops the fetcher as its first step, so half of
# what this checks is legitimately absent while it runs, and restarting on top of it would interleave a session
# start with a block_db trim.
if pgrep -f '[r]eorg-recover' >/dev/null 2>&1; then
  say "reorg-recover is running — leaving it alone"; exit 0
fi
if [ -f "$MONAD_DIR/logs/STOP" ]; then
  say "logs/STOP present — a deliberate stop, not restarting"; exit 0
fi

# OUTPUT, not liveness. Every check in this file until now asks "is the process there" — and a prover that
# proves without submitting passes all of them: session up, log moving, queue draining, ledger filling. The
# pipeline's product is a DELIVERED proof, so the only check that means anything is whether proofs are landing.
# 1789 of them were produced and none posted while every other signal read healthy.
#
# The signal: run records appearing with no submit log beside them. Both live on the box, so this needs nothing
# from the Mac — a check that depended on the leaderboard being reachable would go blind exactly when the link
# is the problem.
# Derived like prove-farm's own paths ($RUNDATA/..., RUNDATA=<repo>/run-data), not written out. Pointing this
# at the wrong directory makes the check fire on every single proof — a guard that cries wolf constantly is a
# guard that gets ignored, which is worse than not having it.
REPO="${REPO:-$HOME/zkvm-bench}"
RUNDATA="${RUNDATA:-$REPO/run-data}"
RESULTS="${RESULTS:-$REPO/infra/zisk-infra/results}"
SUBMIT_LOGS="${SUBMIT_LOGS:-$RUNDATA/prove-farm-logs}"
# FIRST, because a dead pump explains most of what the checks below would otherwise misread: proofs that stop
# arriving, a prover that looks broken, "proving but not delivering". Fixing the transport before judging the
# prover keeps this script from restarting something that was never at fault.
check_pump

proved_recent=$(find "$RESULTS" -name report.json -newermt "-20 minutes" 2>/dev/null | wc -l | tr -d ' ')
submit_recent=$(find "$SUBMIT_LOGS" -name 'submit-*.log' -newermt "-20 minutes" 2>/dev/null | wc -l | tr -d ' ')
PROVE_CMD_FILE="${PROVE_CMD_FILE:-$HOME/.rtp-prove-cmd}"
PUMP_CMD_FILE="${PUMP_CMD_FILE:-$HOME/.rtp-pump-cmd}"
PUMP_EXEC_SOCK="${PUMP_EXEC_SOCK:-$HOME/.zisk-exec.sock}"

# check_pump — the data channel, on a REMOTE prover, and why it is worth a watchdog at all.
#
# THE FALLBACK IS ONLY A FALLBACK FOR ONE HOUR. When the pump dies, core.sh reverts to `scp` for the witness —
# which needs THIS BOX's key to the prover, and the hourly `find ~/.ssh -type f -name 'id_*' -delete` takes it.
# So after the first top of the hour a dead pump is not a slower pipeline, it is a stopped one: every block
# comes back rc=255. Observed 2026-08-20, and it is the reason this check exists rather than being left to the
# operator noticing.
#
# EVERYTHING HERE GOES THROUGH THE EXEC CHANNEL, for the same reason: it is dialled by the prover, so it works
# with no key on this box. If that channel is gone too, there is nothing this script can do from here — it says
# so and stops, because a restart it cannot reach is not a repair.
pump_run(){ PUMP_EXEC_SOCK="$PUMP_EXEC_SOCK" "$REPO/infra/zisk-infra/witness-pump" run "$*" 2>/dev/null; }

check_pump() {
  [ -s "$PUMP_CMD_FILE" ] || return 0            # no remote pump in this deployment (a prover on the Mac)
  if ! pump_run "true" >/dev/null 2>&1; then
    say "the exec channel does not answer, so the pump cannot be checked or restarted from here. Nothing on \
this box can reach the prover without a key. Re-run rtp-up when you can."
    return 1
  fi
  # `[w]itness-pump serve` and NOT the plain string: this command line names the process it looks for, so an
  # unbracketed pattern would match the shell running it. The same rule the restart below depends on.
  n="$(pump_run 'pgrep -c -f "[w]itness-pump serve" || true' | tr -cd '0-9')"
  [ -n "$n" ] || n=0
  if [ "$n" -gt 0 ]; then
    return 0
  fi
  say "the pump is NOT serving on the prover — every witness would fall back to scp, which needs this box's \
key, which the hourly cron deletes. Restarting it from $PUMP_CMD_FILE."
  if [ "$DRY" = 1 ]; then
    say "  [dry-run] would replay $PUMP_CMD_FILE over the exec channel"
    return 0
  fi
  # Restart and CHECK, in two separate calls. One call cannot both kill and start: the start line names
  # `witness-pump serve`, so a pkill in the same command line matches its own shell and nothing after it runs.
  # The stale socket first, or the new server may find the path taken. Its value comes from the RECORDED
  # command — the only place that knows it — and not from a remote shell, where PUMP_SOCK is unset.
  sock="$(sed -n 's/.*PUMP_SOCK=\([^ ]*\).*/\1/p' "$PUMP_CMD_FILE" | head -1)"
  [ -n "$sock" ] && pump_run "rm -f $sock" >/dev/null 2>&1 || true
  pump_run "$(cat "$PUMP_CMD_FILE")" >/dev/null 2>&1 || true
  sleep 5
  n="$(pump_run 'pgrep -c -f "[w]itness-pump serve" || true' | tr -cd '0-9')"
  if [ "${n:-0}" -gt 0 ]; then
    say "  pump back up ($(pump_run 'grep -o "channels open: [0-9/]*" $HOME/witness-pump.log | tail -1'))"
    echo "$(date +%s)" >> "$STATE"
  else
    say "  the replay did not bring it back — see the prover's ~/witness-pump.log"
  fi
}
TIP_ENV_FILE="${TIP_ENV_FILE:-$HOME/.rtp-tip-env}"

# Restart the prover from the invocation rtp-up RECORDED, never from one rebuilt here. A watchdog that
# reassembled the command would drift from rtp-up the first time a flag is added, and the flags that go missing
# silently are the ones that matter: --ethproofs-url absent means proving forever and delivering nothing.
#
# There is no catching up afterwards. A proof for a block the chain finished hours ago is not late, it is a
# false measurement — ethproofs-mock now refuses it outright. So the only thing worth automating is SHRINKING
# the window: 5 minutes of loss instead of the thirteen hours it took a human to notice.
# prove_in_flight — is prove_remote mid-exchange right now? A run dir exists from the moment the prove starts
# and gets its report.json only when the artifacts come back, so "young dir, no report yet" is exactly the
# in-flight window. Bounded by INFLIGHT_SECS so an ABANDONED dir (killed attempt, dead prover) ages out and
# stops blocking restarts for ever.
INFLIGHT_SECS="${INFLIGHT_SECS:-180}"
prove_in_flight() {
  [ -d "$RESULTS" ] || return 1
  local d
  d="$(find "$RESULTS" -mindepth 3 -maxdepth 3 -type d -newermt "-$INFLIGHT_SECS seconds" 2>/dev/null \
       | while IFS= read -r c; do [ -s "$c/report.json" ] || { printf '%s' "$c"; break; }; done)"
  [ -n "$d" ]
}

restart_prover() {
  # NEVER ON TOP OF A LIVE PROVE. `tmux kill-session -t prove` takes the prove with it, and a real prove is
  # ~20 s of GPU work whose artifacts are only fetched at the very end — so killing it mid-flight destroys
  # the proof AND guarantees no submission, which is the exact condition that triggered this restart. It
  # closes a loop: restart -> prove killed -> still not delivering -> restart, every 5 minutes, for ever.
  # Observed on 2026-08-20: 12 restarts, not one proof delivered, and each one threw away a finished proof
  # that was sitting on the prover waiting to be collected.
  if prove_in_flight; then
    say "NOT restarting: a prove is in flight (run dir younger than ${INFLIGHT_SECS}s with no report yet). \
Killing it is what would make 'not delivering' true. Waiting for the next tick."
    return 1
  fi
  if [ ! -s "$PROVE_CMD_FILE" ]; then
    say "cannot restart the prover: no $PROVE_CMD_FILE. It is written by rtp-up — run that once and this \
becomes self-healing."
    return 1
  fi
  if [ "$DRY" = 1 ]; then
    say "  would run: tmux new-session -d -s prove \"\$(cat $PROVE_CMD_FILE)\""
    return 0
  fi
  tmux kill-session -t prove 2>/dev/null
  tmux new-session -d -s prove "$(cat "$PROVE_CMD_FILE")" && return 0
  return 1
}

if [ "${proved_recent:-0}" -gt 3 ] && [ "${submit_recent:-0}" = 0 ]; then
  say "PROVING BUT NOT DELIVERING: $proved_recent proof(s) in the last 20 min and NOT ONE submission. Those \
blocks are marked proven and will never be retried, so they are output LOST — there is no backfill, a missed \
proof is missed. Restarting the prover from the recorded invocation."
  if restart_prover; then
    [ "$DRY" = 1 ] || { echo "$(date +%s)" >> "$STATE"; say "prover restarted from $PROVE_CMD_FILE"; }
  fi
fi

# The list, from the one thing that creates those sessions. A copy kept here would be a second place to
# update, and the copy that falls behind is the invisible one: a session this does not name is a session
# nothing restarts, on the box whose whole point is that nobody is watching it.
[ -n "${TIP_SESSIONS:-}" ] || TIP_SESSIONS="$("$HERE/witness-follow" sessions tip 2>/dev/null)"
# EMPTY is not "nothing to check", it is "no check at all": the loop below would find nothing missing, report
# everything up and exit 0 — quietly, 288 times a day, with the pipeline down. So refuse to run instead.
if [ -z "$(printf '%s' "$TIP_SESSIONS" | tr -d ' \t\n')" ]; then
  say "cannot read the tip session list from $HERE/witness-follow ('sessions tip' printed nothing) — refusing \
to run, because an empty list would report a dead pipeline as healthy. Fix that path, or set TIP_SESSIONS."
  exit 1
fi

missing=""
for s in $TIP_SESSIONS; do
  tmux has-session -t "$s" 2>/dev/null || missing="$missing $s"
done
prove_down=0
tmux has-session -t prove 2>/dev/null || prove_down=1

# `prove` absent on its own is a dead pipeline too: the producer keeps framing witnesses into a queue nobody
# drains. It is not in TIP_SESSIONS because witness-follow does not own it — it is restarted from its own file.
if [ -z "$missing" ] && [ "$prove_down" = 1 ]; then
  say "tip sessions up but the prove session is gone — restarting it from the recorded invocation"
  if restart_prover; then
    [ "$DRY" = 1 ] || echo "$(date +%s)" >> "$STATE"
  fi
  exit 0
fi

if [ -z "$missing" ]; then
  # Everything up. Say nothing on the happy path: this runs 288 times a day and a quiet log is a readable one.
  [ "$DRY" = 1 ] && say "all of$TIP_SESSIONS up$([ $prove_down = 1 ] && echo ' (prove is down — rtp-up territory)')"
  exit 0
fi

# Rate limit, in a window. Each restart appends its epoch; only those inside the window count.
now=$(date +%s)
recent=0
if [ -f "$STATE" ]; then
  while read -r t; do
    case "$t" in ''|*[!0-9]*) continue ;; esac
    [ $(( now - t )) -lt "$WINDOW_SECS" ] && recent=$((recent + 1))
  done < "$STATE"
fi
if [ "$recent" -ge "$MAX_RESTARTS" ]; then
  say "sessions down ($missing) but $recent restart(s) already in the last $((WINDOW_SECS / 60)) min — \
NOT restarting. Something is failing that a restart does not fix: read $MONAD_DIR/logs/ALERT and the newest \
$MONAD_DIR/logs/*.log. Clear $STATE once the cause is fixed."
  exit 1
fi

# An ALERT with no supervisor left to act on it: recover first, or the restart dies on the same block.
if [ -f "$MONAD_DIR/logs/ALERT" ]; then
  say "sessions down ($missing) AND logs/ALERT present — recovering before restarting"
  if [ "$DRY" = 1 ]; then
    say "  would run: $HERE/reorg-recover"
  elif ! MONAD_DIR="$MONAD_DIR" "$HERE/reorg-recover" >>"$LOG" 2>&1; then
    say "  reorg-recover refused (see $LOG) — leaving the ALERT and NOT restarting"
    exit 1
  fi
fi

say "restarting the tip phase (missing:$missing)"
if [ "$DRY" = 1 ]; then
  say "  would run: witness-follow start tip"
  exit 0
fi
# The env that rtp-up passes for the tip phase. Kept here rather than sourced, because a watchdog that depends
# on the Mac being reachable is a watchdog that stops working exactly when the link is the problem.
# ETHPROOFS_URL and CLUSTER matter as much as the polling knobs, and are the easiest to forget: without them
# the tap starts fine, frames witnesses fine, and simply never sends its heartbeat — so the leaderboard freezes
# while every session is up and every log looks healthy. That happened, and it read as "the pipeline stopped".
# MOCK_PORT is what rtp-up forwards over the reverse tunnel; the tap posts to it on localhost.
# NO DEFAULTS INVENTED HERE. The env comes from the file rtp-up recorded; without it this restart would
# substitute its own values, and PROVE_EVERY is a POLICY — it decides which blocks are offered at all, so
# changing it silently changes what coverage means. That happened: a restart imposed 2 on a run set to 10.
if [ ! -s "$TIP_ENV_FILE" ]; then
  say "cannot restart the tip phase: no $TIP_ENV_FILE. It is written by rtp-up — run that once and this \
becomes self-healing. Restarting with guessed settings would change the cadence and the heartbeat silently."
  exit 1
fi
if (cd "$HERE" && env $(cat "$TIP_ENV_FILE") ./witness-follow start tip >>"$LOG" 2>&1); then
  echo "$now" >> "$STATE"
  say "restarted. $((recent + 1))/$MAX_RESTARTS in the last $((WINDOW_SECS / 60)) min."
  if [ "$prove_down" = 1 ]; then
    say "the prove session was down too — restarting it from the recorded invocation"
    restart_prover || say "  prover NOT restarted; witnesses will queue until rtp-up runs"
  fi
else
  say "witness-follow start tip FAILED (see $LOG)"
  exit 1
fi
