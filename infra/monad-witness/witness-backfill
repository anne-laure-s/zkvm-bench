#!/usr/bin/env bash
# witness-backfill — regenerate the Monad witness corpus for a FIXED block set, from a given
# monad branch, on a remote box, and bring it home.
#
# This is NOT witness-follow. That one runs the real-time seam (follow the tip, forever, prune as
# you go). This one is the opposite shape: a bounded backfill of a corpus we already have, so that
# a new guest generation can be measured on the SAME blocks as the old one. It ends.
#
#   ./witness-backfill plan  <branch>       print every command, start nothing (default)
#   ./witness-backfill run   <branch>       do it. REUSES a trie already on the box: it probes the
#                                           history and rewinds to the snapshot when that reaches back
#                                           far enough (seconds), and only resets + reloads (~66 min)
#                                           when the rewind is refused or there is no trie — asking
#                                           before it destroys anything.
#   ./witness-backfill again <branch>       another branch over the SAME range. `run` now does the
#                                           same probe-then-rewind by default, so this differs only in
#                                           skipping the block_db fetch outright and in accepting
#                                           AGAINST= to stop early.
#                                           AGAINST=<gen> probes the first PROBE blocks against that
#                                           corpus and stops if the bytes match — no second corpus.
#   ./witness-backfill status [branch]      where the remote run is (read-only)
#   ./witness-backfill stop                 SIGTERM replay AND fetcher (both — see below)
#   ./witness-backfill pull  <branch>       compress + fetch home + delete remote (idempotent)
#
# The branch is positional (BRANCH= still works). `run` SYNCS it first: these branches are
# force-pushed, so a plain fetch is rejected as non-fast-forward and a stale checkout would build
# yesterday's commit under today's name. Local-only branches (al/*, never pushed) are used as-is.
#
# Phases, and why each is here:
#   dbstate   read-only probe: is there a trie, and does its history still reach the snapshot? This is
#             what decides between the two paths below, and it costs seconds against the 66 minutes it
#             can save. Only `earliest` matters — a trie whose oldest version is past the snapshot
#             cannot be rewound to it, whatever its size.
#   rewind    monad-mpt --rewind-to <snapshot>. Seconds. Note it does NOT fail when it cannot reach the
#             target: it warns and exits 0, so the outcome is asserted, never the exit code.
#   reset     truncate + monad-mpt --create — the fallback, and it DESTROYS the trie. Once the RTP
#             pipeline has followed the tip there is often no way back to a months-old range
#             (--rewind-to is refused below history_min_valid), so an old range may only start fresh.
#   load      monad-cli --load-binary-snapshot. ~66 min, ~350 GB. The snapshot version MUST be
#             FIRST-1 and must exist as a directory; only 25551990 exists on the devcore box today.
#   fetch     fetch_blocks.py into a block_db holding EXACTLY [FIRST-256 .. LAST]. The 256 ancestors
#             are read-only (dump_witness queries ancestor headers and crashes without them); the
#             pruning is what BOUNDS the replay, since run_replay.py has no end-block flag.
#   replay    run_replay.py --zkvm-witness. Dumps <block>.witness + <block>.post_state_root.
#   pull      zstd -> scp -> verify -> delete remote.
#
# Config (env), all overridable:
#   HOST                               the devcore box to run on. REQUIRED, no default
#   BRANCH BLOCKS OUT GEN              what to build, from where, and what to call the result
#   FORCE=1                            replace an existing generation (erases it — see guard_generation)
#   REF                                build this ref verbatim, skipping the branch sync
#   MONAD_DIR DB DB_SIZE BLOCK_DB WITNESS_DIR SNAPSHOTS RPC PY NTHREADS MAX_BATCH SESSION
#   MAX_RESTARTS                       replay restarts allowed after a no-ALERT crash (default 10)
set -uo pipefail

# No default: the box is infrastructure, not part of this repo. Checked at dispatch, so the header
# above still reads without one.
HOST="${HOST:-}"
BRANCH="${BRANCH:-}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/../.." && pwd)"
# Default corpus: exactly the blocks we already have locally, so old and new are comparable.
BLOCKS="${BLOCKS:-$REPO/guests/monad/current/witnesses}"
# A generation is one directory holding BOTH the witnesses and the ELFs that read them — use-gen
# refuses a generation missing either. Resolved by resolve_gen() below, because the default carries
# the branch's COMMIT: these branches are rebased and force-pushed, so <leaf>-<yyyy-mm> alone
# collides with itself within a month.
GEN="${GEN:-}"
OUT="${OUT:-}"
REF="${REF:-}"                       # what we actually build: origin/<branch> after a sync, else <branch>

MONAD_DIR="${MONAD_DIR:-\$HOME/monad}"
DB="${DB:-\$HOME/triedb.db}"
DB_SIZE="${DB_SIZE:-600G}"           # 0.8 x capacity must still fit the fs — see README
# Pin the trie history so the DB can be REWOUND to the start of the range and replayed by another
# branch's node, instead of paying the ~66 min snapshot load again (see `again` below). Empty = the
# node's own dynamic behaviour. Needs ./patch-fixed-history.py on the node — run_replay.py already
# forwards the flag, but the node ignores it unpatched.
HISTORY="${HISTORY:-}"
BLOCK_DB="${BLOCK_DB:-\$HOME/block_db_backfill}"
WITNESS_DIR="${WITNESS_DIR:-\$HOME/witnesses-backfill}"
SNAPSHOTS="${SNAPSHOTS:-/home/refdata/ETH/mainnet/snapshots}"
RPC="${RPC:-http://chi-001.devcore4.com:8545}"
PY="${PY:-\$HOME/.pyenv/versions/3.12.13/bin/python3}"
# This repo, checked out ON THE BOX. Everything this script needs from it -- the replay scripts, the
# node patch -- arrives there by `git pull`, not by being copied from here: one source of truth, and
# the box states which commit it is on.
BOX_REPO="${BOX_REPO:-\$HOME/zkvm-bench}"   # a fresh tmux has no pyenv in PATH
NTHREADS="${NTHREADS:-8}"
MAX_BATCH="${MAX_BATCH:-2000}"
SESSION="${SESSION:-wbackfill}"
MAX_RESTARTS="${MAX_RESTARTS:-10}"   # run_replay.py dies on any RPC blip — see start_replay()
ANCESTORS=256                        # the BLOCKHASH window dump_witness reads

die(){ echo "witness-backfill: $1" >&2; exit 1; }
# Set per verb, because they do not have the same number of phases and a "[8/7]" is a small lie that
# makes a reader doubt the rest of the output.
STEP=0; STEPS=8       # `run` re-pins this once the trie probe says which path it takes: a rewind
                      # skips reset+load (and often fetch), so a fixed 8 would number the steps wrong
step(){ STEP=$((STEP + 1)); printf '\n\033[1m[%d/%d] %s\033[0m  (%s)\n' "$STEP" "$STEPS" "$1" "$(date +%H:%M:%S)"; }
hms(){ printf '%02d:%02d:%02d' $(($1/3600)) $(($1%3600/60)) $(($1%60)); }
say(){ printf '\n\033[1m== %s\033[0m\n' "$1"; }
# -n is deliberate: without it ssh swallows the driver's own stdin, which breaks every read/loop that
# calls it. The cost is that sshq can NEVER be the right side of a pipe -- stdin comes from /dev/null,
# so `cat > file` writes an empty file and the failure is silent. Use sshin for that.
sshq(){ ssh -n -o ConnectTimeout=10 -o BatchMode=yes "$HOST" "$@"; }
# The one shape sshq cannot serve: sending data in over stdin. Used only for the phase script, which
# is generated text and has no file to pull from git.
sshin(){ ssh -o ConnectTimeout=10 -o BatchMode=yes "$HOST" "$@"; }

# ---------------------------------------------------------------- the block set
# Derived from what we already have, so "the same blocks" is a fact, not a promise. A gap is fatal
# rather than silently backfilled: a non-contiguous replay needs a different bound than a range.
resolve_blocks() {
  # bash 3.2 on macOS: no mapfile, no ${arr[-1]}. A newline-separated string is portable and all
  # this needs — the set is only ever used for its first, last and count.
  local list
  if [ -d "$BLOCKS" ]; then
    list=$(ls "$BLOCKS"/*.witness 2>/dev/null | sed 's|.*/||;s|\.witness||' | sort -n)
  elif [ -f "$BLOCKS" ]; then
    list=$(grep -oE '[0-9]+' "$BLOCKS" | sort -n)
  elif echo "$BLOCKS" | grep -qE '^[0-9]+-[0-9]+$'; then
    # -f '%.0f': BSD seq formats with %g by DEFAULT, so a mainnet height comes out as 2.5552e+07 and
    # the arithmetic below dies on it. GNU seq prints integers either way, which is why this only
    # breaks on a Mac — i.e. exactly where `plan` is meant to be usable before touching the box.
    list=$(seq -f '%.0f' "${BLOCKS%-*}" "${BLOCKS#*-}")
  else
    die "BLOCKS is neither a directory, a file, nor FIRST-LAST: $BLOCKS"
  fi
  COUNT=$(printf '%s\n' "$list" | grep -c '[0-9]')
  [ "$COUNT" -gt 0 ] || die "no blocks resolved from $BLOCKS"
  FIRST=$(printf '%s\n' "$list" | head -1)
  LAST=$(printf '%s\n' "$list" | tail -1)
  local span=$((LAST - FIRST + 1))
  [ "$span" -eq "$COUNT" ] || die "block set has gaps ($COUNT blocks over a span of $span) — \
the replay is bounded by a contiguous block_db, so a gapped set needs a different bound"
  SNAP=$((FIRST - 1))
  FETCH_START=$((FIRST - ANCESTORS))
  FETCH_COUNT=$((LAST - FETCH_START + 1))
}

# A generation directory is immutable once filed: it is the pairing of a witness set with the ELFs
# that read it, and every figure quoted anywhere cites it by name. Reusing a name silently rewrites
# history — and the default name is <leaf>-<yyyy-mm>, so a rebase regenerated in the same month
# collides. Worse than overwriting: `tar -x` MERGES, so a smaller new set leaves stragglers from the
# old one behind and you get a mixed-lineage directory that looks whole.
guard_generation() {
  [ -d "$OUT" ] || return 0
  local nw ne
  nw=$(ls "$OUT/witnesses"/*.witness 2>/dev/null | wc -l | tr -d ' ')
  ne=$(ls "$OUT/elf"/*.elf 2>/dev/null | wc -l | tr -d ' ')
  [ "$nw" -eq 0 ] && [ "$ne" -eq 0 ] && return 0
  if [ "${FORCE:-0}" = 1 ]; then
    # Replace means replace: a leftover tarball or a stale PROVENANCE from the previous occupant
    # would outlive the set it describes. Refuse to rm anything that is not a generation dir.
    case "$OUT" in
      "$REPO/guests/monad/gen/"?*) ;;
      *) die "FORCE=1 refused: $OUT is not under guests/monad/gen/" ;;
    esac
    echo "  FORCE=1: erasing generation $GEN ($nw witnesses, $ne elf) and everything beside them"
    rm -rf "$OUT"
    return 0
  fi
  local commit; commit=$(sshq "git -C $MONAD_DIR rev-parse --short $BRANCH" 2>/dev/null || echo "COMMIT")
  die "generation '$GEN' already exists at
    $OUT   ($nw witnesses, $ne elf)
  Refusing to write into it: a rebase regenerated in the same month reuses this name, and the
  extraction would merge the two sets rather than replace them.
  Either name this one for the commit it comes from:
    GEN=$GEN-$commit $0 ${1:-run}
  or, if you really mean to replace it:
    FORCE=1 $0 ${1:-run}"
}

# Bring the branch up to date BEFORE the name is derived from its commit, or the generation carries
# a SHA that is one rebase old. Only `run` calls this: `plan` promises to start nothing, and a fetch
# writes to the remote checkout's refs.
sync_branch() {
  say "syncing $BRANCH on $HOST"
  if [ -n "$REF" ]; then echo "  REF=$REF given — skipping the sync"; return 0; fi
  # ls-remote exits 2 for "no such ref" and something else for "could not talk to origin". Both
  # would otherwise print "origin has no such branch", and only one of them is true — a network
  # failure silently building a stale local branch is exactly the trap this phase exists to close.
  local rc=0
  sshq "git -C $MONAD_DIR ls-remote --exit-code --heads origin '$BRANCH' >/dev/null 2>&1" || rc=$?
  if [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ]; then
    die "cannot reach origin from $HOST to check '$BRANCH' (git ls-remote exit $rc).
  Refusing to guess: building the local ref might silently use a pre-rebase commit.
  Re-run when the network is back, or force the local one with:  REF=$BRANCH $0 run $BRANCH"
  fi
  if [ "$rc" -eq 0 ]; then
    local before after
    before=$(sshq "git -C $MONAD_DIR rev-parse --short '$BRANCH' 2>/dev/null" || echo none)
    # --force with an explicit refspec: these branches are force-pushed, and a plain fetch is
    # rejected as non-fast-forward — which looks like a network error and is not one.
    sshq "git -C $MONAD_DIR fetch --force origin 'refs/heads/$BRANCH:refs/remotes/origin/$BRANCH'" \
      || die "fetch of $BRANCH failed on $HOST"
    after=$(sshq "git -C $MONAD_DIR rev-parse --short 'origin/$BRANCH'")
    # Which of the two to build. Taking origin unconditionally is how this built a commit nobody
    # asked for: the branch on origin was BEHIND the one on the box, so the run silently compiled
    # older code while reporting the branch name you typed. Decide by ancestry and say which won.
    if [ "$before" = "$after" ]; then
      REF="origin/$BRANCH"
      echo "  origin/$BRANCH at $after (unchanged)"
    elif sshq "git -C $MONAD_DIR merge-base --is-ancestor 'origin/$BRANCH' '$BRANCH'" 2>/dev/null; then
      REF="$BRANCH"
      echo "  $BRANCH ($before) is AHEAD of origin/$BRANCH ($after) — building the local one."
      echo "  Push it when you want origin to agree; nothing here needs that."
    elif sshq "git -C $MONAD_DIR merge-base --is-ancestor '$BRANCH' 'origin/$BRANCH'" 2>/dev/null; then
      REF="origin/$BRANCH"
      echo "  origin/$BRANCH  $before -> $after   (local is behind; building the remote one)"
    else
      die "'$BRANCH' on $HOST ($before) and origin/$BRANCH ($after) have DIVERGED — neither contains
  the other, so there is no defensible choice between them. Pick one:
      REF=$BRANCH $0 <verb> $BRANCH             build what is on the box
      REF=origin/$BRANCH $0 <verb> $BRANCH      build what is on origin"
    fi
  else
    REF="$BRANCH"
    echo "  origin has no '$BRANCH' — using the local branch as-is (these working branches are unpushed)"
  fi
  sshq "git -C $MONAD_DIR rev-parse --verify -q '$REF^{commit}' >/dev/null" \
    || die "'$REF' does not resolve on $HOST"
}

# The commit is what distinguishes two generations from the same branch in the same month, so it is
# in the name by default rather than only in the provenance file.
resolve_gen() {
  if [ -z "$GEN" ]; then
    local leaf commit
    leaf=$(echo "${BRANCH:-unnamed}" | sed 's|.*/||; s|[^A-Za-z0-9_-]|-|g')
    commit=$(sshq "git -C $MONAD_DIR rev-parse --short ${REF:-${BRANCH:-HEAD}}" 2>/dev/null)
    if [ -z "$commit" ]; then
      commit="nocommit"          # offline `plan`: the shape is still informative
      echo "  (could not reach $HOST to resolve the commit — name shown with a placeholder)" >&2
    fi
    GEN="$leaf-$(date +%Y-%m)-$commit"
  fi
  OUT="${OUT:-$REPO/guests/monad/gen/$GEN}"
}

# ---------------------------------------------------------------- the replay scripts
REPLAY_DIR="$HERE/replay"

# Copy this repo's run_replay.py / fetch_blocks.py to the box. Unconditional: they are deployment
# artifacts and this checkout is where they live, so there is nothing to reconcile. Done in preflight
# rather than at first use, which is phase 6 of 8 -- by then the reset has destroyed the triedb.
ensure_replay_scripts() {
  sshq "test -d $BOX_REPO/.git" \
    || die "no zkvm-bench checkout at $BOX_REPO on $HOST — this script's inputs travel by git, \
not by copy. Clone it there, or set BOX_REPO."
  sshq "test -f $BOX_REPO/infra/monad-witness/replay/run_replay.py" \
    || die "$BOX_REPO on $HOST predates infra/monad-witness/replay/ — git pull it there first."
  sshq "cp $BOX_REPO/infra/monad-witness/replay/run_replay.py \
           $BOX_REPO/infra/monad-witness/replay/fetch_blocks.py $MONAD_DIR/" \
    || die "could not place the replay scripts into $MONAD_DIR on $HOST"
  echo "  replay scripts from $BOX_REPO @ $(sshq "git -C $BOX_REPO rev-parse --short HEAD" 2>/dev/null)"
}

# Send patch-fixed-history.py to the box and arrange for the build phase to apply it. The node only
# accepts --fixed-history-length with it, and `run` always passes that flag.
ensure_node_patch() {
  [ -n "$HISTORY" ] || return 0
  sshq "test -x $BOX_REPO/infra/monad-witness/patch-fixed-history.py" \
    || die "no patch-fixed-history.py in $BOX_REPO on $HOST — git pull it there."
}

# ---------------------------------------------------------------- preflight
# Every one of these has cost someone a rebuild or a 66-minute load. They are cheap; the failures
# they catch are not.
preflight() {
  say "preflight on $HOST"
  sshq true 2>/dev/null || die "cannot ssh to $HOST"
  # First, before the reset destroys a triedb and the load spends an hour.
  guard_generation run

  [ -n "$BRANCH" ] || die "BRANCH is required (the monad branch to generate from)"
  sshq "git -C $MONAD_DIR rev-parse --verify -q '$BRANCH^{commit}' >/dev/null" \
    || die "branch '$BRANCH' not found in $MONAD_DIR on $HOST (fetch it there first; \
sam/* branches are force-pushed, so: git fetch origin --force 'refs/heads/sam/*:refs/remotes/origin/sam/*')"

  # The snapshot is the hard constraint on WHICH range can be backfilled at all.
  sshq "test -d $SNAPSHOTS/$SNAP" || die "no snapshot $SNAP in $SNAPSHOTS on $HOST — the load needs \
exactly FIRST-1. Available: $(sshq "ls $SNAPSHOTS 2>/dev/null | tr '\n' ' '")"

  # memlock: monad hard-asserts !mlock() in HugeMem. The default 8 MB means the DB will not open.
  #
  # Fatal or a warning depending on whether a triedb already exists, because that is exactly what
  # decides whether proceeding can possibly work:
  #   DB present -- the box mlock'd successfully at least once to create it, so a low `ulimit -Hl`
  #     here is more likely to be this shell's view than the box's real ceiling. Warn: the run may
  #     also only need a rewind, and you may want the build going while an admin is found.
  #   DB absent  -- reset + load is CERTAIN (there is nothing to rewind to), the load cannot open
  #     the DB without mlock, and there is no evidence the box ever could. Starting means spending a
  #     guest build to arrive at a guaranteed failure. Die now.
  # Raising it needs root either way (limits.conf, or setcap cap_ipc_lock+ep on the binaries), so
  # this is never something the script can fix.
  local db_present=no
  sshq "test -f $DB" 2>/dev/null && db_present=yes
  local ml; ml=$(sshq 'ulimit -Hl' 2>/dev/null)
  if [ "$ml" = "unlimited" ] || { [ -n "$ml" ] && [ "$ml" -gt 1048576 ] 2>/dev/null; }; then
    :
  elif [ "$db_present" = yes ]; then
    echo "  WARNING memlock hard limit is '$ml' — monad asserts on mlock(); an admin must raise it."
    echo "          Not fatal: $DB exists, so this box mlock'd at least once. It will bite at the"
    echo "          triedb reset if this run needs one."
  else
    die "memlock hard limit is '$ml' on $HOST and there is no triedb at $DB.
  With no trie there is nothing to rewind to, so this run MUST reset + load — and monad hard-asserts
  !mlock() in HugeMem, so the load cannot even open the DB. Every minute after this point would be
  spent to reach a guaranteed failure.
  An admin must raise it first (limits.conf 'memlock unlimited', or setcap cap_ipc_lock+ep on
  build/cmd/monad, build/cmd/monad-cli and build/category/mpt/monad-mpt), and hugepages must be
  configured too — see infra/monad-witness/README.md."
  fi

  local py_ok; py_ok=$(sshq "test -x $PY && echo yes")
  [ "$py_ok" = yes ] || die "no python at $PY on $HOST (pyenv is not on a fresh tmux PATH)"

  ensure_replay_scripts

  # The reset destroys the triedb. Anything mid-replay is holding it, and would also fight us for
  # the disk. fuser is not installed on this box, so match on the process names instead.
  local busy; busy=$(sshq "pgrep -af 'cmd/monad|run_replay\.py|fetch_blocks\.py' | grep -v pgrep" 2>/dev/null)
  [ -z "$busy" ] || die "something is still running on $HOST — it is using the triedb this would \
destroy:
$busy
  Stop it first (./witness-follow stop, and kill fetch_blocks.py — its stop leaves the fetcher alive)."

  # The guest ELFs need a RISC-V toolchain located through a machine-specific, gitignored file.
  sshq "test -f $MONAD_DIR/zkvm/.cargo/config.toml" \
    || die "no $MONAD_DIR/zkvm/.cargo/config.toml on $HOST — it carries RISCV_TOOLCHAIN_DIR and is \
gitignored, so a fresh checkout does not have it. Create it (see zkvm/README.md)."
  sshq "test -x \$HOME/.cargo/bin/cargo" || die "no cargo on $HOST"
  sshq "test -d \$HOME/.rustup/toolchains/zisk" || die "no zisk rust toolchain on $HOST"

  # p_build runs `ninja -C build`, which needs a CONFIGURED cmake dir. A fresh clone has none, and
  # ninja's own error names a missing build.ninja rather than the missing configure step.
  sshq "test -f $MONAD_DIR/build/build.ninja" \
    || die "no configured build in $MONAD_DIR/build on $HOST — cmake has never run there. \
Configure it once (see the monad repo's build docs) before backfilling."

  # Space: the reset frees the old triedb, so compare against free+current rather than free alone.
  local free_g cur_g want_g
  free_g=$(sshq "df -BG --output=avail \$HOME | tail -1 | tr -dc 0-9")
  cur_g=$(sshq "du -sBG $DB 2>/dev/null | cut -f1 | tr -dc 0-9"); cur_g="${cur_g:-0}"
  want_g="${DB_SIZE%G}"
  echo "  disk: ${free_g}G free + ${cur_g}G reclaimed by the reset, DB_SIZE=${DB_SIZE}"
  [ $((free_g + cur_g)) -gt $((want_g * 8 / 10 + 60)) ] \
    || die "not enough room: 0.8 x $DB_SIZE plus witnesses will not fit in $((free_g + cur_g))G"
}

# ---------------------------------------------------------------- the remote plan
# One function per phase, each emitting shell. `plan` prints them; `run` feeds them to tmux. Keeping
# them as text means the plan you read is byte-for-byte the plan that runs.
p_build() { cat <<EOF
set -e
cd $MONAD_DIR
# --detach, not a plain checkout: git refuses a branch that is checked out in another worktree of
# the same repo, and both al/zkvm-r3* are (monad + monad-profiling). We want the commit anyway.
git checkout --detach ${REF:-$BRANCH}
git rev-parse HEAD
# A checkout moves the submodule gitlink but not its working tree, and the branches disagree on
# third_party/quill — a stale one breaks cmd/monad itself with a missing-header error that reads
# like a broken branch. Verify: the status line must start with a space, not +/-.
git submodule update --init --recursive
git submodule status third_party/quill
# The node only accepts --fixed-history-length with this patch, and the run verb ALWAYS sends it
# (it pins the history so the next run over this range can rewind instead of reloading). A fresh
# checkout does not carry it, so without this the node rejects its own driver's argv:
#   The following arguments were not expected: --fixed-history-length 600
# Applied here, on the checkout, before the build that has to contain it. Idempotent, and it refuses
# to guess if upstream moved -- in which case the build stops rather than producing a node that will
# fail at replay, six phases later.
${HISTORY:+$PY $BOX_REPO/infra/monad-witness/patch-fixed-history.py --file cmd/monad/main.cpp}
ninja -C build -k 0 cmd/monad cmd/monad-cli category/mpt/monad-mpt
EOF
}

# Both ELFs, from the SAME checkout that generates the witnesses — that pairing is the whole point
# of a generation directory, and it is why this runs after p_build's checkout and not before.
p_guest() { cat <<EOF
set -e
cd $MONAD_DIR
# A successful build is not evidence that it built what was asked: cmake caches, and the C++ guest
# archive is produced by build.rs THROUGH cmake, so a branch switch can leave a stale archive in
# place. Deleting the build dir is what makes the checkout land (trap 75).
rm -rf zkvm/zisk/target/riscv64ima-zisk-zkvm-elf/release/build
( cd zkvm/zisk \\
  && PATH="\$HOME/.cargo/bin:\$PATH" \\
     RUSTC="\$HOME/.rustup/toolchains/zisk/bin/rustc" \\
     CARGO_BUILD_TARGET=riscv64ima-zisk-zkvm-elf \\
     cargo build --release )

rm -rf zkvm/sp1/target/release/build/monad-zkvm-sp1-script-*/out
( cd zkvm/sp1/script \\
  && PATH="\$HOME/.cargo/bin:\$HOME/.sp1/bin:\$PATH" cargo build --release )

# Stage both under the canonical names use-gen expects.
mkdir -p /tmp/wb-elf
cp zkvm/zisk/target/riscv64ima-zisk-zkvm-elf/release/monad-zkvm-zisk \\
   /tmp/wb-elf/monad-zkvm-guest-zisk.elf
cp "\$(ls -t zkvm/sp1/target/release/build/monad-zkvm-sp1-script-*/out/monad-zkvm-guest-sp1.elf | head -1)" \\
   /tmp/wb-elf/monad-zkvm-guest-sp1.elf
cd /tmp/wb-elf && sha256sum *.elf | tee /tmp/wb-elf/SHA256
EOF
}

p_reset() { cat <<EOF
set -e
# monad-mpt does NOT create the backing file, it formats an existing one (ENOENT if missing).
rm -f $DB
truncate -s $DB_SIZE $DB
$MONAD_DIR/build/category/mpt/monad-mpt --storage $DB --create --state-machine ethereum
EOF
}

p_load() { cat <<EOF
set -e
# Path is the PARENT dir; the tool appends /<version>. ~66 min, ~350 GB.
$MONAD_DIR/build/cmd/monad-cli --db $DB --version $SNAP \\
    --load-binary-snapshot $SNAPSHOTS
# Must be latest_finalized_block_id=$SNAP (not MAX) or the load did not take — assert it, because
# the next phase would otherwise replay from the wrong height and only fail hours later.
$MONAD_DIR/build/cmd/monad-cli --db $DB --version latest_finalized | tee /tmp/wb-finalized
grep -q 'latest_finalized_block_id=$SNAP' /tmp/wb-finalized \\
  || { echo "load did not land at $SNAP"; exit 1; }
EOF
}

p_rewind() { cat <<EOF
set -e
cd $MONAD_DIR
# --rewind-to DOES NOT FAIL when it cannot reach the target: it prints
#   "WARNING: Cannot rewind database to before <n>, ignoring request."
# and exits 0. So the exit status proves nothing here — assert the OUTCOME.
# It also asks for confirmation before destroying the history above the target; that is the point.
yes | ./build/category/mpt/monad-mpt --storage $DB --rewind-to $SNAP 2>&1 | tee /tmp/wb-rewind-out
./build/cmd/monad-cli --db $DB --version latest_finalized > /tmp/wb-finalized 2>&1 || true
cat /tmp/wb-finalized
if grep -q 'latest_finalized_block_id=$SNAP' /tmp/wb-finalized; then
  echo "REWIND=ok"
else
  echo "REWIND=ignored"
fi
EOF
}

# Is there a trie on the box, and does its history still reach the snapshot? `run` asks before it
# destroys anything: reloading 350 GB takes ~66 min, a rewind takes seconds, and the only way to know
# which is possible is to look. Read-only — monad-mpt without a mutating flag just prints the range.
p_dbstate() { cat <<EOF
set -e
if [ ! -f $DB ]; then echo "DBSTATE=absent"; exit 0; fi
sz=\$(du -sBG $DB 2>/dev/null | cut -f1 | tr -dc 0-9)
$MONAD_DIR/build/category/mpt/monad-mpt --storage $DB > /tmp/wb-dbstate-out 2>&1 || true
cat /tmp/wb-dbstate-out
# "History: N versions, earliest is E, latest is L" — E is what decides whether $SNAP is reachable.
e=\$(grep -oE 'earliest is [0-9]+' /tmp/wb-dbstate-out | head -1 | tr -dc 0-9)
l=\$(grep -oE 'latest is [0-9]+' /tmp/wb-dbstate-out | head -1 | tr -dc 0-9)
if [ -z "\$e" ]; then echo "DBSTATE=unreadable size=\${sz:-0}G"; exit 0; fi
echo "DBSTATE=present size=\${sz:-0}G earliest=\$e latest=\$l"
if [ "\$e" -le "$SNAP" ]; then echo "REACHABLE=yes"; else echo "REACHABLE=no"; fi
EOF
}

p_fetch() { cat <<EOF
set -e
# EXACTLY [FIRST-$ANCESTORS .. LAST]. The ancestors are read-only (dump_witness queries ancestor
# headers and crashes without them); the upper bound is what STOPS the replay, because
# run_replay.py has no end-block flag — it is bounded by the block_db running out.
mkdir -p $BLOCK_DB
cd $MONAD_DIR
$PY fetch_blocks.py --block-db $BLOCK_DB --rpc $RPC --start $FETCH_START --count $FETCH_COUNT
# Prune anything outside the window: a stale wider block_db is how a "bounded" run once planned
# 50k blocks and dumped 137 GB until ENOSPC.
find $BLOCK_DB -maxdepth 1 -type f -printf '%f\\n' \\
  | awk '\$1+0 < $FETCH_START || \$1+0 > $LAST' \\
  | while read -r f; do rm -f "$BLOCK_DB/\$f"; done
echo "block_db now: \$(ls $BLOCK_DB | wc -l) files, want $FETCH_COUNT"
EOF
}

p_replay() { cat <<EOF
set -e
mkdir -p $WITNESS_DIR
cd $MONAD_DIR
rm -f ./logs/ALERT            # it refuses to start while this exists
# --min-follow-batch 1 is NOT optional: the default 8 makes the guard
# n_ready < max(1, min(min_follow_batch, gap)) idle forever on the last <8 blocks of a bounded run,
# with no error and no ALERT.
$PY run_replay.py \\
    --monad-bin build/cmd/monad --monad-cli-bin build/cmd/monad-cli \\
    --block-db $BLOCK_DB --db $DB --rpc $RPC \\
    --logs-dir ./logs --status-file status-backfill.json \\
    --nthreads $NTHREADS --max-batch $MAX_BATCH --min-follow-batch 1 \\
    ${HISTORY:+--fixed-history-length $HISTORY} \\
    --zkvm-witness $WITNESS_DIR
EOF
}

# ---------------------------------------------------------------- already built?
# The guest ELFs are cheap (minutes); the trie reset + snapshot load + replay is hours. So build the
# guests FIRST and ask whether this exact pair already exists before spending any of that.
#
# Honest about what the ELF proves. It fingerprints the GUEST — the READER. A format change forces a
# reader change, so identical ELFs do mean the same witness FORMAT. What they do not pin is the
# CONTENT: dump_witness lives in cmd/monad, and the node can change which nodes it puts in a witness
# (dedup, ordering) without touching the format, so the same reader consumes both while the bytes —
# and therefore every measurement drawn from them — differ. That is why the commit is compared too,
# and why a match on ELFs alone reports rather than assumes.
check_elf_seen() {
  local remote_shas z_sha s_sha
  remote_shas=$(sshq "cat /tmp/wb-elf/SHA256" 2>/dev/null)
  z_sha=$(echo "$remote_shas" | awk '/zisk/{print $1}')
  s_sha=$(echo "$remote_shas" | awk '/sp1/{print $1}')
  [ -n "$z_sha" ] && [ -n "$s_sha" ] || { echo "  (no staged ELF checksums — skipping the seen-before check)"; return 0; }
  echo "  built: zisk $(echo "$z_sha" | cut -c1-16)…  sp1 $(echo "$s_sha" | cut -c1-16)…"

  local g d lz ls hit=""
  for d in "$REPO"/guests/monad/gen/*/; do
    [ -f "$d/elf/monad-zkvm-guest-zisk.elf" ] || continue
    [ -f "$d/elf/monad-zkvm-guest-sp1.elf" ]  || continue
    lz=$(shasum -a256 "$d/elf/monad-zkvm-guest-zisk.elf" | cut -d' ' -f1)
    ls=$(shasum -a256 "$d/elf/monad-zkvm-guest-sp1.elf"  | cut -d' ' -f1)
    if [ "$lz" = "$z_sha" ] && [ "$ls" = "$s_sha" ]; then hit="$d"; break; fi
  done
  [ -n "$hit" ] || { echo "  not seen before — proceeding to the trie"; return 0; }

  g=$(basename "${hit%/}")
  local nw; nw=$(ls "$hit/witnesses"/*.witness 2>/dev/null | wc -l | tr -d ' ')
  local prev_commit cur_commit
  # Strict: only the explicit field this script writes. A loose hex grep is worse than nothing —
  # it matched the witness-format magic (4d5a5701) in a real PROVENANCE and called it a commit.
  prev_commit=$(sed -n 's/^- \*\*commit\*\* `\([0-9a-f]\{7,40\}\)`.*/\1/p' "$hit/PROVENANCE.md" 2>/dev/null | head -1)
  cur_commit=$(sshq "git -C $MONAD_DIR rev-parse --short ${REF:-$BRANCH}" 2>/dev/null)

  say "these ELFs already exist — generation '$g'"
  echo "  both guest ELFs are byte-identical to $hit"
  echo "  it already holds $nw witnesses"
  if [ -n "$prev_commit" ] && [ "$prev_commit" = "$cur_commit" ]; then
    echo "  and its provenance names the same commit ($cur_commit) — this run would reproduce it exactly."
  elif [ -n "$prev_commit" ]; then
    echo "  BUT its provenance names commit $prev_commit, not $cur_commit."
    echo "  Same guest, different tree: dump_witness lives in cmd/monad, not in the guest, so the"
    echo "  witness format MAY have changed even though the ELFs did not. Regenerating is the safe"
    echo "  reading; reusing is the fast one."
  else
    echo "  (could not read a commit from its PROVENANCE.md — cannot tell if the tree matches)"
  fi
  echo
  echo "  reuse it:      cd guests/monad && ./use-gen $g"
  echo "  regenerate:    FORCE=1 $0 run      (spends the trie reset + load + replay anyway)"
  die "stopping before the trie — nothing was destroyed"
}

# ---------------------------------------------------------------- same witnesses?
# The question that decides everything: does this branch produce the SAME witness bytes as a corpus
# we already have? If yes, it needs no corpus of its own — its guest is a VARIANT reading the
# existing one (guests/monad-variants/, like r3 beside the sam generation), and the whole reset +
# load + replay is waste.
#
# It is answered by COMPARING BYTES, on a few blocks, and by nothing else:
#   * a source diff is not an answer. Clean proves sameness, but two branches almost always differ
#     somewhere outside zkvm/ — a test, a README — so in practice it reports "unknown" and helps
#     nobody.
#   * identical guest ELFs are not an answer either. They pin the FORMAT (a format change forces a
#     reader change) but not the CONTENT: dump_witness can change which trie nodes it emits, in the
#     same format, and every measurement moves while the reader is none the wiser.
# Replaying PROBE blocks costs seconds once the trie is rewound, which is what makes this the cheap
# check rather than the thorough one.
PROBE="${PROBE:-20}"        # blocks to compare before committing to a full replay; 0 disables

probe_witnesses() {   # -> 0 if the first $PROBE witnesses are byte-identical to $OUT/witnesses
  local ref="$1" n=0 same=0 diff=0 b
  [ -d "$ref" ] || { echo "  no reference corpus at $ref — cannot probe"; return 2; }
  # NOT seq: on macOS it prints 2.5552e+07 for an 8-digit block number, so every file check below
  # missed, n stayed 0, and "cannot compare" reached a caller that reads any non-zero as "they
  # differ" -- which sent a 504-block replay after a corpus already on disk.
  for b in $(python3 -c 'import sys; a,n=int(sys.argv[1]),int(sys.argv[2]); print("\n".join(str(x) for x in range(a, a+n)))' "$FIRST" "$PROBE"); do
    [ -f "$ref/$b.witness" ] || continue
    local remote_sha local_sha
    remote_sha=$(sshq "sha256sum $WITNESS_DIR/$b.witness 2>/dev/null | cut -d' ' -f1")
    [ -n "$remote_sha" ] || continue
    local_sha=$(shasum -a256 "$ref/$b.witness" | cut -d' ' -f1)
    n=$((n + 1))
    if [ "$remote_sha" = "$local_sha" ]; then same=$((same + 1)); else diff=$((diff + 1)); fi
  done
  echo "  compared $n block(s): $same identical, $diff different"
  # Comparing nothing is not evidence of anything, and the caller can only read a return code --
  # every non-zero one means "they differ" to it. So say it here instead of letting it be guessed.
  [ "$n" -gt 0 ] || die "probe compared 0 blocks against $ref — refusing to call that a difference"
  [ "$diff" -eq 0 ]
}

# ---------------------------------------------------------------- run
tmux_run() {   # $1 window, $2 script
  local w="$1"; shift
  sshq "tmux has-session -t $SESSION 2>/dev/null || tmux new-session -d -s $SESSION -n idle"
  # sshin, NOT sshq: sshq passes -n, so the phase script arrived as an EMPTY file and every phase
  # then "succeeded" instantly having done nothing -- builds that never built, a rewind that never
  # rewound, all reporting done with an EXIT=0 log and no output at all.
  printf '%s\n' "$1" | sshin "cat > /tmp/wb-$w.sh && chmod +x /tmp/wb-$w.sh"
  # A phase script that arrives empty must not look like a phase that had nothing to do.
  sshq "test -s /tmp/wb-$w.sh" || die "the $w phase script arrived empty on $HOST — refusing to run it"
  # Redirect, do NOT pipe through tee. `cmd | tee log; echo EXIT=$?` records TEE's status, which is
  # 0 whatever the phase did -- so a build that stopped on a compile error, and a phase script that
  # arrived empty, both reported EXIT=0 and the run carried on with a stale binary. Nothing reads the
  # pane (wait_window polls the log), so there is nothing to lose by writing straight to the file.
  sshq "tmux new-window -t $SESSION -n $w 'bash /tmp/wb-$w.sh > /tmp/wb-$w.log 2>&1; echo EXIT=\$? >> /tmp/wb-$w.log; sleep infinity'"
}

wait_window() {  # $1 window, $2 label, $3 poll secs, $4 optional remote progress probe
  local w="$1" label="$2" poll="${3:-30}" probe="${4:-}"
  local t0; t0=$(date +%s)
  local beat=0
  echo "  tmux window '$w' on $HOST — heartbeat every ~60s"
  while :; do
    local ec; ec=$(sshq "grep -m1 -oE '^EXIT=[0-9]+' /tmp/wb-$w.log 2>/dev/null" | cut -d= -f2)
    if [ -n "$ec" ]; then
      [ "$ec" = 0 ] || { sshq "tail -25 /tmp/wb-$w.log"; die "$label failed (exit $ec)"; }
      echo "  $label done"; return 0
    fi
    # The window writes EXIT= even on failure, so a MISSING window means it was killed from
    # outside (or tmux died). Without this the poll waits for a line nobody will ever write.
    sshq "tmux list-windows -t $SESSION -F '#W' 2>/dev/null | grep -qx '$w'" \
      || { sshq "tail -25 /tmp/wb-$w.log 2>/dev/null"; die "$label: tmux window '$w' vanished"; }

    # A silent hour is indistinguishable from a hung one. Print elapsed plus whatever the phase
    # can cheaply say about itself — DB size for the load, file count for the fetch, last log line
    # for the builds — rather than a bare spinner.
    beat=$((beat + poll))
    if [ "$beat" -ge 60 ]; then
      beat=0
      local now info=""
      now=$(( $(date +%s) - t0 ))
      [ -n "$probe" ] && info=$(sshq "$probe" 2>/dev/null | tr -d '\n' | cut -c1-70)
      printf '    %s  %s%s\n' "$(hms $now)" "$label" "${info:+ — $info}"
    fi
    sleep "$poll"
  done
}

# run_replay.py dies on ANY exception, and it catches none: every loop iteration calls
# rpc_block_number(finalized) with requests(timeout=30) + raise_for_status(), so one blip on the
# RPC — slow, 5xx, malformed result — raises and kills a run that is otherwise perfectly healthy.
# It exits WITHOUT writing ALERT (that is only written when the monad child returns non-zero), so
# it looks like the replay stopped for no reason.
#
# What makes the restart safe, and cheap: the client resumes from the triedb's last finalized block
# on every start (run_replay.py's own docstring), so a restart re-enters exactly where it stopped.
# And the RPC result feeds only `gap`, whose sole decision use is
# `n_ready < max(1, min(min_follow_batch, gap))` — with --min-follow-batch 1 that threshold is 1
# whatever gap is. In this bounded mode the RPC call is pure liability: it can end the run and
# changes nothing. replay/run_replay.py makes that lookup advisory, which is the direct fix; this
# restart loop covers the class, including a box still running an older copy.
start_replay() {
  sshq "tmux kill-window -t $SESSION:replay 2>/dev/null; true"
  tmux_run replay "$(p_replay)"
}

count_done() { sshq "ls $WITNESS_DIR/*.witness 2>/dev/null | wc -l"; }

wait_for_witnesses() {
  local t0; t0=$(date +%s)
  echo "  waiting for $COUNT witnesses in $WITNESS_DIR ..."
  # The replay does not exit when the block_db runs out — it sleeps in a loop. So completion is a
  # COUNT, not an exit code, and we stop it ourselves once the corpus is whole.
  local last=-1 stall=0 restarts=0
  while :; do
    local n; n=$(count_done); n="${n:-0}"
    [ "$n" -ge "$COUNT" ] && { echo "  all $COUNT witnesses present"; return 0; }

    # Two ways the count stops moving that are NOT slowness, and both look like it:
    #   - a crashed batch drops logs/ALERT and the replay refuses to continue
    #   - the replay process is simply gone
    # Neither prints anything into the witness directory, so without these the loop waits forever.
    if sshq "test -f $MONAD_DIR/logs/ALERT"; then
      sshq "cat $MONAD_DIR/logs/ALERT 2>/dev/null | head -20; tail -15 /tmp/wb-replay.log"
      die "replay dropped logs/ALERT at $n/$COUNT — stopped. Fix, rm the ALERT, and re-run."
    fi
    if ! sshq "pgrep -f 'run_replay\.py.*status-backfill' >/dev/null"; then
      # No ALERT above means the monad child never failed — so this is run_replay.py itself
      # falling over on an unguarded exception, almost always the RPC. Restart it; it resumes.
      if [ "$restarts" -ge "$MAX_RESTARTS" ]; then
        sshq "tail -25 /tmp/wb-replay.log 2>/dev/null"
        die "the replay died $restarts times at $n/$COUNT witnesses — not restarting again.
  Look at the tail above: if it is a requests/RPC traceback, the RPC is flaky and the run is fine;
  raise MAX_RESTARTS, or point --rpc somewhere steadier."
      fi
      restarts=$((restarts + 1))
      echo "    replay exited with no ALERT at $n/$COUNT — restarting ($restarts/$MAX_RESTARTS)"
      sshq "tail -6 /tmp/wb-replay.log 2>/dev/null | sed 's/^/      /'"
      start_replay
      sleep 10
      continue
    fi

    if [ "$n" = "$last" ]; then
      stall=$((stall + 1))
      [ $((stall % 10)) -eq 0 ] && echo "  still $n/$COUNT after $((stall * 30))s — check: \
ssh $HOST tail /tmp/wb-replay.log; logs/ALERT"
    else
      # Rate and ETA from the run's own progress: at ~4.6 blocks/s with --zkvm-witness, 504
      # blocks is a few minutes, but a slow box or a big block set should not be a mystery.
      local el rate eta=""
      el=$(( $(date +%s) - t0 ))
      if [ "$el" -gt 30 ] && [ "$n" -gt 0 ]; then
        rate=$(awk -v n="$n" -v e="$el" 'BEGIN{printf "%.2f", n/e}')
        eta=$(awk -v n="$n" -v c="$COUNT" -v e="$el" 'BEGIN{if(n>0) printf "%d", (c-n)*e/n}')
        printf '    %s  %d/%d witnesses  %s/s  eta %s\n' "$(hms $el)" "$n" "$COUNT" "$rate" "$(hms ${eta:-0})"
      else
        printf '    %s  %d/%d witnesses\n' "$(hms $el)" "$n" "$COUNT"
      fi
      stall=0
    fi
    last="$n"
    sleep 30
  done
}

do_stop() {
  say "stopping replay and fetcher on $HOST"
  # witness-follow's stop leaves the fetcher alive; here that would keep block_db growing toward the
  # tip and an unbounded replay would dump ~7 MB/block until the disk fills. Kill both.
  sshq "pkill -f 'run_replay.py.*status-backfill' ; pkill -f 'fetch_blocks.py.*$BLOCK_DB' ; true"
  sshq "tmux kill-session -t $SESSION 2>/dev/null; true"
  echo "  stopped"
}

do_pull() {
  resolve_blocks
  resolve_gen
  guard_generation pull
  say "compressing $COUNT witness pairs on $HOST"
  local tarball="/tmp/witnesses-$FIRST-$LAST.tar.zst"
  sshq "cd $WITNESS_DIR && tar -cf - *.witness *.post_state_root | zstd -T0 -3 -q -o $tarball -f && \
       ls -la $tarball && sha256sum $tarball | cut -d' ' -f1 > $tarball.sha256"
  local remote_sha; remote_sha=$(sshq "cat $tarball.sha256")

  say "fetching home -> $OUT"
  # Replace, never merge: leftovers from a previous set are invisible in a listing.
  rm -rf "$OUT/witnesses" "$OUT/elf"
  mkdir -p "$OUT/witnesses"
  scp -q -o ConnectTimeout=10 "$HOST:$tarball" "$OUT/" || die "scp failed"
  local local_sha; local_sha=$(shasum -a256 "$OUT/$(basename "$tarball")" | cut -d' ' -f1)
  [ "$local_sha" = "$remote_sha" ] || die "checksum mismatch — NOT deleting the remote copy
  remote $remote_sha
  local  $local_sha"
  echo "  checksum ok ($local_sha)"

  tar -xf "$OUT/$(basename "$tarball")" -C "$OUT/witnesses"
  local got; got=$(ls "$OUT/witnesses"/*.witness 2>/dev/null | wc -l | tr -d ' ')
  [ "$got" -eq "$COUNT" ] || die "extracted $got witnesses, expected $COUNT — remote copy kept"
  echo "  extracted $got witnesses + post_state_root pairs"

  # The ELFs travel with them: a generation is the pair, and use-gen refuses one without the other.
  say "fetching the guest ELFs"
  mkdir -p "$OUT/elf"
  scp -q -o ConnectTimeout=10 "$HOST:/tmp/wb-elf/monad-zkvm-guest-zisk.elf" \
                              "$HOST:/tmp/wb-elf/monad-zkvm-guest-sp1.elf" "$OUT/elf/" \
    || die "could not fetch the ELFs — did the guest phase run? (remote witnesses kept)"
  local sha_z sha_s
  sha_z=$(shasum -a256 "$OUT/elf/monad-zkvm-guest-zisk.elf" | cut -d' ' -f1)
  sha_s=$(shasum -a256 "$OUT/elf/monad-zkvm-guest-sp1.elf"  | cut -d' ' -f1)
  local remote_shas; remote_shas=$(sshq "cat /tmp/wb-elf/SHA256")
  echo "$remote_shas" | grep -q "$sha_z" || die "zisk ELF checksum mismatch — remote copies kept"
  echo "$remote_shas" | grep -q "$sha_s" || die "sp1 ELF checksum mismatch — remote copies kept"
  echo "  zisk $(echo "$sha_z" | cut -c1-16)…  sp1 $(echo "$sha_s" | cut -c1-16)…"

  # Provenance is written here rather than by hand, because the one generation that was filed
  # without it silently won every fixture lookup for two days.
  local commit; commit=$(sshq "git -C $MONAD_DIR rev-parse --short ${REF:-$BRANCH}")
  local fmt; fmt=$("$REPO/guests/monad/witness-fmt" "$OUT/witnesses/$FIRST.witness" 2>/dev/null | awk '{print $1, $2}')
  cat > "$OUT/PROVENANCE.md" <<PROV
# generation \`$GEN\`

Generated $(date +%Y-%m-%d) by \`infra/monad-witness/witness-backfill\` on \`$HOST\`. Witnesses and
ELFs come from a single checkout — that pairing is the point of a generation directory.

- **branch** \`$BRANCH\`
- **commit** \`$commit\`
- **host** \`$HOST\`

Those three lines are machine-read: a later run compares its freshly built ELFs against every
generation here and, on a match, reads **commit** back to tell "same guest, same tree" (reuse this
set) from "same guest, different tree" (dump_witness may have moved — regenerate). Keep the field
shape if you edit this file.

## Witnesses

$COUNT blocks, **$FIRST..$LAST** (contiguous), wire format \`$fmt\`. The same block set as the
generation this replaced, so figures are comparable across generations rather than merely similar.
Replayed from snapshot \`$SNAP\` with a block_db pruned to \`$FETCH_START..$LAST\` — the 256
leading blocks are the BLOCKHASH ancestor window, read for headers and never replayed.

## Guests

| elf | sha256 |
|---|---|
| \`monad-zkvm-guest-zisk.elf\` | \`$sha_z\` |
| \`monad-zkvm-guest-sp1.elf\` | \`$sha_s\` |

## Select it

\`\`\`sh
cd guests/monad && ./use-gen $GEN
\`\`\`

\`use-gen\` re-checks the witness format across the set before switching; nothing here is trusted
on the strength of this file.
PROV
  echo "  wrote $OUT/PROVENANCE.md"

  # Only now, with every byte verified and unpacked locally, is it safe to reclaim the box.
  say "deleting remote copies"
  sshq "rm -rf $WITNESS_DIR $tarball $tarball.sha256 /tmp/wb-elf && echo '  removed $WITNESS_DIR, the tarball and the staged ELFs'"
  echo
  echo "  generation: $OUT"
  echo "    witnesses  $COUNT  ($FIRST..$LAST)"
  echo "    elf        monad-zkvm-guest-{zisk,sp1}.elf"
  echo "  next:  cd guests/monad && ./use-gen $GEN"
}

# ---------------------------------------------------------------- entry
cmd="${1:-plan}"
[ -n "$HOST" ] || die "HOST is required — the devcore box to run on. There is no default: it is \
infrastructure, not part of this repo.  e.g.  HOST=<box> $0 $cmd ${2:-<branch>}"
# Positional branch, so the common case reads as a sentence. BRANCH= still wins nothing/loses
# nothing — it is the fallback when no argument is given.
[ $# -ge 2 ] && BRANCH="$2"
case "$cmd" in
  plan)
    resolve_blocks
    # Same default as run/again: the plan has to show the build that will actually run, and pinning
    # the history is what puts the node patch in it.
    [ -n "$HISTORY" ] || HISTORY=$((LAST - FIRST + 1 + 96))
    resolve_gen
    say "plan — nothing will be started"
    cat <<EOF
  host        $HOST
  branch      ${BRANCH:-<unset — required for run>}
  blocks      $COUNT contiguous, $FIRST..$LAST   (from $BLOCKS)
  snapshot    $SNAP        (must be FIRST-1, and must exist)
  block_db    $FETCH_START..$LAST  ($FETCH_COUNT files: $ANCESTORS ancestors + $COUNT replayed)
  triedb      $DB @ $DB_SIZE   (reset destroys the current one)
  witnesses   $WITNESS_DIR -> $OUT/witnesses
  guest elf   built on $HOST from $BRANCH -> $OUT/elf/monad-zkvm-guest-{zisk,sp1}.elf
  generation  $GEN   (use-gen-ready: witnesses + both ELFs + PROVENANCE.md)
  history     $HISTORY versions (span+96) — the node is patched in the build phase to accept it
EOF
    # `rewind` is listed too: it belongs to `again`, not to `run`, but plan promises every command and
    # a phase that destroys history is not one to discover at execution time.
    for p in build guest dbstate rewind reset load fetch replay; do
      printf '\n\033[1m-- %s --\033[0m\n' "$p"; "p_$p"
    done
    cat <<EOF

  run it:      BRANCH=$BRANCH $0 run          (probes the trie: rewinds if it can, else reset + load)
  the same range from another branch, skipping even the block_db check:
               $0 again $BRANCH               (needs ./patch-fixed-history.py on the node)
  add AGAINST=<generation> to stop early when the first \$PROBE blocks come out byte-identical.
EOF
    ;;
  run)
    resolve_blocks
    [ -n "$BRANCH" ] || die "usage: $0 run <branch>"
    sync_branch
    resolve_gen
    preflight
    [ -n "$HISTORY" ] || HISTORY=$((LAST - FIRST + 1 + 96))
    # build, guest, seen?, dbstate, [rewind | reset+load+fetch], replay, pull. Counted for the
    # rewind path and raised in the fallback, so the numbering never runs past its total.
    STEPS=7
    say "run — $COUNT blocks ($FIRST..$LAST) from branch $BRANCH on $HOST"
    echo "  history pinned at $HISTORY versions (span $((LAST - FIRST + 1)) + margin), so the NEXT run"
    echo "  over this range can rewind instead of reloading."
    echo "  A trie already on the box is REWOUND if its history reaches $SNAP; only if that is refused"
    echo "  is $DB destroyed and reloaded (~66 min), and you are asked again at that point."
    read -r -p "  proceed? [y/N] " a; [ "$a" = y ] || die "aborted"

    ensure_node_patch
    step "node build";        tmux_run build "$(p_build)"
    wait_window build "node build" 20 "tail -1 /tmp/wb-build.log"
    step "guest ELF build";   tmux_run guest "$(p_guest)"
    wait_window guest "guest ELF build" 20 "tail -1 /tmp/wb-guest.log"
    step "already built?"
    [ "${FORCE:-0}" = 1 ] && echo "  FORCE=1 — skipping the seen-before check" || check_elf_seen

    # Reuse before destroy. Probing costs seconds; being wrong costs 66 minutes.
    step "triedb state"
    dbs=$(sshq "$(p_dbstate)" 2>&1) || true
    echo "$dbs" | sed 's/^/      /'
    rewound=0
    if echo "$dbs" | grep -q '^REACHABLE=yes'; then
      echo "  a trie is loaded and its history reaches $SNAP — rewinding instead of reloading"
      step "rewind trie to $SNAP"; tmux_run rewind "$(p_rewind)"
      wait_window rewind "trie rewind" 10 "tail -1 /tmp/wb-rewind.log"
      # The exit code is meaningless (see p_rewind); the marker is the verdict.
      if sshq "grep -q '^REWIND=ok' /tmp/wb-rewind.log"; then
        echo "  rewind ok — the trie is back at $SNAP, no reload needed"
        rewound=1
      else
        echo "  rewind was REFUSED despite a reachable range — falling back to reset + load"
        sshq "grep -i 'cannot rewind' /tmp/wb-rewind-out 2>/dev/null | head -2" || true
      fi
    elif echo "$dbs" | grep -q '^DBSTATE=absent'; then
      echo "  no trie on the box — nothing to rewind, loading from the snapshot"
    else
      echo "  the trie on the box cannot serve this range (see earliest= above) — it must be reloaded"
    fi

    if [ "$rewound" = 1 ]; then
      # The block_db survives a rewind, but it is what BOUNDS the replay, so verify it rather than
      # assume: a previous run may have pruned it, or covered a different range.
      step "block_db check"
      have=$(sshq "ls $BLOCK_DB 2>/dev/null | wc -l" 2>/dev/null | tr -dc 0-9)
      echo "  $BLOCK_DB holds ${have:-0} file(s), the corpus needs $FETCH_COUNT"
      if [ "${have:-0}" -lt "$FETCH_COUNT" ]; then
        echo "  incomplete — fetching the missing range"
        STEPS=$((STEPS + 1))
        step "block_db fetch";  tmux_run fetch "$(p_fetch)"
        wait_window fetch "block_db fetch" 20 "echo \$(ls $BLOCK_DB 2>/dev/null | wc -l)/$FETCH_COUNT blocks"
      fi
    else
      # Word the prompt for the case that is actually true. On a box with no trie there is nothing
      # to destroy, and a red DESTROYS warning that does not apply teaches the reader to skim the
      # one that does.
      printf '\n\033[1;31m'
      if echo "$dbs" | grep -q '^DBSTATE=absent'; then
        echo "  ###  SNAPSHOT LOAD — creates $DB on $HOST (~66 min, ~350 GB)  ###"
        printf '\033[0m'
        read -r -p "  create and load now? [y/N] " a; [ "$a" = y ] || die "aborted"
      else
        echo "  ###  RESET + SNAPSHOT LOAD — this DESTROYS $DB on $HOST (~66 min, ~350 GB)  ###"
        printf '\033[0m'
        read -r -p "  destroy and reload now? [y/N] " a; [ "$a" = y ] || die "aborted — nothing destroyed"
      fi
      STEPS=$((STEPS + 2))          # reset + load join the plan (fetch was already counted)
      step "triedb reset";      tmux_run reset "$(p_reset)"
      wait_window reset "triedb reset" 10 "tail -1 /tmp/wb-reset.log"
      step "snapshot load ~66 min"; tmux_run load "$(p_load)"
      wait_window load "snapshot load" 60 "du -sh $DB 2>/dev/null | cut -f1 | sed 's/\$/ of ~350G/'"
      STEPS=$((STEPS + 1))
      step "block_db fetch";    tmux_run fetch "$(p_fetch)"
      wait_window fetch "block_db fetch" 20 "echo \$(ls $BLOCK_DB 2>/dev/null | wc -l)/$FETCH_COUNT blocks"
    fi
    step "replay + witnesses"; tmux_run replay "$(p_replay)"
    # Assert the bound BEFORE walking away. run_replay.py logs "executing blocks A..B" PER BATCH
    # (B = last + min(n_ready, max_batch)), so B == LAST only when one batch covers the corpus.
    # What actually matters is that B never goes PAST LAST — a B beyond it means the block_db is
    # wider than intended, which is how a bounded run once became 19,504 witnesses and 137 GB.
    sleep 20
    line=$(sshq "grep -m1 -oE 'executing blocks [0-9]+\.\.[0-9]+' /tmp/wb-replay.log")
    [ -n "$line" ] || { sshq "head -20 /tmp/wb-replay.log"; do_stop; die "replay printed no range — stopped"; }
    b="${line##*..}"
    echo "  first batch: $line"
    [ "$b" -le "$LAST" ] \
      || { do_stop; die "replay planned up to $b, past LAST=$LAST — the block_db is wider than the \
corpus. Prune it and retry; stopped before it could fill the disk."; }
    echo "  bound ok: first batch ends at $b, never past $LAST"
    wait_for_witnesses
    do_stop
    step "pull home"
    do_pull
    ;;
  again)
    # Second (and Nth) branch over the SAME range: skip reset + load + fetch by rewinding the trie
    # instead of reloading the snapshot. ~66 min -> seconds, when the history reaches back that far.
    resolve_blocks
    [ -n "$BRANCH" ] || die "usage: $0 again <branch>"
    [ -n "$HISTORY" ] || HISTORY=$((LAST - FIRST + 1 + 96))
    # rewind path: build, guest, seen?, rewind, replay, pull (+1 if AGAINST probes, +3 on fallback)
    STEPS=6; [ -n "${AGAINST:-}" ] && [ "$PROBE" -gt 0 ] && STEPS=7
    sync_branch
    resolve_gen
    sshq true 2>/dev/null || die "cannot ssh to $HOST"
    # BEFORE anything is built or replayed. `run` gets this via preflight; `again` did not, and
    # without it a branch whose corpus is already on disk would be replayed in full and only refused
    # at do_pull — hours after the point where it was already known to be unnecessary. Whether this
    # corpus resembles AGAINST is beside the question: it exists, so it is not to be regenerated.
    guard_generation again
    say "again — replay $COUNT blocks ($FIRST..$LAST) with branch $BRANCH, reusing the loaded trie"
    echo "  history pinned at $HISTORY versions (span $((LAST - FIRST + 1)) + margin)"

    ensure_node_patch
    step "node build";        tmux_run build "$(p_build)"
    wait_window build "node build" 20 "tail -1 /tmp/wb-build.log"
    step "guest ELF build";   tmux_run guest "$(p_guest)"
    wait_window guest "guest ELF build" 20 "tail -1 /tmp/wb-guest.log"
    step "already built?"
    [ "${FORCE:-0}" = 1 ] && echo "  FORCE=1 — skipping the seen-before check" || check_elf_seen

    step "rewind trie to $SNAP"; tmux_run rewind "$(p_rewind)"
    wait_window rewind "trie rewind" 10 "tail -1 /tmp/wb-rewind.log"
    # The exit code is meaningless (see p_rewind); the marker is the verdict.
    if sshq "grep -q '^REWIND=ok' /tmp/wb-rewind.log"; then
      echo "  rewind ok — the trie is back at $SNAP, no reload needed"
    else
      printf '\n\033[1;31m'
      cat <<'BANNER'
  ############################################################################
  #  REWIND REFUSED — falling back to a FULL RESET + SNAPSHOT LOAD (~66 min) #
  ############################################################################
BANNER
      printf '\033[0m'
      sshq "grep -i 'cannot rewind' /tmp/wb-rewind-out 2>/dev/null | head -2" || true
      cat <<EOF
  The trie no longer holds history back to $SNAP, so it cannot be reused.
  Almost always the same cause: disk occupancy crossed 60% during the previous replay
  (usage_limit_start_compact_slow), the slow-ring compaction ran, and the history it freed is gone.
  Raising --fixed-history-length afterwards cannot bring it back.

  To make the NEXT run reusable: give the DB more room (DB_SIZE=$DB_SIZE today) so the whole replay
  stays under 60%, and keep HISTORY above the span ($HISTORY now).

  This fallback DESTROYS $DB on $HOST and reloads ~350 GB.
EOF
      read -r -p "  reset + load now? [y/N] " a; [ "$a" = y ] || die "aborted — nothing destroyed"
      STEPS=$((STEPS + 3))          # reset + load + fetch join the plan
      step "triedb reset";      tmux_run reset "$(p_reset)"
      wait_window reset "triedb reset" 10 "tail -1 /tmp/wb-reset.log"
      step "snapshot load ~66 min"; tmux_run load "$(p_load)"
      wait_window load "snapshot load" 60 "du -sh $DB 2>/dev/null | cut -f1 | sed 's/\$/ of ~350G/'"
      step "block_db fetch";    tmux_run fetch "$(p_fetch)"
      wait_window fetch "block_db fetch" 20 "echo \$(ls $BLOCK_DB 2>/dev/null | wc -l)/$FETCH_COUNT blocks"
    fi

    step "replay + witnesses"; tmux_run replay "$(p_replay)"
    sleep 20
    line=$(sshq "grep -m1 -oE 'executing blocks [0-9]+\.\.[0-9]+' /tmp/wb-replay.log")
    [ -n "$line" ] || { sshq "head -20 /tmp/wb-replay.log"; do_stop; die "replay printed no range — stopped"; }
    b="${line##*..}"
    echo "  first batch: $line"
    [ "$b" -le "$LAST" ] \
      || { do_stop; die "replay planned up to $b, past LAST=$LAST — stopped."; }

    # Probe before committing to the whole corpus. AGAINST names the generation already on disk to
    # compare with; without it there is nothing to compare and the run just proceeds.
    if [ "$PROBE" -gt 0 ] && [ -n "${AGAINST:-}" ]; then
      step "probe: first $PROBE blocks vs $AGAINST"
      ref="$REPO/guests/monad/gen/$AGAINST/witnesses"
      while :; do
        done_n=$(count_done); [ "$done_n" -ge "$PROBE" ] && break
        echo "  waiting: $done_n/$PROBE witnesses"; sleep 10
      done
      if probe_witnesses "$ref"; then
        do_stop
        cat <<EOF

  IDENTICAL to $AGAINST on the first $PROBE blocks — the bytes, not the source.
  Replaying the remaining $((COUNT - PROBE)) would reproduce a corpus you already have.

  Stop here. Build this branch's guest ELFs as a VARIANT instead:
      guests/monad-variants/<name>/monad-<name>-{zisk,sp1}.elf
  and measure against $AGAINST. See guests/monad-variants/README.md.

  Continue anyway with PROBE=0.
EOF
        exit 0
      fi
      echo "  they differ — this branch needs its own corpus; continuing"
    fi

    wait_for_witnesses
    do_stop
    step "pull home"
    do_pull
    ;;
  status)
    resolve_blocks
    resolve_gen
    say "status on $HOST"
    echo "  witnesses  $(count_done)/$COUNT in $WITNESS_DIR"
    sshq "tmux list-windows -t $SESSION 2>/dev/null || echo '  no tmux session $SESSION'"
    sshq "tail -3 /tmp/wb-replay.log 2>/dev/null || true"
    sshq "test -f $MONAD_DIR/logs/ALERT && echo '  ALERT present — replay refuses to start' || true"
    ;;
  stop) do_stop ;;
  pull) do_pull ;;
  *) die "usage: $0 {plan|run|status|stop|pull}" ;;
esac
