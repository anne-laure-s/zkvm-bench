#!/usr/bin/env bash
# witness-follow — bring up (and look at) the Monad witness seam on the devcore box.
#
# The seam has three long-running pieces. Two are Sam's and are NOT reimplemented here — this only
# orchestrates them and adds the third. They are UNTRACKED files in ~/monad/ (in no branch at all, and
# origin does not carry the sam/* branches they began on), so read them on the box, not in a checkout:
#
#   fetch     fetch_blocks.py   raw blocks from an RPC -> block_db          (follows the chain, forever)
#   replay    run_replay.py     block_db -> triedb, dumping zkVM witnesses  (follows block_db, forever)
#   tap       ./witness-tap     witnesses -> queue + manifest + heartbeat, and PRUNES what is done
#
# ./witness-profile is deliberately NOT one of them. A work-unit (steps) is a BENCHMARK quantity, not an
# RTP one: the real-time pipeline never needs it, and producing it live would add a third process, more
# failure surface and disk I/O on the producer's path for data nobody reads there. Run it by hand on a
# curated corpus instead. The one place emulation legitimately belongs in a live run is inside the MOCK
# prover (cli/prove-farm --mock-exec-fallback), where it stands in for proving and its cost is deducted
# from the simulated sleep — i.e. inside the fiction, not in the producer.
#
# Two phases, because they have opposite needs:
#
#   catch-up  replay WITHOUT --zkvm-witness. The flag forces the interpreter (~4.6 vs ~8 blocks/s) and
#             would dump ~7 MB per block for tens of thousands of blocks — hundreds of GB of witnesses
#             nobody wants. Run this until `gap_to_finalized` is small.
#   tip       replay WITH --zkvm-witness and small batches, plus the tap. This is the RTP producer.
#
#   ./witness-follow plan  [catchup|tip]     print the exact commands (default; nothing is started)
#   ./witness-follow start [catchup|tip]     start the tmux sessions for that phase
#   ./witness-follow status                  where everything is (read-only)
#   ./witness-follow stop                    SIGTERM the replay/tap (leaves the fetcher alone)
#
# Config (env): MONAD_DIR REPO WITNESS_DIR BLOCK_DB DB RPC NTHREADS MAX_BATCH MIN_FOLLOW_BATCH
#               PY ETHPROOFS_URL CLUSTER PROVE_EVERY KEEP_RECENT SKIP_AFTER
#               HEAD_TAG CONFIRMATIONS   (block-by-block — see README)
#               SUPERVISE_MAX_CRASHES SUPERVISE_BACKOFF SUPERVISE_HEALTHY_SECS
#                                          the tip supervisor restarts a crash that left no ALERT (20 tries,
#                                          10 s apart, budget reset after 300 s of healthy running). A
#                                          deliberate `stop` writes logs/STOP and is never fought.
#               FETCH_POLL TAP_INTERVAL REPLAY_POLL   (polling latency: 6 s, 6 s and 12 s by default,
#                                          waiting in the end-to-end budget for no benefit)
#               TIP_DIRECT=0 BLOCK_DB_TIMEOUT=30    at the tip, TIP_DIRECT=1 runs ONE long-lived monad that
#                                          waits for blocks instead of run_replay.py starting a fresh one per
#                                          batch, removing a process start per block from chain->witness. Off
#                                          by default here AND in rtp-up: measured 0.19 s median on that leg
#                                          over 300 tip blocks, so the gain is unproven. BLOCK_DB_TIMEOUT is
#                                          SECONDS AS A BARE INTEGER — the parser rejects "30s" with "Could
#                                          not convert", although --help prints its own default as "0s".
set -uo pipefail

MONAD_DIR="${MONAD_DIR:-$HOME/monad}"
REPO="${REPO:-$HOME/zkvm-bench}"
WITNESS_DIR="${WITNESS_DIR:-$HOME/witnesses}"
BLOCK_DB="${BLOCK_DB:-$HOME/block_db}"
DB="${DB:-$HOME/triedb.db}"
RPC="${RPC:-http://chi-001.devcore4.com:8545}"
NTHREADS="${NTHREADS:-8}"
MAX_BATCH="${MAX_BATCH:-2000}"
MIN_FOLLOW_BATCH="${MIN_FOLLOW_BATCH:-1}"
PY="${PY:-$HOME/.pyenv/versions/3.12.13/bin/python3}"   # a fresh tmux has no pyenv in PATH
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

die(){ echo "witness-follow: $1" >&2; exit 1; }

# HEAD_TAG/CONFIRMATIONS need the fetch_blocks.py from replay/ on the box. An older one only knows
# `finalized` — which advances 32 blocks at a time, so witnesses arrive in epoch bursts ~13-19 min behind
# the head. `latest` + 2 confirmations makes it one block per slot.
fetch_cmd() {
  local extra=""
  [ -n "${HEAD_TAG:-}" ]      && extra="$extra --head-tag $HEAD_TAG"
  [ -n "${CONFIRMATIONS:-}" ] && extra="$extra --confirmations $CONFIRMATIONS"
  # The fetcher sleeps --poll-interval when caught up (6 s by default), so up to 6 s of pure latency sits
  # between a block appearing and the fetcher noticing. One RPC call per second to a local node is nothing.
  [ -n "${FETCH_POLL:-}" ]    && extra="$extra --poll-interval $FETCH_POLL"
  echo "cd $MONAD_DIR && $PY fetch_blocks.py --rpc $RPC --block-db $BLOCK_DB$extra 2>&1 | tee -a ~/fetch.log"
}
replay_cmd() {  # $1 = catchup|tip
  local extra="--max-batch $MAX_BATCH"
  [ "$1" = tip ] && extra="--min-follow-batch $MIN_FOLLOW_BATCH --zkvm-witness $WITNESS_DIR"
  # run_replay.py idles on its OWN poll interval (12 s by default) once it has consumed the block_db — the
  # single largest polling delay in the whole pipeline, and measured at 6-18 s inside chain->witness.
  # Passed only when set, because an unknown flag would stop the replay from starting at all.
  [ -n "${REPLAY_POLL:-}" ] && extra="$extra --poll-interval $REPLAY_POLL"
  echo "cd $MONAD_DIR && $PY run_replay.py --monad-bin build/cmd/monad --monad-cli-bin build/cmd/monad-cli \
--block-db $BLOCK_DB --db $DB --rpc $RPC --logs-dir ./logs --status-file status.json \
--nthreads $NTHREADS $extra 2>&1 | tee -a ~/replay-$1.log"
}
# tip_direct_cmd — ONE long-lived monad process that WAITS for blocks, instead of a fresh one per batch.
#
# `monad --help` gives two options run_replay.py never uses together:
#   --nblocks           default 18446744073709551615, i.e. "until stopped"
#   --block-db-timeout  seconds to wait for a block to appear in block_db (0 = no retry, the default)
#
# With both, monad follows block_db as it grows. That removes the single remaining floor under chain->witness:
# run_replay.py starts a NEW monad per batch, and --min-follow-batch 1 (required for block-by-block) pays that
# full startup — db open, ring config, ~0.4 s of initialisation — for EVERY block. It also makes
# run_replay.py's own --poll-interval irrelevant, since monad itself is now the thing that waits.
#
# monad resumes from the triedb's own head (observed: "Finished initializing db at block = N, start block
# number = N+1"), so no start block is needed and restarts stay safe.
#
# MAX_BATCH and MIN_FOLLOW_BATCH have no meaning on this path — there are no batches.
tip_direct_cmd() {
  local extra=""
  [ -n "${BLOCK_DB_TIMEOUT:-}" ] && extra="--block-db-timeout $BLOCK_DB_TIMEOUT"
  echo "$MONAD_DIR/build/cmd/monad --chain ethereum_mainnet --block-db $BLOCK_DB --db $DB \
--nthreads $NTHREADS --zkvm-witness $WITNESS_DIR $extra"
}
tap_cmd() {
  echo "cd $HERE && WITNESS_DIR=$WITNESS_DIR REPO=$REPO BLOCK_DB=$BLOCK_DB RPC=$RPC \
${ETHPROOFS_URL:+ETHPROOFS_URL=$ETHPROOFS_URL }${CLUSTER:+CLUSTER=$CLUSTER }\
${PROVE_EVERY:+PROVE_EVERY=$PROVE_EVERY }${KEEP_RECENT:+KEEP_RECENT=$KEEP_RECENT }\
${SKIP_AFTER:+SKIP_AFTER=$SKIP_AFTER }\
${TAP_INTERVAL:+INTERVAL=$TAP_INTERVAL }${SETTLE_SECS:+SETTLE_SECS=$SETTLE_SECS }\
./witness-tap 2>&1 | tee -a ~/witness-tap.log"
}

phase_sessions() { [ "$1" = tip ] && echo "fetch replay-tip tap" || echo "fetch replay-catchup"; }

# cmd_supervise — run the tip replay FOREVER, recovering from reorgs on its own.
#
# At CONFIRMATIONS=0 a reorg stops run_replay.py with an ALERT and nothing restarts it: two reorgs in four
# hours took the producer down twice, each needing a manual rewind. Real-time proving cannot depend on someone
# watching. So: run the replay, and when it dies with an ALERT, repair the state and run it again.
#
# Deliberately NOT a blind retry loop. ./reorg-recover refuses anything that is not reorg-shaped and gives up
# once its margin is exhausted, so a genuine fault (disk full, corruption) stops the loop instead of grinding
# the database.
#
# An exit without an ALERT is NOT enough to mean "a clean stop", even though reading it that way is what keeps
# `witness-follow stop` from being fought. It is equally the signature of the ORCHESTRATOR dying — run_replay.py
# has no try/except anywhere and makes a 30 s HTTP call every iteration — and those crashes are the ones that
# must be restarted. Both exit rc=1 with no ALERT, so the two are told apart by the logs/STOP marker cmd_stop
# writes, and by nothing else.
# run_tip_once — one run of the tip producer, on whichever path TIP_DIRECT selects.
#
# TIP_DIRECT=1: monad directly, long-lived. TIP_DIRECT=0 (the default): the old run_replay.py path, kept so the
# two can be MEASURED against each other rather than one replacing the other on an argument.
#
# The default is 0 here to match rtp-up's. rtp-up passes the value explicitly on every call, so this default
# only governs a direct invocation of this script — the path with no operator watching it, and the one where a
# default disagreeing with rtp-up's would silently select the long-lived monad instead of run_replay.py. Both
# spellings below (`run_tip_once` and the `replay-tip` env line) have to carry the same one.
#
# The direct path has to write logs/ALERT itself, because that marker is run_replay.py's job and ./reorg-recover
# parses it for the failing block number. Same shape, same first lines, so nothing downstream changes.
# wait_for_start_block — do not launch monad before the block it will start on is actually in block_db.
#
# monad builds a 256-block BLOCKHASH buffer at startup and hard-ASSERTS on it: a start block that is missing
# — or still being written — aborts the process with SIGABRT before a single block is executed. That is not a
# recoverable error and it is not reorg-shaped, so reorg-recover refuses it, the watchdog stands down, and
# the producer stays down until a human reads the ALERT. One second of misfortune costs hours of downtime.
#
# It happened on 2026-08-18: `start tip` launched the fetcher, slept 3 s, and started monad while the fetcher
# was still 16 minutes behind. monad asked for block 25782602 at 10:50:05 and the fetcher wrote that exact
# file at 10:50:05. Nine hours of tip proving were lost to a race with a one-second window.
#
# Three seconds of sleep is a hope, not a synchronisation: it is sized for a fetcher that is already caught
# up, which is precisely the case that never needed it. So wait for the FILE, and wait for it to stop
# growing — absent and half-written fail identically.
#
# The start block is the database's own next block, read read-only. A parse failure skips the wait rather
# than blocking the producer: this guard exists to prevent a crash, not to become a new way to not start.
wait_for_start_block() {
  # `wc -c` rather than `stat -c %s`: the same script is read and edited on a Mac, where `stat -c` is not
  # an option at all and silently yields nothing — a size check that always reads 0 would wait forever.
  # `2>/dev/null` goes BEFORE the input redirection: redirections apply left to right, so with it after,
  # the shell reports "No such file or directory" itself on every poll of a block that has not arrived —
  # which is the normal case this loop exists to sit through.
  local cli="$MONAD_DIR/build/cmd/monad-cli" last start waited=0 s1 s2
  local limit="${TIP_START_WAIT:-600}"
  [ -x "$cli" ] || { echo "supervise: no monad-cli at $cli — starting without the block_db wait"; return 0; }
  last="$("$cli" --db "$DB" --version latest_finalized 2>&1 |
          sed -n 's/.*latest_finalized_block_id=\([0-9][0-9]*\).*/\1/p' | tail -1)"
  case "$last" in ''|*[!0-9]*)
    echo "supervise: could not read latest_finalized from $DB — starting without the block_db wait"; return 0 ;;
  esac
  start=$((last + 1))
  while :; do
    s1=$(wc -c 2>/dev/null < "$BLOCK_DB/$start" || echo 0); s1=${s1// /}
    if [ "$s1" -gt 0 ]; then
      # Stable, not merely present: fetch_blocks.py writes the file in place, so a size that is still
      # changing is a block monad would read half of.
      sleep 1; waited=$((waited + 1))
      s2=$(wc -c 2>/dev/null < "$BLOCK_DB/$start" || echo 0); s2=${s2// /}
      if [ "$s1" = "$s2" ]; then
        [ "$waited" -gt 1 ] && echo "supervise: block $start is in block_db (waited ${waited}s) — starting the tip producer"
        return 0
      fi
      continue
    fi
    if [ "$waited" -ge "$limit" ]; then
      echo "supervise: block $start is STILL not in $BLOCK_DB after ${limit}s — NOT starting monad, which would"
      echo "supervise:   abort on its BLOCKHASH buffer and leave an ALERT nothing can recover from."
      echo "supervise:   The fetcher is behind or stopped: check 'tmux capture-pane -p -t fetch' and ~/fetch.log."
      return 1
    fi
    [ "$waited" = 0 ] && echo "supervise: waiting for block $start to reach block_db (the fetcher is behind)"
    sleep 2; waited=$((waited + 2))
  done
}

run_tip_once() {
  if [ "${TIP_DIRECT:-0}" = 0 ]; then
    echo "supervise: tip replay via run_replay.py (TIP_DIRECT=0 — one monad process per batch)"
    eval "$(replay_cmd tip)"; return $?
  fi
  local log rc; log="$MONAD_DIR/logs/monad-tip-$(date +%Y%m%d-%H%M%SZ).log"
  mkdir -p "$MONAD_DIR/logs" "$WITNESS_DIR"
  wait_for_start_block || return 1
  echo "supervise: tip producer direct, one long-lived process -> $log"
  echo "supervise:   $(tip_direct_cmd)"
  eval "$(tip_direct_cmd)" > "$log" 2>&1; rc=$?
  if [ "$rc" -ne 0 ]; then
    # Same format run_replay.py writes, so ./reorg-recover finds "block N failed with: <reason>" in the tail.
    { echo "monad exited $rc (direct tip mode)"
      echo "log: $log"
      echo "last lines:"
      tail -40 "$log"
    } > "$MONAD_DIR/logs/ALERT"
  fi
  return "$rc"
}

cmd_supervise() {
  local rc crashes=0
  while :; do
    if ! tmux has-session -t fetch 2>/dev/null; then
      echo "supervise: fetcher not running (reorg-recover stops it by design) — starting it"
      tmux new-session -d -s fetch "$(fetch_cmd)"
      sleep 3
    fi
    local t0; t0=$(date +%s)
    run_tip_once; rc=$?
    if [ ! -f "$MONAD_DIR/logs/ALERT" ]; then
      # "No ALERT" does not mean "a clean stop": it is ALSO the signature of the
      # orchestrator itself falling over, because ALERT is only written when the monad CHILD fails.
      # run_replay.py catches no exception anywhere, and its per-iteration finalized lookup is a
      # 30 s-timeout HTTP call — so one RPC blip took the producer down with nothing to explain
      # it. replay/run_replay.py treats that lookup as advisory, which fixes that specific cause;
      # this handles the class, including boxes still running an older copy.
      if [ -f "$MONAD_DIR/logs/STOP" ]; then
        echo "supervise: STOP present — deliberate stop (rc=$rc). Not restarting."
        return 0
      fi
      local ran=$(( $(date +%s) - t0 ))
      # A producer that ran healthily for a while and then crashed has earned a fresh budget;
      # otherwise a long-lived run would eventually exhaust it on unrelated blips.
      [ "$ran" -gt "${SUPERVISE_HEALTHY_SECS:-300}" ] && crashes=0
      crashes=$((crashes + 1))
      if [ "$crashes" -gt "${SUPERVISE_MAX_CRASHES:-20}" ]; then
        echo "supervise: crashed $crashes times with no ALERT — giving up. Look at the newest \
$MONAD_DIR/logs/*.log; if it is a requests/RPC traceback, the box is running an older run_replay.py \
than replay/." >&2
        return "$rc"
      fi
      echo "supervise: exited rc=$rc after ${ran}s with no ALERT and no STOP — that is a crash, \
not a stop. Restarting ($crashes/${SUPERVISE_MAX_CRASHES:-20}) in ${SUPERVISE_BACKOFF:-10}s."
      sleep "${SUPERVISE_BACKOFF:-10}"
      continue
    fi
    echo "supervise: ALERT present — attempting reorg recovery"
    if ! MONAD_DIR="$MONAD_DIR" BLOCK_DB="$BLOCK_DB" DB="$DB" "$HERE/reorg-recover"; then
      echo "supervise: recovery refused (reason above). The ALERT is left in place; stopping." >&2
      return 1
    fi
    echo "supervise: recovered — restarting"
  done
}

cmd_plan() {
  local phase="${1:-catchup}"
  echo "# phase: $phase   (nothing has been started — this only prints)"
  echo
  echo "tmux new-session -d -s fetch \"$(fetch_cmd)\""
  echo
  echo "tmux new-session -d -s replay-$phase \"$(replay_cmd "$phase")\""
  if [ "$phase" = tip ]; then
    echo
    echo "# ALWAYS dry-run the tap once first — it is the only piece that deletes files:"
    echo "$(tap_cmd | sed 's/\.\/witness-tap/.\/witness-tap --once --dry-run/')"
    echo
    echo "tmux new-session -d -s tap \"$(tap_cmd)\""
  fi
}

cmd_start() {
  local phase="${1:-catchup}" s
  case "$phase" in catchup|tip) ;; *) die "phase must be catchup or tip" ;; esac
  [ -d "$MONAD_DIR" ] || die "no monad tree at $MONAD_DIR"
  [ -x "$REPO/guests/monad-zisk/gen-inputs" ] || die "no zkvm-bench clone at $REPO (git pull it first)"
  [ -f "$MONAD_DIR/logs/ALERT" ] && die "logs/ALERT present — a previous replay batch FAILED. Read it, \
fix the cause, then rm it. Never clear it blindly."
  # A stale STOP would make the supervisor quit on the first crash of a brand-new run.
  rm -f "$MONAD_DIR/logs/STOP"
  [ "$phase" = tip ] && mkdir -p "$WITNESS_DIR"
  for s in $(phase_sessions "$phase"); do
    if tmux has-session -t "$s" 2>/dev/null; then echo "· $s already running"; continue; fi
    case "$s" in
      fetch)        tmux new-session -d -s "$s" "$(fetch_cmd)" ;;
      # The TIP replay runs under the supervisor, so a reorg is repaired and the replay restarted without
      # anyone watching. Catch-up does not need it: it replays already-finalized history, which cannot reorg.
      # Every variable is passed EXPLICITLY: a tmux session inherits the tmux SERVER's environment, not that of
      # the shell that created it, so exported values silently vanish. The other commands escape this because
      # they interpolate their values into the command text; `supervise` reads them at runtime, so they have to
      # be spelled out here or it would quietly run on defaults.
      replay-tip)   tmux new-session -d -s "$s" "cd $HERE && MONAD_DIR=$MONAD_DIR REPO=$REPO \
WITNESS_DIR=$WITNESS_DIR BLOCK_DB=$BLOCK_DB DB=$DB RPC=$RPC NTHREADS=$NTHREADS PY=$PY \
MAX_BATCH=$MAX_BATCH MIN_FOLLOW_BATCH=$MIN_FOLLOW_BATCH TIP_DIRECT=${TIP_DIRECT:-0} \
BLOCK_DB_TIMEOUT=${BLOCK_DB_TIMEOUT:-30} ${REPLAY_POLL:+REPLAY_POLL=$REPLAY_POLL }\
${HEAD_TAG:+HEAD_TAG=$HEAD_TAG }${CONFIRMATIONS:+CONFIRMATIONS=$CONFIRMATIONS }\
${FETCH_POLL:+FETCH_POLL=$FETCH_POLL }./witness-follow supervise >> ~/replay-supervise.log 2>&1" ;;
      replay-*)     tmux new-session -d -s "$s" "$(replay_cmd "$phase")" ;;
      tap)          tmux new-session -d -s "$s" "$(tap_cmd)" ;;
    esac
    echo "· started $s"
  done
  echo; cmd_status
}

cmd_stop() {
  local s
  # Tell the supervisor this was deliberate. A stop and a crash are otherwise indistinguishable:
  # run_replay.py's SIGTERM handler does sys.exit(1), and an unhandled exception exits 1 too, and
  # NEITHER writes an ALERT. Without this marker the supervisor can only either fight `stop` or ignore
  # crashes; with it, it distinguishes them (see cmd_supervise).
  mkdir -p "$MONAD_DIR/logs" && : > "$MONAD_DIR/logs/STOP"
  for s in replay-catchup replay-tip tap profile; do
    tmux has-session -t "$s" 2>/dev/null || continue
    # SIGTERM run_replay.py: it forwards to monad and exits WITHOUT writing an ALERT (a clean stop).
    pkill -TERM -f "[r]un_replay.py" 2>/dev/null
    pkill -TERM -f "[w]itness-tap" 2>/dev/null
    pkill -TERM -f "[w]itness-profile" 2>/dev/null
    sleep 3; tmux kill-session -t "$s" 2>/dev/null
    echo "· stopped $s"
  done
  echo "(the fetcher is left running — the block_db is cheap and reusable)"
}

cmd_status() {
  echo "== sessions =="; tmux ls 2>&1 | sed 's/^/  /'
  echo "== replay =="
  [ -f "$MONAD_DIR/status.json" ] && sed 's/^/  /' "$MONAD_DIR/status.json"
  [ -f "$MONAD_DIR/logs/ALERT" ] && echo "  ⚠️  logs/ALERT PRESENT — the replay stopped on a failure"
  local L; L="$(ls -t "$MONAD_DIR"/logs/monad_*.log 2>/dev/null | head -1)"
  if [ -n "$L" ]; then
    echo "  log: $(basename "$L")   $(grep -o 'Disk usage: 0\.[0-9]*' "$L" | tail -1)"
    echo "  $(grep -oE 'Compaction head offset fast=[0-9]+, slow=[0-9]+' "$L" | tail -1)"
    grep -h 'Adjust db history length' "$L" | tail -1 | sed 's/^/  /'
  fi
  echo "== witnesses =="
  echo "  dump : $(ls "$WITNESS_DIR" 2>/dev/null | grep -c '\.witness$') file(s), $(du -sh "$WITNESS_DIR" 2>/dev/null | cut -f1)"
  # Strict tag form: the queue also holds <tag>.pv.bin public values, which are not queue entries.
  echo "  queue: $(ls "$REPO/guests/monad-zisk/fixtures" 2>/dev/null | grep -cE '^[0-9]+-[0-9]+\.bin$') input(s)"
  # Guard the file test: a redirection from a missing file prints its own error before any 2>/dev/null
  # inside the substitution can catch it — noisy on every status call before the tap has ever run.
  local M="${MANIFEST:-$HOME/witness-manifest.csv}"
  if [ -f "$M" ]; then echo "  manif: $(( $(wc -l < "$M") - 1 )) row(s)"
  else echo "  manif: 0 row(s)  (no $M yet)"; fi
  echo "== disk =="; df -h / | tail -1 | sed 's/^/  /'; echo "  triedb: $(du -sh "$DB" 2>/dev/null | cut -f1)"
}

case "${1:-plan}" in
  plan)   shift || true; cmd_plan "${1:-catchup}" ;;
  start)  shift || true; cmd_start "${1:-catchup}" ;;
  supervise) cmd_supervise ;;
  stop)   cmd_stop ;;
  status) cmd_status ;;
  -h|--help) sed -n '2,30p' "$0" ;;
  *) die "unknown command '${1}' (plan | start | tip | status | stop)" ;;
esac
