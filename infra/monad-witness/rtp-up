#!/usr/bin/env bash
# rtp-up — bring the whole RTP pipeline up, end to end, from the Mac.
#
# TWO PROVERS. By default the prover is a MODEL (zisk-runner's mock branch: emulate the block for its step
# count, apply the 16x5090 fit, sleep). `--real` swaps in a ZisK cluster on a GPU box instead. Everything
# around the prover — fetch, replay, witness, both transfers, submission, verification — is real in both.
#
# Topology it wires (the one we settled on):
#
#   the box                                    this Mac
#   ───────                                    ────────
#   fetch_blocks.py  (latest-N, block by block)
#   run_replay.py    (--zkvm-witness)
#   witness-tap      (queue · manifest · heartbeat · purge)
#   cli/prove-farm   ──7 MB witness──►         default: zisk-runner in MOCK mode — emulate the block to
#                    ◄──380 KB proof──           measure its steps, derive the proving time, sleep
#                    ──submission────►         cli/ethproofs-mock  (verifies, leaderboard, /status)
#
#   with --real, the middle column moves to PROVER=<gpu box>: prove-farm drops --mock, so
#   `infra/zisk-infra/run prove-cluster` drives the ZisK coordinator there and returns a real proof.
#
# The Mac reaches the box directly; the box reaches the Mac through a reverse tunnel this script
# supervises (2222 -> the Mac's sshd, 8547 -> the mock). In mock mode only the prover's SLEEP is fiction:
# the block fetch, the execution, the witness, both transfers, the submission and the verification are all
# real. With --real nothing is.
#
# WHAT IT WILL NOT DO, on purpose:
#   * enable Remote Login (a security setting — turn it on yourself in System Settings > Sharing)
#   * commit or push your code (it warns; the box's own clone is verified at step 6 instead)
#   * install a toolchain
#   * switch your monad branch (it checks, and stops if it is wrong — a checkout is a decision)
#  It DOES rebuild monad's binary when it does not match the checkout: BUILD_MONAD=1 is the default, and
#  that repair is one deterministic command. BUILD_MONAD=0 turns it back into an error with instructions.
#
#   ./rtp-up [--real] [--dry-run] [--purge] [--keep-mock] [--cron] [--stop]
#
#     --real       prove on a REAL ZisK cluster instead of the model. REQUIRES PROVER=<gpu box>.
#                  Also: runs the per-ELF `cargo-zisk remote setup` (without --hints — the Monad guest
#                  has none), checks the coordinator is answering before starting, prints the projected
#                  service times and the cadence they suggest (PROVE_EVERY stays yours), and gives the
#                  deployment its own runner dir, workspace, socket, log and ethproofs cluster id so it
#                  cannot collide with a mock one on the same host. And it establishes the two persistent
#                  channels ON THE PROVER (data + exec, both dialled by the prover), so the box->prover key
#                  is needed at startup and never again — see "Real proving on a cluster" in the README.
#     --dry-run    print every command, run none of them
#     --purge      empty the prover queue and the witness dump first, for a clean coverage measurement
#     --keep-mock  do not restart ethproofs-mock (default: restart it, so it can never run stale code —
#                  its store persists, nothing is lost)
#     --cron       also install the daily archive-logs cron on the box
#     --stop       tear the whole thing down instead (box sessions, tunnel, mock, prover channels)
#
# It also patches the fetcher for `newHeads` notifications (and installs websocket-client on the box for
# them), so a block is picked up on arrival rather than on the next poll.
#
# It also CATCHES UP first: the replay has to reach the head before it starts dumping witnesses, and it must
# do that with --zkvm-witness OFF (the flag forces the interpreter and writes ~7 MB per block — replaying a
# backlog with it on costs hours and tens of GB for blocks that have no real-time value). The script starts
# the witness-less replay, polls the gap until it closes, then switches to the tip phase.
#
# Config (env): BOX=<box> (required)  MAC_USER=$USER  TUN_SSH_PORT=2222  MOCK_PORT=8547
#               BOX_FROM_PROVER=<user@host the PROVER can reach the box by>  BOX_PORT_FROM_PROVER=22
#                   Both derived from `ssh -G $BOX` — this Mac's own resolution of the alias, which is the only
#                   place the user, the real hostname AND the sshd port all exist. Everything the prover dials
#                   uses them; everything the Mac dials keeps using $BOX.
#               RPC=<url>  (the chain, for the public-value checks on both sides)
#               MOCK_STORE=/tmp/ethproofs-rtp  MOCK_SECS=2.12  MOCK_PER_MSTEP=0.0364  MOCK_SPEED=2.5  MOCK_JITTER=0.5
#               HEAD_TAG=latest  CONFIRMATIONS=0 (the head — real time)  RUNNER_DIR=$HOME/zisk-mock
#               CATCHUP_TARGET=10 (blocks)  CATCHUP_POLL=30 (s)
#                   Catch-up ends when the gap closes or when the replay stops advancing — never on a clock, so
#                   a multi-hour backlog runs to completion.
#               FETCH_POLL=1  TAP_INTERVAL=1  REPLAY_POLL=0.3  SETTLE_SECS=0.5   (polling latency)
#               TIP_DIRECT=1  BLOCK_DB_TIMEOUT=30   ONE long-lived monad at the tip. TIP_DIRECT=0 reverts to
#                   a fresh monad PER BLOCK, which pays every per-process cost per block — that is what the
#                   pipeline exists to avoid. Needs a binary from al/rtp; step 5b verifies it.
#               PROVE_REAL / PROVE_GPUS=1        --real, and how many GPUs the cluster has (naming + cadence)
#               EP_URL / EP_TOKEN / EP_CLUSTER   where proofs are submitted (default: the local mock)
#               COORDINATOR_URL=http://127.0.0.1:7000  COORDINATOR_HEALTH=http://127.0.0.1:9090/health
#                   the ZisK coordinator as the PROVER sees it — used for the per-ELF setup and the
#                   liveness check only; cluster/start.sh on that box is what configures it.
#               RUNNER_DIR / PROVER_WS           paths ON THE PROVER. With --real they default under the
#                   prover's own $HOME (resolved from the box); unset them unless you mean something else.
#               PROVER_LOG_FILES  logs ON THE PROVER whose tails ride back with the artifacts, space-separated
#                   (e.g. "~/prove.log /tmp/zisk-coordinator.log"). PROVER_LOG_TAIL=200 lines each. They land
#                   in the result tarball as prover.log. Empty = nothing extra crosses.
#               KEPT_MAX_GB     cap on the box's parked-witness collection, in GB (witness-tap's default is
#                   20; 0 = unbounded). The sampled corpus is never evicted, so a cap below its size is
#                   reported rather than enforced.
#               KZG_STRICT=0    make step 5b's lazy-trusted-setup check fatal instead of a warning. Off by
#                   default: an unpatched binary still produces correct witnesses, just ~2 s/block slower.
#               SKIP_AFTER      how far behind the tip an un-proved block is abandoned, in BLOCKS.
#                   Derived as max(10 x PROVE_EVERY, 100) so the window always holds ~10 SAMPLED blocks.
#               PROVE_EVERY=1   prove every Nth BLOCK (not seconds — N counts blocks). 1 = every block.
#                   NEVER derived. With --real the projected service times and a suggested N are printed;
#                   the value stays yours. A cadence faster than the prover's throughput gives a queue that
#                   cannot drain — the script says so rather than deciding for you.
#                   Raise it when the prover cannot hold the 12 s slot. N=2 is the first value that fits;
#                   100 = ethproofs sampling. Selection is `block % N == 0`, so the same blocks are picked
#                   across runs and across zkVMs. Coverage then reports 1/N as its CEILING, not a shortfall.
#               PROVER=<ssh target the BOX can reach>  PROVER_PORT=22
#                   REMOTE / PORT are accepted as aliases — the names core.sh and prove-farm already use.
#                   unset = the mock prover runs on this Mac through the tunnel: 20-34 s per block of pure
#                   transport, the largest term left in the end-to-end. Set it to a datacenter host and the
#                   witness never touches the home link. See the block above PROVER= for the details.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAC_REPO="$(cd "$HERE/../.." && pwd)"

# No default: the box is infrastructure, not part of this repo. Checked below, after --help.
#
# BOX_FROM_PROVER — the same box, under the name the PROVER can reach it by. Two different machines resolve
# names differently and there is no reason they should agree: `BOX=nyc-003` is an alias in THIS Mac's
# ~/.ssh/config (it carries the user, the key, maybe a ProxyJump), and on a rented GPU box it is nothing at
# all — `ssh: Could not resolve hostname nyc-003`. The prover needs a real address AND the right user, e.g.
# aschmitt@nyc-003.devcore4.com. Defaults to $BOX, which is correct whenever the box has a globally
# resolvable name; set it when the Mac uses an alias. Everything the PROVER dials uses this; everything the
# MAC dials keeps using $BOX.
BOX="${BOX:-}"
BOX_FROM_PROVER_SET="${BOX_FROM_PROVER:-}"                 # was it given? the derivation must not override it
BOX_FROM_PROVER="${BOX_FROM_PROVER:-$BOX}"
MAC_USER="${MAC_USER:-$USER}"
TUN_SSH_PORT="${TUN_SSH_PORT:-2222}"
MOCK_PORT="${MOCK_PORT:-8547}"
# The chain, for the PUBLIC-VALUE checks. The guest commits the pre-state root, the post-state root and
# the block hash; the manifest carries the two roots, so this supplies the hash and covers a manifest
# written before the block_hash column existed. It goes to two places on purpose: the submitter refuses
# to send a proof whose committed values are not the block's, and the mock refuses to accept one — the
# server keeps its own opinion rather than trusting the prover's. Headers only, so a non-archive node
# serves it. Same default as witness-tap's.
RPC="${RPC:-http://chi-001.devcore4.com:8545}"
# GUEST_ELF — prove with THIS ELF instead of the one committed at the box's registry path.
# A path ON THIS MAC: generations live here, and their elf/ directories are gitignored, so the binary a
# candidate generation ships cannot reach the box through git at all. Unset = the committed ELF, unchanged
# behaviour. Set = it is copied to the box under its own sha and passed as ELF= in the prove invocation, so
# nothing is committed to try a guest and the two cannot be confused: the filename IS the checksum.
GUEST_ELF="${GUEST_ELF:-}"
MOCK_STORE="${MOCK_STORE:-/tmp/ethproofs-rtp}"
MOCK_SECS="${MOCK_SECS:-2.12}"        # least-squares fit on the 11 measured 16x5090 blocks:
MOCK_PER_MSTEP="${MOCK_PER_MSTEP:-0.0364}"  #   secs = 2.12 + 0.0364 x Msteps  (+-0.2 s)
# Real blocks are 330-600 Msteps = 14-24 s, above the 12 s slot, so the queue could never drain. 2.5 is the
# smallest factor putting even the heaviest observed block under the slot. Recorded in every report.json.
MOCK_SPEED="${MOCK_SPEED:-2.5}"
MOCK_JITTER="${MOCK_JITTER:-0.5}"

# Declared HERE, ahead of PROVE_EVERY, because the right default cadence depends on which prover runs. The
# full rationale for the two modes is at the RUNNER_DIR block below; these two lines only have to exist early.
PROVE_REAL="${PROVE_REAL:-0}"
# Pre-scan for --real. The mode decides RUNNER_DIR, PROVER_WS, PUMP_SOCK, the log name, the ethproofs cluster
# id and the default cadence — all of which are resolved in this config block, well before the real argument
# parser runs. Without this pre-pass the flag would be accepted and silently apply to none of them, which is
# the worst of the three possible behaviours. The parser below still owns validation and every other flag.
for _a in "$@"; do [ "$_a" = "--real" ] && PROVE_REAL=1; done; unset _a
PROVE_GPUS="${PROVE_GPUS:-1}"

# ── the CURRENT guest's step distribution, in Msteps ────────────────────────────────────────────────
# Measured with ziskemu on the generation `guests/monad/current` points at. Source:
# profiling/results/compare-jd.json, axis `jd-vs-r4`, side `a` (monad-jd-zisk), 504 blocks.
# KEEP THESE IN STEP WITH THE GUEST. r4+jd is 0.79x zisk-reth on steps, where the generation before it
# was 1.46x — the guest got ~1.8x cheaper (median 333 -> 186 Msteps). A stale value here does not fail,
# it silently costs coverage: carried at the old max of 896 the derived cadence was 1:44 where 1:26 fits.
GUEST_MS_MEAN="${GUEST_MS_MEAN:-196}"
GUEST_MS_MED="${GUEST_MS_MED:-186}"
GUEST_MS_P90="${GUEST_MS_P90:-303}"
GUEST_MS_MAX="${GUEST_MS_MAX:-527}"
# Margin on the derived cadence. The fit is in STEPS, but ZisK's own work unit is COST, and the two do
# not move together across guests: r4 is 0.795x zisk-reth on steps and 0.861x on COST, i.e. this guest
# carries ~8 % more COST per step than the guest the fit was measured on (attestation added keccak,
# which COST prices heavily). If proving time tracks COST rather than steps, every figure below is ~8 %
# low. 1.15 covers that plus headroom; drop it to 1.0 once real timings exist.
PROVE_MARGIN="${PROVE_MARGIN:-1.15}"
HEAD_TAG="${HEAD_TAG:-latest}"
# 0 = prove the HEAD, the block as it comes out. That is what real-time proving means, and confirmations
# are its direct opposite: each one is 12 s of deliberate waiting on a 12 s slot budget. The cost is reorg
# exposure — a replaced block leaves the replay unable to apply the next one, which stops the producer with
# an ALERT until the triedb is rewound. That is a recovery problem to solve, not a reason to wait.
CONFIRMATIONS="${CONFIRMATIONS:-0}"
# Polling intervals. Both the fetcher and the tap default to 6 s, i.e. up to 12 s of PURE WAITING in the
# end-to-end latency for nothing at all. One RPC call and one directory scan per second cost nothing.
FETCH_POLL="${FETCH_POLL:-1}"
TAP_INTERVAL="${TAP_INTERVAL:-1}"
# run_replay.py's own idle poll. Was 12 s by default — the biggest single polling delay in the pipeline.
# 0.3 rather than 1: avail->witness is fully decomposed and the poll is the ONLY part of it left that a
# setting can touch (with the trusted setup loaded lazily, monad's start is ~0.3 s, the db open 0.36 s, the
# actual work 0.38 s — all of it code, none of it configuration), so the ~0.5 s the poll averages is worth
# taking. Each loop also spawns monad-cli (~0.14 s) and one RPC call, so the real cadence is ~0.5 s and going
# lower would only burn CPU on the producer — RTP-FINDINGS says to time `monad-cli --db` before trying.
REPLAY_POLL="${REPLAY_POLL:-0.3}"
# The tap skips a witness younger than this so it never frames a half-written one. 2 s was cautious and
# showed up whole in wit->queue; monad writes a witness in one pass, so 0.5 s is enough margin.
SETTLE_SECS="${SETTLE_SECS:-0.5}"
# PROVE EVERY N BLOCKS. N counts BLOCKS, not seconds — every other knob up to here is a duration, so the unit
# is worth stating twice. The selection itself lives in witness-tap (`is_cadence = b % PROVE_EVERY == 0`), and
# witness-follow forwards the value to it.
#
# WHY IT IS NOT A RETREAT — measured on 300 consecutive live blocks (25697053..25697390), not estimated:
#   producer  t_block -> t_queued   median  8.34 s   p90 11.55 s    (of which 6.90 s is chain visibility)
#   prover    full service (wall)   median 12.00 s   p90 15.00 s    (mock prove 7.19 s + transport 4.77 s)
#   38% of blocks overrun the 12 s slot, and coverage was ALREADY 88.8% — 38 of those 338 blocks were
#   dropped by --newest-first, silently and unreproducibly.
# So the choice is not between full coverage and sampling; it is between an involuntary 88.8% at random and a
# deliberate 1/N where every sampled block is proved at genuine real-time latency. On the same 300 services,
# N=1 fits the slot 61.7% of the time and N=2 fits it 100% — N=2 is the answer, and N=3+ buys nothing more.
# What you trade is coverage, and coverage is the number this pipeline is honest about: 1/N is the CEILING,
# not a shortfall. Once the transport regression is fixed (4.77 s -> ~2.3 s) N=1 becomes tenable again: this
# is a knob, not a permanent concession.
#
# The modulus is on the BLOCK NUMBER, not on arrival order, so the same blocks are selected across runs and
# across zkVMs — which is what makes a cross-prover comparison possible at all. PROVE_EVERY=100 is the
# ethproofs sampling cadence.
#
# ONE INTERACTION TO KNOW ABOUT. witness-tap abandons a block once it falls outside `b > last - SKIP_AFTER`,
# and SKIP_AFTER counts BLOCKS (100), not sampled blocks. At N=2 or 4 that window still holds 50 or 25 sampled
# blocks, so it never binds. At N >= 100 it holds at most one, and a tap that lags will drop sampled blocks
# outright — so this script now DERIVES it from N instead of leaving it to be remembered.
#
# Until 2026-08-13 neither witness-follow nor rtp-up forwarded SKIP_AFTER at all: it was a witness-tap knob
# (default 100) that nothing upstream could set, so `SKIP_AFTER=… ./rtp-up` was silently a no-op. Both
# forward it now.
# THE CADENCE IS NEVER DERIVED. Default 1, in both modes, and yours to change.
#
# It is tempting to derive it in real mode — the model below yields a number, and a cadence faster than the
# prover's throughput provably cannot drain ('unproved' climbs without bound and witness-tap starts
# abandoning blocks at its SKIP_AFTER window). We do not, on purpose: that model is a fit measured on the
# zisk-reth guest, rescaled by a step ratio, and no real proof of the Monad guest has ever been timed
# (`profiling/FINDINGS.md`: "None of this is GPU proving time, which is still unmeasured"). A derived default
# would read as authoritative and put a guess where a decision belongs — and coverage is the one number this
# pipeline is honest about.
#
# So the arithmetic is PRINTED as advice at start-up, beside the projected service times, and the value stays
# an explicit choice:
#
#   secs_worst  = MOCK_SECS + MOCK_PER_MSTEP x 16/PROVE_GPUS x GUEST_MS_MAX   (the fit is per 16 GPUs)
#   suggested N = ceil(secs_worst x PROVE_MARGIN / 12)          -> 30 on 1 GPU with r4+jd
PROVE_EVERY="${PROVE_EVERY:-1}"

# SKIP_AFTER — how far behind the tip an un-proved block may fall before witness-tap abandons it. It counts
# BLOCKS, so the window holds SKIP_AFTER/PROVE_EVERY SAMPLED blocks, and THAT is the number that matters: it
# is the tap's tolerance to the prover lagging, measured in blocks the prover actually gets. At the default
# 100 with N=30 it is 3.3 — a prover three sampled blocks behind starts losing work it will never get back.
# Derived to keep ~10 sampled blocks in the window, floored at witness-tap's own default so a small N never
# makes the window tighter than it is today.
SKIP_AFTER="${SKIP_AFTER:-$(( PROVE_EVERY * 10 > 100 ? PROVE_EVERY * 10 : 100 ))}"
# Validated here because there is no `set -e`: a non-numeric value would make `[ -gt ]` complain and carry on,
# and 0 would reach witness-tap as `b % 0` — a ZeroDivisionError that kills the tap one block into the run.
# `die` is defined further down, so this reports the failure itself. The numeric test is second on purpose:
# `[ -lt ]` on a non-numeric value is itself an error, and the short-circuit keeps it from ever running.
if ! printf '%s' "$PROVE_EVERY" | grep -Eq '^[0-9]+$' || [ "$PROVE_EVERY" -lt 1 ]; then
  printf '\n\033[1mrtp-up: PROVE_EVERY must be a positive integer (1 = every block), got "%s"\033[0m\n' \
    "$PROVE_EVERY" >&2
  exit 1
fi
# ── REAL vs MOCK prover ─────────────────────────────────────────────────────────────────────────────
# The pipeline's prover has always been a MODEL: zisk-runner's mock branch emulates the block to get its step
# count, applies `secs = MOCK_SECS + MOCK_PER_MSTEP x Msteps` / MOCK_SPEED, and sleeps. Every transfer, every
# submission and every latency number around it is real; only the proving is simulated. That was the right
# trade while no box existed — 1011 of the run records in this repo are `mode=mock backend=mock-cluster`.
#
# `--real` (PROVE_REAL=1) swaps that model for a ZisK cluster. What changes:
#   * prove-farm drops `--mock` and the four `--mock-*` flags, so `prove_remote` drives the coordinator
#   * the per-ELF `cargo-zisk remote setup` gets run — WITHOUT `--hints`, because the Monad guest has none
#     (core.sh already proves hint-less witnesses; it is only the setup call that hardcoded the flag)
#   * the prover's identity, workspace, socket and log all get separate names, so a real deployment and a
#     mock one can sit on the same host without overwriting each other's records
#   * PROVE_EVERY stops defaulting to 1: a real prover has a throughput, and a cadence below it produces a
#     queue that cannot drain (see the default computed below)
#
# It REQUIRES PROVER= — a real prover is a GPU box, never this laptop.
# PROVE_REAL and PROVE_GPUS are set further up, ahead of PROVE_EVERY, which needs them.
# PROVE_GPUS is used only to pick that starting cadence and to name the ethproofs cluster; nothing here
# configures the cluster itself (cluster/start.sh does, on the box).

# The runner must live OUTSIDE ~/Documents: macOS TCC protects it, and a process started by sshd cannot
# execute anything there ("Operation not permitted"). This is why the script copies it at all.
# Separate defaults per mode: the two deployments share a host in practice, and a shared workspace would mean
# a real proof landing in the same reports/ a mock run then overwrites.
# ⚠️ These are paths ON THE PROVER, but `$HOME` here expands on the MAC. That is correct only when the prover
# IS the Mac (PROVER unset). With a remote prover the two homes differ — on a vast.ai GPU box it is /root —
# and today's mock path papers over it by using the Mac's absolute path on the remote host: it "works" because
# mkdir creates it, but the runner then lives at /Users/<you>/zisk-mock on a Linux box, and every `~/...`
# instruction printed about that host is wrong. Real mode resolves the prover's own $HOME instead (6d).
# RESOLVED BEFORE THE MODE BLOCK, because the mode block reads it: RUNNER_DIR must not default to this Mac's
# $HOME when the prover is elsewhere, and EP_CLUSTER must name that prover. Resolved after them, the alias
# worked for the ssh calls and silently did nothing for either — a remote prover staging into /Users/<me>.
# SAY when the alias is what supplied it. A REMOTE left exported from an unrelated zisk-infra session would
# otherwise move the prover off this Mac without the operator having asked for it in this command. Decided
# BEFORE the assignment, which is the only moment the two are still distinguishable.
PROVER_FROM_ALIAS=0
[ -z "${PROVER:-}" ] && [ -n "${REMOTE:-}" ] && PROVER_FROM_ALIAS=1
PROVER="${PROVER:-${REMOTE:-}}"

# The mock path is deliberately LEFT AS IS: it is a working deployment, and changing where it stages files is
# not part of making real proving work. The same fix applies there whenever someone wants it.
if [ "$PROVE_REAL" = 1 ]; then
  # Empty = "resolve against the prover's $HOME in 6d". A value passed in by the user is used verbatim.
  RUNNER_DIR="${RUNNER_DIR:-}"
  PROVER_WS="${PROVER_WS:-}"
  PUMP_SOCK="${PUMP_SOCK:-/tmp/zisk-pump-real.sock}"
  PROVE_LOG="${PROVE_LOG:-~/prove-real.log}"
  EP_CLUSTER="${EP_CLUSTER:-${PROVE_GPUS}gpu-ZisK-monad}"
  # THE PHASE SPLIT, which exists only on the prover. The coordinator logs, per job:
  #   Finished JobId(…) ✔ Duration: 23.062s (5.475s+17.537s+0.050s) Steps: 113.914.853 Instances: 78
  # — the three phase durations the runbook names (EXECUTE · CALCULATING_CONTRIBUTIONS ·
  # GENERATING_INNER_PROOFS), plus the coordinator's own step count. Nothing in the run record has it: the
  # runner sees only its own wall clock, and `cargo-zisk remote prove` reports no phases. So its tail rides
  # back inside the artifact tarball that already crosses, as prover.log — no extra round trip, a few KB.
  # Wrong path (a cluster started elsewhere) is not an error: core.sh skips a file it cannot read.
  PROVER_LOG_FILES="${PROVER_LOG_FILES-\$HOME/zkvm-bench/infra/zisk-infra/cluster/logs/coordinator.log}"
else
  # THE MOCK PROVER CAN ALSO BE REMOTE — a cheap box, precisely so the paying one is not the thing being
  # rehearsed on. Then these must NOT default to this Mac's $HOME: `mkdir -p /Users/<me>/zisk-mock` on a Linux
  # prover fails outright, and 6c only resolves the prover's own $HOME when they are empty. So: empty when the
  # prover is elsewhere, this Mac's paths when the prover IS this Mac.
  if [ -n "${PROVER:-}" ]; then
    RUNNER_DIR="${RUNNER_DIR:-}"
    PROVER_WS="${PROVER_WS:-}"
  else
    RUNNER_DIR="${RUNNER_DIR:-$HOME/zisk-mock}"
    PROVER_WS="${PROVER_WS:-$HOME/zisk-mock-ws}"
  fi
  # witness-pump's unix socket, on the PROVER. Deliberately in /tmp and deliberately short: ~104 bytes is the
  # hard cap for a unix socket path on macOS, and $HOME can already be half of it.
  PUMP_SOCK="${PUMP_SOCK:-/tmp/zisk-pump.sock}"
  PROVE_LOG="${PROVE_LOG:-~/prove-mock.log}"
  # NAME THE PROVER, when it is not this Mac. Every mock run would otherwise land on the leaderboard under
  # `local-ZisK-monad`, so a rehearsal on a remote box and one on this Mac become one indistinguishable row —
  # and the whole point of rehearsing elsewhere is that the transport is different.
  if [ -n "${PROVER:-}" ]; then
    ep_who="${PROVER##*@}"                                  # user@host -> host
    # An IP keeps all four octets — `${host%%.*}` would label a box at 10.0.0.7 as `mock-10`, which is not a
    # name, it is a collision waiting for the next box on the same /8.
    case "$ep_who" in
      *[!0-9.]*) ep_who="${ep_who%%.*}" ;;                  # a hostname: the first label is enough
      *)         ep_who="${ep_who//./-}" ;;                 # an IPv4: keep it whole
    esac
    EP_CLUSTER="${EP_CLUSTER:-mock-$ep_who-ZisK-monad}"
  else
    EP_CLUSTER="${EP_CLUSTER:-local-ZisK-monad}"
  fi
fi
# Where the proofs get submitted. Defaults to the local ethproofs-mock through the tunnel, which is what every
# run so far has used; point it at ethproofs.org (with a real token and the cluster id they assign) when the
# prover is meant to appear on the leaderboard.
EP_URL="${EP_URL:-http://localhost:$MOCK_PORT}"
EP_TOKEN="${EP_TOKEN:-}"
# ZisK coordinator on the prover, as the PROVER itself sees it. Only used for the per-ELF setup and the
# liveness check — prove_remote reads its own default from the runner's env.
COORDINATOR_URL="${COORDINATOR_URL:-http://127.0.0.1:7000}"
# Metrics/health port of that coordinator, for the liveness check (`/health` returns 200 with an empty body).
COORDINATOR_HEALTH="${COORDINATOR_HEALTH:-http://127.0.0.1:9090/health}"

# WHERE THE PROVER RUNS — the single largest remaining term in the end-to-end latency.
#
# Every block sends a 7-15 MB framed witness from the box to the prover. Default (PROVER unset) that prover
# is this Mac, reached through the reverse tunnel: measured at 20-34 s per block, ~2 Mbit/s effective, and
# multiplexing every ssh call onto one connection already took what there was to take. It is not the link,
# it is the topology — a home uplink with TCP inside TCP. No interval, buffer or compression flag fixes it.
#
# Set PROVER to an ssh target the BOX can reach on a datacenter link (chi-001, or the GPU box where real
# proving would happen) and that term collapses to a fraction of a second. Only the 381 KB proof and its
# report then cross the home link, to the ethproofs mock — 20-40x less data on the slow hop.
#
#   PROVER=chi-001 ./rtp-up
#
# The runner is staged there FROM THE BOX, not from here: the box is what has to reach it, so staging over
# the same path proves the path. ziskemu must exist on it, or the mock loses the step measurement and falls
# back to its fixed term — which would quietly turn every simulated duration into the same number.
# REMOTE/PORT are accepted as the same thing, because that is what the rest of the repo calls them:
# core.sh's prove_remote requires `REMOTE=user@host` and reads `PORT`, prove-farm takes --remote/--port. A
# session that already has them exported should not have to restate them under a second pair of names.
# PROVER/PROVER_PORT still win when both are set.
if [ -n "$PROVER" ]; then
  PROVER_TARGET="$PROVER";               PROVER_PORT="${PROVER_PORT:-${PORT:-22}}"; PROVER_WHERE="$PROVER"
else
  PROVER_TARGET="$MAC_USER@localhost";   PROVER_PORT="$TUN_SSH_PORT";           PROVER_WHERE="this Mac"
fi

# PULL_VIA — the witness travels on a connection the PROVER opens, not through the tunnel.
#
# Measured: pushing 10 MB box->Mac through the reverse tunnel ran at 3.8 Mbit/s; the same 10 MB over a direct
# connection between the same two machines ran at 25 Mbit/s (and that was the Mac's slower direction). The
# link was never the limit, TCP-in-TCP was. The tunnel exists only because a laptop behind NAT cannot be
# reached — but the laptop can always reach the box, so the payload should go that way round.
#
# The value is the box as the PROVER sees it, which for a Mac prover is exactly $BOX: the alias this script
# already uses for every `ssh "$BOX"` call, so it is working by construction. Meaningless for a datacenter
# prover (it would not resolve there, and it has no tunnel to avoid), hence only when the prover is the Mac.
if [ -z "$PROVER" ]; then PULL_VIA="${PULL_VIA:-$BOX}"; else PULL_VIA="${PULL_VIA:-}"; fi

# TIP_DIRECT — at the tip, ONE long-lived monad that waits for blocks (--block-db-timeout) instead of
# run_replay.py starting a fresh process per batch. With MIN_FOLLOW_BATCH=1, that per-batch startup is paid for
# every single block: a full db open on a 440 GB triedb before any work happens. It is the last floor under
# chain->witness, and no polling interval reaches it.
# TIP_DIRECT=0 restores the run_replay.py path so the two can be measured rather than argued about.
#
# ON BY DEFAULT, and it is the whole point: real-time proving does not restart a process per block for work
# that is deterministic. ONE monad waits on --block-db-timeout and executes every block as it lands.
#
# TIP_DIRECT=0 starts a fresh monad PER BLOCK (--min-follow-batch 1 forces that), and every per-process cost
# is then paid per block. Measured on this box, 2026-08-14, 100 blocks at the tip with a lazy trusted setup:
# 84 % of blocks execute in 0.24 s, and 16 % in 2.28 s — a flat 2.04 s gap, uncorrelated with gas
# (corr = -0.10) because it is not work. One long-lived process pays that class of cost ONCE, at the first
# block; per-block processes pay it again on every block that touches it. `0.19 s` for
# `t_avail -> t_witness` is what this leg reads when the process is already up.
#
# It needs a binary from al/rtp, whose ethereum runloop WAITS for a block instead of asserting. Step 5b
# verifies that fatally, so this default cannot silently land on a binary that would exit 107.
#
# It needs a monad whose ETHEREUM runloop takes the flag. `cmd/monad/main.cpp:204` drops the
# `->needs(as_eth_blocks_flag)` constraint, and `case CHAIN_CONFIG_ETHEREUM_MAINNET:` passes both the witness
# dump (473) and block_db_timeout (478) to runloop_ethereum — the call site `--chain ethereum_mainnet` selects.
# Without that, `--block-db-timeout` requires `--as-eth-blocks`, which is the Monad-chain ingestion path and not
# the Ethereum-mainnet block_db an RPC feeds; on such a binary the flag is accepted and silently does nothing.
#
# Two figures describe this leg and they measure different things: 0.19 s is a per-block LATENCY at the tip,
# where blocks arrive every 12 s and the replay is never saturated, while "~3 s per block, almost entirely db
# open" is a THROUGHPUT while draining a backlog. Neither substitutes for the other. `TIP_DIRECT=1` against `0`
# on one run is what settles which path the tip should use, and that is why both paths exist.
TIP_DIRECT="${TIP_DIRECT:-1}"
# Seconds, as a bare integer — the parser rejects "30s" ("Could not convert"), despite --help printing its
# default as "0s". Only meaningful once the box runs a monad with the runloop_ethereum retry patch; on an
# unpatched binary the flag is accepted and silently does nothing on this chain.
BLOCK_DB_TIMEOUT="${BLOCK_DB_TIMEOUT:-30}"
BOX_REPO="${BOX_REPO:-\$HOME/zkvm-bench}"

DRY=0 PURGE=0 KEEP_MOCK=0 CRON=0 STOP=0
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)   DRY=1; shift ;;
    --purge)     PURGE=1; shift ;;
    --keep-mock) KEEP_MOCK=1; shift ;;
    --real)      PROVE_REAL=1; shift ;;
    --cron)      CRON=1; shift ;;
    --stop)      STOP=1; shift ;;
    -h|--help)   sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; /^set -uo/d'; exit 0 ;;
    *)           echo "rtp-up: unknown argument '$1' (see --help)" >&2; exit 2 ;;
  esac
done

step(){ printf '\n\033[1m== %s\033[0m\n' "$*"; }
say(){  printf '   %s\n' "$*"; }
die(){  printf '\n\033[1mrtp-up: %s\033[0m\n' "$*" >&2; exit 1; }
# run — every mutating action goes through here, so --dry-run is honest by construction.
run(){ if [ "$DRY" = 1 ]; then printf '   $ %s\n' "$*"; else eval "$@"; fi; }
onbox(){ if [ "$DRY" = 1 ]; then printf '   [%s] $ %s\n' "$BOX" "$*"; else ssh "$BOX" "$*"; fi; }
# onbox_q — read-only query, always executed even in dry-run (it changes nothing and the checks are the
# point of a dry run).
onbox_q(){ ssh -o BatchMode=yes "$BOX" "$*" 2>/dev/null; }

# sweep_leftovers <start|stop> — kill what a previous run left behind that no tmux session owns any more.
#
# `tmux kill-session` does NOT kill a process that has already been reparented. When a session dies while its
# command runs, init (or launchd) adopts the child and it keeps going — invisible to every `tmux ls` and to every
# check in this script. Restarting then does not replace it, it ADDS a second one.
#
# Two prove-farms on one prover workspace is the case that matters. Both pick the same head of the same queue,
# both stage the input into the same $PROVER_WS/inputs/, and whichever finishes first deletes that input as part
# of its retention. The other one's emulation then opens a file that is gone: no crash, just "Could not read
# inputs file", a fall back to the fixed term of the cost model, and from then on every block carries a
# fabricated duration and NO public values. One farm orphaned on 2026-08-17 ran 36 h beside the real one and
# made 32 consecutive proofs measure nothing, while every session, log and heartbeat read healthy.
#
# THE BRACKET TRICK IS NOT COSMETIC. `ssh box "pkill -f cli/prove-farm"` puts that pattern on the box's own
# command line, so pkill matches the shell running it and kills its own parent: the ssh returns 255 and the
# sweep reads as a connection failure. `[c]li/prove-farm` matches the process but never the literal pattern.
#
# On the PROVER the patterns stay narrow on purpose. A bare `pkill -f ziskemu` would also kill unrelated
# emulations — profiling/series runs six at a time on this Mac — so everything except the pump is matched only
# inside the prover's own workspace, and skipped entirely when that path is not resolved yet.
sweep_leftovers() {
  local mode="$1" pat n killed=0 boxpats
  # ONE list, for the kill AND for the survivor check below. Two hand-maintained copies drift, and the copy
  # that loses an entry is the CHECK: a pattern it does not name reads as dead whether it is or not.
  boxpats="$(printf '%s\n' '[c]li/prove-farm' '[w]itness-tap' '[w]itness-follow supervise' \
                           '[r]un_replay.py' 'build/cmd/[m]onad --chain')"
  # KILLED, BUT NEVER BLOCKING. The box-side pump processes are `exec-agent` and `send`, and neither is ours to
  # own: both are spawned BY THE PROVER's persistent channels, and exec-host redials every 5 s. So killing the
  # agent here and then demanding it stay dead is a race this sweep cannot win — measured: it reported
  # `STILL RUNNING 5s after the kill: [w]itness-pump(1)` on a box where the kill worked every time and the
  # prover simply reconnected. They also cannot cause the harm this check exists to prevent: a relay is not a
  # second writer on a triedb, a block_db or a workspace. Clearing a stale one still matters (it holds the
  # socket the new agent needs), so they are killed — and the channel step later restarts BOTH ends properly,
  # which is the only thing that actually settles them.
  local boxsoft="[w]itness-pump"
  # The fetcher, on start only: witness-follow restarts it a few steps later, so an orphan of it would become a
  # second writer on one block_db. --stop leaves the fetcher alone by design (the block_db is cheap and reusable).
  [ "$mode" = start ] && boxpats="$boxpats
[f]etch_blocks.py"
  while IFS= read -r pat; do
    [ -n "$pat" ] || continue
    # </dev/null on every ssh in this loop: ssh reads stdin, and stdin here IS the pattern list. Without it
    # the first iteration swallows the rest of the list and the sweep silently checks one pattern out of seven.
    n="$(onbox_q "pgrep -cf \"$pat\"" </dev/null | tr -d ' \n')"
    case "$n" in ''|*[!0-9]*) n=0 ;; esac
    [ "$n" = 0 ] && continue
    say "box: $n process(es) matching $pat — killing"
    onbox "pkill -f \"$pat\" || true" </dev/null
    killed=$((killed + n))
  done <<<"$boxpats
$boxsoft"

  # The prover: the pump and its channels are ours by name, so they are safe to match anywhere.
  # NO `exec ` PREFIX. The channels are `ssh -C -o BatchMode=yes <box> $HOME/.../witness-pump exec-agent`
  # with no literal `exec ` in them, so the prefixed patterns matched nothing and every run added four more:
  # 11 on this Mac and 19 on the box, and a stale pair kept the box-side socket while the new host could not
  # serve it. `witness-pump run` then answered success with no output, the workspace probe came back empty,
  # and every single block failed with "cannot prepare remote workspace".
  while IFS= read -r pat; do
    [ -n "$pat" ] || continue
    run "pkill -f \"$pat\" 2>/dev/null || true" </dev/null
  done <<PROVPATS
[w]itness-pump serve
[w]itness-pump send
[w]itness-pump exec-host
[w]itness-pump exec-agent
PROVPATS
  if [ -n "${RUNNER_DIR:-}" ] && [ -n "${PROVER_WS:-}" ]; then
    run "pkill -f '$RUNNER_DIR/[z]isk-runner' 2>/dev/null || true"
    run "pkill -f '[z]iskemu .*$PROVER_WS' 2>/dev/null || true"
  else
    say "prover: workspace not resolved here — leaving zisk-runner/ziskemu alone rather than matching them broadly"
  fi
  # NOT "orphans killed": this matches by pattern, so it also takes the session-owned processes — which is
  # correct on both paths (start restarts them below, stop is stopping them anyway). Claiming orphanhood in the
  # output would misreport the ordinary case as an incident every single run.
  [ "$killed" = 0 ] && say "nothing left running on the box" || say "$killed process(es) killed on the box"
  [ "$killed" = 0 ] && return 0

  # AND CHECK THEY ACTUALLY DIED. `pkill` reports that it delivered a signal, not that anything exited, and this
  # whole sweep exists because a process nobody could see kept running. A survivor is not cosmetic, and not only
  # for prove-farm: a second run_replay.py is a second writer on one triedb, a second fetcher a second writer on
  # one block_db, and a surviving witness-pump keeps the socket the new host cannot then serve. Every pattern the
  # kill used is re-checked, so on `start` any of them is fatal — continuing would rebuild the situation we just
  # came to clear. On `stop` there is nothing left to protect, so it warns.
  [ "$DRY" = 1 ] && return 0
  # pkill is ASYNCHRONOUS: it delivers a signal and returns. A `witness-pump send` with an open ssh channel and
  # a 7 MB transfer in flight, or a python process unwinding one, routinely needs more than a second. Every
  # pattern is now fatal on `start`, so a single check would turn a slow exit into a refused run — which is a
  # new way to not start, not a guard. So POLL, and re-check only what is still there: a pattern that clears on
  # try 3 was never a survivor. Nothing here waits on the ordinary case, which clears on the first try.
  local pending="$boxpats" still="" survivors="" try
  for try in 1 2 3 4 5; do
    sleep 1
    still=""; survivors=""
    while IFS= read -r pat; do
      [ -n "$pat" ] || continue
      n="$(onbox_q "pgrep -cf \"$pat\"" </dev/null | tr -d ' \n')"
      case "$n" in ''|*[!0-9]*) n=0 ;; esac
      [ "$n" = 0 ] && continue
      still="$still$pat
"
      survivors="$survivors $pat($n)"
    done <<<"$pending"
    [ -z "$still" ] && break
    [ "$try" = 5 ] || say "still exiting after ${try}s:$survivors — waiting"
    pending="$still"
  done
  if [ -n "$survivors" ]; then
    say "STILL RUNNING ${try}s after the kill:$survivors"
    # What SURVIVED, as one ERE, so the line that says which processes they are can name any of them. A fixed
    # two-pattern probe printed nothing for the other five, which reads as "reported, but not there".
    onbox_q "pgrep -af '$(printf '%s' "$pending" | tr '\n' '|' | sed 's/|$//')' | head -5" </dev/null \
      | sed 's/^/     /'
    if [ "$mode" = start ]; then
      die "the box still has processes this run would duplicate — kill them by hand (ssh $BOX 'pgrep -af \
\"prove-farm|witness-tap|run_replay|fetch_blocks|cmd/monad\"; kill <pid>') and re-run. Starting now would
   put two of them on one workspace, one triedb or one block_db.
   The pump's box-side relays are NOT in this list: the prover redials them, so they are killed and not
   waited for — the channel step restarts both ends."
    fi
    say "left over after --stop; kill them by hand if they matter"
  fi
}

# alert_error — the line that says WHY, pulled out of logs/ALERT.
# The ALERT is a 3-line header plus `tail -40` of the run's log, so the failure is at its END, not its
# start. Showing `head -3` gives "monad exited 1 / log: … / last lines:" and nothing else — which is how a
# 1.77 MB log with `block N failed with: invalid excess blob gas` as its final line came to read as empty.
alert_error(){ onbox_q "grep -oE 'block [0-9]+ failed with: .*' ~/monad/logs/ALERT | tail -1"; }

# recover_reorg — ONE implementation, called from both places an ALERT can appear: at startup (a reorg that
# landed while we were stopped) and mid-run (one that lands during the catch-up this script is supervising).
# They used to differ: startup repaired it, the catch-up path printed head -3 and died, pointing at a message
# the run had never printed. A 13k-block catch-up crosses days of chain and WILL meet a reorg, so the path
# that matters most was the one without the repair. Two copies of a decision is how they drift — the same
# lesson as the reorg-signature list, which rtp-up now reads out of reorg-recover instead of restating.
# Returns 0 if repaired (or nothing to repair), non-zero if it must not be touched. Never clears the ALERT
# itself: reorg-recover owns that, and a hand-cleared ALERT just fails on the same block.
recover_reorg(){
  local where="$1" err sigs
  err="$(alert_error)"
  [ -n "$err" ] || { say "an ALERT is present but names no 'block N failed with: …' line — read it by hand:"
                     onbox_q "tail -20 ~/monad/logs/ALERT" | sed 's/^/   | /'; return 1; }
  say "ALERT ($where): $err"
  sigs="$(sed -n 's/^  \*"\(.*\)"\*)$/\1/p' "$HERE/reorg-recover" | head -1 | sed 's/"\*|\*"/|/g')"
  [ -n "$sigs" ] || { say "cannot read the reorg signatures out of $HERE/reorg-recover"; return 1; }
  if ! printf '%s' "$err" | grep -qE "$sigs"; then
    say "not one of the signatures reorg-recover handles ($sigs) — a rewind would discard good state."
    return 1
  fi
  say "reorg-shaped — running reorg-recover on $BOX"
  onbox "cd $BOX_REPO/infra/monad-witness && ./reorg-recover 2>&1 | sed 's/^/   | /'"
}

# Checked here rather than at assignment: --help must answer without a box.
[ -n "$BOX" ] || die "BOX is required — the devcore box the producer runs on. There is no default: it \
is infrastructure, not part of this repo.  e.g.  BOX=<box> $0"

# A real prover is a GPU box the producer can reach. It cannot be this laptop: PROVER unset means the witness
# crosses the reverse tunnel to the Mac, and there is no ZisK cluster here to receive it. Refuse rather than
# let the run reach the first block and fail there, which is the same error 40 minutes later.
if [ "$PROVE_REAL" = 1 ] && [ -z "$PROVER" ]; then
  die "--real needs PROVER=<ssh target the box can reach>, the GPU box running the ZisK cluster.
   Without it the prover is this Mac through the tunnel, which has no cluster.
   e.g.  BOX=<box> PROVER=<gpu-box> PROVE_GPUS=1 $0 --real"
fi

# ── teardown ────────────────────────────────────────────────────────────────────────────────────────
if [ "$STOP" = 1 ]; then
  step "Stopping the box's sessions"
  onbox "cd $BOX_REPO/infra/monad-witness && ./witness-follow stop; tmux kill-session -t prove 2>/dev/null; tmux ls 2>&1 | sed 's/^/   /'"
  if [ -n "$PROVER" ]; then
    # The prover's own channels. Left up, they hold ssh connections to the box AND the code they started with,
    # so the next run's exec check would answer from the OLD witness-pump and look perfectly healthy.
    # Best-effort on purpose: this hop needs the box's key, which the hourly cron may already have deleted —
    # in that case the next start's pkill clears them anyway.
    step "Stopping the channels on $PROVER_TARGET"
    onbox "ssh -o BatchMode=yes -o ConnectTimeout=8 -p $PROVER_PORT $PROVER_TARGET \
'pkill -f \"[w]itness-pump serve\" 2>/dev/null; pkill -f \"[w]itness-pump exec-host\" 2>/dev/null; \
pkill -f \"ssh -N .*[-]L [0-9]*:127.0.0.1:\" 2>/dev/null; true' \
2>/dev/null || echo '   · could not reach the prover (its channels will be cleared at the next start)'"
  fi
  step "Stopping the tunnel and the mock on this Mac"
  # The supervisor FIRST, or it would immediately redial the ssh we are about to kill. And match the actual
  # command line: the forward spec, not "ssh -N -R" — the -o options sit between those tokens.
  run "pkill -f 'rtp-up-tunnel' || true"
  run "pkill -f 'R $TUN_SSH_PORT:127.0.0.1:22' || true"
  run "pkill -f ethproofs-mock || true"
  step "Killing anything left running"
  sweep_leftovers stop
  say "the fetcher on the box is left running (the block_db is cheap and reusable)"
  exit 0
fi

# ── 0. this Mac's repo must be pushed, or the box cannot have the code ──────────────────────────────
# Warnings, not gates. What actually has to be true is that the BOX has the code it needs, and that is
# verified for real at step 6 by grepping its clone — not inferrable from this repo's git state. Blocking on
# an uncommitted notes file was pure friction.
# The one asymmetry worth naming: the box runs the PUSHED version, while the runner staged on this Mac at
# step 1 is copied from the WORKING TREE. So uncommitted changes can make the two ends disagree.
# BEFORE ANYTHING IS STARTED, and that is the whole point. Placed later — even one step later — it kills the
# services this same run just launched: the data pump, the exec host and their channels all match its patterns,
# and nothing restarts them. That is exactly what happened on 2026-08-19: every launch left a dead pump behind
# a stale socket, the workspace probe failed on it, and 26 consecutive blocks died in one second each while the
# transport that did work fell back to scp at a fifth of the link's speed.
step "Leftovers from a previous run"
sweep_leftovers start

step "This repo's state"
cd "$MAC_REPO" || die "cannot cd to $MAC_REPO"
say "$(git log --oneline -1)"
dirty="$(git status --porcelain 2>/dev/null)"
if [ -n "$dirty" ]; then
  say "uncommitted (fine — but the box pulls the pushed version, this Mac stages from the working tree):"
  printf '%s\n' "$dirty" | head -8 | sed 's/^/     /'
fi
ahead="$(git rev-list '@{u}..HEAD' --count 2>/dev/null || echo '?')"
case "$ahead" in
  0) ;;
  '?') say "no upstream configured — cannot tell whether the box can pull this" ;;
  *) say "NOTE: $ahead commit(s) not pushed. The box will pull what IS on the remote; step 6 checks it has \
what the run needs." ;;
esac

# ── 1. the mock prover's runner, outside the TCC-protected tree ─────────────────────────────────────
# Only when the prover IS this Mac. For a remote prover the staging needs the box's clone, which is not
# updated until step 7 — so it happens there instead (7c), over the same box->prover path the run will use.
if [ -z "$PROVER" ]; then
  step "Staging the mock prover's runner in $RUNNER_DIR"
  run "mkdir -p '$RUNNER_DIR'"
  run "cp '$MAC_REPO/infra/zisk-infra/zisk-runner' '$RUNNER_DIR/'"
  run "chmod +x '$RUNNER_DIR/zisk-runner'"
  if [ "$DRY" != 1 ]; then
    grep -q 'MOCK PROVER] emulating' "$RUNNER_DIR/zisk-runner" \
      || die "the staged runner has no emulating mock branch — is $MAC_REPO up to date?"
    say "staged, and it carries the emulating mock branch"
  fi
  # witness-pump — the persistent transfer channel. It lives on the PROVER because only the prover can open a
  # connection (the box is reachable, a laptop behind NAT is not), and it saves the ~2 s of ssh setup that every
  # per-block scp repays: measured 4.05 -> 2.66 s per witness, +34 %, byte-verified over 10 interleaved rounds.
  run "cp '$MAC_REPO/infra/zisk-infra/witness-pump' '$RUNNER_DIR/'"
  # ethproofs-submit too, so the POST can happen HERE, where the proof already is. Posting it from the box means
  # sending a 508 KB base64 body back through the tunnel at 3.8 Mbit/s — ~1.10 s per block for bytes that never
  # left this machine. The box still decides: it invokes, reads the status, logs the verdict, writes the CSV.
  run "cp '$MAC_REPO/cli/ethproofs-submit' '$RUNNER_DIR/'"
  # check-pv WITH it, and beside it: ethproofs-submit loads it from its OWN directory, so staging one without
  # the other leaves the gate loaded-but-absent — it fails open with a NOT VERIFIED note and every proof goes
  # out unchecked on the path that posts almost all of them. Verified below rather than assumed.
  run "cp '$MAC_REPO/cli/check-pv' '$RUNNER_DIR/'"
  run "chmod +x '$RUNNER_DIR/ethproofs-submit' '$RUNNER_DIR/check-pv'"
  run "chmod +x '$RUNNER_DIR/witness-pump'"
  # The staged submitter must actually be able to load it. Same reasoning as the runner's mock-branch check
  # a few steps down: a copy that did not land is indistinguishable from one that did, until a proof about
  # nothing has already been delivered.
  if [ "$DRY" != 1 ]; then
    if "$RUNNER_DIR/ethproofs-submit" --help >/dev/null 2>&1 && [ -x "$RUNNER_DIR/check-pv" ] \
       && "$RUNNER_DIR/check-pv" --help >/dev/null 2>&1; then
      say "staged, and the public-value gate loads (check-pv beside ethproofs-submit)"
    else
      die "the public-value gate did not stage on the prover — without it every proof is submitted unchecked"
    fi
  fi
  # Restart it, never reuse: like the prover session, a live pump holds the code and env it started with.
  # PUMP_SOCK stays SHORT — a unix socket path is capped at ~104 bytes on macOS, the same limit that bit the
  # ssh ControlPath, and the pump refuses to start rather than emit a bare "AF_UNIX path too long".
  # KILL THE CHANNELS TOO, not just the server. The children are `ssh -C … exec …/witness-pump send`, which
  # the pattern 'witness-pump serve' does not match: killing only the server reparents its N channels to
  # launchd, where they sit holding an ssh connection to the box for as long as the machine is up. Observed:
  # one 31-minute-old orphan from a previous serve, ppid=1. Harmless in bandwidth (0.45 s of CPU in 35 min,
  # sleeping — an idle TCP connection costs nothing) but it is an unbounded leak of one connection per
  # channel per restart, and it makes `ps` unreadable when diagnosing the pump.
  # exec-host too, and its channel: same reasoning as the data channels, plus this one holds the connection
  # that lets the box drive at all. An orphan from a previous run would keep answering commands from a stale
  # copy of the code — the "deployed but not running" trap, inverted.
  run "pkill -f 'witness-pump serve' 2>/dev/null; pkill -f 'exec .*witness-pump send' 2>/dev/null; \
pkill -f 'witness-pump exec-host' 2>/dev/null; pkill -f 'exec .*witness-pump exec-agent' 2>/dev/null; \
rm -f '$PUMP_SOCK'; true"

  # PROFILE THE LINK, now that nothing is transferring on it. This slot is the only valid one: the old pump is
  # dead and the new one is not up, so the probe measures the network instead of measuring itself — the mistake
  # that produced two contradictory throughput curves in one afternoon.
  #
  # Its first job is not tuning, it is measurement hygiene. Moving this prover between two Wi-Fi networks in one
  # session silently reused the first link's figures as the second's reference: the "25-29 Mbit/s"
  # recorded then was 802.11n on a congested 2.4 GHz channel, while the WAN behind it does 47-62. Half a day of
  # arithmetic was off by ~2x for want of a line saying "this is not the link those numbers came from".
  #
  # rc=2 means new-or-changed. It is deliberately NOT fatal — a link change is information, not an error.
  PUMP_CHANNELS="${PUMP_CHANNELS:-}"
  if [ "$DRY" != 1 ] && [ -x "$HERE/netprofile" ]; then
    step "Link profile"
    PUMP_SOCK="$PUMP_SOCK" "$HERE/netprofile" probe "$BOX" 2>&1 | sed 's/^/   /' || true
    # And APPLY it. netprofile measures how many parallel channels this network rewards and remembers it per
    # network; the pump splits one witness across that many. Measured on this link, real 13.24 MB witness,
    # order alternated, sha-verified, n=8: 1.40 s -> 1.00 s, paired +0.37 s, favourable 8/8 — the first
    # unanimous result in this whole investigation, and it is unanimous because the new link's RTT jitter is
    # sigma 11 ms instead of 68, so a 0.37 s effect is finally above the noise.
    # An explicit PUMP_CHANNELS in the environment always wins, for pinning a measurement.
    if [ -z "$PUMP_CHANNELS" ]; then
      eval "$("$HERE/netprofile" params "$BOX" 2>/dev/null || true)"
      PUMP_CHANNELS="${NETPROFILE_CHANNELS:-1}"
      say "channels: $PUMP_CHANNELS (from the link profile — PUMP_CHANNELS=N to pin it)"
    else
      say "channels: $PUMP_CHANNELS (pinned)"
    fi
  fi
  PUMP_CHANNELS="${PUMP_CHANNELS:-1}"
  run "( trap '' INT; PUMP_SOCK='$PUMP_SOCK' PUMP_BOX='$BOX' PUMP_CHANNELS='$PUMP_CHANNELS' nohup '$RUNNER_DIR/witness-pump' serve >> ~/witness-pump.log 2>&1 & )"
  if [ "$DRY" != 1 ]; then
    # Give it a moment to bind and open the channel, then check BOTH: a socket with no channel behind it
    # would fail every block silently into the scp fallback, which is exactly the "deployed but not working"
    # trap this script exists to catch.
    sleep 3
    if [ -S "$PUMP_SOCK" ] && grep -q 'channels open' ~/witness-pump.log 2>/dev/null; then
      say "witness-pump serving on $PUMP_SOCK, $PUMP_CHANNELS channel(s) to $BOX"
    else
      say "WARNING: witness-pump did not come up — every block will fall back to scp (~1.4 s slower each)"
      say "  check: tail ~/witness-pump.log"
    fi
  fi

  # THE EXEC CHANNEL, which is what takes the box-side key out of the proving path. prove_remote uses it in
  # place of `ssh <prover> CMD` whenever its socket exists on the box, and falls back to that ssh otherwise.
  # Started here rather than by hand so it survives a restart like everything else this script owns.
  #
  # The PROVER dials it, which is the whole point: the hourly `find ~/.ssh -type f -name 'id_*' -delete` on the
  # box then has nothing left to take away. Without it, proving keeps going on the multiplexed master already
  # authenticated and stops for good when that expires — measured at six hours of silence with the producer
  # perfectly healthy and every session still up.
  run "( trap '' INT; PUMP_BOX='$BOX' PUMP_REMOTE_CMD='$BOX_REPO/infra/zisk-infra/witness-pump' \
nohup '$RUNNER_DIR/witness-pump' exec-host >> ~/witness-exec.log 2>&1 & )"
  # STARTED IS NOT SERVING. The box picks the exec channel on a `-S` test, which a socket file left by a dead
  # agent passes — so an unverified channel does not degrade, it fails every block. Prove it answers here.
  if [ "$DRY" != 1 ]; then
    exec_ok=0
    for _try in 1 2 3 4 5 6; do
      if onbox_q "cd $BOX_REPO && PUMP_EXEC_SOCK=\$HOME/.zisk-exec.sock infra/zisk-infra/witness-pump run 'echo up'" | grep -q up; then
        exec_ok=1; break
      fi
      sleep 2
    done
    [ "$exec_ok" = 1 ] \
      && say "exec channel answers from $BOX" \
      || die "the exec channel does not answer from $BOX after 12 s. Nothing else was started.
   The key installed a few steps above still works right now, so box->Mac ssh is not the problem — the
   channel itself is. It matters LATER: the box's hourly cron deletes that key, and from then on the channel
   is the only way the prover stays reachable, which is exactly why it is established while the key is there.
   Look at ~/witness-exec.log on this Mac and \`ssh $BOX 'ls -la ~/.zisk-exec.sock'\`."
  fi
  if [ "$DRY" != 1 ]; then
    sleep 4
    if onbox_q "test -S ~/.zisk-exec.sock && echo yes" | grep -q yes; then
      say "exec channel up — the box drives the prover without a key of its own"
    else
      say "WARNING: the exec channel did not come up. Proving still works, but through the box→Mac ssh, which"
      say "  needs ~/.ssh/id_ed25519 ON THE BOX — the file the hourly cron deletes. Expect it to stop within"
      say "  the hour. check: tail ~/witness-exec.log"
    fi
  fi
  command -v ziskemu >/dev/null 2>&1 \
    && say "ziskemu found: the prover will measure real step counts" \
    || say "WARNING: no ziskemu on this Mac — the model will fall back to its fixed term only"
else
  step "$([ "$PROVE_REAL" = 1 ] && echo "Real prover" || echo "Mock prover") on $PROVER (not this Mac) — staging deferred to after the box's clone is updated"
  [ "$PROVER_FROM_ALIAS" = 1 ] && say "from REMOTE in the environment (PROVER= overrides it; unset REMOTE for a prover on this Mac)"
fi

# ── 2. the box must be able to ssh back here, without a password ────────────────────────────────────
step "Key auth from $BOX back to this Mac"
# Test the PRIVATE half. Checking only `.pub` was a real bug: a leftover public key (or a wiped ~/.ssh that
# kept nothing at all) let this step report success while the box had nothing to authenticate with, and the
# run then survived purely on a forwarded agent — until the agent went away and every transfer stopped.
# Before generating anything: is something on that host scheduled to DELETE it again? On the devcore box the answer
# is yes — an Ansible-managed crontab entry, `0 * * * * find ~/.ssh -type f -name 'id_*' -delete`, wipes the
# private key at the top of every hour. That is why this step has "fired twice on a box where the key was
# verified present hours earlier", and why ~/.ssh keeps coming back with only authorized_keys + known_hosts:
# the glob matches id_* and nothing else. Generating a fresh key here still "succeeds", so no existing check
# catches it — the pipeline just quietly loses every fresh ssh connection at the next :00, keeps proving on
# a multiplexed master authenticated before the wipe, and dies for good whenever that socket drops.
# Detect it and say so, with the deadline. Do not work around it silently: the entry is a deliberate control
# owned by whoever runs the Ansible, and renaming the key to dodge the glob is their decision, not this
# script's. Repeated re-runs are also why the Mac's authorized_keys accumulates one dead key per run.
wipe_cron="$(onbox_q "crontab -l 2>/dev/null | grep -E '^[^#].*\.ssh.*(id_\*|id_ed25519|id_rsa).*-delete'")"
if [ -n "$wipe_cron" ]; then
  say "WARNING: a cron entry on $BOX deletes the private key on a schedule:"
  printf '   %s\n' "     $wipe_cron"
  say "  a key generated now survives until that job next runs. The prefetcher (the only component that"
  say "  opens a FRESH connection per block) stops at that moment; proving limps on through the existing"
  say "  multiplexed master and stops for good when it drops. Re-running rtp-up is a reset, not a fix."
  say "  Durable options: get the entry scoped/exempted by whoever owns the Ansible, or remove the need for"
  say "  a box->Mac private key at all (the prover can already reach the box — that is what PULL_VIA uses)."
fi
have_key="$(onbox_q 'test -f ~/.ssh/id_ed25519 && echo yes')"
pub="$(onbox_q 'cat ~/.ssh/id_ed25519.pub 2>/dev/null')"
if [ "$have_key" != yes ] || [ -z "$pub" ]; then
  # Say WHICH half is missing, and what the directory looks like. This has fired twice on a box where the key
  # was verified present hours earlier, and "no usable key pair" alone gives nothing to reason from.
  say "no usable key pair on the box — generating one there"
  say "  private: ${have_key:-MISSING}   public: $([ -n "$pub" ] && echo present || echo MISSING)"
  onbox_q 'ls -la ~/.ssh/ 2>&1 | head -8' | sed 's/^/     /'
  onbox "mkdir -p ~/.ssh && chmod 700 ~/.ssh && rm -f ~/.ssh/id_ed25519 ~/.ssh/id_ed25519.pub && ssh-keygen -t ed25519 -N '' -f ~/.ssh/id_ed25519 -q -C $BOX-rtp"
  have_key="$(onbox_q 'test -f ~/.ssh/id_ed25519 && echo yes')"
  pub="$(onbox_q 'cat ~/.ssh/id_ed25519.pub 2>/dev/null')"
  [ "$have_key" = yes ] || [ "$DRY" = 1 ] || die "ssh-keygen did not leave a private key on $BOX. If ~/.ssh \
keeps being emptied there, something on that host manages it (config management, a home reset) — find that \
before going further, or the pipeline will keep dying whenever your agent is not around."
fi
[ -n "$pub" ] || [ "$DRY" = 1 ] || die "still no public key on $BOX"
if [ "$DRY" != 1 ]; then
  mkdir -p ~/.ssh && chmod 700 ~/.ssh
  if grep -qxF "$pub" ~/.ssh/authorized_keys 2>/dev/null; then
    say "already authorised here"
  else
    printf '%s\n' "$pub" >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys
    say "added to ~/.ssh/authorized_keys"
  fi
  # sshd refuses a key SILENTLY if the home dir is group/other-writable — the failure looks like a bad key.
  # Only touched if it actually is, and said out loud: it is your home directory's permissions.
  case "$(ls -ld ~ | cut -c1-10)" in
    *w*w*|*w??w*) say "NOTE: ~ is group/other-writable, which makes sshd ignore the key — fixing with chmod go-w ~"
                  chmod go-w ~ ;;
  esac
fi

# ── 3. ethproofs-mock ──────────────────────────────────────────────────────────────────────────────
# The extractor the mock needs to read a proof's public values. Absent, the mock's gate falls OPEN — it says
# so on startup, but a warning in a scrollback is not a check. Named here because this is the step that owns
# the mock, and because "the gate is armed" must be visible at launch, not discovered from a 409 that never came.
if [ ! -x "$MAC_REPO/infra/zisk-infra/zisk-publics/target/release/zisk-publics" ]; then
  say "⚠️  zisk-publics is not built — the mock cannot read a proof's committed values, so it will accept any"
  say "    proof that verifies, for any block. Build it once (~90 s):"
  say "      (cd infra/zisk-infra/zisk-publics && cargo build --release)"
fi
step "ethproofs-mock on :$MOCK_PORT (store $MOCK_STORE)"
if [ "$KEEP_MOCK" = 1 ]; then
  say "--keep-mock: leaving whatever is running alone"
else
  run "pkill -f ethproofs-mock || true"
  run "sleep 1"
  # EP_PROVE_EVERY so the leaderboard knows this run's deadline. A sampled block owns PROVE_EVERY slots, so
  # the window it had to land in is PROVE_EVERY × 12 s — and a mock told nothing assumes 1, which would flag
  # every block on a sampled campaign as late.
  run "( trap '' INT; EP_PROVE_EVERY=$PROVE_EVERY nohup '$MAC_REPO/cli/ethproofs-mock' --port $MOCK_PORT --store '$MOCK_STORE' --rpc '$RPC' --verify-cmd '$MAC_REPO/cli/verify-proof' >> ~/ethproofs-mock.log 2>&1 & )"
  run "sleep 2"
fi
if [ "$DRY" != 1 ]; then
  curl -sf "http://127.0.0.1:$MOCK_PORT/status" >/dev/null \
    && say "answering on 127.0.0.1:$MOCK_PORT (log: ~/ethproofs-mock.log)" \
    || die "not answering on :$MOCK_PORT — see ~/ethproofs-mock.log"
fi

# ── 4. the reverse tunnel, supervised ──────────────────────────────────────────────────────────────
# 127.0.0.1 rather than localhost: the mock binds IPv4 only, and `localhost` can resolve to ::1 first.
# The retry loop matters over a multi-hour run on a home link — a dropped tunnel would otherwise stay
# dropped, and every submission would fail silently until someone noticed.
step "Reverse tunnel ($TUN_SSH_PORT -> this Mac's sshd, $MOCK_PORT -> the mock)"
tun_alive(){ [ -n "$(onbox_q "ss -ltn 2>/dev/null | grep -c ':$TUN_SSH_PORT '")" ] \
             && [ "$(onbox_q "ss -ltn 2>/dev/null | grep -c ':$TUN_SSH_PORT '")" != "0" ]; }
# ALWAYS RESTARTED, never reused — the same rule as the prove session, and for a sharper reason here.
# `tun_alive` only asks whether SOMETHING listens on the port. Two failure modes hide behind a yes:
#   * a stale ssh from a previous run holds $TUN_SSH_PORT while its Mac side is gone, so the port is bound
#     and the tunnel is useless — and this step then says "already listening" and changes nothing;
#   * a previous supervisor loop is still alive, so the new one cannot bind and BOTH spin on
#     `ExitOnForwardFailure` every 5 s. Seen verbatim in ~/tunnel.log:
#         Error: remote port forwarding failed for listen port 2222
#         rtp-up-tunnel: link down, retrying in 5s
#     repeated until nothing was up at all, which is how every box->Mac submission came to fail.
# So: kill the supervisor AND its ssh (the loop's own pkill pattern misses the child, exactly like the pump's
# did), then start one. Step 5 below verifies the result end to end and dies if it is not usable.
run "pkill -f 'rtp-up-tunnel' 2>/dev/null; pkill -f 'R $TUN_SSH_PORT:127.0.0.1:22' 2>/dev/null; true"
# The box side can also be holding the port from a dropped session; a bound port there fails the forward.
onbox_q "pkill -f 'sshd.*$TUN_SSH_PORT' 2>/dev/null; true" >/dev/null 2>&1 || true
run "sleep 1"
run "( trap '' INT; nohup bash -c 'while true; do ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o BatchMode=yes -R $TUN_SSH_PORT:127.0.0.1:22 -R $MOCK_PORT:127.0.0.1:$MOCK_PORT $BOX; echo \"rtp-up-tunnel: link down, retrying in 5s\"; sleep 5; done' >> ~/tunnel.log 2>&1 & )"
run "sleep 3"
if [ "$DRY" != 1 ] && ! tun_alive; then
  say "WARNING: nothing is listening on $BOX:$TUN_SSH_PORT after the restart — see ~/tunnel.log."
  say "  'remote port forwarding failed' there means the port is still held on the box; step 5 will die on it."
fi

# ── 5. both directions must actually work, before anything is started ──────────────────────────────
step "End-to-end reachability"
if [ "$DRY" != 1 ]; then
  # IdentityAgent=none + IdentitiesOnly=yes: BatchMode does NOT rule out agent authentication, so without
  # these a forwarded agent answers for the box and this check passes with no key on it at all. That is
  # exactly how the pipeline came to depend on an agent that later disappeared. Test what the tmux sessions
  # will actually have — their own key, nothing else.
  onbox_q "ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o IdentityAgent=none -o IdentitiesOnly=yes -i ~/.ssh/id_ed25519 -p $TUN_SSH_PORT $MAC_USER@localhost true" \
    && say "$BOX can ssh into this Mac with its OWN key (no agent involved)" \
    || die "$BOX cannot ssh in using its own key. An agent may still make it look fine interactively, but the \
tmux sessions have no agent. Check: Remote Login enabled on this Mac? ~/.ssh/authorized_keys contains the \
key printed above? ~ not group-writable? See ~/tunnel.log"
  onbox_q "curl -sf http://localhost:$MOCK_PORT/status >/dev/null" \
    && say "$BOX can reach the mock through the tunnel" \
    || die "$BOX cannot reach the mock on :$MOCK_PORT — the tunnel's forward is not up (see ~/tunnel.log)"
  # The prover hop, whichever it is. For a remote prover this is the check that matters most: the box must
  # reach it with a key, unattended, or every block fails at upload and the queue silently drains to nothing.
  if [ -n "$PROVER" ]; then
    # ESTABLISH IT, do not just check it. The box's hourly `find ~/.ssh -type f -name 'id_*' -delete` takes
    # BOTH halves of its keypair, so a pubkey deposited on the prover by hand is worthless within the hour and
    # every later run dies here. That is not an operator mistake to be documented, it is a standing condition
    # to be handled at startup — which is exactly what "the key is only needed at startup" means.
    #
    # This Mac is the only party that can do it: it reaches the box (its own key) and the prover (its own key),
    # while the box↔prover pair is what we are trying to create. So: make sure the box HAS a keypair, then put
    # its public half on the prover from here.
    #
    # It appends to an access file, so it takes the two precautions that file demands: a no-clobber .bak of
    # the original, and a newline guard — a file with no trailing newline glues the new key onto the last
    # existing one and invalidates BOTH, which locks you out of the machine you are provisioning.
    if [ "$DRY" != 1 ]; then
      box_pub="$(onbox_q "ls ~/.ssh/id_*.pub >/dev/null 2>&1 || ssh-keygen -t ed25519 -N '' -f ~/.ssh/id_ed25519 </dev/null >/dev/null 2>&1; cat ~/.ssh/id_*.pub 2>/dev/null | head -1")"
      case "$box_pub" in
        ssh-*|ecdsa-*)
          if printf '%s\n' "$box_pub" | ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
               -p "$PROVER_PORT" "$PROVER_TARGET" \
               "mkdir -p ~/.ssh && chmod 700 ~/.ssh && touch ~/.ssh/authorized_keys \
&& { cp -n ~/.ssh/authorized_keys ~/.ssh/authorized_keys.rtp-bak 2>/dev/null || true; } \
&& { [ -n \"\$(tail -c1 ~/.ssh/authorized_keys)\" ] && echo >> ~/.ssh/authorized_keys || true; } \
&& while read -r l; do grep -qxF \"\$l\" ~/.ssh/authorized_keys || echo \"\$l\" >> ~/.ssh/authorized_keys; done \
&& chmod 600 ~/.ssh/authorized_keys && echo ok" 2>/dev/null | grep -q ok; then
            say "$BOX's key is authorised on $PROVER_TARGET (re-done every run: the box's cron deletes it hourly)"
          else
            say "WARNING: could not put $BOX's key on $PROVER_TARGET from this Mac — the check below will say so."
          fi ;;
        *) say "WARNING: $BOX has no usable public key to authorise (got '${box_pub:0:20}')." ;;
      esac
    fi
    onbox_q "ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -p $PROVER_PORT $PROVER_TARGET true" \
      && say "$BOX can ssh into the prover $PROVER_TARGET without a password" \
      || die "$BOX cannot ssh into $PROVER_TARGET (port $PROVER_PORT). Add $BOX's ~/.ssh/id_ed25519.pub to \
that host's authorized_keys — the same way step 2 does it for this Mac."
  fi
  bashv="$(onbox_q "ssh -o BatchMode=yes -p $PROVER_PORT $PROVER_TARGET 'bash --version | head -1'")"
  say "prover's shell: ${bashv:-unknown}"
  case "$bashv" in *"version 3."*) say "  (bash 3.2: emulation time is measured to the second — ±1s of noise)";; esac
fi

# ── 6. the box: code, producer, prover ─────────────────────────────────────────────────────────────
# ── 5b. the monad BINARY must match the monad SOURCE, on the RTP branch ────────────────────────────
#
# This cost an hour of misdiagnosis. The producer's behaviour comes from a compiled binary, and nothing in the
# pipeline notices when that binary was built from a different branch than the one checked out:
#
#   al/rtp carries `runloop_ethereum: wait for a block instead of asserting, honouring --block-db-timeout`,
#   and drops the `->needs(as_eth_blocks_flag)` constraint in cmd/monad/main.cpp.
#
# The checkout was on al/rtp; the binary had been built from another branch, so it still enforced that
# constraint and exited 107 on `--block-db-timeout` alone. That wrote an ALERT which reorg-recover correctly
# refuses (it is not a reorg), and the failure message pointed at flags rather than at a stale build. Reading
# An earlier write-up made it worse: it states the wait "lives in the Monad runloop, not the Ethereum one", which was
# true of the OLD branch and is exactly what al/rtp changes.
#
# So: check the branch, then check that the binary embeds the checked-out commit. Fatal, because running the
# wrong binary produces failures that read as configuration problems.
# MONAD_BRANCH= (empty) skips both checks.
MONAD_BRANCH="${MONAD_BRANCH:-al/rtp}"
MONAD_DIR_BOX="${MONAD_DIR_BOX:-\$HOME/monad}"
# A STALE BINARY IS REBUILT, NOT REPORTED. The fix was one deterministic command that this script already
# knew and printed for you to copy — which is the definition of something it should just run.
#
# It is a 10-40 min incremental build (~251 files differ across the branches here), so it is announced and
# its output is streamed rather than swallowed: a rebuild that fails on a compiler error after a rebase, or
# on OOM from -j$(nproc), has to be readable. The result is re-verified afterwards, so a build that "worked"
# without producing a matching binary still stops the run.
#
# BUILD_MONAD=0 restores the old behaviour (die with the command). A WRONG BRANCH stays fatal either way:
# `git checkout` in your monad tree is a decision, not a repair.
BUILD_MONAD="${BUILD_MONAD:-1}"
if [ "$DRY" != 1 ] && [ -n "$MONAD_BRANCH" ]; then
  step "monad: branch $MONAD_BRANCH, and a binary built from it"
  mb="$(onbox_q "cd $MONAD_DIR_BOX && git rev-parse --abbrev-ref HEAD")"
  [ "$mb" = "$MONAD_BRANCH" ] \
    || die "$BOX's monad is on branch '$mb', not '$MONAD_BRANCH'. The RTP pipeline needs $MONAD_BRANCH — it is
the branch where the ethereum runloop WAITS for a block instead of asserting. Switch it and rebuild:
    ssh $BOX 'cd monad && git checkout $MONAD_BRANCH && cmake --build build --target monad -j\$(nproc)'
  (MONAD_BRANCH= skips this check.)"
  say "branch $mb"

  # AND IS THAT CHECKOUT WHAT THE BRANCH SAYS? Everything below verifies that the
  # binary matches the box's checkout — one link short of what the pipeline needs,
  # which is that the producer is built from what $MONAD_BRANCH actually holds. A
  # commit pushed upstream was invisible here: the checkout stayed put, the binary
  # matched it, the check said "matches the checkout", and the run proceeded on a
  # producer from days earlier. That is exactly the silent staleness the rest of
  # this script exists to prevent, so it is checked before the binary is.
  # The fetch's OUTCOME is kept. A fetch that fails leaves the PREVIOUS origin/$MONAD_BRANCH in place — days
  # old, and still perfectly countable — so the counts below would read "up to date" against a ref that is
  # itself stale. Same silent staleness, one level up, and the counts cannot reveal it.
  fetched=1
  onbox_q "cd $MONAD_DIR_BOX && git fetch -q origin '+refs/heads/$MONAD_BRANCH:refs/remotes/origin/$MONAD_BRANCH'" \
    >/dev/null 2>&1 || fetched=0
  behind="$(onbox_q "cd $MONAD_DIR_BOX && git rev-list --count HEAD..origin/$MONAD_BRANCH 2>/dev/null" | tr -d ' \n')"
  ahead="$(onbox_q "cd $MONAD_DIR_BOX && git rev-list --count origin/$MONAD_BRANCH..HEAD 2>/dev/null" | tr -d ' \n')"
  # EMPTY IS NOT ZERO. `git rev-list --count HEAD..origin/<branch>` exits 128 with NO OUTPUT when that ref does
  # not exist, and folding that into 0 makes all three branches below silent — this check then announces nothing
  # for a comparison it never performed, which is precisely the staleness the paragraph above says it exists to
  # prevent. So the two cases are told apart, and "could not tell" is said out loud instead of read as agreement.
  # A warning, not fatal, and deliberately: 5b-bis below still proves the binary matches the CHECKOUT, so what
  # is unknown here is only the checkout's relation to upstream — and blocking a bring-up on a network blip
  # would cost more than it saves. Silence is the failure mode; stopping is not the fix.
  unreadable=0
  case "$behind" in ''|*[!0-9]*) unreadable=1; behind=0 ;; esac
  case "$ahead"  in ''|*[!0-9]*) unreadable=1; ahead=0 ;; esac
  if [ "$unreadable" = 1 ]; then
    say "⚠️  cannot compare $BOX's checkout with origin/$MONAD_BRANCH — THE BRANCH-FRESHNESS CHECK DID NOT RUN."
    say "    git rev-list returned no count, so origin/$MONAD_BRANCH most likely does not exist on the box."
    say "    The producer may be running old code and nothing here can tell. Check by hand:"
    say "      ssh $BOX 'cd monad && git fetch origin $MONAD_BRANCH && git status -sb'"
  elif [ "$fetched" != 1 ]; then
    say "⚠️  git fetch FAILED on $BOX, so what follows is measured against a possibly stale"
    say "    origin/$MONAD_BRANCH — a network or auth failure reads as 'up to date' here. Verify:"
    say "      ssh $BOX 'cd monad && git fetch origin $MONAD_BRANCH'"
  fi
  if [ "$behind" != 0 ] && [ "$ahead" != 0 ]; then
    die "$BOX's monad checkout has diverged from origin/$MONAD_BRANCH ($ahead local, $behind upstream).
   rtp-up will not resolve that: reconcile it by hand and re-run."
  elif [ "$behind" != 0 ]; then
    say "checkout is $behind commit(s) behind origin/$MONAD_BRANCH"
    if [ "$BUILD_MONAD" != 1 ]; then
      die "$BOX's monad is behind origin/$MONAD_BRANCH, so the producer would run old code. Update it:
    ssh $BOX 'cd monad && git pull --ff-only && cmake --build build --target monad -j\$(nproc)'
  (BUILD_MONAD=1 — the default — fast-forwards and rebuilds here instead.)"
    fi
    onbox "cd $MONAD_DIR_BOX && git merge --ff-only origin/$MONAD_BRANCH 2>&1 | tail -2" \
      || die "could not fast-forward $BOX's monad to origin/$MONAD_BRANCH — reconcile it by hand."
    say "fast-forwarded; the binary check below will rebuild it"
  elif [ "$ahead" != 0 ]; then
    say "checkout is $ahead commit(s) AHEAD of origin/$MONAD_BRANCH (unpushed work — left alone)"
  fi

  # AFTER the fast-forward, so the binary is compared against the commit the box
  # now holds and not the one it held a moment ago.
  mhead="$(onbox_q "cd $MONAD_DIR_BOX && git rev-parse HEAD")"
  # The build commit is compiled in — monad prints it as "running with commit '<sha>'" — so it can be read out
  # of the binary without starting it. If no 40-hex string is found at all, fall back to mtime: a binary older
  # than the commit it should contain is stale beyond doubt.
  if onbox_q "strings -a $MONAD_DIR_BOX/build/cmd/monad 2>/dev/null | grep -qF '$mhead' && echo yes" | grep -q yes; then
    say "binary built from ${mhead:0:12} — matches the checkout"
  else
    # Why it is stale, for the log — the two cases need different words even though the repair is identical.
    if onbox_q "test \$(stat -c %Y $MONAD_DIR_BOX/build/cmd/monad) -lt \$(cd $MONAD_DIR_BOX && git log -1 --format=%ct) && echo old" | grep -q old; then
      say "binary is OLDER than the commit checked out on $MONAD_BRANCH — it cannot contain it"
    else
      say "binary does not contain ${mhead:0:12} — it was built from another branch or revision"
    fi
    if [ "$BUILD_MONAD" != 1 ]; then
      die "$BOX's monad binary does not match the checkout on $MONAD_BRANCH. Rebuild:
    ssh $BOX 'cd monad && cmake --build build --target monad -j\$(nproc)'
  (Incremental, but ~251 files differ across branches here — allow 10-40 min on 16 cores.)
  (BUILD_MONAD=1 — the default — rebuilds it here instead.)"
    fi
    step "Rebuilding monad on $BOX (10-40 min; BUILD_MONAD=0 to do it yourself)"
    # SUBMODULES FIRST. `git checkout` does not move them, and the branches pin different ones —
    # third_party/fiber is dbab7e10 on al/zkvm-r4 and a0764ba7 on al/rtp. Building al/rtp against r4's fiber
    # fails with `PriorityAlgorithm` abstract, because that fiber's `algorithm` base declares a pure virtual
    # the client does not override. A branch switch is exactly when the automatic rebuild runs, so without
    # this the rebuild reliably fails on the one occasion it exists for.
    say "syncing submodules (a branch switch does not move them)"
    onbox "cd $MONAD_DIR_BOX && git submodule update --init --recursive 2>&1 | tail -5" || true
    # `set -o pipefail` on the REMOTE side, and NO truncation. Both were bugs:
    #   * without pipefail the pipeline's status is `tail`'s, so a failed cmake reported SUCCESS and the run
    #     fell through to the re-verify, which then blamed the build directory for a compiler error;
    #   * `tail -25` kept the ninja progress lines and cut the diagnostic above them — the opposite of useful.
    # This is the one long step in the script and the place a human has to read the output, so it all comes.
    if ! onbox "set -o pipefail; cd $MONAD_DIR_BOX && cmake --build build --target monad -j\$(nproc) 2>&1"; then
      die "the rebuild failed on $BOX — THE COMPILER OUTPUT IS ABOVE, and it names the cause. Nothing
   else was started, so the producer is still on the binary it had.
   The submodules are NOT the suspect: they were synced a moment ago, in this same step. The one case
   where they still are is a missing override on a boost::fibers base class, which means the sync did
   not take: \`ssh $BOX 'cd monad && git submodule status'\` against \`git ls-tree HEAD third_party/fiber\`.
   Anything else — and an unused function or a narrowing conversion counts, this build is -Werror — is
   the code that was just pulled, not the environment."
    fi
    # Re-verify rather than trust the exit code: a build can succeed and still not produce a binary carrying
    # this commit (wrong build dir, a target that was already up to date against different sources).
    # TWO SIGNALS, because the sha alone cannot answer this after an incremental
    # build. GIT_COMMIT_HASH is captured by `git rev-parse HEAD` at CMake CONFIGURE
    # time (CMakeLists.txt) and reaches the binary as a compile definition on
    # cmd/monad — so a build that only recompiles the files that changed leaves the
    # embedded sha at whatever the last configure saw. Demanding it made this step
    # kill a perfectly good rebuild: two objects recompiled, the executable
    # relinked, and the check declared failure.
    #
    # So: the sha when it is there (exact, and what the producer's own log line
    # will say), else the binary being NEWER than the commit — which is what an
    # incremental build actually proves.
    if onbox_q "strings -a $MONAD_DIR_BOX/build/cmd/monad 2>/dev/null | grep -qF '$mhead' && echo yes" | grep -q yes; then
      say "rebuilt, and the binary now carries ${mhead:0:12}"
    elif onbox_q "test \$(stat -c %Y $MONAD_DIR_BOX/build/cmd/monad) -gt \$(cd $MONAD_DIR_BOX && git log -1 --format=%ct) && echo newer" | grep -q newer; then
      say "rebuilt: the binary is newer than ${mhead:0:12}, so it carries it"
      say "  (its embedded GIT_COMMIT_HASH still shows the last CMake configure — cosmetic,"
      say "   but it is what 'running with commit' logs, so re-configure to refresh it:"
      say "   ssh $BOX 'cd monad && GIT_COMMIT_HASH=\$(git rev-parse HEAD) cmake -B build && cmake --build build --target monad')"
    else
      die "the rebuild reported success but $BOX's binary is neither carrying ${mhead:0:12} nor newer
   than it. Check that $MONAD_DIR_BOX/build is the build directory this checkout uses:
     ssh $BOX 'cd monad && cmake --build build --target monad -j\$(nproc) && ls -l build/cmd/monad'"
    fi
  fi

  # ── 5b-bis. CONTENT, not just provenance ─────────────────────────────────────────────────────────
  # The two checks above prove where the binary came from. They cannot prove what it contains, and that is
  # not a nuance: the lazy-KZG fix lived as an uncommitted working-tree edit once, so a binary built with it
  # and a binary built without it matched the checkout identically while differing by 2 s PER BLOCK.
  #
  # ~2 s of every monad startup is `init_trusted_setup()` called from main(): blst subgroup checks over
  # 4096 G1 + 65 G2 points, needed only by the point_evaluation precompile (0x0a), which most blocks never
  # touch. With --min-follow-batch 1 that is 2 s per block — over half of chain->witness. `al/rtp` loads it
  # on first use as of `9d5676438`, and after that commit main.cpp names the function nowhere — which is
  # exactly the property this check reads.
  #
  # So: grep the SOURCE for the call site. Cheap, and it is the property that matters rather than a proxy.
  # A warning, not fatal: an unpatched box still produces correct witnesses, only slowly, and blocking a run
  # over a latency regression would be worse than saying so. KZG_STRICT=1 makes it fatal.
  kzg_calls="$(onbox_q "grep -c init_trusted_setup $MONAD_DIR_BOX/cmd/monad/main.cpp 2>/dev/null" | tr -d ' ')"
  if [ "${kzg_calls:-0}" != 0 ]; then
    msg="$BOX's monad still calls init_trusted_setup() from main() ($kzg_calls occurrence(s) in
   cmd/monad/main.cpp). That is ~2 s of KZG trusted-setup load on EVERY process start, and with
   --min-follow-batch 1 the producer starts one process per block. Expect chain->witness at 2-3 s
   instead of ~0.2 s.
   The fix is upstream on $MONAD_BRANCH, commit 9d5676438 (kzg: load the trusted setup on first use), so
   the box is simply behind. Pull and rebuild:
     ssh $BOX 'cd monad && git pull --ff-only && cmake --build build --target monad -j\$(nproc)'
   Verify: \`time ./build/cmd/monad --nblocks 0 --db <db>\` — ~2 s of user time means it is still eager.
   (A pull that brings nothing means the checkout does not contain that commit at all — check with
   \`git merge-base --is-ancestor 9d5676438 HEAD\`.)"
    if [ "${KZG_STRICT:-0}" = 1 ]; then die "$msg"; else say "⚠️  $msg"; fi
  elif [ -n "$kzg_calls" ]; then
    say "trusted setup is lazy (main.cpp does not call init_trusted_setup) — no per-block KZG load"
  else
    # grep printed nothing at all: the file is not there. Saying so beats skipping in silence, which is how
    # a check that never ran gets mistaken for a check that passed.
    say "⚠️  could not read $MONAD_DIR_BOX/cmd/monad/main.cpp — the lazy-trusted-setup check did NOT run."
    say "    Set MONAD_DIR_BOX if monad lives elsewhere on $BOX."
  fi
elif [ "$DRY" != 1 ] && [ "$TIP_DIRECT" = 1 ]; then
  # 5b above is the whole reason TIP_DIRECT=1 is a safe default: it proves the binary embeds a commit from
  # al/rtp, the branch whose ethereum runloop waits for a block instead of asserting. MONAD_BRANCH= disables
  # 5b, so on this path nothing has verified that — and on a binary that still enforces
  # ->needs(as_eth_blocks_flag), --block-db-timeout alone exits 107 and writes an ALERT that reorg-recover
  # correctly refuses, because it is not a reorg.
  say "⚠️  MONAD_BRANCH= skipped the branch/binary checks, and TIP_DIRECT=1 depends on them."
  say "    If the binary was not built from al/rtp, monad will exit 107 and write logs/ALERT."
  say "    Either drop MONAD_BRANCH= or run with TIP_DIRECT=0."
fi

step "Updating the box's clone"
onbox "cd $BOX_REPO && git pull --ff-only 2>&1 | tail -2"
if [ "$DRY" != 1 ]; then
  # Two plain greps rather than arithmetic over `grep -c`: summing with cut/paste/bc needs bc on the box and,
  # worse, an empty result from a failed pipeline would compare unequal to "0" and PASS the check.
  if [ "$PROVE_REAL" = 1 ]; then
    # Real mode does not use the mock branch, so asserting on it would be checking the wrong thing. What has to
    # be in the box's clone is the guest ELF it will ship to the prover, and the prove-cluster verb that routes
    # monad-zisk to the ZisK stack.
    onbox_q "test -s $BOX_REPO/guests/monad-zisk/monad-zisk.elf" \
      || die "the box's clone has no guests/monad-zisk/monad-zisk.elf. It is a symlink to
   guests/monad/monad-zkvm-guest-zisk.elf, which IS committed — so this means the ELF was
   modified locally and never pushed (step 0 warns about exactly that), or the pull failed."
    onbox_q "grep -q 'prove-cluster)' $BOX_REPO/infra/zisk-infra/run" \
      || die "the box's infra/zisk-infra/run has no prove-cluster verb — did the pull work?"
    say "the box's clone has the guest ELF and the prove-cluster verb"
  else
    onbox_q "grep -q 'MOCK PROVER] emulating' $BOX_REPO/infra/zisk-infra/zisk-runner" \
      || die "the box's runner has no emulating mock branch — did the pull work?"
    onbox_q "grep -q ZISK_MOCK_PER_MSTEP $BOX_REPO/cli/prove-farm" \
      || die "the box's prove-farm cannot drive a remote mock prover — did the pull work?"
    say "the box's clone has the mock prover"
  fi
fi

# ── the guest ELF, when it is not the committed one ────────────────────────────────────────────────
BOX_ELF=""
if [ -n "$GUEST_ELF" ]; then
  step "Guest ELF override"
  # THREE SPELLINGS, because requiring an absolute path is a trap: the natural
  # thing to type is a repo-relative path, and prefixing it with $PWD silently
  # doubles a segment when the shell is not sitting at the repo root
  # (guests/monad/guests/monad/gen/...). Accept, in order: the path as given, the
  # same path under this repo, and a bare generation name.
  case "$GUEST_ELF" in
    /*) ;;
    *)  if [ -f "$MAC_REPO/$GUEST_ELF" ]; then
          say "resolved against $MAC_REPO"
          GUEST_ELF="$MAC_REPO/$GUEST_ELF"
        fi ;;
  esac
  if [ ! -f "$GUEST_ELF" ]; then
    gen_elf="$MAC_REPO/guests/monad/gen/$(basename "$GUEST_ELF")/elf/monad-zkvm-guest-zisk.elf"
    if [ -f "$gen_elf" ]; then
      say "read as a generation name"
      GUEST_ELF="$gen_elf"
    fi
  fi
  if [ ! -f "$GUEST_ELF" ]; then
    die "GUEST_ELF=$GUEST_ELF is not a file on this Mac. Give an absolute path, a path
   relative to $MAC_REPO, or just a generation name — these all work:
     GUEST_ELF=zkvm-r8-2026-08-0df7094a1
     GUEST_ELF=guests/monad/gen/zkvm-r8-2026-08-0df7094a1/elf/monad-zkvm-guest-zisk.elf
     GUEST_ELF=$MAC_REPO/guests/monad/gen/zkvm-r8-2026-08-0df7094a1/elf/monad-zkvm-guest-zisk.elf
   Available: $(ls "$MAC_REPO/guests/monad/gen" 2>/dev/null | tr '\n' ' ')"
  fi
  elf_sha="$(shasum -a 256 "$GUEST_ELF" | cut -d' ' -f1)"
  BOX_ELF="\$HOME/rtp-guest-$(printf '%s' "$elf_sha" | cut -c1-16).elf"
  say "$GUEST_ELF"
  say "sha256 $elf_sha"
  # Named by its own checksum, so a second override lands beside the first instead of overwriting it, and so
  # the path in ~/.rtp-prove-cmd says WHICH binary that run used without needing to hash anything.
  # A RELATIVE remote path, and no local resolution of the box's $HOME. scp and
  # ssh both resolve a relative path against the remote home, and the prove
  # command carries $HOME unexpanded for the box's own shell to handle — so
  # nothing here has to ask the box where its home is.
  #
  # Asking cost an outage. onbox_q hides its stderr, so the one ssh that failed
  # returned an empty string; that empty string became the scp destination, which
  # silently means "the remote home under the same basename"; and the verification
  # then ran `sha256sum` with no argument, which reads stdin and waits for ever.
  # Three silent degradations in a row, from one unchecked value.
  box_elf_rel="rtp-guest-$(printf '%s' "$elf_sha" | cut -c1-16).elf"
  if [ "$DRY" = 1 ]; then
    printf '   $ scp %s %s:%s\n' "$GUEST_ELF" "$BOX" "$box_elf_rel"
  else
    scp -q -o BatchMode=yes "$GUEST_ELF" "$BOX:$box_elf_rel" \
      || die "could not copy the ELF to $BOX"
    remote_sha="$(onbox_q "sha256sum '$box_elf_rel' | cut -c1-16" | tr -d ' \n')"
    [ -n "$remote_sha" ] \
      || die "could not read back the ELF's checksum on $BOX (ssh returned nothing).
   The file may be there, but nothing has verified it — refusing to prove with it."
    [ "$remote_sha" = "$(printf '%s' "$elf_sha" | cut -c1-16)" ] \
      || die "the ELF on $BOX hashes to $remote_sha, not $(printf '%s' "$elf_sha" | cut -c1-16)"
    say "landed on $BOX as $BOX_ELF (sha verified after the copy)"
  fi
  # Both halves of the mock path read $ELF: infra/zisk-infra/run for the prove, cli/prove-farm for the
  # emulation that measures the work. Passing it once covers both.
  say "the committed ELF at $BOX_REPO/guests/monad-zisk/monad-zisk.elf is NOT what will be proved"
fi

# ── 6c. a remote prover's runner, pushed from the box's freshly-pulled clone ────────────────────────
if [ -n "$PROVER" ]; then
  # DEFINED HERE, not inside the --real branch: everything below this point that talks to the prover — the
  # channels above all — applies to a MOCK prover on a remote box just as much. Left in the real branch, a
  # remote mock run printed `onprover: command not found` six times and carried on (there is no `set -e`),
  # so the channels never started and nothing in the output said the run was degraded.
  onprover(){ onbox "ssh -o BatchMode=yes -p $PROVER_PORT $PROVER_TARGET '$*'"; }
  onprover_q(){ onbox_q "ssh -o BatchMode=yes -p $PROVER_PORT $PROVER_TARGET '$*'"; }
  # THE PROVER'S HOST KEY, ON THE BOX — and this one comes FIRST, because the very next thing that happens is
  # the box dialling the prover with BatchMode=yes. A fresh prover is unknown to the box, ssh will not prompt,
  # and the dial dies on `Host key verification failed` before any later check can say why.
  # Mirror image of the box's key going the other way: taken from THIS MAC's known_hosts, which has it because
  # you connected to the prover from here; never scanned, so nothing is trusted on first contact.
  if [ "$DRY" != 1 ]; then
    ph="${PROVER_TARGET#*@}"
    pk="$(ssh-keygen -F "[$ph]:$PROVER_PORT" 2>/dev/null | grep -v '^#')"
    [ -n "$pk" ] || pk="$(ssh-keygen -F "$ph" 2>/dev/null | grep -v '^#')"
    if [ -n "$pk" ]; then
      printf '%s\n' "$pk" | onbox_q "mkdir -p ~/.ssh && chmod 700 ~/.ssh \
&& touch ~/.ssh/known_hosts && chmod 600 ~/.ssh/known_hosts \
&& { cp -n ~/.ssh/known_hosts ~/.ssh/known_hosts.rtp-bak 2>/dev/null || true; } \
&& { [ -n \"\$(tail -c1 ~/.ssh/known_hosts)\" ] && echo >> ~/.ssh/known_hosts || true; } \
&& while read -r l; do grep -qxF \"\$l\" ~/.ssh/known_hosts || echo \"\$l\" >> ~/.ssh/known_hosts; done" \
        && say "the prover's host key is known on $BOX (from this Mac's known_hosts)"
    else
      say "WARNING: this Mac has no known_hosts entry for [$ph]:$PROVER_PORT, so $BOX has no verified host key"
      say "  for the prover and its first ssh will fail. Connect to the prover from here once, then re-run."
    fi
  fi
  # Resolve the PROVER's own $HOME before anything is written there. Asked FROM THE BOX, over the same
  # box->prover hop the staging uses, so a failure here is the same failure the staging would hit — and it
  # surfaces now, with a message, instead of as a scp into a surprising path.
  if [ -z "$RUNNER_DIR" ] || [ -z "$PROVER_WS" ]; then
    PROVER_HOME="$(onbox_q "ssh -o BatchMode=yes -p $PROVER_PORT $PROVER_TARGET 'printf %s \"\$HOME\"'")"
    if [ -z "$PROVER_HOME" ]; then
      # Dry runs have no round trip to make; a real run that cannot ask has a broken box->prover hop.
      if [ "$DRY" = 1 ]; then PROVER_HOME='$HOME'
      else die "cannot read \$HOME on $PROVER_TARGET from $BOX. This must work, from the box:
       ssh -o BatchMode=yes -p $PROVER_PORT $PROVER_TARGET true
   Run it there and read what it says:
     'Host key verification failed' -> the step above could not give $BOX the prover's host key.
     'Permission denied'            -> $BOX has no key on the prover. That hop is a precondition this script
        does not set up: put $BOX:~/.ssh/id_*.pub into $PROVER_TARGET:~/.ssh/authorized_keys."
      fi
    fi
    # Per MODE, not one name for both: a mock and a real deployment on the same prover must not share a runner
    # dir or a workspace — that is the same separation PUMP_SOCK, PROVE_LOG and EP_CLUSTER already make.
    if [ "$PROVE_REAL" = 1 ]; then pdir=zisk-prover; else pdir=zisk-mock; fi
    RUNNER_DIR="${RUNNER_DIR:-$PROVER_HOME/$pdir}"
    PROVER_WS="${PROVER_WS:-$PROVER_HOME/$pdir-ws}"
    say "prover \$HOME is $PROVER_HOME → runner $RUNNER_DIR, workspace $PROVER_WS"
  fi
  step "Staging the runner on $PROVER_TARGET:$RUNNER_DIR (from the box)"
  onbox "ssh -o BatchMode=yes -p $PROVER_PORT $PROVER_TARGET 'mkdir -p $RUNNER_DIR $PROVER_WS'"
  onbox "scp -q -o BatchMode=yes -P $PROVER_PORT $BOX_REPO/infra/zisk-infra/zisk-runner $PROVER_TARGET:$RUNNER_DIR/"
  onbox "ssh -o BatchMode=yes -p $PROVER_PORT $PROVER_TARGET 'chmod +x $RUNNER_DIR/zisk-runner'"
  if [ "$DRY" != 1 ] && [ "$PROVE_REAL" != 1 ]; then
    onbox_q "ssh -o BatchMode=yes -p $PROVER_PORT $PROVER_TARGET \"grep -q 'MOCK PROVER] emulating' $RUNNER_DIR/zisk-runner\"" \
      && say "staged, and it carries the emulating mock branch" \
      || die "the runner on $PROVER_TARGET has no emulating mock branch — the copy did not land"
    # Without ziskemu the model loses its only per-block input and every simulated duration becomes the same
    # fixed term. That is not a degraded measurement, it is a constant pretending to be one — so say it loudly.
    onbox_q "ssh -o BatchMode=yes -p $PROVER_PORT $PROVER_TARGET 'command -v ziskemu >/dev/null 2>&1'" \
      && say "ziskemu found on the prover: it will measure real step counts" \
      || say "WARNING: no ziskemu on $PROVER_TARGET — every mock duration will be the SAME fixed term, \
unrelated to the block. Install ZisK there, or keep the prover on the Mac."
  fi

  # ── 6d. real mode: the cluster must be up, and the ELF must be SET UP on it ────────────────────────
  # This is the step that did not exist. core.sh only WARNS when it uploads a changed ELF ("re-run the
  # per-ELF setup"), so a real run against a fresh ELF would fail block after block with nothing saying why.
  if [ "$PROVE_REAL" = 1 ]; then
    step "Real prover on $PROVER_TARGET: cluster liveness + per-ELF setup"
    if [ "$DRY" != 1 ]; then
      onprover_q "PATH=\$HOME/.zisk/bin:\$PATH command -v cargo-zisk >/dev/null 2>&1" \
        || die "no cargo-zisk on $PROVER_TARGET — run infra/zisk-infra/cluster/00-install-once.sh there first."
      # The coordinator, not just the host. A dead coordinator makes every block fail one at a time, ~40 s
      # apart, with a transport error that reads like a network problem.
      onprover_q "curl -sf -m 5 -o /dev/null $COORDINATOR_HEALTH" \
        || die "the ZisK coordinator on $PROVER_TARGET is not answering at $COORDINATOR_HEALTH.
   Start it there:  cd ~/zisk-infra/cluster && ./start.sh
   Then wait for the worker to register (4-12 min: ~30 GB allocated per GPU)."
      say "coordinator answering at $COORDINATOR_HEALTH"
    fi
    # Ship the ELF ahead of the first block, from the box's clone, into the SAME workspace path prove_remote
    # uses. It then finds the checksum matching and skips the upload — and, more to the point, the setup below
    # has something to act on. `scp` follows the symlink, so what lands is the real ELF.
    onbox "ssh -o BatchMode=yes -p $PROVER_PORT $PROVER_TARGET 'mkdir -p $PROVER_WS/elfs'"
    # The override too, under the name prove_remote will look for — otherwise `remote setup` would key the
    # committed ELF while every block proves another one, and the coordinator would miss on all of them.
    if [ -n "${BOX_ELF:-}" ]; then
      onbox "scp -q -o BatchMode=yes -P $PROVER_PORT $BOX_ELF $PROVER_TARGET:$PROVER_WS/elfs/monad-zisk.elf"
    else
      onbox "scp -q -o BatchMode=yes -P $PROVER_PORT $BOX_REPO/guests/monad-zisk/monad-zisk.elf $PROVER_TARGET:$PROVER_WS/elfs/"
    fi
    # NO --hints. The Monad guest has no reth-style hints-gen, and `remote setup -e <elf>` without the flag is
    # the documented form for a hint-less guest (infra/zisk-infra/cluster/README.md). Passing --hints here is
    # what every other setup call in the repo does, and it is wrong for this guest.
    # Idempotent: the coordinator caches per-ELF keys, so a re-run costs a hash comparison.
    step "cargo-zisk remote setup (no --hints: the Monad guest has none)"
    onprover "PATH=\$HOME/.zisk/bin:\$PATH cargo-zisk remote setup -e $PROVER_WS/elfs/monad-zisk.elf \
--coordinator $COORDINATOR_URL 2>&1 | tail -5"
  fi

  # ── the persistent channels, on a REAL prover ────────────────────────────────────────────────────
  # THE KEY IS ONLY NEEDED AT STARTUP, and that is the whole design. Without this, a real run leans on
  # box->prover ssh for every single block: one connection per witness, per artifact fetch, per submission —
  # and the box's hourly cron (`find ~/.ssh -type f -name id_* -delete`) takes that key away, so the campaign
  # dies at the top of the hour with everything else looking healthy. Renaming the key to dodge the cron is
  # not the answer: it trades the architecture for a workaround, and the next machine gets it wrong again.
  #
  # So the same two channels the local prover has, established here while the key still exists:
  #   * witness-pump serve    — the prover PULLS witnesses over N persistent streams
  #   * witness-pump exec-host — the box RUNS commands on the prover with no box-side key at all
  # Both are dialled BY THE PROVER, so the connection that matters afterwards uses the PROVER's key, which
  # this box's cron never touches. prove_cmd already passes WITNESS_PUMP, PUMP_SOCK and REMOTE_SUBMIT for
  # every mode; only the starting was missing.
  step "Persistent channels on $PROVER_TARGET (so the key is needed only now)"
  # HOW THE PROVER REACHES THE BOX — user, host AND PORT, taken from `ssh -G`, which is what this Mac's own
  # ~/.ssh/config resolves $BOX to. That is the authoritative source and the box cannot supply it: asking the
  # box its `hostname -f` gets the name right and silently misses the port, which is how a correct-looking
  # address produced `Connection refused` on 22 while the real sshd was on 9022.
  #
  # Three separate things fail here, one at a time: a name that resolves nowhere else, a port that is not 22,
  # and a key the box has not been told about. Deriving the first two leaves only the one that is genuinely a
  # decision.
  if [ -z "${BOX_FROM_PROVER_SET:-}" ]; then
    eval "$(ssh -G "$BOX" 2>/dev/null | awk '
      /^hostname /{h=$2} /^port /{p=$2} /^user /{u=$2}
      /^proxyjump /{j=$2} /^proxycommand /{sub(/^proxycommand /,""); c=$0}
      END{printf "g_host=%s; g_port=%s; g_user=%s; g_jump=%s; g_cmd=%s\n", h, p, u,
                 (j=="none"?"":j), (c==""||c=="none"?"":"set")}')"
    if [ -n "${g_host:-}" ]; then
      BOX_FROM_PROVER="${g_user:+$g_user@}$g_host"
      BOX_PORT_FROM_PROVER="${g_port:-22}"
      [ "$BOX_FROM_PROVER:$BOX_PORT_FROM_PROVER" = "$BOX:22" ] \
        || say "the prover will dial the box as $BOX_FROM_PROVER port $BOX_PORT_FROM_PROVER (from ssh -G $BOX)"
    fi
    # A jump host is this Mac's route, not a property of the box. The prover has no way to replicate it, so
    # every channel would fail — and it would fail as a refused connection, which reads like a firewall.
    if [ -n "${g_jump:-}" ] || [ -n "${g_cmd:-}" ]; then
      say "WARNING: this Mac reaches $BOX through a jump host / ProxyCommand. The prover cannot use it —"
      say "  give it a route it can dial itself: BOX_FROM_PROVER=user@host BOX_PORT_FROM_PROVER=<port>."
    fi
  fi
  BOX_PORT_FROM_PROVER="${BOX_PORT_FROM_PROVER:-22}"
  for f in infra/zisk-infra/witness-pump cli/ethproofs-submit cli/check-pv infra/monad-witness/netprofile; do
    onbox "scp -q -o BatchMode=yes -P $PROVER_PORT $BOX_REPO/$f $PROVER_TARGET:$RUNNER_DIR/"
  done
  onprover "chmod +x $RUNNER_DIR/witness-pump $RUNNER_DIR/ethproofs-submit $RUNNER_DIR/check-pv \
$RUNNER_DIR/netprofile"
  # check-pv beside ethproofs-submit, or the public-value gate loads-but-absent and every proof ships
  # unchecked — the same pairing the local prover needs.
  if [ "$DRY" != 1 ]; then
    onprover_q "test -x $RUNNER_DIR/check-pv && $RUNNER_DIR/ethproofs-submit --help >/dev/null 2>&1 && echo ok" \
      | grep -q ok \
      && say "submitter and the public-value gate staged" \
      || die "the submitter or check-pv did not stage on $PROVER_TARGET — proofs would ship unverified"
  fi
  # THE BOX'S HOST KEY, ON THE PROVER. The fourth thing that fails in this exact spot, after the name, the
  # port and the key: with BatchMode=yes ssh will not prompt to accept an unknown host, so the prover's very
  # first dial dies on `Host key verification failed` — and every channel is a dial.
  #
  # Taken from THIS MAC's known_hosts, not from ssh-keyscan on the prover. Same result on a good day, but
  # keyscan trusts whatever the rented box's network hands back, while these are the keys this Mac has been
  # connecting with all along. A host key is public; copying one is not handling a credential. If the Mac has
  # no entry, say so rather than fall back to trust-on-first-use — that choice is not this script's to make.
  if [ "$DRY" != 1 ]; then
    box_host="${BOX_FROM_PROVER#*@}"
    hk="$(ssh-keygen -F "[$box_host]:$BOX_PORT_FROM_PROVER" 2>/dev/null | grep -v '^#')"
    [ -n "$hk" ] || hk="$(ssh-keygen -F "$box_host" 2>/dev/null | grep -v '^#')"
    if [ -n "$hk" ]; then
      if printf '%s\n' "$hk" | onprover_q "mkdir -p ~/.ssh && chmod 700 ~/.ssh \
&& touch ~/.ssh/known_hosts && chmod 600 ~/.ssh/known_hosts \
&& { cp -n ~/.ssh/known_hosts ~/.ssh/known_hosts.rtp-bak 2>/dev/null || true; } \
&& { [ -n \"\$(tail -c1 ~/.ssh/known_hosts)\" ] && echo >> ~/.ssh/known_hosts || true; } \
&& while read -r l; do grep -qxF \"\$l\" ~/.ssh/known_hosts || echo \"\$l\" >> ~/.ssh/known_hosts; done \
&& echo installed" | grep -q installed; then
        say "the box's host key is known on $PROVER_TARGET ($(printf '%s\n' "$hk" | grep -c .) entries, from this Mac's known_hosts)"
      else
        say "WARNING: could not install the box's host key on $PROVER_TARGET — the next check will say so."
      fi
    else
      say "WARNING: this Mac has no known_hosts entry for [$box_host]:$BOX_PORT_FROM_PROVER, so there is no"
      say "  verified host key to give the prover. Connect to the box from here once, then re-run."
    fi
  fi

  # THE DIRECTION THAT CARRIES EVERYTHING, checked first. Both channels are dialled BY THE PROVER, so what has
  # to work is prover->box: the prover needs its own key to $BOX, and $BOX has to be a name the PROVER resolves
  # (an alias in this Mac's ~/.ssh/config means nothing there). If it does not, both channels still "start" —
  # the pump binds its socket, the exec-host retries in a loop — and every block quietly falls back to
  # per-block ssh from the box, which is precisely what the hourly key-deleting cron then breaks.
  if [ "$DRY" != 1 ]; then
    onprover_q "ssh -o BatchMode=yes -o ConnectTimeout=8 -p $BOX_PORT_FROM_PROVER $BOX_FROM_PROVER true \
&& echo up" | grep -q up \
      || die "$PROVER_TARGET cannot reach '$BOX_FROM_PROVER' over ssh, and that is the direction all the
   channels dial. On the prover this must work with no password and no agent forwarding:
       ssh -p $BOX_PORT_FROM_PROVER $BOX_FROM_PROVER true
   Two separate causes, and the message ssh gives you says which:
     'Could not resolve hostname'  -> that name means nothing on the prover. An alias from this Mac's
        ~/.ssh/config is not a name; pass the real one with BOX_FROM_PROVER=user@fqdn (this box calls
        itself $(onbox_q hostname -f 2>/dev/null || echo '<hostname -f on the box>')).
     'Host key verification failed' -> the prover does not know the box's host key. The step above installs it
        from this Mac's known_hosts; that warned if it could not.
     'Permission denied'           -> the prover's key is not in $BOX:~/.ssh/authorized_keys yet. From the
        Mac, and only you can decide to do it:
          ssh -p $PROVER_PORT $PROVER_TARGET 'ls ~/.ssh/id_*.pub 2>/dev/null || ssh-keygen -t ed25519 -N \"\" -f ~/.ssh/id_ed25519 < /dev/null'
          ssh -p $PROVER_PORT $PROVER_TARGET 'cat ~/.ssh/id_*.pub' | ssh $BOX 'mkdir -p ~/.ssh && chmod 700 ~/.ssh && touch ~/.ssh/authorized_keys && { [ -n \"\$(tail -c1 ~/.ssh/authorized_keys)\" ] && echo >> ~/.ssh/authorized_keys || true; } && cat >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys && echo added'
        The `tail -c1` guard is not decoration: a file with no trailing newline glues the appended key onto
        the last existing one and invalidates BOTH, locking you out of the machine you just wrote to.
        The box's hourly cron deletes ~/.ssh/id_* there — it does not touch authorized_keys, so this lasts."
  fi

  # How many parallel streams — MEASURED, on the link that carries the witnesses. netprofile runs where the
  # pump serves, and that is the prover; it was already staged above. Defaulting to 1 "because the Mac cannot
  # see this link" was a figure dressed as a decision, and on a 194 ms trans-Pacific path it was the worst
  # available: a single stream spends most of an 8 MB transfer in slow start. Measured on exactly that link,
  # 1 -> 4 channels took the witness from ~23 to ~33 Mbit/s.
  #
  # The probe costs ~40 s of link once per run and writes a per-link record on the PROVER, so a second run on
  # the same box reuses it and says so. An explicit PUMP_CHANNELS still wins, for pinning a measurement.
  if [ -n "${PUMP_CHANNELS:-}" ]; then
    say "channels: $PUMP_CHANNELS (pinned, no probe)"
  elif [ "$DRY" = 1 ]; then
    PUMP_CHANNELS=1
    say "channels: [dry-run] would probe the link from $PROVER_TARGET"
  else
    step "Link profile, measured from $PROVER_TARGET"
    onprover "cd $RUNNER_DIR && NETPROFILE_DB=\$HOME/.zisk-networks.json ./netprofile probe \
$BOX_FROM_PROVER 2>&1 | tail -6" || true
    # `params` prints shell assignments; read the one we apply and nothing else.
    PUMP_CHANNELS="$(onprover_q "cd $RUNNER_DIR && NETPROFILE_DB=\$HOME/.zisk-networks.json ./netprofile \
params $BOX_FROM_PROVER 2>/dev/null" | sed -n 's/.*NETPROFILE_CHANNELS=\([0-9]*\).*/\1/p' | head -1)"
    case "$PUMP_CHANNELS" in
      ''|*[!0-9]*|0) PUMP_CHANNELS=1
                     say "channels: 1 — the probe returned nothing usable (PUMP_CHANNELS=N to pin it)" ;;
      *)             say "channels: $PUMP_CHANNELS (measured on this link)" ;;
    esac
  fi

  # Restart, never reuse: a live channel holds the code and env it started with. Double quotes only — the
  # command travels inside onprover's single quotes.
  # BRACKETED, or the pattern kills the shell running it: this command line IS the remote shell's own cmdline,
  # so `pkill -f "witness-pump serve"` matches itself. It dies on the first pattern and never reaches the
  # second, leaving the OLD exec-host alive beside the new one — precisely the "restart, never reuse" failure
  # this line exists to prevent. `[w]` makes the regex not match its own text. Demonstrated on Linux: the
  # whole remote shell dies, a trailing `echo` included, so the caller sees no output at all.
  onprover "pkill -f \"[w]itness-pump serve\" 2>/dev/null; pkill -f \"[w]itness-pump exec-host\" 2>/dev/null; true"
  # RECORDED, then started FROM the recording — the same rule the prover's invocation follows, and for the
  # same reason: rtp-watchdog has to be able to bring this back at 3 a.m. without rebuilding a command from
  # memory, and a command rebuilt from memory eventually drops the flag nobody notices. The file lives on the
  # BOX because that is where the watchdog runs; the command inside it is executed ON THE PROVER.
  # DOUBLE QUOTES INSIDE, always: this string is passed to onprover, which wraps it in '...' for the box's
  # ssh. One apostrophe here ends that argument and the prover receives a truncated command — the same trap
  # that turned a forward loop into `bash -c exec` earlier today.
  pump_cmd="( trap \"\" INT; PUMP_SOCK=$PUMP_SOCK PUMP_BOX=$BOX_FROM_PROVER PUMP_CHANNELS=$PUMP_CHANNELS \
PUMP_SSH_OPTS=\"-C -o BatchMode=yes -p $BOX_PORT_FROM_PROVER\" \
nohup $RUNNER_DIR/witness-pump serve >> \$HOME/witness-pump.log 2>&1 & )"
  onbox "cat > \$HOME/.rtp-pump-cmd <<'RTPEOF'
$pump_cmd
RTPEOF
chmod 600 \$HOME/.rtp-pump-cmd; echo '   · pump invocation recorded in ~/.rtp-pump-cmd (rtp-watchdog replays it)'"
  onprover "$pump_cmd"
  # ABSOLUTE, resolved on the box. BOX_REPO is the literal string "$HOME/zkvm-bench" so that it resolves on
  # the box — but this value travels THROUGH the prover's shell, which would expand $HOME to the PROVER's home
  # and point exec-host at a path that does not exist there or, worse, at a different clone. So ask the box
  # what the path is, once, and pass the answer.
  BOX_REPO_ABS="$BOX_REPO"
  if [ "$DRY" != 1 ]; then
    BOX_REPO_ABS="$(onbox_q "cd $BOX_REPO && pwd")"
    [ -n "$BOX_REPO_ABS" ] || die "cannot resolve $BOX_REPO on $BOX — the box's clone is what both channels run"
  fi
  onprover "( trap \"\" INT; PUMP_BOX=$BOX_FROM_PROVER PUMP_REMOTE_CMD=$BOX_REPO_ABS/infra/zisk-infra/witness-pump \
PUMP_SSH_OPTS=\"-C -o BatchMode=yes -p $BOX_PORT_FROM_PROVER\" \
nohup $RUNNER_DIR/witness-pump exec-host >> \$HOME/witness-exec.log 2>&1 & )"
  if [ "$DRY" != 1 ]; then
    # STARTED IS NOT SERVING, on either side. The data channel is checked from the prover (its socket lives
    # there); the exec channel from the BOX, which is the side that will use it.
    ok_data=0 ok_exec=0
    for _try in 1 2 3 4 5 6; do
      [ "$ok_data" = 1 ] || onprover_q "test -S $PUMP_SOCK && grep -q \"channels open\" \
\$HOME/witness-pump.log && echo up" | grep -q up && ok_data=1
      # `set -o pipefail` ON PURPOSE, not `echo up`. Everything that crosses this channel is a bash script —
      # core.sh's prove opens with exactly this line so a prover failure propagates through its `tee`. A
      # channel that relays to /bin/sh answers `up` perfectly and then fails EVERY prove in two seconds with
      # `no-report no-proof`. Measured, on a prover whose /bin/sh is dash 0.5.11: the check passed, the run
      # was dead. So the check runs the feature, not a command any shell can do.
      [ "$ok_exec" = 1 ] || onbox_q "cd $BOX_REPO && PUMP_EXEC_SOCK=\$HOME/.zisk-exec.sock \
infra/zisk-infra/witness-pump run 'set -o pipefail; echo up'" | grep -q up && ok_exec=1
      [ "$ok_data" = 1 ] && [ "$ok_exec" = 1 ] && break
      sleep 3
    done
    [ "$ok_data" = 1 ] \
      && say "data channel serving on $PROVER_TARGET:$PUMP_SOCK" \
      || die "the pump on $PROVER_TARGET has no channel open to $BOX_FROM_PROVER — a bound socket alone is the failure
   mode, not the success case: witnesses would cross on per-block ssh, which stops for good when this box's
   cron deletes the key. See $PROVER_TARGET:~/witness-pump.log."
    [ "$ok_exec" = 1 ] \
      && say "exec channel answers from $BOX with no box-side key" \
      || die "the exec channel does not answer a bash command from $BOX. Every control call would need the
   box's key, which the hourly cron deletes. Two causes:
     * the channel is not up at all — see ~/witness-exec.log on $PROVER_TARGET, and check the PROVER can
       ssh to $BOX;
     * it is up but relaying to a shell without \`pipefail\` (a /bin/sh that is old dash). Everything that
       crosses this channel is a bash script, so the pump runs payloads under bash — a copy that predates
       that does not, and no environment variable can retrofit it. The staged binary comes from the BOX's
       clone, so the fix is to get it there:
         git push  &&  ssh $BOX 'cd $BOX_REPO && git pull --ff-only'   then re-run this script.
       (PUMP_SHELL=<path> is for a box whose bash is somewhere unusual, not for an old copy.)"
  fi

  # ── the submission endpoint, AS THE PROVER SEES IT ───────────────────────────────────────────────
  # The prover POSTs the proof itself ("posted BY the prover — the proof never crosses the tunnel"), so
  # ETHPROOFS_URL is resolved on the PROVER. With a mock on this Mac that URL is localhost:$MOCK_PORT, which on
  # a real prover is the PROVER's own localhost with nothing behind it: every block's prover-side submit fails
  # and falls back to posting from the box, dragging the 508 KB proof back over the slow hop — the exact cost
  # that path exists to avoid, and prove-farm only escalates the wording after it has happened many times.
  #
  # The box already publishes the mock on its own 127.0.0.1:$MOCK_PORT (this Mac's reverse tunnel). So give the
  # prover a forward onto it — dialled BY THE PROVER, like everything else here, so it needs no box-side key.
  ep_hostport="$(printf '%s' "$EP_URL" | sed -E 's#^[a-z]+://##; s#/.*$##')"
  case "$ep_hostport" in
    localhost:*|127.0.0.1:*)
      ep_port="${ep_hostport##*:}"
      step "Forwarding the submission endpoint onto $PROVER_TARGET:$ep_port"
      # DOUBLE QUOTES ONLY, and no single quote anywhere in the payload: this string is nested inside
      # onprover's '...' at the box, so one apostrophe here ends the ssh argument and the loop silently
      # becomes `bash -c exec`. The forward's own pattern is distinctive enough to kill by, so the loop needs
      # no name of its own.
      onprover "pkill -f \"[-]L $ep_port:127.0.0.1:$ep_port\" 2>/dev/null; true"
      onprover "( trap \"\" INT; nohup bash -c \"while true; do \
ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o BatchMode=yes \
-p $BOX_PORT_FROM_PROVER -L $ep_port:127.0.0.1:$ep_port $BOX_FROM_PROVER; sleep 5; done\" >> \$HOME/ep-forward.log 2>&1 & )"
      if [ "$DRY" != 1 ]; then
        ep_ok=0
        for _try in 1 2 3 4 5 6; do
          onprover_q "curl -sf -m 5 -o /dev/null $EP_URL/status && echo up" | grep -q up && { ep_ok=1; break; }
          sleep 3
        done
        [ "$ep_ok" = 1 ] \
          && say "the prover reaches $EP_URL — it will post its own proofs" \
          || say "WARNING: the prover cannot reach $EP_URL. Every proof would be posted from $BOX instead, so
   the proof crosses the prover->box hop on every block. See $PROVER_TARGET:~/ep-forward.log, or set EP_URL to
   an endpoint the prover reaches directly."
      fi
      ;;
    *)
      if [ "$DRY" != 1 ]; then
        onprover_q "curl -sf -m 8 -o /dev/null $EP_URL/status && echo up" | grep -q up \
          && say "the prover reaches $EP_URL directly" \
          || say "WARNING: the prover cannot reach $EP_URL — proofs would be posted from $BOX, one slow hop each."
      fi
      ;;
  esac
fi

# ── 6b. the fetcher: newHeads subscription instead of polling ──────────────────────────────────────
# Must happen BEFORE the catch-up, which is what starts the fetcher. And if either the patch or the library
# is newly in place, the RUNNING fetcher is still the old code — so the session is killed to force a restart.
# Continuing with a silently unpatched fetcher would mean none of this has any effect and nothing says so.
step "Fetcher: newHeads over WebSocket"
if [ "$DRY" = 1 ]; then
  say "[dry-run] would install websocket-client if missing and copy replay/fetch_blocks.py"
else
  changed=0
  PYBOX="\$HOME/.pyenv/versions/3.12.13/bin/python3"
  # -m pip against THAT interpreter: witness-follow runs the fetcher with it, and a plain `pip` would
  # happily install into a different Python where the import then fails.
  if onbox_q "$PYBOX -c 'import websocket' 2>/dev/null"; then
    say "websocket-client already present"
  else
    say "installing websocket-client into the box's pyenv"
    onbox "$PYBOX -m pip install --quiet websocket-client && echo '   installed'" && changed=1 \
      || say "install failed — the fetcher will fall back to polling (harmless, just slower)"
  fi
  if onbox_q "grep -q '_head_watcher' ~/monad/fetch_blocks.py"; then
    say "fetch_blocks.py already supports newHeads"
  else
    onbox "cp $BOX_REPO/infra/monad-witness/replay/fetch_blocks.py ~/monad/fetch_blocks.py \
           && echo '   copied replay/fetch_blocks.py'" && changed=1
  fi
  if [ "$changed" = 1 ]; then
    say "restarting the fetcher so it picks this up"
    onbox "tmux kill-session -t fetch 2>/dev/null; echo '   fetch session cleared'"
  fi
fi

# ── 7. catch up to the tip WITHOUT witnesses, before the tip phase ─────────────────────────────────
# The replay must reach the head before it starts dumping witnesses. With --zkvm-witness it runs the
# interpreter (~4.6 vs ~8 blocks/s) AND writes ~7 MB per block, so replaying a backlog with the flag on
# costs hours and tens of GB of witnesses that have no real-time value whatsoever. So: catch up with the
# flag OFF, then switch. Starting `catchup` is idempotent — if we are already at the tip the loop exits on
# its first poll, having cost a few seconds of witness-less replay.
# An ALERT means a previous batch FAILED and the replay will not start. Checked HERE, before the catch-up
# loop, because that loop can only observe the symptom: the gap growing at chain speed while nothing runs.
# Its "no progress in 90s" verdict is true but buries the cause under a minute and a half of polling.
if [ "$DRY" != 1 ] && onbox_q "test -f ~/monad/logs/ALERT && echo yes" | grep -q yes; then
  printf '\n'
  onbox_q "cat ~/monad/logs/ALERT" | sed 's/^/   | /'
  # Only advise a rewind for a reorg-shaped failure. Printing the recovery recipe under an ALERT that says
  # "--block-db-timeout requires --as-eth-blocks" invites rewinding a 440 GB database to fix a typo in a flag.
  # Anchored on the FAILURE line, as ./reorg-recover is. A bare grep over the whole file matches monad's
  # routine "state root = 0x..." info line, which the ALERT embeds in its 40-line tail — so a timeout or a
  # bad flag was classified as a reorg, and recovery was attempted on a database that was perfectly fine.
  # THE SIGNATURE LIST IS READ FROM reorg-recover, NOT COPIED. It was copied once, `excess blob gas` was added
  # there and not here, and this check then refused the very case the tool next to it handles — the same defect
  # RTP-FINDINGS records for reorg-recover itself ("missing from the reorg-signature list, so it REFUSED the
  # very case it exists for"). Two lists cannot stay in step; one can.
  # Extraction: reorg-recover's own `case` line, `*"a"*|*"b"*)` -> `a|b`. If its shape ever changes this yields
  # nothing and the run stops with that said, which is the failure mode to want — silence here means the check
  # matches nothing and every reorg reads as "not a reorg".
  reorg_sigs="$(sed -n 's/^  \*"\(.*\)"\*)$/\1/p' "$HERE/reorg-recover" | head -1 | sed 's/"\*|\*"/|/g')"
  [ -n "$reorg_sigs" ] || die "cannot read the reorg signatures out of $HERE/reorg-recover — its \`case\` line
   changed shape. Without them this check would call every reorg a non-reorg. Fix the extraction here."
  if ! onbox_q "grep -oE 'block [0-9]+ failed with: [a-z ]+' ~/monad/logs/ALERT | grep -qE '$reorg_sigs' && echo yes" | grep -q yes; then
    die "the replay is stopped on the ALERT above, and it is not one of the reorg signatures reorg-recover
handles ($reorg_sigs) — no rewind, and ./reorg-recover would refuse it. Fix the cause it names, then:
   ssh $BOX 'rm ~/monad/logs/ALERT'"
  fi
  # Reorg-shaped: repair it here rather than printing a recipe. witness-follow's supervisor only covers reorgs
  # that happen WHILE it runs; one that lands after a stop (overnight, say) left rtp-up refusing to start with
  # a tool sitting right there that handles exactly this case. reorg-recover refuses anything it should not
  # touch and escalates its own margin, so calling it is not a blind retry.
  if recover_reorg "at startup"; then
    say "recovered — continuing (the fetcher was stopped by the recovery and is restarted below)"
  else
    die "reorg-recover could not repair it (reason above). Do NOT clear the ALERT by hand: the replay would \
fail on the same block. If the margin is exhausted, the divergence is deeper than the history window and the \
triedb has to be rebuilt from a snapshot."
  fi
fi


step "Catching up to the tip (no witnesses while there is a backlog)"
# gap — "<block_db head> <last_executed> <gap>". The block_db listing is authoritative: status.json's
# `available` is only as fresh as the last replay cycle, and the replay may be stopped right now.
# Progress comes from monad-cli, NOT from status.json. run_replay.py writes status.json BEFORE starting a
# batch and then blocks in child.wait() until it finishes — with MAX_BATCH=2000 at 7-9 blocks/s that is 4-5
# minutes during which last_executed cannot change in the file. Polling it every 30 s and concluding "no
# progress" after 90 s declares a healthy replay dead every single time, on its first batch.
# monad-cli reads the triedb's own committed head, live, in ~0.14 s. status.json stays as the fallback in case
# a concurrent read-only open ever fails while monad holds the database.
# Three numbers, because the catch-up has three distinct states and one number cannot tell them apart:
#   AVAIL  status.json's `available` — the CONTIGUOUS head of block_db, which is all the replay can consume.
#          NOT max(block_db): a hole leaves thousands of blocks on disk that are unreachable, and reporting
#          the max once claimed "8097 blocks ready" while the true answer was zero.
#   LAST   the triedb's committed head, from monad-cli, live. status.json's copy is written BEFORE a batch and
#          then frozen for the 4-5 minutes the batch runs, so it cannot be used to detect progress.
#   TIP    the chain head. Distance to it is the only correct "are we caught up" test — AVAIL-LAST reaching
#          zero means the fetcher has stopped supplying, which is the opposite of being caught up.
box_gap(){ onbox_q "
A=\$(grep -o '\"available\": [0-9]*' ~/monad/status.json 2>/dev/null | grep -o '[0-9]*')
T=\$(grep -o '\"finalized_head\": [0-9]*' ~/monad/status.json 2>/dev/null | grep -o '[0-9]*')
L=\$(~/monad/build/cmd/monad-cli --db ~/triedb.db 2>/dev/null | grep -o 'latest_finalized_block_id=[0-9]*' | cut -d= -f2)
[ -n \"\$L\" ] || L=\$(grep -o '\"last_executed\": [0-9]*' ~/monad/status.json 2>/dev/null | grep -o '[0-9]*')
echo \"\${A:-0} \${L:-0} \${T:-0}\"
"; }

if [ "$DRY" = 1 ]; then
  say "[dry-run] would start the catch-up replay and poll until the gap is <= ${CATCHUP_TARGET:-10} blocks"
else
  onbox "cd $BOX_REPO/infra/monad-witness && HEAD_TAG=$HEAD_TAG CONFIRMATIONS=$CONFIRMATIONS FETCH_POLL=$FETCH_POLL REPLAY_POLL=$REPLAY_POLL ./witness-follow start catchup 2>&1 | sed 's/^/   /'"
  # NO WALL-CLOCK DEADLINE. What must stop this loop is a replay that is not advancing, and `stall` below is that
  # test: three polls without progress, escalated to reading logs/ALERT so the cause is named rather than hunted.
  # A duration cannot distinguish a stuck replay from a healthy long one, and the only runs it ends are the
  # healthy slow ones — a backlog of 154 k blocks is ~6 h of legitimate work at the measured batch rate.
  target="${CATCHUP_TARGET:-10}"; poll="${CATCHUP_POLL:-30}"
  stall=0; prev=""
  while :; do
    read -r avail last tip <<<"$(box_gap)"
    [ -n "${tip:-}" ] || die "cannot read the box's progress (is ~/monad/status.json there?)"
    gap=$(( tip - last )); ready=$(( avail - last ))
    if [ "$gap" -le "$target" ]; then
      say "at the tip: available=$avail last_executed=$last gap-to-chain=$gap"
      break
    fi
    if [ "$ready" -le 0 ]; then
      # Nothing to execute: block_db has no block $((last+1)). This is a FETCHER problem, never a replay one,
      # and it is what a block_db purge leaves behind when the fetcher was not stopped first — it keeps writing
      # at the tip from its in-memory position and never comes back to fill the hole, and existing_max_block()
      # takes the MAX, so restarting it does not help either. Only deleting everything above the gap does.
      stall=$((stall + 1))
      [ "$stall" -lt 4 ] || die "the replay has nothing to execute: block_db is missing block $((last + 1)) \
while the chain is $gap blocks ahead. There is a HOLE in block_db — almost certainly a purge done with the \
fetcher still running. Fix it by removing everything above the triedb head so the fetch resumes contiguously:

  pkill -f fetch_blocks.py; tmux kill-session -t fetch
  ls ~/block_db | awk '\$1+0 > $last' > /tmp/drop.txt; wc -l < /tmp/drop.txt
  (cd ~/block_db && xargs -a /tmp/drop.txt rm -f)

then re-run rtp-up, which restarts the fetcher from $((last + 1))."
      say "gap-to-chain=$gap — nothing to execute, block_db is missing $((last + 1)) ($stall/4)"
    elif [ -n "$prev" ]; then
      done_blocks=$(( last - prev ))
      if [ "$done_blocks" -le 0 ]; then
        stall=$((stall + 1))
        # Idle with $ready blocks in hand is a genuine failure. Name the cause here rather than sending the
        # operator to look for it — an ALERT is by far the most common, and hunting for it once cost a morning.
        if [ "$stall" -ge 3 ]; then
          if onbox_q "test -f ~/monad/logs/ALERT && echo yes" | grep -q yes; then
            printf '\n'
            say "the replay stopped on a NEW ALERT after $((3 * poll))s with $ready blocks ready to execute."
            if recover_reorg "during catch-up"; then
              say "recovered — resuming the catch-up (the rewind added to the backlog; that is expected)"
              stall=0; continue
            fi
            die "the ALERT above is not repairable from here. Do NOT clear it by hand: the replay would fail \
on the same block. If reorg-recover exhausted its margin, the divergence is deeper than the history window \
and the triedb has to be rebuilt from a snapshot."
          fi
          die "the replay has not advanced in $((3 * poll))s and there is no ALERT, though $ready blocks are \
ready. The session probably died another way. Check: ssh $BOX 'tmux ls; tail -20 ~/replay-catchup.log'"
        fi
        say "gap-to-chain=$gap — no progress ($stall/3)"
      else
        stall=0
        rate=$(awk -v d="$done_blocks" -v p="$poll" 'BEGIN{printf "%.1f", d/p}')
        eta=$(awk -v g="$gap" -v d="$done_blocks" -v p="$poll" 'BEGIN{printf "%d", (d>0 ? g*p/d/60 : 0)}')
        say "gap-to-chain=$gap  ($rate blocks/s, $ready ready, ~${eta} min left)"
      fi
    else
      say "gap=$gap — catching up"
    fi
    prev="$last"
    sleep "$poll"
  done
  onbox "cd $BOX_REPO/infra/monad-witness && ./witness-follow stop >/dev/null 2>&1; echo '   catch-up replay stopped'"
fi

if [ "$PURGE" = 1 ]; then
  step "Purging the queue and the witness dump (clean coverage)"
  onbox "cd $BOX_REPO/infra/monad-witness && ./witness-follow stop"
  onbox "find $BOX_REPO/guests/monad-zisk/fixtures -maxdepth 1 -type f -delete; rm -f ~/witnesses/*.witness ~/witnesses/*.post_state_root; echo purged"
fi

step "Starting the producer (fetch · replay+witnesses · tap)"
# A sampling cadence must never be invisible: it changes what `coverage` means, and a silent 1-in-N would read
# as a pipeline dropping blocks. Announce it with the slot arithmetic that justifies it.
if [ "$PROVE_EVERY" -gt 1 ]; then
  say "cadence: proving every $PROVE_EVERY blocks (those where block % $PROVE_EVERY == 0)"
  say "  the prover gets $((PROVE_EVERY * 12)) s per sampled block instead of 12 s"
  say "  coverage will read ~$((100 / PROVE_EVERY))% and that is the CEILING, not a shortfall"
  if [ "$PROVE_REAL" = 1 ]; then
    # The service figures quoted in mock mode are the MOCK's (model / MOCK_SPEED). In real mode nothing has been
    # measured yet, so quote the projection and label it as one rather than reuse a number from another prover.
    say "  PROJECTED on $PROVE_GPUS GPU (fit x 16/$PROVE_GPUS, never measured on this guest):"
    say "$(awk -v f="$MOCK_SECS" -v p="$MOCK_PER_MSTEP" -v g="$PROVE_GPUS" \
      -v md="$GUEST_MS_MED" -v mn="$GUEST_MS_MEAN" -v p9="$GUEST_MS_P90" -v mx="$GUEST_MS_MAX" 'BEGIN{
      s=p*16/g; printf "    median %d Ms -> %.0f s · mean %d -> %.0f s · p90 %d -> %.0f s · worst %d -> %.0f s",
      md, f+s*md, mn, f+s*mn, p9, f+s*p9, mx, f+s*mx }')"
    say "  the first real blocks REPLACE these. If the worst case exceeds $((PROVE_EVERY * 12)) s, raise PROVE_EVERY."
  else
    say "  measured mock service is 12.0 s median, 15.0 s p90"
  fi
elif [ "$PROVE_REAL" = 1 ]; then
  say "⚠️  cadence: EVERY block (PROVE_EVERY=1) with a REAL prover on $PROVE_GPUS GPU."
  say "$(awk -v f="$MOCK_SECS" -v p="$MOCK_PER_MSTEP" -v g="$PROVE_GPUS" -v mx="$GUEST_MS_MAX" -v m="$PROVE_MARGIN" 'BEGIN{
    w = f + p*16/g*mx; n = int(w*m/12); if (w*m/12 > n) n++
    printf "    Projected worst case %.0f s against a 12 s slot — PROVE_EVERY=%d would cover it.", w, n }')"
  say "    At N=1 the queue cannot drain: the tap's 'unproved' counter climbs without bound, and witness-tap"
  say "    starts abandoning blocks at its SKIP_AFTER window."
else
  say "cadence: every block (PROVE_EVERY=1). Measured service is 12.0 s median / 15.0 s p90 on a 12 s slot,"
  say "  so 38% of blocks overrun it and --newest-first drops the stragglers: coverage lands near 89%, at random."
  say "  PROVE_EVERY=2 fits 100% of those services and makes the sampling deliberate and reproducible."
fi
if [ "$DRY" != 1 ] && [ -n "$(onbox_q "ls ~/monad/logs/ALERT 2>/dev/null")" ]; then
  # At CONFIRMATIONS=0 this is what a reorg looks like: the replay could not apply the next block on top of
  # one that left the canonical chain. Recovery is a rewind + re-fetch, and it must be deliberate.
  say "⚠️  logs/ALERT is present — the replay stopped on a failed batch (a reorg, at CONFIRMATIONS=0)."
  say "    Recover with, on $BOX:"
  say "      L=\$(grep -o '"last_executed": [0-9]*' ~/monad/status.json | grep -o '[0-9]*')"
  say "      ~/monad/build/category/mpt/monad-mpt --storage ~/triedb.db --rewind-to \$((L - 3)) --yes"
  say "      rm -f ~/block_db/\$((L - 2)) ~/block_db/\$((L - 1)) ~/block_db/\$L ~/monad/logs/ALERT"
  die "not starting the producer on top of an ALERT — rewind first, then re-run."
fi
# Kill the tip sessions first, for the same reason the prover is always restarted: a live tmux session carries
# the code and environment it was created with, and witness-follow skips sessions that already exist. That is
# how the long-lived-monad path stayed undeployed while the logs showed a perfectly healthy producer — twice in
# one day, on two different components. Restarting costs one block; not restarting costs the whole change.
onbox "tmux kill-session -t replay-tip 2>/dev/null; tmux kill-session -t tap 2>/dev/null; pkill -f '[r]un_replay.py' 2>/dev/null; pkill -f '[w]itness-tap' 2>/dev/null; sleep 2; echo '   · tip sessions cleared (they would keep the old code and env)'"
# RECORDED, then launched FROM the recording — same rule as the prover's invocation, and for the same reason:
# anything that rebuilds this env by hand substitutes ITS defaults for the operator's configuration. Done once
# already, twice over: a restart dropped ETHPROOFS_URL (so the heartbeat stopped and the leaderboard froze on a
# healthy pipeline) and imposed PROVE_EVERY=2 on a run deliberately set to a slower cadence. Neither showed up
# as an error. PROVE_EVERY especially is a POLICY, not a tuning knob — silently changing it changes what the
# coverage figure means.
tip_env="HEAD_TAG=$HEAD_TAG CONFIRMATIONS=$CONFIRMATIONS FETCH_POLL=$FETCH_POLL TAP_INTERVAL=$TAP_INTERVAL \
REPLAY_POLL=$REPLAY_POLL SETTLE_SECS=$SETTLE_SECS TIP_DIRECT=$TIP_DIRECT BLOCK_DB_TIMEOUT=$BLOCK_DB_TIMEOUT \
PROVE_EVERY=$PROVE_EVERY SKIP_AFTER=$SKIP_AFTER ETHPROOFS_URL=$EP_URL CLUSTER=$EP_CLUSTER\
${KEPT_MAX_GB:+ KEPT_MAX_GB=$KEPT_MAX_GB}"
onbox "cat > \$HOME/.rtp-tip-env <<'RTPEOF'
$tip_env
RTPEOF
chmod 600 \$HOME/.rtp-tip-env; echo '   · tip env recorded in ~/.rtp-tip-env (rtp-watchdog replays it)'"
onbox "cd $BOX_REPO/infra/monad-witness && env \$(cat \$HOME/.rtp-tip-env) ./witness-follow start tip"
# The cadence is only meaningful in the tip phase: phase_sessions() starts the tap for `tip` and not for
# `catchup`, so catch-up keeps advancing the replay at full speed and sampling never slows the backlog drain.

step "Witness format vs guest generation"
# THE ONE FAILURE THIS EXISTS TO CATCH: a guest built for one witness wire format, fed witnesses in the other.
# It is not a graceful failure — the guest panics or reads garbage — and nothing about it is visible by
# inspection, because witness FILENAMES are identical across formats. Two independent moving parts decide it:
#
#   the PRODUCER's format   <- the monad branch on the box (al/rtp emits rlp-list; the OffsetTrieDb lineage
#                              — the class is `OffsetTrie` since the al/zkvm-r3 rework, the format is the same —
#                              emits MZW\x01), i.e. whatever MONAD_BRANCH checked out above
#   the GUEST's format      <- guests/monad/monad-zkvm-guest-zisk.elf in the box's clone, which is a symlink
#                              target chosen by `use-gen` and committed
#
# They travel by different routes — one is a branch checkout, the other a tracked binary in this repo — so
# they desync on any commit that touches only one of them. Concretely: `git add -A` of a working tree where
# use-gen has installed a new generation ships an offset guest to a box still replaying on al/rtp, and every
# block breaks at once with no line naming the cause. Hence a check before the prover starts, not after.
#
# gen/ is UNTRACKED — it is local state on this Mac — so the box cannot resolve a sha to a generation. The sha
# is read there, the map applied here, and one witness is pulled to read its real format with the same detector
# use-gen uses. ~7 MB once per rtp-up run: the cheapest possible price for not discovering this per block.
if [ "$DRY" = 1 ]; then
  say "dry run — format check skipped"
else
  box_elf_sha="$(onbox_q "sha256sum $BOX_REPO/guests/monad/monad-zkvm-guest-zisk.elf 2>/dev/null | awk '{print \$1}'")"
  elf_gen=""
  for d in "$MAC_REPO"/guests/monad/gen/*/; do
    [ -f "$d/elf/monad-zkvm-guest-zisk.elf" ] || continue
    if [ "$(shasum -a 256 "$d/elf/monad-zkvm-guest-zisk.elf" | awk '{print $1}')" = "$box_elf_sha" ]; then
      elf_gen="$(basename "$d")"
    fi
  done
  # The producer was started seconds ago and the tap deletes a raw witness as soon as it frames it, so the
  # window is narrow and the first look will usually miss. Poll rather than conclude from one empty listing.
  wit=""; for _ in $(seq 1 45); do
    wit="$(onbox_q "ls -t \$HOME/witnesses/*.witness 2>/dev/null | head -1")"
    [ -n "$wit" ] && break
    sleep 1
  done
  if [ -z "$wit" ]; then
    say "WARNING: no witness appeared on $BOX in 45 s — format left UNCHECKED"
    say "  the producer may still be starting; re-run this script once it is emitting, or check by hand:"
    say "    ssh $BOX 'ls -t ~/witnesses/*.witness | head -1'"
  else
    tmp_wit="$(mktemp -t rtpfmt.XXXXXX)"   # XXXXXX: GNU mktemp rejects a template without them
    if scp -q "$BOX:$wit" "$tmp_wit" 2>/dev/null; then
      prod_fmt="$("$MAC_REPO"/guests/monad/witness-fmt --quiet "$tmp_wit" 2>/dev/null || echo unreadable)"
    else
      prod_fmt="unreadable"
    fi
    rm -f "$tmp_wit"
    # The generation's own witnesses ARE the statement of what its guest reads — no separate metadata to drift.
    guest_fmt="unknown"
    if [ -n "$elf_gen" ]; then
      sample="$(ls "$MAC_REPO"/guests/monad/gen/"$elf_gen"/witnesses/*.witness 2>/dev/null | head -1)"
      [ -n "$sample" ] && guest_fmt="$("$MAC_REPO"/guests/monad/witness-fmt --quiet "$sample" 2>/dev/null || echo unknown)"
    fi
    say "producer ($MONAD_BRANCH on $BOX): $prod_fmt   ·   guest (${elf_gen:-UNKNOWN generation}): $guest_fmt"
    if [ -z "$elf_gen" ]; then
      say "WARNING: the box's ELF ($(printf %.12s "$box_elf_sha")…) matches no generation in guests/monad/gen/,"
      say "  so its expected format cannot be known and the pair is UNCHECKED. File the ELF into a generation"
      say "  directory (with its witnesses) to make this checkable — that is what gen/ is for."
    elif [ "$prod_fmt" = unreadable ] || [ "$guest_fmt" = unknown ]; then
      say "WARNING: could not read one side — pair left UNCHECKED (producer=$prod_fmt guest=$guest_fmt)"
    elif [ "$prod_fmt" != "$guest_fmt" ]; then
      say "the box is replaying on '$MONAD_BRANCH', which emits '$prod_fmt' witnesses."
      say "the committed guest is generation '$elf_gen', which reads '$guest_fmt'."
      say "Resolve by moving ONE of the two, not both:"
      say "  · keep the guest -> put the box on the branch of that generation's lineage (MONAD_BRANCH=...)"
      say "  · keep the branch -> select the matching generation and commit it:"
      say "      cd $MAC_REPO/guests/monad && ./use-gen            # lists generations and their formats"
      die "witness format mismatch — refusing to start the prover on a guest that cannot read these witnesses."
    else
      say "match: both '$prod_fmt' — the guest can read what the producer emits"
    fi
  fi
fi

if [ "$PROVE_REAL" = 1 ]; then
  step "Starting the prover (REAL ZisK cluster on $PROVER_WHERE, ${PROVE_GPUS} GPU)"
else
  step "Starting the prover (mock on $PROVER_WHERE, transfers real)"
fi
# ALWAYS restarted, never "already running". A live session carries the environment and the code it was
# started with: after a git pull or a config change, leaving it alone means the new behaviour is deployed but
# not running — which is exactly how PULL_VIA sat unused for a full session while the logs looked healthy.
# prove-farm holds no state (it re-reads the queue every interval), so a restart costs at most one in-flight
# block. Silently keeping a stale process costs a whole measurement run.
#
# --no-prefetch: EXACTLY ONE transfer per block on this link, which is the invariant every attempt at
# overlapping transport violated. Two bulk streams on one 25 Mbit/s link took inputs to 24-34 s
# (size-independent) while `backlog` climbed 14 -> 31.
#
# And overlapping cannot pay here anyway. The prover is busy prove/slot ~= 7.5/12 ~= 62 % of the time, so a
# pre-transfer only has a window when the witness happens to arrive mid-proof, and the transfer must also fit
# in what is left of it: 62 % x ~55 % ~= 34 %. Measured 33-35 % for the farm's prefetcher AND for a shipper
# in the tap — two different implementations hitting the same arithmetic ceiling, because the ceiling is not
# in either of them. The lever that works is making the transfer itself cheaper (scp -O in prove_remote),
# which helps every block instead of a third of them.
# The mode's whole footprint on the command line, built in ONE place. Everything else — the transfer channel,
# the manifest, the submission path, the queue policy — is identical between the two, which is the point: the
# mock rehearsed the real thing, so switching should touch the prover flags and nothing else.
if [ "$PROVE_REAL" = 1 ]; then
  # No --mock: prove-farm then calls `infra/zisk-infra/run prove-cluster`, which resolves the guest's ELF and
  # witness and hands them to prove_remote → the coordinator. --num-gpus only records the GPU count in the
  # report and in the cluster label.
  PROVE_MODE_FLAGS="--num-gpus $PROVE_GPUS"
else
  PROVE_MODE_FLAGS="--mock --mock-secs $MOCK_SECS --mock-per-mstep $MOCK_PER_MSTEP --mock-speed $MOCK_SPEED --mock-jitter $MOCK_JITTER"
fi
# RECORDED, then launched FROM the recording — one string, so the file and what runs cannot drift. This is what
# lets rtp-watchdog restart the prover on its own: it replays this file instead of rebuilding an invocation from
# memory, which is exactly the mistake that produced 1789 proofs nobody submitted. Anything that reconstructs
# this command by hand will eventually drop a flag, and the flags that go missing are the silent ones.
# PROVER_LOG_FILES is a pass-through, and it has to be one: it is set on the BOX, read by core.sh on the box,
# and its effect happens on the PROVER — so an operator setting it here would otherwise see it vanish. Empty by
# default; when set, each named log's tail rides back inside the artifact tarball that already crosses.
prove_cmd="cd $BOX_REPO && ${BOX_ELF:+ELF=$BOX_ELF }REMOTE_WS=$PROVER_WS REMOTE_RUNNER=$RUNNER_DIR/zisk-runner \
${PROVER_LOG_FILES:+PROVER_LOG_FILES='$PROVER_LOG_FILES' }${PROVER_LOG_TAIL:+PROVER_LOG_TAIL=$PROVER_LOG_TAIL }\
${PULL_VIA:+PULL_VIA=$PULL_VIA }WITNESS_PUMP=$RUNNER_DIR/witness-pump PUMP_SOCK=$PUMP_SOCK \
REMOTE_SUBMIT=$RUNNER_DIR/ethproofs-submit WITNESS_MANIFEST=\$HOME/witness-manifest.csv \
cli/prove-farm --guest monad-zisk $PROVE_MODE_FLAGS --remote $PROVER_TARGET --port $PROVER_PORT \
--interval 1 --watch --newest-first --no-prefetch --ethproofs-url $EP_URL${EP_TOKEN:+ --ethproofs-token $EP_TOKEN} \
--ethproofs-cluster $EP_CLUSTER --rpc $RPC 2>&1 | tee -a $PROVE_LOG"
onbox "cat > \$HOME/.rtp-prove-cmd <<'RTPEOF'
$prove_cmd
RTPEOF
chmod 600 \$HOME/.rtp-prove-cmd; echo '   · invocation recorded in ~/.rtp-prove-cmd (rtp-watchdog replays it)'"
onbox "tmux kill-session -t prove 2>/dev/null && echo '   · restarting prove (a live session would keep the old code and env)'; tmux new-session -d -s prove \"\$(cat \$HOME/.rtp-prove-cmd)\""

[ "$CRON" = 1 ] && { step "Installing the daily log archiver on the box"
  onbox "(crontab -l 2>/dev/null | grep -v archive-logs; echo '17 4 * * * \$HOME/zkvm-bench/infra/monad-witness/archive-logs >> \$HOME/archive-logs.log 2>&1') | crontab - && crontab -l | tail -1"; }

# ── 7. where to look ───────────────────────────────────────────────────────────────────────────────
step "Up. What to watch"
cat <<EOF
   on $BOX:
     tail -2 ~/witness-tap.log            lag (2-3 blocks) · raw (0-1) · unproved (must not climb)
     tail -6 $PROVE_LOG             per block: prove=X wall=Z  ->  Z-X IS the transport
     cd \$HOME/zkvm-bench && profiling/rtp-latency.py --manifest ~/witness-manifest.csv \\
        --results infra/zisk-infra/results --guest monad-zisk | tail -15
EOF
if [ "$PROVE_REAL" = 1 ]; then
  # The prover is the GPU box, so its own logs are there, not here. And the FIRST number to read is the one
  # nothing in this repo has ever had: a measured proving time for this guest.
  cat <<EOF
   on $PROVER_TARGET (the prover):
     tail -f <where start.sh ran>/logs/worker.log
                                          phases: EXECUTE · CALCULATING_CONTRIBUTIONS · GENERATING_INNER_PROOFS
     cat $PROVER_WS/reports/\$(ls -t $PROVER_WS/reports 2>/dev/null | grep '\.log\$' | head -1)
                                          the per-block prove log
     nvidia-smi                           the GPU must actually be busy during a proof
   on this Mac:
     open ${EP_URL#http*://}              leaderboard; a REAL proof must read ✓ (⊘ means a mock slipped in)
     tail -f ~/tunnel.log                 link drops and retries

   FIRST THING TO DO once a few blocks have landed — the number that does not exist yet:
     grep -o 'prove=[0-9.]*' $PROVE_LOG | tail -20
   Projected was $(awk -v f="$MOCK_SECS" -v p="$MOCK_PER_MSTEP" -v g="$PROVE_GPUS" -v mn="$GUEST_MS_MEAN" 'BEGIN{printf "%.0f", f+p*16/g*mn}') s on the mean block ($PROVE_GPUS GPU). If the real figure differs, the
   cadence derived above is wrong: re-derive PROVE_EVERY from it, and record it in AGENT-NOTES.md.
   tear down:  $0 --stop
EOF
else
  cat <<EOF
   on this Mac:
     cat $PROVER_WS/reports/\$(ls -t $PROVER_WS/reports | grep '\.log\$' | head -1)
                                          Steps: <9 digits> · model - emulation -> sleep
     open http://127.0.0.1:$MOCK_PORT     leaderboard; a mock proof must read ⊘, never ✗
     tail -f ~/tunnel.log                 link drops and retries
   tear down:  $0 --stop
EOF
fi
