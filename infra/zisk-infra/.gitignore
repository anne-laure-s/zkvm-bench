# Rust build
target/

# Guest artifacts live in ../../guests/ — witnesses are transient here
*.bin
*.hints

# All run outputs / proofs / fetched records — unified here (regenerated)
/results/

# cluster: on-box process state (box checkout only)
cluster/run/
cluster/logs/
cluster/runs/

# The box-check corpora: ~155 MB across three directories, rebuilt on the box by each test's own
# prepare-inputs.sh, and dropped from the wire by cluster/ship.sh. Their scripts, READMEs and
# steps-*.csv ARE tracked — the measurement is the result, the witnesses are not.
cluster/tests/*/inputs/
cluster/tests/*/inputs-*/

# Python / OS
__pycache__/
.DS_Store
