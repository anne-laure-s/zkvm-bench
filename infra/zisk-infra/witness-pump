#!/usr/bin/env python3
"""witness-pump — one long-lived connection that streams witnesses, instead of one connection per block.

WHY THIS EXISTS. A witness pull costs ~4.1 s for a ~10 MB file, of which roughly 2 s is connection setup:
TCP, the SSH banner exchange, an ephemeral key exchange and authentication — ~15 round trips on a link whose
RTT is 90-135 ms. Phase-timed with `scp -vv`: authenticated at 0.93 s, first file byte after that. Every block
pays it again because every block spawns a new `scp`, and SSH re-does the key exchange per connection on
purpose (forward secrecy).

Measured on the real link, byte-verified, 3 witnesses of ~10 MB per round, interleaved:

| one connection PER file | 12.30 s median | 4.10 s/witness | 19.5 Mbit/s |
| ONE connection for all three | 8.19 s median | 2.73 s/witness | **29.3 Mbit/s** |

**+1.37 s per witness, +33 %.** The number that makes it credible rather than another artefact: the single
connection reaches 29.3 Mbit/s, which IS this link's measured rate (25-29 Mbit/s on incompressible data). The
per-file variant is stuck at 19.5 because two thirds of the way through every transfer it stops and re-handshakes.

WHY NOT ControlMaster, WHICH ALREADY DOES THIS. Because it does not, for bulk. With `ControlMaster` the
transfer runs in a SEPARATE process that talks to the master over a Unix socket, and the master relays every
byte — an extra userspace hop on the whole payload. Measured twice: it saves ~0.9 s of handshake on a 1 KB
payload (which is why `retrieve` uses it and gains 1.1 s) and gives all of it back on a multi-MB stream
(3.63 s fresh vs 3.93 s warm; and 3.12 vs 4.43 s/file with `scp -O`). Here the long-lived `ssh` IS the data
path — one process, no relay — which is the whole difference.

DIRECTION. The prover is behind NAT and the box is not, so only the prover can open the connection; that is
already why `PULL_VIA` exists. So the durable process lives on the PROVER, and `prove_remote` (on the box) asks
it for a block over the short control connection it already holds.

  prover:  witness-pump serve            long-lived: holds `ssh box … witness-pump send`
  box:     witness-pump send             reads a path per line, writes LE64(len) + bytes
  prover:  witness-pump get SRC DST      what prove_remote calls; returns 0 on success
  prover:  witness-pump put SRC DEST     push artifacts UP the same channel, so they skip the tunnel

ONE TRANSFER AT A TIME, deliberately. Requests are served serially. Two concurrent bulk streams on this link
is the failure mode that took inputs from 4 s to 24-34 s while the queue grew. A serial
pump cannot reproduce it.

FAILURE IS SLOW, NEVER FATAL. Anything that goes wrong — pump not running, socket stale, ssh dead, short read —
makes `get` exit non-zero, and prove_remote falls back to its own `scp`. That is the pre-pump behaviour, so the
worst case is the old speed, not a stopped pipeline. The destination is written to `<dst>.part` and renamed only
on a complete, length-checked read: a truncated transfer must never leave a file that prove_remote's
name-and-size check would accept as a valid input.

  PUMP_SOCK=~/.zisk-witness-pump.sock   PUMP_BOX=<ssh target of the box, as the PROVER sees it>
  PUMP_SSH_OPTS="-C -o BatchMode=yes"   PUMP_TIMEOUT=120 (seconds for one transfer)
  PUMP_REMOTE_CMD=<path to this file on the box>
"""
import os, socket, struct, subprocess, sys, threading, time

SOCK    = os.path.expanduser(os.environ.get("PUMP_SOCK") or "~/.zisk-witness-pump.sock")
BOX     = os.environ.get("PUMP_BOX") or ""
SSHOPTS = (os.environ.get("PUMP_SSH_OPTS") or "-C -o BatchMode=yes").split()
# The shell exec-host runs a relayed command with. bash when it exists, because that is what the commands are
# written for; PUMP_SHELL overrides for a box that keeps bash somewhere else.
EXEC_SHELL = os.environ.get("PUMP_SHELL") or next(
    (sh for sh in ("/bin/bash", "/usr/bin/bash") if os.path.exists(sh)), None)
TIMEOUT = float(os.environ.get("PUMP_TIMEOUT") or 120)
# Parallel channels for ONE witness. 1 = the single-channel path. netprofile measures the right value per
# network and records it; rtp-up passes it. See Pool for why this exists again after being removed once.
CHANNELS = max(1, int(os.environ.get("PUMP_CHANNELS") or 1))
# Where this same script lives ON THE BOX. Overridable so the pump can be exercised against a staged copy
# before the repo carries it, and so a non-default clone path does not require editing the source.
REMOTE_CMD = os.environ.get("PUMP_REMOTE_CMD") or "zkvm-bench/infra/zisk-infra/witness-pump"
HDR     = struct.Struct("<q")          # LE64 length; negative = the sender could not read the file


def log(msg):
    print(f"{time.strftime('%H:%M:%S')} witness-pump: {msg}", flush=True)


# ── box side ────────────────────────────────────────────────────────────────────────────────────────
def mode_send():
    """Serve requests on stdin, framed replies on stdout.

      <path>                     GET: reply LE64(size) + size bytes  (LE64(-1) if unreadable)
      PUT\\t<dest>\\t<length>      the body follows on stdin; reply LE64(0) ok / LE64(-1) failed

    A negative length keeps the stream usable instead of dying: a pruned witness is routine here (retention
    deletes a framed input once its proof is in hand), and tearing the channel for it would cost a reconnect.

    REQUESTS ARE READ FROM THE BINARY STREAM, one readline at a time — never `for line in sys.stdin`. The text
    wrapper reads ahead, so a PUT body would be partly swallowed into its buffer and the file written short. A
    protocol that carries binary bodies cannot share a stream with a buffering text iterator."""
    inp, out = sys.stdin.buffer, sys.stdout.buffer
    while True:
        raw = inp.readline()
        if not raw:
            return 0
        req = raw.decode(errors="replace").rstrip("\n")
        if not req:
            continue
        try:
            if req.startswith("PUT\t"):
                _, dest, length = req.split("\t", 2)
                need = int(length)
                os.makedirs(os.path.dirname(dest) or ".", exist_ok=True)
                # Straight to <dest>.part, renamed only once every byte declared has arrived: the box must never
                # see a half-written artifact under its real name, same rule as the input side.
                part = dest + ".part"
                got = 0
                with open(part, "wb") as f:
                    while got < need:
                        b = inp.read(min(1 << 20, need - got))
                        if not b:
                            raise ConnectionError("body truncated")
                        f.write(b); got += len(b)
                os.replace(part, dest)
                out.write(HDR.pack(0))
            elif req.startswith("GET\t"):
                # A byte RANGE, so N channels can each carry a slice of one witness. `seek`, never
                # `tail -c +N | head -c` — that was measured and it charges box-side pipe work to the network.
                _, path, off, ln = req.split("\t", 3)
                off, ln = int(off), int(ln)
                with open(path, "rb") as f:
                    f.seek(off)
                    out.write(HDR.pack(ln))
                    left = ln
                    while left:
                        chunk = f.read(min(1 << 20, left))
                        if not chunk:
                            break                       # file shrank: the reader times out on a short body
                        out.write(chunk); left -= len(chunk)
            elif req.startswith("SHARE\t"):
                # ONE CHANNEL'S SHARE, SPLIT BY THE BOX. The caller used to ask SIZE first and then N
                # ranges: two round trips before the first byte, 170 ms of the 538 ms fixed cost on an
                # 85 ms link. Here the box owns the arithmetic and states it in the reply — total size,
                # this share's offset, this share's length — so N requests can go out at once with
                # nothing known in advance, and the two sides cannot disagree about the split.
                # An older box has no such verb: `getsize` on the whole request line raises, the handler
                # answers LE64(-1) and the channel survives, which is what the caller falls back on.
                _, path, i, n = req.split("\t", 3)
                i, n = int(i), int(n)
                size = os.path.getsize(path)
                step = size // n
                off = i * step
                ln = (size - off) if i == n - 1 else step
                with open(path, "rb") as f:
                    f.seek(off)
                    out.write(HDR.pack(size))
                    out.write(HDR.pack(off))
                    out.write(HDR.pack(ln))
                    left = ln
                    while left:
                        chunk = f.read(min(1 << 20, left))
                        if not chunk:
                            break               # file shrank: the reader times out on a short body
                        out.write(chunk); left -= len(chunk)
            elif req.startswith("SIZE\t"):
                out.write(HDR.pack(os.path.getsize(req.split("\t", 1)[1])))
            else:
                path = req
                size = os.path.getsize(path)
                with open(path, "rb") as f:
                    out.write(HDR.pack(size))
                    sent = 0
                    while sent < size:
                        chunk = f.read(1 << 20)
                        if not chunk:                   # file shrank under us: the reader will time out
                            break                       # rather than be handed a short body silently
                        out.write(chunk)
                        sent += len(chunk)
            out.flush()
        except Exception:                               # noqa: BLE001 — never die on one bad request
            try:
                os.unlink(part)                         # noqa: F821 — only bound on the PUT path
            except (OSError, NameError, UnboundLocalError):
                pass
            out.write(HDR.pack(-1))
            out.flush()


# ── prover side: the long-lived pump ────────────────────────────────────────────────────────────────
class Channel:
    """The persistent ssh to the box. Reconnects lazily, so an outage costs one failed request."""

    def __init__(self, idx=0):
        self.idx = idx
        self.p = None
        self.lock = threading.Lock()

    def alive(self):
        return self.p is not None and self.p.poll() is None

    def connect(self):
        if self.alive():
            return True
        if not BOX:
            log("PUMP_BOX is not set — nothing to connect to")
            return False
        # `exec` so the remote shell does not sit between us and the sender, holding a pipe buffer.
        cmd = ["ssh", *SSHOPTS, BOX, f"exec {REMOTE_CMD} send"]
        try:
            self.p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                      stderr=subprocess.DEVNULL, bufsize=0)
            log(f"channel open to {BOX}")
            return True
        except OSError as e:
            log(f"cannot start the channel: {e}")
            self.p = None
            return False

    def close(self):
        if self.p is not None:
            try:
                self.p.stdin.close()
                self.p.kill()
            except OSError:
                pass
            self.p = None

    def _readn(self, n, deadline):
        """Read exactly n bytes or raise. A short read means the channel is broken, not that the file ended:
        the length came from the sender, so anything less is a torn stream and must not be renamed into place."""
        buf = bytearray()
        while len(buf) < n:
            if time.time() > deadline:
                raise TimeoutError(f"timed out with {len(buf)}/{n} bytes")
            chunk = self.p.stdout.read(min(1 << 20, n - len(buf)))
            if not chunk:
                raise ConnectionError(f"channel closed with {len(buf)}/{n} bytes")
            buf += chunk
        return bytes(buf)

    def push(self, src, dest):
        """Send a local file UP the channel to `dest` on the box. Returns the byte count; raises on failure.

        WHY THIS DIRECTION EXISTS. The artifacts (proof, report, log, public values) are written on the prover and
        the box needs them. They used to ride the box->prover ssh's stdout as a tar — which means back through the
        REVERSE TUNNEL, at the 3.8 Mbit/s that TCP-in-TCP gives, against 25 direct. Invisible while the mock
        proof was 480 bytes (~1 ms); with a realistically sized 381 KB proof that return leg is **0.82 s**.
        The pump already holds a direct prover->box connection, so pushing costs no new handshake — only the ack.

        ONE push of one tarball, not four of one file each. Each PUT costs an ack round trip (~0.1-0.2 s at this
        RTT), so four artifacts pushed separately would spend more on acks than the tunnel spent on bytes."""
        if not self.connect():
            raise ConnectionError("no channel")
        deadline = time.time() + TIMEOUT
        size = os.path.getsize(src)
        self.p.stdin.write(f"PUT\t{dest}\t{size}\n".encode())
        with open(src, "rb") as f:
            left = size
            while left:
                b = f.read(1 << 20)
                if not b:
                    raise ConnectionError(f"local read short with {left} bytes to go")
                self.p.stdin.write(b); left -= len(b)
        self.p.stdin.flush()
        (rc,) = HDR.unpack(self._readn(HDR.size, deadline))
        if rc != 0:
            raise ConnectionError(f"the box refused the push to {dest}")
        return size

    def size_of(self, src):
        deadline = time.time() + TIMEOUT
        if not self.connect():
            raise ConnectionError("no channel")
        self.p.stdin.write(f"SIZE\t{src}\n".encode()); self.p.stdin.flush()
        (n,) = HDR.unpack(self._readn(HDR.size, deadline))
        if n < 0:
            raise FileNotFoundError(src)
        return n

    def range_into(self, src, off, ln, part):
        """Fetch [off, off+ln) and write it at that offset in `part`. Own fd, own seek — no shared position,
        no lock. Measured: N threads writing one preallocated file this way costs 0.5 ms for 8 MB and is flat
        in N, so the write path is not why an earlier version of this showed no gain."""
        deadline = time.time() + TIMEOUT
        if not self.connect():
            raise ConnectionError(f"channel {self.idx}: no connection")
        self.p.stdin.write(f"GET\t{src}\t{off}\t{ln}\n".encode()); self.p.stdin.flush()
        (declared,) = HDR.unpack(self._readn(HDR.size, deadline))
        if declared < 0:
            raise FileNotFoundError(src)
        if declared != ln:
            raise ConnectionError(f"asked {ln} bytes at {off}, sender declared {declared}")
        with open(part, "r+b") as f:
            f.seek(off)
            left = ln
            while left:
                b = self._readn(min(1 << 20, left), deadline)
                f.write(b); left -= len(b)

    def share_into(self, src, i, n, part, on_size):
        """This channel's share of `src`, split N ways by the box. Returns the share's length, or None if
        the box does not know the verb — the caller then uses the SIZE + GET path.

        No size is needed to send this: that is the whole point. The reply opens with the total size, so
        the first worker to read a header preallocates the file and releases the others."""
        deadline = time.time() + TIMEOUT
        if not self.connect():
            raise ConnectionError(f"channel {self.idx}: no connection")
        self.p.stdin.write(f"SHARE\t{src}\t{i}\t{n}\n".encode()); self.p.stdin.flush()
        (size,) = HDR.unpack(self._readn(HDR.size, deadline))
        if size < 0:
            # Unreadable file, or a box that predates SHARE. Tell the others so none of them waits for a
            # preallocation that will never come.
            on_size(None)
            return None
        (off,) = HDR.unpack(self._readn(HDR.size, deadline))
        (ln,) = HDR.unpack(self._readn(HDR.size, deadline))
        # on_size both preallocates (once) and holds every worker until that is done, so no one truncates a
        # file another is already writing into. False means the transfer is dead.
        if not on_size(size):
            return None
        with open(part, "r+b") as f:
            f.seek(off)
            left = ln
            while left:
                b = self._readn(min(1 << 20, left), deadline)
                f.write(b); left -= len(b)
        return ln

    def fetch(self, src, dst):
        """Whole file over this one channel — the single-channel path, unchanged."""
        if not self.connect():
            raise ConnectionError("no channel")
        deadline = time.time() + TIMEOUT
        self.p.stdin.write((src + "\n").encode())
        self.p.stdin.flush()
        (size,) = HDR.unpack(self._readn(HDR.size, deadline))
        if size < 0:
            raise FileNotFoundError(f"the box could not read {src}")
        part = dst + ".part"
        os.makedirs(os.path.dirname(dst) or ".", exist_ok=True)
        got = 0
        with open(part, "wb") as f:
            while got < size:
                chunk = self._readn(min(1 << 20, size - got), deadline)
                f.write(chunk)
                got += len(chunk)
        os.replace(part, dst)          # atomic: no half-written input is ever visible under its real name
        return size


class Pool:
    """N persistent channels, and one witness split across them.

    WHY N > 1 IS BACK. It was built, measured worthless, and removed — on a link where four parallel streams
    aggregated 38 Mbit/s and that 38 WAS the ceiling, because the prover sat on 802.11n / 2.4 GHz sharing a
    channel with nine networks. There was nothing to win, and real witnesses confirmed it: equal medians.
    The prover then moved to 802.11ac / 5 GHz / 80 MHz on an empty channel, and the numbers changed shape:

      one stream 36.6 Mbit/s · four streams 78.5 Mbit/s aggregate · RTT 85 ms
      and one stream reaches 47-62 Mbit/s on a 20 MB transfer but only 32-37 on 8 MB

    That gap is slow-start, and a witness is 2-16 MB — squarely inside it. So N windows ramping at once now have
    headroom that did not exist before. `infra/monad-witness/netprofile` is what measures and remembers this per
    network, precisely so the decision is not carried across a move again.

    STILL ONE WITNESS AT A TIME. N channels serve ONE request; requests are serialised by mode_serve. Two
    different blocks in flight is the failure mode that took inputs to 24-34 s while the queue grew."""

    def __init__(self, n):
        self.chs = [Channel(i) for i in range(max(1, n))]

    def connect_all(self):
        return sum(1 for c in self.chs if c.connect())

    def close_all(self):
        for c in self.chs:
            c.close()

    def _fetch_shared(self, src, dst):
        """N shares in flight with NOTHING known in advance — no SIZE round trip. Returns the byte count,
        or None if the box has no SHARE verb (nothing is written in that case).

        This is the 85 ms the old path spent asking for a size before it could divide it: the box divides,
        and says so in each reply. The arithmetic exists in one place now, which also means the two sides
        cannot drift into splitting the same file differently."""
        n = len(self.chs)
        part = dst + ".part"
        os.makedirs(os.path.dirname(dst) or ".", exist_ok=True)
        with open(part, "wb"):
            pass
        ready = threading.Event()
        lock = threading.Lock()
        state = {"size": 0, "dead": False}

        def on_size(size):
            with lock:
                if size is None:
                    state["dead"] = True
                    ready.set()
                    return False
                if not ready.is_set():
                    with open(part, "r+b") as f:
                        f.truncate(size)                      # sized once, so every worker can seek freely
                    state["size"] = size
                    ready.set()
            if not ready.wait(TIMEOUT):                       # outside the lock: waiting under it deadlocks
                return False
            return not state["dead"]

        errs, done, unknown = [], [0] * n, []

        def work(i, ch):
            try:
                with ch.lock:
                    r = ch.share_into(src, i, n, part, on_size)
                if r is None:
                    unknown.append(ch.idx)
                else:
                    done[i] = r
            except Exception as e:                            # noqa: BLE001 — every failure is a fallback
                errs.append(f"ch{ch.idx}: {e}")
                ch.close()                                    # a torn stream would mis-frame later requests
                on_size(None)                                 # never leave a sibling waiting on this one

        ts = [threading.Thread(target=work, args=(i, self.chs[i]), daemon=True) for i in range(n)]
        for t in ts:
            t.start()
        for t in ts:
            t.join(TIMEOUT + 10)
        if unknown and not errs:
            try:
                os.unlink(part)
            except OSError:
                pass
            return None
        if errs or not state["size"] or sum(done) != state["size"]:
            try:
                os.unlink(part)
            except OSError:
                pass
            raise ConnectionError(
                "share fetch failed: " + ("; ".join(errs) if errs
                                          else f"short body ({sum(done)} of {state['size']} B)"))
        os.replace(part, dst)
        return state["size"]

    def fetch(self, src, dst):
        if len(self.chs) == 1:
            return self.chs[0].fetch(src, dst)
        if not getattr(self, "no_share", False):
            got = self._fetch_shared(src, dst)
            if got is not None:
                return got
            # Only an old box answers that way, and it will answer that way every time: ask once, then stop.
            self.no_share = True
            log("the box has no SHARE verb — falling back to SIZE+GET, one extra round trip per witness")
        size = self.chs[0].size_of(src)
        if size <= 0:
            raise FileNotFoundError(src)
        n = len(self.chs)
        step = size // n
        ranges = [(i * step, step if i < n - 1 else size - i * step) for i in range(n)]
        ranges = [(o, l) for o, l in ranges if l > 0]        # a tiny file needs fewer channels than N
        part = dst + ".part"
        os.makedirs(os.path.dirname(dst) or ".", exist_ok=True)
        with open(part, "wb") as f:
            f.truncate(size)                                 # size it once so every worker can seek freely
        errs, done = [], [0] * len(ranges)

        def work(k, ch, off, ln):
            try:
                with ch.lock:
                    ch.range_into(src, off, ln, part)
                done[k] = ln
            except Exception as e:                           # noqa: BLE001 — every failure is a fallback
                errs.append(f"ch{ch.idx}: {e}")
                ch.close()                                   # a torn stream would mis-frame later requests
        ts = [threading.Thread(target=work, args=(k, self.chs[k], o, l), daemon=True)
              for k, (o, l) in enumerate(ranges)]
        for t in ts:
            t.start()
        for t in ts:
            t.join(TIMEOUT + 10)
        if errs or sum(done) != size:
            try:
                os.unlink(part)
            except OSError:
                pass
            raise ConnectionError("; ".join(errs) or f"reassembled {sum(done)}/{size} bytes")
        os.replace(part, dst)      # all-or-nothing: a partial reassembly never appears under the real name
        return size


def mode_serve():
    # A unix socket path is capped at ~104 bytes on macOS (108 on Linux), and the failure is a bare
    # `OSError: AF_UNIX path too long` that says nothing about which path or why. The prover here is a Mac,
    # so say it plainly — this is the same limit that bit the ssh ControlPath in prove_remote.
    if len(SOCK.encode()) > 100:
        log(f"PUMP_SOCK is too long for a unix socket ({len(SOCK)} bytes, limit ~104): {SOCK}")
        log("  pick something short, e.g. PUMP_SOCK=/tmp/zisk-pump.sock")
        return 1
    if os.path.exists(SOCK):
        os.unlink(SOCK)                                  # a stale socket from a killed pump
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    srv.listen(8)
    pool = Pool(CHANNELS)
    log(f"serving on {SOCK} (box={BOX or '<unset>'}, channels={CHANNELS}, timeout={TIMEOUT:g}s)")
    log(f"channels open: {pool.connect_all()}/{CHANNELS}")                                          # fail loudly at startup, not on the first block
    try:
        while True:
            conn, _ = srv.accept()
            with conn:
                try:
                    req = conn.makefile("r").readline().strip()
                    op = "get"
                    if req.startswith("put\t"):
                        op = "put"; req = req[4:]
                    src, _, dst = req.partition("\t")
                    if not src or not dst:
                        conn.sendall(b"ERR malformed request\n")
                        continue
                    t0 = time.time()
                    try:
                        n = pool.chs[0].push(src, dst) if op == "put" else pool.fetch(src, dst)
                    except FileNotFoundError as e:
                        # The box could not read it, and said so with a clean negative length — the stream is
                        # still correctly framed, so KEEP the channel. This is a routine case, not a fault:
                        # retention deletes a framed input once its proof is in hand, so the pump will be
                        # asked for pruned blocks in normal operation. Tearing the channel each time would
                        # spend ~2 s reconnecting for nothing.
                        log(f"absent: {os.path.basename(src)} — the prover will scp it instead")
                        conn.sendall(f"ERR {e}\n".encode())
                        continue
                    except Exception as e:
                        # Any TRANSPORT error, though, must drop the channel: a torn stream leaves unread
                        # bytes in the pipe, and the next request would read THOSE as its length. Reconnecting
                        # is cheap (~2 s, once); mis-framing every later transfer is not recoverable.
                        pool.close_all()
                        log(f"FAILED {os.path.basename(src)}: {e} — the prover will scp it instead")
                        conn.sendall(f"ERR {e}\n".encode())
                        continue
                    dt = max(time.time() - t0, 1e-6)
                    log(f"{'pushed' if op == 'put' else 'streamed'} {os.path.basename(src)} "
                        f"{n/1048576:.1f} MB in {dt:.2f}s ({n*8/dt/1e6:.1f} Mbit/s)")
                    conn.sendall(f"OK {n}\n".encode())
                except OSError as e:
                    log(f"client error: {e}")
    except KeyboardInterrupt:
        pass
    finally:
        pool.close_all()
        try:
            os.unlink(SOCK)
        except OSError:
            pass
    return 0


# ── prover side: the one-shot clients ───────────────────────────────────────────────────────────────
def _ask(line):
    """One request to the local pump. 0 on OK, 1 on anything else — the caller's fallback does the rest."""
    try:
        c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        c.settimeout(TIMEOUT + 10)
        c.connect(SOCK)
    except OSError as e:
        print(f"witness-pump: no pump at {SOCK} ({e})", file=sys.stderr)
        return 1
    with c:
        c.sendall(line.encode())
        reply = c.makefile("r").readline().strip()
    if reply.startswith("OK "):
        return 0
    print(f"witness-pump: {reply or 'no reply'}", file=sys.stderr)
    return 1


def mode_get(src, dst):
    """Pull SRC on the box down to DST here. What prove_remote asks for on the workspace round trip."""
    return _ask(f"{src}\t{dst}\n")


def mode_put(src, dest):
    """Push SRC here up to DEST on the box, over the channel the pump already holds. Called by the prover at the
    end of a run so the artifacts never ride the reverse tunnel — 0.82 s of a 381 KB proof at the tunnel's
    3.8 Mbit/s, against ~0.13 s direct plus one ack."""
    return _ask(f"put\t{src}\t{dest}\n")



# ── the reverse channel: the BOX issues, the PROVER executes ────────────────────────────────────────
# Same connection shape as everything above — the prover dials, so no key is needed on the box — but the roles
# on this one are reversed. An ssh is bidirectional: the box-side agent WRITES commands to its stdout, which is
# the prover's stdin, and reads the answer back. So the box keeps driving and keeps its own clock; it simply
# stops spawning a connection per block.
#
#   prover:  witness-pump exec-host        long-lived: holds `ssh box … witness-pump exec-agent`
#   box:     witness-pump exec-agent       listens on a box-local socket, relays to the prover
#   box:     witness-pump run '<cmd>'      what prove_remote calls INSTEAD of ssh — same contract
#
# `run` is a drop-in for `ssh host CMD`: stdout is stdout, stderr is stderr, the exit status is the command's.
# That is what lets core.sh change one array and nothing else.
#
# FRAMED, because stdout carries a tar and stderr carries a live log, on one pipe. Each frame is
# tag(1) + LE32(len) + bytes, tag in {C,O,E,X}: Command, Out, Err, eXit. Without framing the tar and the log
# would interleave into an unparseable stream — the same rule the data path already follows.
FRM = struct.Struct("<cI")


def _send_frame(f, tag, payload=b""):
    f.write(FRM.pack(tag, len(payload)))
    if payload:
        f.write(payload)
    f.flush()


def _read_frame(f):
    head = f.read(FRM.size)
    if not head or len(head) < FRM.size:
        return None, b""
    tag, n = FRM.unpack(head)
    buf = b""
    while len(buf) < n:
        c = f.read(n - len(buf))
        if not c:
            break
        buf += c
    return tag, buf


def mode_exec_host():
    """PROVER side. Dials the box, then executes whatever the box asks and streams the result back.

    This runs arbitrary shell from the box, which is only acceptable because the box is the side that already
    decides everything about a run — it is the same trust as the ssh it replaces, not a new one, and it is the
    reason this channel is separate from the data one: the data channel answers requests, it does not obey."""
    if not BOX:
        print("witness-pump: PUMP_BOX is required for exec-host", file=sys.stderr)
        return 2
    cmd = ["ssh", *SSHOPTS, BOX, REMOTE_CMD, "exec-agent"]
    while True:
        p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, bufsize=0)
        log("exec channel open to " + BOX)
        try:
            while True:
                tag, payload = _read_frame(p.stdout)
                if tag is None:
                    break
                if tag != b"C":
                    continue
                # Streamed, not collected: the runner's log has to appear on the box WHILE the proof runs,
                # which is how a hung prover stays visible. Collecting it would give that up.
                # BASH, EXPLICITLY. shell=True means /bin/sh, which is dash on Debian/Ubuntu — and every
                # payload that crosses this channel is a bash script written for `ssh host "cmd"`, where the
                # login shell runs it. The difference is not academic: core.sh opens with `set -o pipefail`,
                # dash rejects it as an illegal option, and the prove dies in 2 s with `no-report no-proof`
                # on every block — a channel that "works" and fails everything, which is the one failure mode
                # this pump is supposed to make impossible.
                r = subprocess.Popen(payload.decode(), shell=True, executable=EXEC_SHELL,
                                     stdout=subprocess.PIPE, stderr=subprocess.PIPE, bufsize=0)
                def pump_stream(src, tag_):
                    while True:
                        b = src.read(1 << 16)
                        if not b:
                            return
                        with lock:
                            _send_frame(p.stdin, tag_, b)
                lock = threading.Lock()
                ts = [threading.Thread(target=pump_stream, args=(r.stdout, b"O"), daemon=True),
                      threading.Thread(target=pump_stream, args=(r.stderr, b"E"), daemon=True)]
                for t in ts:
                    t.start()
                rc = r.wait()
                for t in ts:
                    t.join(5)
                with lock:
                    _send_frame(p.stdin, b"X", str(rc).encode())
        except Exception as e:                                  # noqa: BLE001 — never die on one bad command
            log(f"exec channel: {e}")
        finally:
            try:
                p.kill()
            except OSError:
                pass
        log("exec channel dropped — reconnecting in 5s")
        time.sleep(5)


def mode_exec_agent():
    """BOX side, running under the prover's ssh. Listens on a box-local socket and relays one command at a
    time to the prover, streaming the answer back to whoever asked."""
    sock = os.path.expanduser(os.environ.get("PUMP_EXEC_SOCK") or "~/.zisk-exec.sock")
    try:
        os.unlink(sock)
    except OSError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(sock)
    os.chmod(sock, 0o600)
    srv.listen(16)
    up, down = sys.stdout.buffer, sys.stdin.buffer
    while True:
        conn, _ = srv.accept()
        with conn:
            f = conn.makefile("rwb")
            # ONE upstream stream, shared by every caller in turn — so a command's frames MUST all be read
            # before the next caller is served. They are not correlated by any id: the answer is simply
            # whatever comes back next. That makes an abandoned reply poison, not litter.
            #
            # What used to happen: writing to a caller that had already gone (core.sh's $(...) closing early,
            # prove-farm retrying a second later) raised, the handler jumped to `except`, and the rest of that
            # command's frames stayed in the stream. The next caller read THEM. Measured on a live run: a
            # request for `set -o pipefail; echo up` came back with the output of an nvidia-smi, and core.sh's
            # workspace probe got someone else's stdout and reported `did not resolve` — every block, in one
            # second, for as long as the channel stayed up. Every reply after the first abandonment is wrong.
            #
            # So: once the command is upstream, drain to its X no matter what the caller does. A send failure
            # is ignored on purpose — the caller is gone, and the stream still has to be left clean.
            sent = False
            try:
                tag, cmd = _read_frame(f)
                if tag != b"C":
                    continue
                _send_frame(up, b"C", cmd)                      # up to the prover
                sent = True
                while True:
                    t2, body = _read_frame(down)                # back from the prover
                    if t2 is None:
                        sent = False                            # upstream is gone; nothing left to drain
                        try:
                            _send_frame(f, b"X", b"255")
                        except OSError:
                            pass
                        break
                    try:
                        _send_frame(f, t2, body)
                    except OSError:
                        pass                                    # caller gone: keep reading, do not abandon
                    if t2 == b"X":
                        sent = False
                        break
            except Exception:                                   # noqa: BLE001 — one caller must not stop the agent
                try:
                    _send_frame(f, b"X", b"255")
                except OSError:
                    pass
            finally:
                # THE RESYNC, before anything else. Reached when the read loop itself raised after the command
                # went up: the rest of that command's frames are still in the stream and belong to nobody.
                while sent:
                    t2, _body = _read_frame(down)
                    if t2 is None or t2 == b"X":
                        break
                try:
                    f.flush()
                except OSError:
                    pass


def mode_run(cmd):
    """BOX side. A drop-in for `ssh <prover> CMD`, over the permanent channel.

    Same contract as ssh so prove_remote changes one array: stdout to stdout, stderr to stderr, exit status of
    the remote command. Exit 255 is ssh's own "the connection failed" and is reused here, so an absent channel
    is indistinguishable from an unreachable host — which is what the caller's fallback already handles."""
    sock = os.path.expanduser(os.environ.get("PUMP_EXEC_SOCK") or "~/.zisk-exec.sock")
    try:
        c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        c.settimeout(None)
        c.connect(sock)
    except OSError as e:
        print(f"witness-pump: no exec channel at {sock} ({e})", file=sys.stderr)
        return 255
    with c:
        f = c.makefile("rwb")
        _send_frame(f, b"C", cmd.encode())
        while True:
            tag, body = _read_frame(f)
            if tag is None:
                return 255
            if tag == b"O":
                sys.stdout.buffer.write(body); sys.stdout.buffer.flush()
            elif tag == b"E":
                sys.stderr.buffer.write(body); sys.stderr.buffer.flush()
            elif tag == b"X":
                try:
                    return int(body)
                except ValueError:
                    return 255


def main(argv):
    if len(argv) < 2:
        print(__doc__.strip().splitlines()[0], file=sys.stderr)
        print("usage: witness-pump {send|serve|get SRC DST|put SRC DEST|"
              "exec-host|exec-agent|run CMD}", file=sys.stderr)
        return 2
    m = argv[1]
    if m == "send":
        return mode_send()
    if m == "serve":
        return mode_serve()
    if m == "get":
        if len(argv) != 4:
            print("usage: witness-pump get SRC DST", file=sys.stderr)
            return 2
        return mode_get(argv[2], argv[3])
    if m == "put":
        if len(argv) != 4:
            print("usage: witness-pump put SRC DEST_ON_BOX", file=sys.stderr)
            return 2
        return mode_put(argv[2], argv[3])
    if m == "exec-host":
        return mode_exec_host()
    if m == "exec-agent":
        return mode_exec_agent()
    if m == "run":
        if len(argv) != 3:
            print("usage: witness-pump run '<command>'", file=sys.stderr)
            return 2
        return mode_run(argv[2])
    print(f"unknown mode: {m}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
