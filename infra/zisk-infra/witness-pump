#!/usr/bin/env python3
"""witness-pump — one long-lived connection that streams witnesses, instead of one connection per block.

WHY THIS EXISTS. A witness pull costs ~4.1 s for a ~10 MB file, of which roughly 2 s is connection setup:
TCP, the SSH banner exchange, an ephemeral key exchange and authentication — ~15 round trips on a link whose
RTT is 90-135 ms. Phase-timed with `scp -vv`: authenticated at 0.93 s, first file byte after that. Every block
pays it again because every block spawns a new `scp`, and SSH re-does the key exchange per connection on
purpose (forward secrecy).

Measured on the real link, byte-verified, 3 witnesses of ~10 MB per round, interleaved:

| one connection PER file | 12.30 s median | 4.10 s/witness | 19.5 Mbit/s |
| ONE connection for all three | 8.19 s median | 2.73 s/witness | **29.3 Mbit/s** |

**+1.37 s per witness, +33 %.** The number that makes it credible rather than another artefact: the single
connection reaches 29.3 Mbit/s, which IS this link's measured rate (25-29 Mbit/s on incompressible data). The
per-file variant is stuck at 19.5 because two thirds of the way through every transfer it stops and re-handshakes.

WHY NOT ControlMaster, WHICH ALREADY DOES THIS. Because it does not, for bulk. With `ControlMaster` the
transfer runs in a SEPARATE process that talks to the master over a Unix socket, and the master relays every
byte — an extra userspace hop on the whole payload. Measured twice: it saves ~0.9 s of handshake on a 1 KB
payload (which is why `retrieve` uses it and gains 1.1 s) and gives all of it back on a multi-MB stream
(3.63 s fresh vs 3.93 s warm; and 3.12 vs 4.43 s/file with `scp -O`). Here the long-lived `ssh` IS the data
path — one process, no relay — which is the whole difference.

DIRECTION. The prover is behind NAT and the box is not, so only the prover can open the connection; that is
already why `PULL_VIA` exists. So the durable process lives on the PROVER, and `prove_remote` (on the box) asks
it for a block over the short control connection it already holds.

  prover:  witness-pump serve            long-lived: holds `ssh box … witness-pump send`
  box:     witness-pump send             reads a path per line, writes LE64(len) + bytes
  prover:  witness-pump get SRC DST      what prove_remote calls; returns 0 on success
  prover:  witness-pump put SRC DEST     push artifacts UP the same channel, so they skip the tunnel

ONE TRANSFER AT A TIME, deliberately. Requests are served serially. Two concurrent bulk streams on this link
is the failure mode that took inputs from 4 s to 24-34 s while the queue grew — see RTP-FINDINGS. A serial
pump cannot reproduce it.

FAILURE IS SLOW, NEVER FATAL. Anything that goes wrong — pump not running, socket stale, ssh dead, short read —
makes `get` exit non-zero, and prove_remote falls back to its own `scp`. That is the pre-pump behaviour, so the
worst case is the old speed, not a stopped pipeline. The destination is written to `<dst>.part` and renamed only
on a complete, length-checked read: a truncated transfer must never leave a file that prove_remote's
name-and-size check would accept as a valid input.

  PUMP_SOCK=~/.zisk-witness-pump.sock   PUMP_BOX=<ssh target of the box, as the PROVER sees it>
  PUMP_SSH_OPTS="-C -o BatchMode=yes"   PUMP_TIMEOUT=120 (seconds for one transfer)
  PUMP_REMOTE_CMD=<path to this file on the box>
"""
import os, socket, struct, subprocess, sys, time

SOCK    = os.path.expanduser(os.environ.get("PUMP_SOCK") or "~/.zisk-witness-pump.sock")
BOX     = os.environ.get("PUMP_BOX") or ""
SSHOPTS = (os.environ.get("PUMP_SSH_OPTS") or "-C -o BatchMode=yes").split()
TIMEOUT = float(os.environ.get("PUMP_TIMEOUT") or 120)
# Where this same script lives ON THE BOX. Overridable so the pump can be exercised against a staged copy
# before the repo carries it, and so a non-default clone path does not require editing the source.
REMOTE_CMD = os.environ.get("PUMP_REMOTE_CMD") or "zkvm-bench/infra/zisk-infra/witness-pump"
HDR     = struct.Struct("<q")          # LE64 length; negative = the sender could not read the file


def log(msg):
    print(f"{time.strftime('%H:%M:%S')} witness-pump: {msg}", flush=True)


# ── box side ────────────────────────────────────────────────────────────────────────────────────────
def mode_send():
    """Serve requests on stdin, framed replies on stdout.

      <path>                     GET: reply LE64(size) + size bytes  (LE64(-1) if unreadable)
      PUT\\t<dest>\\t<length>      the body follows on stdin; reply LE64(0) ok / LE64(-1) failed

    A negative length keeps the stream usable instead of dying: a pruned witness is routine here (retention
    deletes a framed input once its proof is in hand), and tearing the channel for it would cost a reconnect.

    REQUESTS ARE READ FROM THE BINARY STREAM, one readline at a time — never `for line in sys.stdin`. The text
    wrapper reads ahead, so a PUT body would be partly swallowed into its buffer and the file written short. A
    protocol that carries binary bodies cannot share a stream with a buffering text iterator."""
    inp, out = sys.stdin.buffer, sys.stdout.buffer
    while True:
        raw = inp.readline()
        if not raw:
            return 0
        req = raw.decode(errors="replace").rstrip("\n")
        if not req:
            continue
        try:
            if req.startswith("PUT\t"):
                _, dest, length = req.split("\t", 2)
                need = int(length)
                os.makedirs(os.path.dirname(dest) or ".", exist_ok=True)
                # Straight to <dest>.part, renamed only once every byte declared has arrived: the box must never
                # see a half-written artifact under its real name, same rule as the input side.
                part = dest + ".part"
                got = 0
                with open(part, "wb") as f:
                    while got < need:
                        b = inp.read(min(1 << 20, need - got))
                        if not b:
                            raise ConnectionError("body truncated")
                        f.write(b); got += len(b)
                os.replace(part, dest)
                out.write(HDR.pack(0))
            else:
                path = req
                size = os.path.getsize(path)
                with open(path, "rb") as f:
                    out.write(HDR.pack(size))
                    sent = 0
                    while sent < size:
                        chunk = f.read(1 << 20)
                        if not chunk:                   # file shrank under us: the reader will time out
                            break                       # rather than be handed a short body silently
                        out.write(chunk)
                        sent += len(chunk)
            out.flush()
        except Exception:                               # noqa: BLE001 — never die on one bad request
            try:
                os.unlink(part)                         # noqa: F821 — only bound on the PUT path
            except (OSError, NameError, UnboundLocalError):
                pass
            out.write(HDR.pack(-1))
            out.flush()
    return 0


# ── prover side: the long-lived pump ────────────────────────────────────────────────────────────────
class Channel:
    """The persistent ssh to the box. Reconnects lazily, so an outage costs one failed request."""

    def __init__(self):
        self.p = None

    def alive(self):
        return self.p is not None and self.p.poll() is None

    def connect(self):
        if self.alive():
            return True
        if not BOX:
            log("PUMP_BOX is not set — nothing to connect to")
            return False
        # `exec` so the remote shell does not sit between us and the sender, holding a pipe buffer.
        cmd = ["ssh", *SSHOPTS, BOX, f"exec {REMOTE_CMD} send"]
        try:
            self.p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                      stderr=subprocess.DEVNULL, bufsize=0)
            log(f"channel open to {BOX}")
            return True
        except OSError as e:
            log(f"cannot start the channel: {e}")
            self.p = None
            return False

    def close(self):
        if self.p is not None:
            try:
                self.p.stdin.close()
                self.p.kill()
            except OSError:
                pass
            self.p = None

    def _readn(self, n, deadline):
        """Read exactly n bytes or raise. A short read means the channel is broken, not that the file ended:
        the length came from the sender, so anything less is a torn stream and must not be renamed into place."""
        buf = bytearray()
        while len(buf) < n:
            if time.time() > deadline:
                raise TimeoutError(f"timed out with {len(buf)}/{n} bytes")
            chunk = self.p.stdout.read(min(1 << 20, n - len(buf)))
            if not chunk:
                raise ConnectionError(f"channel closed with {len(buf)}/{n} bytes")
            buf += chunk
        return bytes(buf)

    def push(self, src, dest):
        """Send a local file UP the channel to `dest` on the box. Returns the byte count; raises on failure.

        WHY THIS DIRECTION EXISTS. The artifacts (proof, report, log, public values) are written on the prover and
        the box needs them. They used to ride the box->prover ssh's stdout as a tar — which means back through the
        REVERSE TUNNEL, at the 3.8 Mbit/s that TCP-in-TCP gives, against 25 direct. Invisible while the mock
        proof was 480 bytes (~1 ms); with a realistically sized 381 KB proof that return leg is **0.82 s**.
        The pump already holds a direct prover->box connection, so pushing costs no new handshake — only the ack.

        ONE push of one tarball, not four of one file each. Each PUT costs an ack round trip (~0.1-0.2 s at this
        RTT), so four artifacts pushed separately would spend more on acks than the tunnel spent on bytes."""
        if not self.connect():
            raise ConnectionError("no channel")
        deadline = time.time() + TIMEOUT
        size = os.path.getsize(src)
        self.p.stdin.write(f"PUT\t{dest}\t{size}\n".encode())
        with open(src, "rb") as f:
            left = size
            while left:
                b = f.read(1 << 20)
                if not b:
                    raise ConnectionError(f"local read short with {left} bytes to go")
                self.p.stdin.write(b); left -= len(b)
        self.p.stdin.flush()
        (rc,) = HDR.unpack(self._readn(HDR.size, deadline))
        if rc != 0:
            raise ConnectionError(f"the box refused the push to {dest}")
        return size

    def fetch(self, src, dst):
        """Pull one file. Returns its size. Raises on any problem; the caller reports and lets the box fall
        back to scp."""
        if not self.connect():
            raise ConnectionError("no channel")
        deadline = time.time() + TIMEOUT
        self.p.stdin.write((src + "\n").encode())
        self.p.stdin.flush()
        (size,) = HDR.unpack(self._readn(HDR.size, deadline))
        if size < 0:
            raise FileNotFoundError(f"the box could not read {src}")
        part = dst + ".part"
        os.makedirs(os.path.dirname(dst) or ".", exist_ok=True)
        got = 0
        with open(part, "wb") as f:
            while got < size:
                chunk = self._readn(min(1 << 20, size - got), deadline)
                f.write(chunk)
                got += len(chunk)
        os.replace(part, dst)          # atomic: no half-written input is ever visible under its real name
        return size


def mode_serve():
    # A unix socket path is capped at ~104 bytes on macOS (108 on Linux), and the failure is a bare
    # `OSError: AF_UNIX path too long` that says nothing about which path or why. The prover here is a Mac,
    # so say it plainly — this is the same limit that bit the ssh ControlPath in prove_remote.
    if len(SOCK.encode()) > 100:
        log(f"PUMP_SOCK is too long for a unix socket ({len(SOCK)} bytes, limit ~104): {SOCK}")
        log("  pick something short, e.g. PUMP_SOCK=/tmp/zisk-pump.sock")
        return 1
    if os.path.exists(SOCK):
        os.unlink(SOCK)                                  # a stale socket from a killed pump
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    srv.listen(8)
    ch = Channel()
    log(f"serving on {SOCK} (box={BOX or '<unset>'}, timeout={TIMEOUT:g}s)")
    ch.connect()                                          # fail loudly at startup, not on the first block
    try:
        while True:
            conn, _ = srv.accept()
            with conn:
                try:
                    req = conn.makefile("r").readline().strip()
                    op = "get"
                    if req.startswith("put\t"):
                        op = "put"; req = req[4:]
                    src, _, dst = req.partition("\t")
                    if not src or not dst:
                        conn.sendall(b"ERR malformed request\n")
                        continue
                    t0 = time.time()
                    try:
                        n = ch.push(src, dst) if op == "put" else ch.fetch(src, dst)
                    except FileNotFoundError as e:
                        # The box could not read it, and said so with a clean negative length — the stream is
                        # still correctly framed, so KEEP the channel. This is a routine case, not a fault:
                        # retention deletes a framed input once its proof is in hand, so the pump will be
                        # asked for pruned blocks in normal operation. Tearing the channel each time would
                        # spend ~2 s reconnecting for nothing.
                        log(f"absent: {os.path.basename(src)} — the prover will scp it instead")
                        conn.sendall(f"ERR {e}\n".encode())
                        continue
                    except Exception as e:
                        # Any TRANSPORT error, though, must drop the channel: a torn stream leaves unread
                        # bytes in the pipe, and the next request would read THOSE as its length. Reconnecting
                        # is cheap (~2 s, once); mis-framing every later transfer is not recoverable.
                        ch.close()
                        log(f"FAILED {os.path.basename(src)}: {e} — the prover will scp it instead")
                        conn.sendall(f"ERR {e}\n".encode())
                        continue
                    dt = max(time.time() - t0, 1e-6)
                    log(f"{'pushed' if op == 'put' else 'streamed'} {os.path.basename(src)} "
                        f"{n/1048576:.1f} MB in {dt:.2f}s ({n*8/dt/1e6:.1f} Mbit/s)")
                    conn.sendall(f"OK {n}\n".encode())
                except OSError as e:
                    log(f"client error: {e}")
    except KeyboardInterrupt:
        pass
    finally:
        ch.close()
        try:
            os.unlink(SOCK)
        except OSError:
            pass
    return 0


# ── prover side: the one-shot clients ───────────────────────────────────────────────────────────────
def _ask(line):
    """One request to the local pump. 0 on OK, 1 on anything else — the caller's fallback does the rest."""
    try:
        c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        c.settimeout(TIMEOUT + 10)
        c.connect(SOCK)
    except OSError as e:
        print(f"witness-pump: no pump at {SOCK} ({e})", file=sys.stderr)
        return 1
    with c:
        c.sendall(line.encode())
        reply = c.makefile("r").readline().strip()
    if reply.startswith("OK "):
        return 0
    print(f"witness-pump: {reply or 'no reply'}", file=sys.stderr)
    return 1


def mode_get(src, dst):
    """Pull SRC on the box down to DST here. What prove_remote asks for on the workspace round trip."""
    return _ask(f"{src}\t{dst}\n")


def mode_put(src, dest):
    """Push SRC here up to DEST on the box, over the channel the pump already holds. Called by the prover at the
    end of a run so the artifacts never ride the reverse tunnel — 0.82 s of a 381 KB proof at the tunnel's
    3.8 Mbit/s, against ~0.13 s direct plus one ack."""
    return _ask(f"put\t{src}\t{dest}\n")


def main(argv):
    if len(argv) < 2:
        print(__doc__.strip().splitlines()[0], file=sys.stderr)
        print("usage: witness-pump {send|serve|get SRC DST}", file=sys.stderr)
        return 2
    m = argv[1]
    if m == "send":
        return mode_send()
    if m == "serve":
        return mode_serve()
    if m == "get":
        if len(argv) != 4:
            print("usage: witness-pump get SRC DST", file=sys.stderr)
            return 2
        return mode_get(argv[2], argv[3])
    if m == "put":
        if len(argv) != 4:
            print("usage: witness-pump put SRC DEST_ON_BOX", file=sys.stderr)
            return 2
        return mode_put(argv[2], argv[3])
    print(f"unknown mode: {m}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
