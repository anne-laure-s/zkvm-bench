#!/usr/bin/env bash
#
# zisk-runner — shell wrapper around the ZisK CLI, the parity twin of sp1-runner.
#
# A single entrypoint for both local emulation (Mac/CPU) and remote proving (box/GPU).
# It is agnostic of the guest's input/output types: it passes the input file straight
# to the ZisK tools and emits the SAME report.json schema as sp1-runner, so the
# downstream comparison tooling works unchanged.
#
#   zisk-runner --elf E --input I --mode execute          [--public-values PV] [--report R]
#   zisk-runner --elf E --input I --hints H --mode prove-compressed --output O [--public-values PV] [--report R] [--skip-verify]
#   zisk-runner --mode verify --proof O                   [--report R]
#
# ZISK_MOCK_SECS (+ ZISK_MOCK_JITTER, ZISK_MOCK_DIST=uniform|normal): turn the prove modes into a MOCK
# prover — sleep, emit a MOCK-PROOF-magic fake, skip cargo-zisk entirely. Lets a free machine stand in for
# the cluster so the real transport path is exercised; no GPU, no toolchain required.
#
# Modes:
#   execute           emulate (ziskemu -m) -> step count (≈ SP1 cycles) + public values
#   prove-compressed  default recursive STARK proof (≈ SP1 prove-compressed)   [DEFAULT]
#   prove-plonk       STARK + on-chain PLONK wrap (≈ SP1 groth16) — supported, unused by default
#   prove-minimal     smaller STARK (-c), slower — supported, unused by default
#   verify            verify an existing proof cryptographically
#
# Proving backend (env ZISK_PROVE_BACKEND):
#   remote (default)  `cargo-zisk remote prove …`  — talks to the box's coordinator/worker (multi-GPU)
#   local             `cargo-zisk prove --asm --gpu …` — single-process (adds --gpu when supported)
#
# ⚠️ ZisK is v1.1.0-alpha and CLI flags/output formats shift between versions. Every
# external invocation here is overridable via env (see CONFIG) and the output parsing
# is best-effort. Confirm against your installed version with `cargo-zisk prove --help`
# and `ziskemu --help`, then adjust the regexes / flags below or via the env knobs.
set -uo pipefail
# ziskup installs the ZisK binaries here; a fresh/non-interactive shell may not
# have it on PATH yet. Harmless on the Mac (the dir just won't exist).
export PATH="$HOME/.zisk/bin:$PATH"

# ── CONFIG (override via env) ────────────────────────────────────────────────
ZISK_EMU_BIN="${ZISK_EMU_BIN:-ziskemu}"          # emulator
ZISK_CLI_BIN="${ZISK_CLI_BIN:-cargo-zisk}"       # main CLI
ZISK_PROVE_BACKEND="${ZISK_PROVE_BACKEND:-remote}"
ZISK_COORDINATOR_URL="${ZISK_COORDINATOR_URL:-http://127.0.0.1:7000}"
ZISK_EMU_EXTRA_FLAGS="${ZISK_EMU_EXTRA_FLAGS:-}"
ZISK_PROVE_EXTRA_FLAGS="${ZISK_PROVE_EXTRA_FLAGS:-}"
ZISK_VERIFY_EXTRA_FLAGS="${ZISK_VERIFY_EXTRA_FLAGS:-}"

# ── arg parsing (same flags as sp1-runner) ───────────────────────────────────
ELF="" INPUT="" HINTS="" MODE="execute" PROOF="" OUTPUT="" PV="" REPORT="" SKIP_VERIFY=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --elf)            ELF="$2"; shift 2 ;;
    --input)          INPUT="$2"; shift 2 ;;
    --hints)          HINTS="$2"; shift 2 ;;
    --mode)           MODE="$2"; shift 2 ;;
    --proof)          PROOF="$2"; shift 2 ;;
    --output)         OUTPUT="$2"; shift 2 ;;
    --public-values)  PV="$2"; shift 2 ;;
    --report)         REPORT="$2"; shift 2 ;;
    --skip-verify)    SKIP_VERIFY=1; shift ;;
    -h|--help)        sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; /^set -uo/d'; exit 0 ;;
    *) echo "ERROR: unknown arg '$1'" >&2; exit 2 ;;
  esac
done

# ── helpers ──────────────────────────────────────────────────────────────────
# now — best-effort high-res clock (seconds.fraction). Falls back gracefully on
# macOS bash 3.2 / BSD date (no %N): then only second precision, which is fine for
# the local emulation profile (the benchmark prove_secs runs on the Linux box).
now() {
  if [[ -n "${EPOCHREALTIME:-}" ]]; then echo "${EPOCHREALTIME/,/.}"; return; fi
  local t; t="$(date +%s.%N 2>/dev/null)"
  case "$t" in *N|"") date +%s ;; *) echo "$t" ;; esac
}
elapsed() { awk -v a="$1" -v b="$2" 'BEGIN{ d=b-a; if (d<0) d=0; printf "%.3f", d }'; }
ensure_parent() { local d; d="$(dirname "$1")"; [[ -n "$d" ]] && mkdir -p "$d"; }
# jnum — emit a JSON number or `null` for an empty value.
jnum() { [[ -n "$1" ]] && printf '%s' "$1" || printf 'null'; }
jbool() { [[ "$1" == 1 ]] && printf 'true' || printf 'false'; }

# parse_steps <emulator-log> — the step count, ANCHORED on `steps=<n>` (what `ziskemu -m` prints) before
# falling back to the loose "first number on a line mentioning step". The loose form alone would happily
# return a timestamp or a version number if the output ever gains a prefix, and a wrong step count does not
# fail loudly — it silently mis-scales the mock prover's model and every duration derived from it.
parse_steps() {
  local n
  n="$(grep -oE 'steps?[=: ]+[0-9][0-9,]*' "$1" 2>/dev/null | grep -oE '[0-9][0-9,]*' | head -n1 | tr -d ',')"
  [[ -n "$n" ]] || n="$(grep -iE 'steps?' "$1" 2>/dev/null | grep -oE '[0-9][0-9,]*' | head -n1 | tr -d ',')"
  printf '%s' "$n"
}

# vkey — the verification key of the ZisK installed HERE, as hex, or empty.
#
# ethproofs' `verifier_id` answers "which verifier can check this proof", and for ZisK that is not a
# per-program key: the setup is per-ELF but the final verification key is part of the install, one file of
# exactly 32 bytes. So the key itself IS the identifier — no hashing, no derivation.
#
# It is read on the PROVER, the machine whose verifier the proof belongs to. That matters: this Mac and the
# devcore box hold different keys because they run different ZisK builds, and a proof made under one cannot be
# checked by the other. Publishing the key is what makes such a mismatch legible on the leaderboard instead of
# surfacing as a mysterious REJECTED.
vkey() {
  local f="${ZISK_VERKEY:-$HOME/.zisk/provingKey/zisk/vadcop_final/vadcop_final.verkey.bin}"
  [[ -r "$f" ]] || return 0
  # xxd OR od. `xxd` ships with vim-common and a prover image need not have it — this one does not, so the
  # helper returned empty, `vkey_hash` was null in every report, the submission carried no verifier_id and the
  # leaderboard's column stayed blank. `od` is coreutils and is always there.
  local hex
  hex="$(xxd -p "$f" 2>/dev/null | tr -d '\n')"
  [[ -n "$hex" ]] || hex="$(od -An -tx1 -v "$f" 2>/dev/null | tr -d ' \n')"
  [[ -n "$hex" ]] && printf '0x%s' "$hex"
}

write_report() { # $1 = json body
  [[ -z "$REPORT" ]] && return 0
  ensure_parent "$REPORT"
  printf '%s\n' "$1" > "$REPORT"
  echo "Report        : $REPORT"
}

echo "== zisk-runner =="
echo "Mode     : $MODE"

case "$MODE" in
  # ──────── EXECUTE (emulate) ────────
  execute)
    [[ -n "$ELF" && -n "$INPUT" ]] || { echo "ERROR: execute needs --elf and --input" >&2; exit 2; }
    echo "ELF      : $ELF"
    echo "Input    : $INPUT"
    # XXXXXX IS REQUIRED. `mktemp -t zisk-emu` works on macOS (it appends its own suffix) and fails on GNU
    # coreutils with "too few X's in template" — so on the box the emulation ran, printed its metrics, and
    # captured them into '' : steps came back null in every exec-report while the run looked successful. The
    # public values were fine, which is what made it invisible: the artefact that matters was there.
    emu_log="$(mktemp -t zisk-emu.XXXXXX)"
    t0="$(now)"
    # -m logs metrics (steps/duration). -o writes the program output (public values)
    # if a path is given; harmless if the version ignores it.
    # shellcheck disable=SC2086
    if [[ -n "$PV" ]]; then ensure_parent "$PV"; fi
    "$ZISK_EMU_BIN" -e "$ELF" -i "$INPUT" -m ${PV:+-o "$PV"} $ZISK_EMU_EXTRA_FLAGS 2>&1 | tee "$emu_log"
    rc=${PIPESTATUS[0]}
    t1="$(now)"
    dt="$(elapsed "$t0" "$t1")"
    [[ "$rc" == 0 ]] || { echo "ERROR: ziskemu exited $rc" >&2; rm -f "$emu_log"; exit "$rc"; }
    # Best-effort: pull the step count out of the emulator metrics. ZisK calls
    # cycles "steps". Match the first integer on a line mentioning "steps".
    steps="$(parse_steps "$emu_log")"
    pv_bytes=""; [[ -n "$PV" && -f "$PV" ]] && pv_bytes="$(wc -c < "$PV" | tr -d ' ')"
    rm -f "$emu_log"
    echo "Steps         : ${steps:-<unparsed>}"
    echo "Time          : ${dt}s"
    write_report "$(cat <<JSON
{
  "mode": "execute",
  "steps": $(jnum "$steps"),
  "elapsed_secs": $(jnum "$dt"),
  "public_values_bytes": $(jnum "$pv_bytes")
}
JSON
)"
    ;;

  # ──────── PROVE ────────
  # Verified against cargo-zisk v1.1.0-alpha source (cli/.../embedded/prove.rs):
  #   * `-o` is the PROOF FILE path (not a dir) → no glob/lift needed.
  #   * local `cargo-zisk prove --hints` REQUIRES `--asm`; `remote prove` does NOT take --asm.
  #   * default (no -c/--plonk) = the standard STARK proof (our "compressed" analog).
  #   * GPU is OPT-IN: prove.rs does `if self.gpu { builder.gpu() }` — WITHOUT `--gpu` it proves
  #     on CPU. The `--gpu` flag exists only on a GPU build (cfg(not(cpu-only)); hidden on the Mac).
  #     So the local backend ADDS `--gpu` when the installed build supports it (auto-detected).
  #     (The real multi-GPU path is the distributed backend → the worker runs with --gpu.)
  prove-compressed|prove-plonk|prove-minimal)
    [[ -n "$ELF" && -n "$INPUT" ]] || { echo "ERROR: prove needs --elf and --input" >&2; exit 2; }
    [[ -n "$OUTPUT" ]] || { echo "ERROR: prove needs --output" >&2; exit 2; }
    echo "ELF      : $ELF"
    echo "Input    : $INPUT"
    [[ -n "$HINTS" ]] && echo "Hints    : $HINTS"
    echo "Backend  : $ZISK_PROVE_BACKEND"
    ensure_parent "$OUTPUT"

    extra="$ZISK_PROVE_EXTRA_FLAGS"
    case "$MODE" in
      prove-plonk)   extra="$extra --plonk" ;;   # on-chain (≈ SP1 groth16)
      prove-minimal) extra="$extra -c" ;;        # smaller STARK, slower
    esac

    if [[ "$ZISK_PROVE_BACKEND" == "local" ]]; then
      # Single-process. Needs a prior `cargo-zisk setup -e <elf> --asm --hints`.
      set -- "$ZISK_CLI_BIN" prove -e "$ELF" -i "$INPUT" -o "$OUTPUT"
      # --asm --hints: reth guest proves with precompile hints (needs --asm).
      # -u / --unlock-mapped-memory: the ASM emulator mmaps the ROM with MAP_LOCKED by
      # default; unprivileged Docker boxes (vast.ai) cap memlock at 64 KB → the locked
      # mmap fails (errno 11). -u disables locking (no perf cost with lots of RAM). It
      # only applies with --asm, so it's added on the same branch. Override off with
      # ZISK_LOCK_MEM=1 if you're on a box where memlock is unlimited and want locking.
      [[ -n "$HINTS" ]] && { set -- "$@" --asm --hints "$HINTS"; [[ "${ZISK_LOCK_MEM:-0}" == 1 ]] || set -- "$@" -u; }
      # GPU is opt-in (see header) → add --gpu when the build supports it, else it runs on CPU.
      # ZISK_LOCAL_GPU: auto (default) | 1 (force --gpu) | 0 (force CPU).
      if [[ "${ZISK_LOCAL_GPU:-auto}" == 1 ]] \
         || { [[ "${ZISK_LOCAL_GPU:-auto}" == auto ]] && "$ZISK_CLI_BIN" prove --help 2>/dev/null | grep -qiE '(^|[[:space:]])-g,|--gpu'; }; then
        set -- "$@" --gpu
        echo "GPU      : --gpu (local prove)"
      else
        echo "GPU      : OFF (cargo-zisk prove has no --gpu here → CPU prove; set ZISK_LOCAL_GPU=1 to force)"
      fi
    else
      # Distributed via the coordinator/workers. Needs a prior
      # `cargo-zisk remote setup -e <elf> --hints` against the same coordinator.
      set -- "$ZISK_CLI_BIN" remote prove --coordinator "$ZISK_COORDINATOR_URL" \
        -e "$ELF" -i "$INPUT" -o "$OUTPUT" --timeout 0
      [[ -n "$HINTS" ]] && set -- "$@" --hints "$HINTS"
    fi
    # shellcheck disable=SC2206
    [[ -n "$extra" ]] && set -- "$@" $extra

    # MOCK PROVER: emit a fake proof after standing in for the proving time, instead of proving. This exists
    # so the pipeline can be rehearsed against a REAL remote — every transfer, the workspace, the run-record
    # fetch — with the prover as the only fiction, exactly where the real one would be. No GPU needed, and no
    # ZisK toolchain unless you ask for the step-based model.
    #   * the proof bytes start with MOCK-PROOF, so cli/verify-proof and cli/ethproofs-mock both refuse it
    #   * public values, when the emulation runs, are the guest's REAL ones — the proof is fake, they are not
    # Triggered on a NON-ZERO value, not merely a set one: the driver passes these unconditionally, so
    # testing -n would make `--mock --remote` with no timing flags emulate for a model of zero.
    _nz() { [[ -n "${1:-}" ]] && awk -v v="$1" 'BEGIN{exit !(v + 0 != 0)}'; }
    if _nz "${ZISK_MOCK_SECS:-}" || _nz "${ZISK_MOCK_PER_MSTEP:-}"; then
      # The witness is HERE — it was just uploaded — and so is the emulator. So the mock prover measures
      # the work itself: emulate the block, read its step count, and derive how long the real prover would
      # have taken. Nothing about the duration is decided elsewhere; the driver only passes the model.
      #   ZISK_MOCK_SECS       fixed overhead (s)
      #   ZISK_MOCK_PER_MSTEP  seconds per million steps — set it and the emulation runs
      #   ZISK_MOCK_SPEED      divides the work term only (a faster/slower cluster)
      #   ZISK_MOCK_JITTER / ZISK_MOCK_DIST   noise: ± bound (uniform) or std dev (normal)
      mock_steps=""; mock_emul=0
      if _nz "${ZISK_MOCK_PER_MSTEP:-}"; then
        if command -v "$ZISK_EMU_BIN" >/dev/null 2>&1; then
          echo "Cmd      : [MOCK PROVER] emulating to measure the work ($ZISK_EMU_BIN)"
          emu_log="$(mktemp -t zisk-mock-emu.XXXXXX)"
          te0="$(now)"
          # Same invocation as --mode execute: -m for the metrics, -o for the real public values.
          if [[ -n "$PV" ]]; then ensure_parent "$PV"; fi
          # shellcheck disable=SC2086
          "$ZISK_EMU_BIN" -e "$ELF" -i "$INPUT" -m ${PV:+-o "$PV"} $ZISK_EMU_EXTRA_FLAGS >"$emu_log" 2>&1
          emu_rc=$?
          mock_emul="$(elapsed "$te0" "$(now)")"
          mock_steps="$(parse_steps "$emu_log")"
          if [[ "$emu_rc" != 0 || -z "$mock_steps" ]]; then
            # Do NOT swallow this: without a step count the model silently collapses to the fixed term, so
            # the duration would be wrong and the evidence gone. Keep the log and show why.
            echo "WARN: emulation ${emu_rc:+exited $emu_rc }${mock_steps:+}${mock_steps:-produced no step count}" \
                 "— the model falls back to the fixed term alone. Emulator output kept at $emu_log:" >&2
            tail -5 "$emu_log" >&2
          else
            rm -f "$emu_log"
          fi
          echo "Steps    : ${mock_steps:-<unparsed>}  (measured in ${mock_emul}s)"
        else
          echo "WARN: $ZISK_EMU_BIN not found — cannot measure steps, falling back to the fixed term" >&2
        fi
      fi
      # secs = overhead + per_mstep × Msteps / speed  ± noise
      mock_dt="$(awk -v b="${ZISK_MOCK_SECS:-0}" -v p="${ZISK_MOCK_PER_MSTEP:-0}" -v s="${mock_steps:-0}" \
                     -v sp="${ZISK_MOCK_SPEED:-1}" -v j="${ZISK_MOCK_JITTER:-0}" \
                     -v d="${ZISK_MOCK_DIST:-uniform}" -v seed="$RANDOM$$" 'BEGIN{
        srand(seed); if (sp <= 0) sp = 1
        v = b + (p > 0 && s > 0 ? p * (s / 1000000) / sp : 0)
        if (j > 0) { if (d == "normal") { u1 = rand(); if (u1 < 1e-12) u1 = 1e-12
                       v += j * sqrt(-2 * log(u1)) * cos(6.283185307179586 * rand()) }
                     else v += (rand() * 2 - 1) * j }
        if (v < 0.1) v = 0.1; printf "%.2f", v }')"
      # The emulation was real time spent standing in for proving, so it is DEDUCTED: the mock's total
      # occupancy equals the modelled proving time. If it overran the model, say so — silence there would
      # make every latency number downstream optimistic by an unknown amount.
      mock_nap="$(awk -v t="$mock_dt" -v e="$mock_emul" 'BEGIN{ d = t - e; if (d < 0) d = 0; printf "%.2f", d }')"
      if awk -v e="$mock_emul" -v t="$mock_dt" 'BEGIN{exit !(e > t)}'; then
        echo "WARN: OVERSHOT — emulation took ${mock_emul}s but the model says ${mock_dt}s; this box emulates" \
             "slower than the modelled prover. Raise ZISK_MOCK_PER_MSTEP or drop it." >&2
      fi
      echo "Cmd      : [MOCK PROVER] model=${mock_dt}s − emulation=${mock_emul}s → sleep ${mock_nap}s — no proving"
      ensure_parent "$OUTPUT"
      sleep "$mock_nap"
      # SIZE IS NOT PART OF THE FICTION. The mock's sleep is allowed to be invented; its proof SIZE is not,
      # because everything downstream of the prover is sized by it — the tar back to the box, the base64 in
      # ethproofs-submit, and the POST that (in this topology) crosses the reverse tunnel at 3.8 Mbit/s.
      # At 480 bytes that whole return leg measures ~3 ms and is therefore never exercised: the first real
      # prover would discover ~0.8 s of it at once. Measured references: a real SP1 proof in this repo is
      # 1.273 MB (n=5, spread 126 bytes — essentially constant), and a ZisK compressed proof is ~381 KB.
      #
      # Constant, not block-varying: real proof size does not track the block, so making it do so would be a
      # second fiction dressed as realism.
      #
      # Padded from /dev/urandom, never zeros. A real proof is cryptographic and incompressible; zero padding
      # would vanish under `ssh -C` and leave the return leg exactly as unmeasured as 480 bytes did.
      # NOT `local` — this branch is top-level script, not a function body. `local` there fails, leaves the name
      # unbound, and `set -u` then kills the runner at the next reference: the report is never written and the
      # block comes back as "no-report no-proof" with an 80-byte truncated proof. Cost one full restart to find.
      mock_pb="${ZISK_MOCK_PROOF_BYTES:-390144}"            # 381 KiB — a ZisK compressed proof
      { printf 'MOCK-PROOF/mock-remote NOT-A-REAL-PROOF elf=%s input=%s ' \
          "$(basename "$ELF")" "$(basename "$INPUT")"
        head -c "$mock_pb" /dev/urandom; } > "$OUTPUT"
      proof_bytes="$(wc -c < "$OUTPUT" | tr -d ' ')"
      pv_bytes=""; [[ -n "$PV" && -f "$PV" ]] && pv_bytes="$(wc -c < "$PV" | tr -d ' ')"
      echo "Proof saved   : $OUTPUT ($proof_bytes bytes) — FAKE"
      # `steps` in the report is the real, deterministic work-unit the emulation measured — so
      # cli/ethproofs-submit fills proving_cycles and rtp-latency fills its work column with no extra hop.
      write_report "$(cat <<JSON
{
  "mode": "mock",
  "zkvm": "ZisK",
  "steps": $(jnum "$mock_steps"),
  "prove_secs": $mock_dt,
  "mock_speed": ${ZISK_MOCK_SPEED:-1},
  "emulate_secs": $(jnum "$mock_emul"),
  "verify_secs": null,
  "total_secs": $mock_dt,
  "proof_bytes": $proof_bytes,
  "public_values_bytes": $(jnum "$pv_bytes"),
  "verified": null,
  "backend": "mock-remote"
}
JSON
)"
      exit 0
    fi

    echo "Cmd      : $*"
    t0="$(now)"
    # TEE'd, not swallowed. The output must keep STREAMING — core.sh relays it live, and a hung prover is only
    # visible that way — and it must be readable afterwards, because on the cluster path the step count is
    # printed there and NOWHERE else: `cargo-zisk remote prove` writes no report and the coordinator's own log
    # stays on the prover. Without this the run record carried no work unit at all, so every submission went
    # out with `work=None` and rtp-latency's work column stayed empty.
    # PIPESTATUS[0], because the status that decides the run is the prover's, not tee's.
    prove_out="$(mktemp -t zisk-prove.XXXXXX)"
    "$@" 2>&1 | tee "$prove_out"
    rc=${PIPESTATUS[0]}
    t1="$(now)"
    steps="$(parse_steps "$prove_out")"
    rm -f "$prove_out"
    [[ "$rc" == 0 ]] || { echo "ERROR: prove exited $rc" >&2; exit "$rc"; }
    prove_dt="$(elapsed "$t0" "$t1")"
    echo "Prove         : ${prove_dt}s${steps:+  ($steps steps)}"

    # `-o` wrote the proof directly to $OUTPUT.
    if [[ -f "$OUTPUT" ]]; then
      proof_bytes="$(wc -c < "$OUTPUT" | tr -d ' ')"
      echo "Proof saved   : $OUTPUT ($proof_bytes bytes)"
    else
      proof_bytes=""
      echo "WARN: no proof at $OUTPUT after prove — proof_bytes unknown" >&2
    fi

    # Optional verify after generation (default on, like sp1-runner).
    verify_dt=""
    if [[ "$SKIP_VERIFY" == 0 && -f "$OUTPUT" ]]; then
      tv0="$(now)"
      if "$ZISK_CLI_BIN" verify -p "$OUTPUT" $ZISK_VERIFY_EXTRA_FLAGS; then
        tv1="$(now)"; verify_dt="$(elapsed "$tv0" "$tv1")"
        echo "Verify OK     : ${verify_dt}s"
      else
        echo "WARN: post-prove verify failed (proof kept)" >&2
      fi
    fi

    total_dt="$(elapsed "$t0" "$(now)")"
    write_report "$(cat <<JSON
{
  "mode": "$MODE",
  "steps": $(jnum "${steps:-}"),
  "prove_secs": $(jnum "$prove_dt"),
  "verify_secs": $(jnum "$verify_dt"),
  "total_secs": $(jnum "$total_dt"),
  "proof_bytes": $(jnum "$proof_bytes"),
  "verified": $(jbool $([[ -n "$verify_dt" ]] && echo 1 || echo 0)),
  "vkey_hash": $(v="$(vkey)"; [[ -n "$v" ]] && printf '"%s"' "$v" || printf null),
  "backend": "$ZISK_PROVE_BACKEND"
}
JSON
)"
    ;;

  # ──────── VERIFY ────────
  verify)
    [[ -n "$PROOF" ]] || { echo "ERROR: verify needs --proof" >&2; exit 2; }
    echo "Proof    : $PROOF"
    t0="$(now)"
    "$ZISK_CLI_BIN" verify -p "$PROOF" $ZISK_VERIFY_EXTRA_FLAGS
    rc=$?
    t1="$(now)"
    [[ "$rc" == 0 ]] || { echo "ERROR: verify failed ($rc)" >&2; exit "$rc"; }
    verify_dt="$(elapsed "$t0" "$t1")"
    echo "Verify OK     : ${verify_dt}s"
    write_report "$(cat <<JSON
{
  "mode": "verify",
  "verify_secs": $(jnum "$verify_dt"),
  "verified": true
}
JSON
)"
    ;;

  *)
    echo "ERROR: unknown mode '$MODE' (execute|prove-compressed|prove-minimal|prove-plonk|verify)" >&2
    exit 2 ;;
esac
