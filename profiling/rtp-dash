#!/usr/bin/env python3
"""rtp-dash — a live view of the RTP pipeline's per-leg timings, in compare.html's idiom.

    ./rtp-dash --box nyc-003                     one shot -> profiling/results/rtp-live.html
    ./rtp-dash --box nyc-003 --watch 20          rewrite it every 20 s
    ./rtp-dash --csv /path/to/rows.csv           skip the box, read a CSV already in hand

RUNS ON THIS MAC, reads on the box. The manifest and the run records live on the producer, so the joins
have to happen there; the page has to be openable here. So this drives `rtp-latency.py --csv` over ssh and
keeps only the joined rows. One source of truth for the joins, which stay in rtp-latency.py.

NO SERVER, and that is the point: the page carries `<meta http-equiv="refresh">` and is rewritten in place,
so `open`ing the file once is the whole setup. Fetching a JSON side-car would be tidier and would need a
local HTTP server, because a file:// page cannot fetch a file:// sibling.

WHAT IT REFUSES TO CONFLATE. In a `--mock` campaign the prover's DURATION is modelled from the emulated step
count (`prove_secs = MOCK_SECS + MOCK_PER_MSTEP x Msteps`, divided by MOCK_SPEED), while everything around it
is real: the chain wait, the replay, the framing and both transfers are measured. So `prove` and every total
containing it are marked MODELLED and rendered in the dim hue, and the measured legs are not. A dashboard that
showed one median for all of them would be presenting a sleep as a proving time.

DISPERSION IS p90, NOT σ. These legs are bimodal, not gaussian — transport alternates between the persistent
channel and its scp fallback, and a standard deviation over two modes describes neither. p90 answers the
question that decides the pipeline: does the block fit its 12 s slot.
"""
import argparse, csv, io, os, statistics, subprocess, sys, time

# The legs, in pipeline order. `modelled` marks what a mock run does not measure.
LEGS = [
    ("node",      "chain → visible",   "the block exists and the fetcher can see it",           False),
    ("witness",   "replay + dump",     "execute the block and write its witness",               False),
    ("queue",     "framing",           "the tap frames it into the prover queue",               False),
    ("transport", "transport",         "witness to the prover and artefacts back",              False),
    ("prove_secs", "prove",            "the prover itself",                                     True),
    ("service",   "service",           "queued → proved, the prover's whole share",             True),
    ("pipeline",  "pipeline",          "witness → proof in hand",                               True),
    ("e2e",       "end to end",        "block exists → proof in hand",                          True),
]
SLOT = 12.0  # one mainnet block. The number every leg is ultimately judged against.

def fetch_rows(box, guest, manifest, results):
    """Run the joiner on the box and bring back its CSV, preceded by one AGE line.

    The AGE line carries the box's own epoch and the manifest's last `t_queued`, both taken THERE. Data age is
    then a subtraction between two clocks that are the same clock. Comparing this page's local time against the
    box's log timestamps does not work and is actively misleading: nyc-003 runs on New York time, so a pipeline
    that stopped 13 minutes ago reads as six hours dead from a machine on CEST.

    The joiner's own stdout (its human table) is discarded; the contract we depend on is --csv, which
    DictWriter-s every key of every row."""
    remote = (
        # t_queued is field 5 of the manifest, and the last non-empty one is the freshest block the tap framed.
        # printf "%d", NOT print: awk formats a bare number with OFMT, so an epoch like 1786720701.23 comes out
        # as "1.78672e+09" and any later truncation reads it as the year 1970 plus one second.
        "q=$(awk -F, 'NR>1 && $5!=\"\" {v=$5} END{printf \"%d\\n\", v}' " + manifest + "); "
        "echo \"AGE $(date +%s) $q\"; "
        # PER-PROCESS temp file, never a fixed /tmp/rtp-dash.csv. The usage above documents --watch, so two
        # dashboards pointed at one box are an expected configuration, and on a shared path each one's `rm -f`
        # deletes the other's join mid-flight. That failure renders as the empty-CSV card, which makes it
        # indistinguishable from "nothing has joined yet" — the one state this page must report truthfully.
        # mktemp hands back a file that is already empty, so the old leading `rm -f` has nothing left to do.
        "c=$(mktemp /tmp/rtp-dash.XXXXXX) || exit 0; "
        # NOT chained on the joiner's exit status. It raises IndexError on `rows[0]` when nothing joins — a
        # fresh generation, or right after `rtp-up --purge` — and an `&&` there turns "no blocks yet", which is
        # a legitimate state this page must display, into a dashboard that shows nothing at all.
        f"cd ~/zkvm-bench && profiling/rtp-latency.py --manifest {manifest} "
        f"--results {results} --guest {guest} --csv \"$c\" >/dev/null 2>&1; "
        "[ -s \"$c\" ] && cat \"$c\"; rm -f \"$c\"; exit 0"
    )
    out = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=20", box, remote],
                         capture_output=True, text=True, timeout=300)
    # The AGE line alone is a complete answer: it says the producer is alive and nothing has joined yet.
    if out.returncode != 0 or not out.stdout.strip():
        raise RuntimeError(f"could not reach {box}: rc={out.returncode} {out.stderr.strip()[:200]}")
    age = None
    text = out.stdout
    if text.startswith("AGE "):
        head, _, text = text.partition("\n")
        try:
            _, now_s, last_s = head.split()
            if int(last_s) > 0:
                age = int(now_s) - int(last_s)
        except ValueError:
            pass
    return list(csv.DictReader(io.StringIO(text))), age

def nums(rows, key):
    v = []
    for r in rows:
        s = (r.get(key) or "").strip()
        if not s:
            continue
        try:
            v.append(float(s))
        except ValueError:
            pass
    return sorted(v)

def stats(v):
    if not v:
        return None
    n = len(v)
    p90 = v[min(n - 1, int(round(0.9 * (n - 1))))]
    return {"n": n, "median": statistics.median(v), "p90": p90, "min": v[0], "max": v[-1],
            "over": sum(1 for x in v if x > SLOT)}

def esc(s):
    return (str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))

