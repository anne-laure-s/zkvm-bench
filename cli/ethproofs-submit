#!/usr/bin/env python3
"""cli/ethproofs-submit — stack-agnostic ethproofs submitter (the "submit" seam as a thin CLI).

Takes a prove run record (proof.bin [or segments/] + report.json — the shared prove contract from
cli/report-schema.md) and POSTs the 3-endpoint ethproofs lifecycle (queued -> proving -> proved) to
an ethproofs API: cli/ethproofs-mock now, ethproofs.org later (same surface, config-only swap). Any
prover that emits the shared report.json + a proof file can submit with NO stack-specific code —
unlike RSP's bin/eth-proofs, which bundles witness+prove+submit into one process.

Pairs with cli/prove-farm: `prove-farm --watch --ethproofs-url <url>` calls this after each proof, so
the continuous pipeline is  witness-farm -> prove-farm -> ethproofs-submit  (three swappable seams).
The witness is fetched ONCE (by witness-farm); prove+submit reuse it with zero RPC.

  cli/ethproofs-submit --run-dir <dir> --block <N> [--vm SP1] [--guest rsp] [--ethproofs-url http://localhost:8547]
                       [--token dev] [--cluster 1] [--cycles N | --steps N] [--public-inputs D]
                       [--verifier-id 0x..] [--proving-time-ms N] [--minimal] [--proved-only] [--dry-run]

CANONICAL fields (report.json -> ethproofs /proofs/proved) — match EXACTLY what RSP bin/eth-proofs and
ZisK api.rs send, so swapping to the real ethproofs.org is config-only:
  proof.bin (bytes) -> proof (base64)          |  --block / report.block  -> block_number
  report.prove_secs x 1000 -> proving_time(ms) |  --cluster               -> cluster_id
  report.vkey_hash -> verifier_id              |  report.cycles OR .steps -> proving_cycles
                                              |    (else the run's exec-report.json — same number)
      (BOTH SP1 cycles and ZisK steps go in `proving_cycles` — there is NO `proving_steps` in the API)
EXTRA fields (mock leaderboard only; NOT sent by the real clients — dropped by --minimal):
  --vm / report.zkvm -> vm  ·  --guest / report.guest -> guest  ·  --public-inputs / <run>/*.pv.bin
  t_block + e2e_secs  (chain time of the block, and chain-time -> ack: the WHOLE pipeline in one number)
  mock:true  (from report mode=mock / backend=mock-cluster / MOCK-PROOF magic; warns if sent non-local)
"""
import argparse, base64, csv, glob, hashlib, io, json, os, sys, tarfile, time, urllib.error, urllib.parse, urllib.request

MOCK_MAGIC = b"MOCK-PROOF"   # prove-farm --mock writes proof bytes starting with this (see mock_prove)


def pv_digest(run_dir):
    """A short, stable digest of the committed public values (the proof's public inputs/outputs).
    Identifies non-block proofs (e.g. fibonacci) and pins what was proven.

    Order matters and is explicit rather than glob-alphabetical: the PROVER's own public values (*.pv.bin)
    win, and `expected_pv.bin` — what a local emulation of the guest committed — is only a fallback, used
    when there is no prover output (a mock run). Sending the emulated digest while a real one exists would
    quietly attribute the guest's claim to the proof."""
    p = pv_path(run_dir)
    if p:
        try:
            return "sha256:" + hashlib.sha256(open(p, "rb").read()).hexdigest()[:16]
        except OSError:
            pass
    return None


def pv_path(run_dir):
    """WHICH file holds the public values. Split out of pv_digest so the digest that gets sent and the
    values the gate below verifies are the same bytes — a gate that read a different file would bless a
    digest it never inspected."""
    for p in sorted(glob.glob(os.path.join(run_dir, "*.pv.bin"))) + [
            os.path.join(run_dir, "expected_pv.bin")]:
        if os.path.isfile(p):
            return p
    return None


_CHECKPV = "unset"


def load_checkpv():
    """cli/check-pv as a module, or None. Cached, and never fatal.

    An explicit SourceFileLoader, because scripts in cli/ carry no .py extension and
    spec_from_file_location alone hands back a spec with loader=None for those.

    Fail-open BUT LOUD: a box holding an older clone without check-pv must keep delivering proofs rather
    than go silent — but every line that depends on it then says NOT VERIFIED."""
    global _CHECKPV
    if _CHECKPV != "unset":
        return _CHECKPV
    try:
        import importlib.util as iu
        from importlib.machinery import SourceFileLoader
        path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "check-pv")
        spec = iu.spec_from_file_location("_checkpv", path, loader=SourceFileLoader("_checkpv", path))
        mod = iu.module_from_spec(spec)
        spec.loader.exec_module(mod)
        _CHECKPV = mod
    except Exception as e:                                        # noqa: BLE001 — never fatal
        print(f"ethproofs-submit: WARNING cannot load cli/check-pv ({e}) — public values will NOT be verified",
              file=sys.stderr)
        _CHECKPV = None
    return _CHECKPV


def pv_named(run_dir):
    """The public values as {name: 0xhex}, or None.

    Sent alongside the digest so the RECEIVER can verify them too. A 16-hex digest tells the server nothing
    it can check: to re-derive it the server would have to guess the padding length, and a padding change
    would then read as a wrong root and refuse every good proof. Named values are checkable directly, and a
    refusal can say WHICH value was wrong."""
    cp = load_checkpv()
    p = pv_path(run_dir)
    if cp is None or p is None:
        return None
    try:
        with open(p, "rb") as f:
            return {k: "0x" + v for k, v in cp.decode(f.read()).items()}
    except (OSError, ValueError):
        return None


def verify_public_values(run_dir, block, manifest, rpc_url, dry):
    """Refuse to submit a proof whose committed values are not the block's. -> (ok, note)

    THIS IS THE GATE THAT WAS MISSING. A guest reading a witness format it was not built for, or an ELF built
    against a different zkVM toolchain than the emulator running it, commits 256 bytes of zeros and exits 0.
    Nothing else in the pipeline can tell that apart from a real proof: the step count is plausible, the proof
    verifies, the digest is well-formed, and the leaderboard fills up with proofs about nothing.

    Fail CLOSED on a mismatch and OPEN on missing ground truth. Those are different failures and the pipeline
    must react differently: a wrong root means this proof must not be delivered, while an unreachable RPC
    means only that we cannot tell — and blocking every submission on a reachable RPC would turn a link
    problem into a total delivery outage, which is the failure this pipeline can least afford.

    The layout and the comparison live in cli/check-pv, not here, so the receiving side re-derives the same
    expectation from the same definition.
    """
    pv_file = pv_path(run_dir)
    if pv_file is None:
        return True, "no public values in the run record — nothing to verify"
    cp = load_checkpv()
    if cp is None:
        return True, "NOT VERIFIED: cannot load cli/check-pv (see the warning above)"
    try:
        with open(pv_file, "rb") as f:
            pv = f.read()
    except OSError as e:
        return True, f"NOT VERIFIED: cannot read {pv_file} ({e})"
    if len(pv) < cp.WORDS[-1][1] + 32:
        return False, f"{os.path.basename(pv_file)} is {len(pv)} B — too short to hold the guest's commitment"

    truth, src = cp.ground_truth(block, manifest, rpc_url)
    rows, verdict = cp.check(pv, truth)
    if verdict == "empty":
        return False, ("EMPTY COMMITMENT — every value byte is zero. The run exited cleanly and proved "
                       "nothing; the guest almost certainly does not match the installed zkVM toolchain "
                       "or the witness format. Rebuild it.")
    if verdict == "mismatch":
        bad = "; ".join(f"{n}=0x{g[:16]}… expected 0x{w[:16]}… ({src.get(n, '?')})"
                        for n, g, w, ok in rows if ok is False)
        return False, f"WRONG STATE — {bad}. The proof would verify, about the wrong block."
    if verdict == "unverified":
        return True, "NOT VERIFIED: no ground truth reachable (pass --manifest and/or --rpc)"
    checked = [n for n, _g, _w, ok in rows if ok]
    skipped = [n for n, _g, _w, ok in rows if ok is None]
    note = "verified " + "+".join(checked) + f" ({','.join(sorted(set(src.values())))})"
    # Name what was NOT checked. A partial pass is a pass — the two roots pin the state transition on their
    # own — but "verified" must never read as "all three verified" when a source was missing.
    if skipped:
        note += "; NOT verified: " + "+".join(skipped)
    return True, note


def block_chain_time(manifest, block):
    """The block's OWN header timestamp (chain time) from the producer's manifest, or None.

    This is what makes an END-TO-END latency possible. Every other stamp belongs to one machine's clock, but
    a block header's timestamp is chain time: comparing it with the moment this submitter gets its 200 OK
    measures the whole pipeline — node reception, execution, witness, framing, transfer, proving, submission
    — in one number, and both ends are NTP-synced rather than the same clock."""
    if not manifest or not os.path.isfile(manifest):
        return None
    try:
        with open(manifest, newline="") as f:
            for row in csv.DictReader(f):
                if (row.get("block") or "").strip() == str(block):
                    v = (row.get("t_block") or "").strip()
                    return float(v) if v else None
    except (OSError, ValueError):
        pass
    return None


def producer_secs(manifest, block):
    """(node_secs, witness_secs) — the two halves of getting a witness, which have NOTHING in common.

    node    t_block -> t_avail: the block's own timestamp until the RPC will serve it. Measured at 4.6-6.1 s on
            chi-001, i.e. half the slot, and none of it is ours — the fetcher, the newHeads subscription and the
            block_db write together add nothing measurable on top of it.
    witness t_avail -> t_witness: replaying the block and dumping the witness. This one IS ours.

    Reported separately because a single `witness` column charged the producer for the node's lag, which makes
    the pipeline look three times worse than it is and points optimisation at the wrong component.
    """
    if not manifest or not os.path.isfile(manifest):
        return (None, None)
    try:
        with open(manifest, newline="") as f:
            for row in csv.DictReader(f):
                if (row.get("block") or "").strip() == str(block):
                    tb = (row.get("t_block") or "").strip()
                    ta = (row.get("t_avail") or "").strip()
                    tw = (row.get("t_witness") or "").strip()
                    node = round(float(ta) - float(tb), 1) if tb and ta else None
                    # Fall back to t_block when t_avail is missing (older manifest rows): the sum still
                    # reconciles with e2e, it just lands entirely in the witness column as it used to.
                    base = ta or tb
                    wit = round(float(tw) - float(base), 1) if tw and base else None
                    return (node, wit)
    except (OSError, ValueError):
        pass
    return (None, None)


def exec_work(run_dir):
    """The work-unit from the run record's bundled exec-report.json, if any.

    Legitimate as a fallback for `proving_cycles`: a ZisK step count (like an SP1 cycle count) is the
    DETERMINISTIC trace length for a given ELF + input — the same number whichever machine measured it, so
    an emulator's count is the prover's count. It is only a fallback because a prover that reports its own
    work-unit should be believed first. Costs one small file read, once per submission, after proving."""
    p = os.path.join(run_dir, "exec-report.json")
    if not os.path.isfile(p):
        return None
    try:
        with open(p) as f:
            d = json.load(f)
    except (OSError, ValueError):
        return None
    for k in ("steps", "cycles"):
        if d.get(k) is not None:
            return d[k]
    return None


def read_report(run_dir):
    p = os.path.join(run_dir, "report.json")
    if not os.path.isfile(p):
        return {}
    try:
        with open(p) as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError) as e:
        print(f"ethproofs-submit: warning: could not read {p}: {e}", file=sys.stderr)
        return {}


def read_proof(run_dir):
    """Return (proof_bytes, kind). proof.bin as-is; segments/ dir packed to a tar; else error."""
    bin_path = os.path.join(run_dir, "proof.bin")
    seg_dir = os.path.join(run_dir, "segments")
    if os.path.isfile(bin_path):
        with open(bin_path, "rb") as f:
            return f.read(), "proof.bin"
    if os.path.isdir(seg_dir):
        buf = io.BytesIO()
        with tarfile.open(fileobj=buf, mode="w") as tar:
            tar.add(seg_dir, arcname="segments")
        return buf.getvalue(), "segments/ (tar)"
    raise SystemExit(f"ethproofs-submit: no proof.bin or segments/ in {run_dir!r} — is that a finished run record?")


def post(url, token, path, obj, dry):
    body = json.dumps(obj).encode()
    if dry:
        redacted = {k: (f"<{len(v)} b64 chars>" if k == "proof" else v) for k, v in obj.items()}
        print(f"  POST {url}{path}  {json.dumps(redacted)}")
        return {"proof_id": "<dry-run>"}
    req = urllib.request.Request(url + path, data=body, method="POST",
                                 headers={"Content-Type": "application/json",
                                          "Authorization": f"Bearer {token}"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            raw = resp.read()
    except urllib.error.HTTPError as e:
        raise SystemExit(f"ethproofs-submit: {path} -> HTTP {e.code}: {e.read().decode(errors='replace')[:300]}")
    except urllib.error.URLError as e:
        raise SystemExit(f"ethproofs-submit: {path} -> cannot reach {url} ({e.reason}) — is the ethproofs API up?")
    try:
        return json.loads(raw or b"{}")
    except json.JSONDecodeError:
        return {"raw": raw.decode(errors="replace")}


def main():
    ap = argparse.ArgumentParser(description="stack-agnostic ethproofs submitter (proof + report.json -> API)")
    ap.add_argument("--run-dir", required=True, help="prove run record dir (proof.bin|segments/ + report.json)")
    ap.add_argument("--block", type=int, help="block number (else report.block)")
    ap.add_argument("--ethproofs-url", default=os.environ.get("ETHPROOFS_API_URL", "http://localhost:8547"))
    ap.add_argument("--token", default=os.environ.get("ETHPROOFS_API_TOKEN", "dev"))
    ap.add_argument("--cluster", default=os.environ.get("ETHPROOFS_CLUSTER", "1"),
                    help="cluster id — ONE per prover deployment (rsp and zisk are different clusters). "
                         "Numeric for real ethproofs; any string for the mock (e.g. the guest name).")
    ap.add_argument("--vm", help="zkVM (SP1/ZisK/OpenVM); else report.zkvm — identifies what proved it")
    ap.add_argument("--guest", help="guest program (rsp/zisk-reth/monad-sp1/…); else report.guest")
    ap.add_argument("--public-inputs", help="public-inputs digest; else derived from the run's *.pv.bin")
    ap.add_argument("--cycles", type=int, help="work-unit override (SP1/OpenVM); else report.cycles")
    ap.add_argument("--steps", type=int, help="work-unit override (ZisK); else report.steps")
    ap.add_argument("--verifier-id", help="vk / verifier id; else report.vkey_hash")
    ap.add_argument("--proving-time-ms", type=int, help="else report.prove_secs x 1000")
    ap.add_argument("--minimal", action="store_true",
                    help="send ONLY the canonical ethproofs fields (block_number, cluster_id, proof, "
                         "proving_cycles, proving_time, verifier_id) — drop vm/guest/mock/public_inputs. "
                         "Use for the real ethproofs.org if it rejects unknown fields.")
    # Default ON. The queued/proving posts happen HERE, at submission time, i.e. after the block is already
    # proved — so they stamp "queued" and "proving" with a timestamp that is neither. They are two extra TCP
    # connections through the tunnel per block, carrying information that is wrong by construction. Honest
    # lifecycle reporting would have to be posted by the producer and the prover as those states are entered,
    # which is a different change; until then, not sending them beats sending fiction.
    ap.add_argument("--proved-only", action=argparse.BooleanOptionalAction, default=True,
                    help="POST only /proved (default). --no-proved-only also posts queued/proving, whose "
                         "timestamps are meaningless from here.")
    ap.add_argument("--manifest", default=os.environ.get("WITNESS_MANIFEST",
                                                        os.path.expanduser("~/witness-manifest.csv")),
                    help="producer manifest, for the block's chain timestamp -> end-to-end latency")
    ap.add_argument("--dry-run", action="store_true", help="print the requests, don't send")
    ap.add_argument("--rpc", default=os.environ.get("RPC"),
                    help="JSON-RPC URL used to complete the public-value check (block hash, and any "
                         "root the manifest lacks). Env: RPC.")
    ap.add_argument("--no-pv-check", action="store_true",
                    help="submit even if the committed public values are wrong or empty. For "
                         "deliberately-invalid test proofs ONLY — this is the check that separates a "
                         "proof of the block from a proof of nothing.")
    args = ap.parse_args()

    url = args.ethproofs_url.rstrip("/")
    # cluster_id: send as int when it's numeric (real ethproofs expects an int), else as-is (a mock name).
    cluster = int(args.cluster) if str(args.cluster).lstrip("-").isdigit() else args.cluster
    rep = read_report(args.run_dir)

    block = args.block if args.block is not None else rep.get("block")
    if block is None:
        raise SystemExit("ethproofs-submit: block unknown — pass --block (report.json has none for SP1/ZisK)")

    proof_bytes, kind = read_proof(args.run_dir)
    proof_b64 = base64.b64encode(proof_bytes).decode()

    # MOCK detection — mark fake proofs so they can NEVER be mistaken for real ones. Signalled three ways:
    # report.json mode=mock / backend=mock-cluster, or the proof's self-identifying MOCK-PROOF magic.
    is_mock = (rep.get("mode") == "mock" or rep.get("backend") == "mock-cluster"
               or proof_bytes[:len(MOCK_MAGIC)] == MOCK_MAGIC)

    # identity — WHAT was proven (vm + guest + mock flag). These are EXTRA fields the real ethproofs
    # clients (bin/eth-proofs, zisk api.rs) do NOT send — kept for the mock's leaderboard, but DROPPED
    # under --minimal (use that against a strict ethproofs.org that rejects unknown fields). Flags win,
    # else the report's zkvm/guest.
    vm = args.vm if args.vm is not None else rep.get("zkvm")
    guest = args.guest if args.guest is not None else rep.get("guest")
    ident = {}
    if not args.minimal:
        if vm is not None:
            ident["vm"] = vm
        if guest is not None:
            ident["guest"] = guest
        if is_mock:
            ident["mock"] = True

    # Safety: never let a fake proof pass for real on a REAL (non-local) ethproofs endpoint.
    host = urllib.parse.urlsplit(url).hostname or ""
    if is_mock and host not in ("localhost", "127.0.0.1", "::1", ""):
        print(f"ethproofs-submit: ⚠️  MOCK proof → non-local endpoint ({host}). This is NOT a real proof; "
              f"a real ethproofs would reject it (verification fails). Submitting anyway (it's marked mock).",
              file=sys.stderr)

    # work-unit → ALWAYS `proving_cycles`, matching BOTH real clients: RSP cycles and ZisK *steps* both go
    # in that field (there is no `proving_steps` in the ethproofs API). Explicit override wins, else report.
    # explicit override > the prove report's own field > the bundled exec-report (deterministic, see above).
    # Without the last one every ZisK submission goes out with an empty work-unit: zisk-runner's PROVE report
    # carries prove_secs/proof_bytes/backend but never the step count.
    work = next((v for v in (args.steps, args.cycles, rep.get("steps"), rep.get("cycles"),
                             exec_work(args.run_dir)) if v is not None), None)
    proved = {"block_number": block, "cluster_id": cluster, "proof": proof_b64, **ident}
    if work is not None:
        proved["proving_cycles"] = work

    ptime = args.proving_time_ms
    if ptime is None and rep.get("prove_secs") is not None:
        ptime = round(float(rep["prove_secs"]) * 1000)
    if ptime is not None:
        proved["proving_time"] = ptime

    vid = args.verifier_id if args.verifier_id is not None else rep.get("vkey_hash")
    if vid is not None:
        proved["verifier_id"] = vid

    pi = None if args.minimal else (args.public_inputs if args.public_inputs is not None else pv_digest(args.run_dir))
    # End-to-end: chain time of the block -> now, measured the instant before we hand the proof over.
    tb = None if args.minimal else block_chain_time(args.manifest, block)
    e2e = round(time.time() - tb, 1) if tb else None
    if tb:
        proved["t_block"] = int(tb)
        proved["e2e_secs"] = e2e

    # Phase timings from the run record, so the leaderboard shows WHERE the time went rather than only how much.
    # `transport_secs` is what the pipeline costs around the prover: shipping the witness plus fetching the
    # artifacts. Written by prove_remote; absent for local runs, and absent is not zero — omit rather than
    # invent, or a local run would read as a suspiciously perfect transport.
    if not args.minimal:
        ns, ws = producer_secs(args.manifest, block)
        if ns is not None:
            proved["node_secs"] = ns
        if ws is not None:
            proved["witness_secs"] = ws
        try:
            with open(os.path.join(args.run_dir, "timing.json")) as f:
                t = json.load(f)
            for k in ("transport_secs", "input_secs", "retrieve_secs", "pulled_direct"):
                if t.get(k) is not None:
                    proved[k] = t[k]
        except (OSError, ValueError):
            pass
    if pi is not None:
        proved["public_inputs"] = pi
    # The values themselves, for the receiving side's own check. An extra field like vm/guest/t_block —
    # dropped by --minimal, which is what real ethproofs gets.
    if not args.minimal:
        pvn = pv_named(args.run_dir)
        if pvn:
            proved["public_values"] = pvn

    lifecycle = {"block_number": block, "cluster_id": cluster, **ident}
    print(f"ethproofs-submit: {'[MOCK] ' if is_mock else ''}{'[minimal] ' if args.minimal else ''}vm={vm} guest={guest} block={block} cluster={cluster} -> {url}  "
          f"(proof={len(proof_bytes)}B from {kind}, time={ptime}ms, work={proved.get('proving_cycles')}, "
          f"vk={str(vid)[:14]}, pi={pi}{f', e2e={e2e}s' if e2e else ''})")

    # BEFORE any POST. Refusing after /proofs/queued would leave a lifecycle open on a proof that never
    # arrives, and the block would read as in-flight forever.
    ok, note = (True, "skipped (--no-pv-check)") if args.no_pv_check else \
        verify_public_values(args.run_dir, block, args.manifest, args.rpc, args.dry_run)
    print(f"ethproofs-submit: public values: {note}")
    if not ok:
        print(f"ethproofs-submit: REFUSING to submit block {block} — {note}", file=sys.stderr)
        return 4

    if not args.proved_only:
        post(url, args.token, "/proofs/queued", lifecycle, args.dry_run)
        post(url, args.token, "/proofs/proving", lifecycle, args.dry_run)
    resp = post(url, args.token, "/proofs/proved", proved, args.dry_run)
    print(f"ethproofs-submit: proved OK — response {json.dumps(resp)}")


if __name__ == "__main__":
    # sys.exit(main()), not main(): main() RETURNS its refusal code, and swallowing it would exit 0 on a
    # refused submission — prove-farm would log a success for a proof that was never sent.
    sys.exit(main())
