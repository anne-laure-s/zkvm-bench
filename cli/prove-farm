#!/usr/bin/env bash
#
# prove-farm — batch-prove collected witnesses on a remote cluster, for ANY guest/stack.
# The prove-side analog of cli/execute: pick a guest (guests.registry, via reg.sh) and, per block,
# loop the UNIFORM verb `infra/<stack>/run prove-cluster GUEST=<g> BLOCK=<n> REMOTE=...`. Each stack
# implements that verb behind one contract (resolve its own elf/witness, drive ITS cluster backend,
# fetch back a run record) — so this driver has ZERO per-stack branching. Adding a stack = a
# guests.registry row + a `prove-cluster` verb, nothing here.
#
# The contract each `run prove-cluster` must satisfy (see cli/report-schema.md):
#   fetches to  infra/<stack>/results/<tag>/<mode>-<run>/  a run record with
#     proof.bin (or segments/) · a detailed proving log · report.json  (+ pv/vkey/env best-effort)
#   exit 0 iff the proof was produced AND fetched back.
#
# The cluster stays a pure proving service: `run prove-cluster` (via prove_remote) does the ssh/scp;
# NOTHING here runs on the box. Bring up the box + runner/gateway via that stack's cluster*/ scripts.
#
#   ./prove-farm --guest rsp    --remote root@ssh.vast.ai --port 12345 [--mode prove-compressed] [BLOCKS...]
#   ./prove-farm --guest zisk   --remote root@ssh.vast.ai --port 12345 [BLOCKS...]
#   ./prove-farm --guest openvm --remote root@ssh.vast.ai --port 12345 --num-gpus 8 20000000
#   ./prove-farm --guest rsp    --remote root@ssh.vast.ai --port 12345 --watch --newest-first
#   ./prove-farm --guest rsp    --remote … --port … --watch --ethproofs-url http://localhost:8547  # + submit
#   ./prove-farm --guest rsp    --mock --watch --ethproofs-url http://localhost:8547   # NO box: mock-cluster prover
#   ./prove-farm --list
#
# With no BLOCKS, proves every witness found for the guest (guests/<rung>/fixtures|inputs/<tag>.bin).
# --watch = CONTINUOUS consumer: keep draining the witness queue (re-scan each cycle), one proof at a
# time (natural backpressure for one cluster), re-scanning every --interval seconds when caught up. Pair it
# with cli/witness-farm (the producer following the tip) → the continuous proving pipeline. With
# --newest-first it proves nearest the tip first (RTP policy); older un-proven blocks wait.
# --ethproofs-url = also SUBMIT each finished proof to an ethproofs API (cli/ethproofs-mock now,
# ethproofs.org later) via cli/ethproofs-submit → this becomes the full witness→prove→submit consumer:
#     cli/witness-farm (produce) │ cli/prove-farm --watch (prove) │ cli/ethproofs-submit (submit)
# Without it, prove-farm just proves (benchmark mode). The witness is fetched ONCE (by witness-farm)
# and reused here with zero RPC — prove/submit as many times as you like (mock now, real cluster later).
# INVARIANT: the mock prover's SLEEP is the only fiction in this pipeline. Block fetch, execution, witness
# generation, framing, submission and verification are all real and measured — otherwise the numbers mean
# nothing. Note what that implies about --mock: it skips prove_remote, so the witness upload and the proof
# download are ABSENT from a mock run, not modelled. Do not paper over that with a knob; measure the
# transfers for real (they are one scp of ~7 MB and one of ~380 KB).
#
# --mock = MOCK-CLUSTER stand-in for the prover seam: emit a valid run record locally (fake proof, no
# box), so the WHOLE decoupled pipeline (witness-farm → prove-farm → ethproofs-submit) runs on a real
# block with NO external dep. Tests the plumbing, not the prover — the sibling of ethproofs-mock and
# SP1_PROVER=mock. Drop --mock (add --remote) to prove for real on the cluster.
# --mock-secs/--mock-per-mb/--mock-jitter/--mock-dist = make the fake prover TAKE TIME:
#     prove_secs = --mock-secs + --mock-per-mb × witness_MB ± noise(--mock-jitter, --mock-dist)
# Default 0 = instant, fine for a plumbing check but it hides every RTP dynamic: a free prover never
# builds a queue, so coverage is always 100% and nothing is ever abandoned. Two useful settings:
#   realism  --mock-secs 2.12 --mock-per-mstep 0.0364 --mock-jitter 0.5
#            AUTHORITATIVE calibration: least-squares fit of `Total proving` against `Steps` over the 11
#            measured 16×5090 blocks (74 M -> 4.90 s … 479 M -> 19.76 s), giving
#                secs = 2.12 + 0.0364 × Msteps       residuals within +-0.2 s
#            Do not re-derive it from two points, as an earlier version of this comment did: the slope was
#            close but the fixed term came out nearly 2x too high.
#            Steps come from <input>.exec-report.json — either one that already exists, or one the mock
#            makes for itself via --mock-exec-fallback.
#   fallback --mock-secs 4 --mock-per-mb 3 --mock-jitter 0.5                (no exec-report available)
#            Measured on real monad witnesses: steps/MB is 46-48 on 5-6.5 MB blocks but 58.7 on a 3.1 MB
#            one (the guest has a fixed cost), so size under-rates small blocks — usable, biased low.
# --mock-speed <x>  scales the WORK term only (>1 faster prover, <1 slower). Fixed overhead is untouched,
#            which is how clusters really scale: 8 -> 16 GPUs took a 410 Mstep block 44.9 s -> 17.9 s while
#            small blocks stayed flat. Use it to ask "what if the prover were twice as fast?".
#            It is also how you make the pipeline measurable at RTP cadence TODAY: real mainnet blocks run
#            330-600 Msteps, i.e. 14-24 s at speed 1, so most of them exceed the 12 s slot and the queue can
#            never drain. --mock-speed 2.5 is the smallest value that puts even the heaviest observed block
#            under the slot (596 Msteps -> 10.8 s). The factor is recorded as `mock_speed` in every
#            report.json, so a scaled duration can never be mistaken for a measured one.
# WHERE THE EMULATION HAPPENS. With --remote, the mock prover measures the work ITSELF: the witness has just
#            been uploaded to it, so it emulates the block there, reads the step count, derives its duration
#            from the model above and deducts the emulation from its sleep (zisk-runner's ZISK_MOCK_* branch).
#            Nothing on the driver's side needs an emulator, and the emulation stands in for proving exactly
#            where proving would have happened. Its measured `steps` come back in the run record, so
#            proving_cycles and the latency report's work column fill themselves.
#            Without --remote the driver IS the prover (local mock-cluster), so it does the same thing on
#            this machine — that is what --mock-exec-fallback enables, and it needs ziskemu here.
#            Either way the deduction has headroom: the emulator runs ~150 Msteps/s against a modelled
#            prover at ~28 Msteps/s, so measuring costs ~1/5 of the proof it replaces.
#            ZisK is near-deterministic per block (three passes: 20.71/20.66/20.64 s), so the spread comes
#            from the BLOCKS, not the prover: this puts it in the size term. On real witnesses (median
#            7.2 MB, p99 13.9) that lands ~25 s median with a 13-46 s range, matching the 16×5090 numbers.
#   stress   --mock-secs 9 --mock-jitter 5 --mock-dist normal
#            jitter is the STD DEV here, so ~1 draw in 3 leaves ±5 and the occasional 25 s proof piles the
#            queue up. A uniform ±5 is bounded at [4,14] and never produces that.
# Outputs (run-data/, gitignored): run-data/prove-farm.csv, run-data/prove-farm-logs/. Run records
# land under the stack's own results/ (written by run prove-cluster), same as a manual
# `run prove-cluster`.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"                  # repo root (cli/ lives one level down)
RUNDATA="${RUNDATA:-$ROOT/run-data}"            # all runtime output lives here (see .gitignore)
source "$HERE/reg.sh"

die(){ echo "prove-farm: $*" >&2; exit 2; }
log(){ printf '%s  %s\n' "$(date +%H:%M:%S)" "$*"; }
usage(){ sed -n '2,/^set -uo/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//; /^set -uo/d'; exit "${1:-0}"; }

GUEST="rsp"; PREFETCH=1; REMOTE=""; PORT=""; MODE=""; NUM_GPUS=""; WITNESS_DIR=""; CHAIN_ID="1"; MAX_BLOCKS=0
# Where cli/ethproofs-submit lives ON THE PROVER, for the prover-side POST (see submit_one). Staged there by
# rtp-up alongside zisk-runner and witness-pump. Empty or absent -> submit_one posts from here instead.
REMOTE_SUBMIT="${REMOTE_SUBMIT:-}"
WATCH=0; INTERVAL=2; NEWEST_FIRST=0; MOCK=0   # INTERVAL: idle re-scan. 2s, not 30 — at the tip the
# queue is empty right after each proof, so a long idle sleep meant sleeping THROUGH the next blocks.
# Re-scanning costs a directory listing and a CSV scan; there was never a reason for it to be slow.
# mock-cluster timing. Default 0 = instant, which is right for a quick plumbing check but hides every RTP
# dynamic: with a free prover there is no backpressure, so the queue never builds, coverage is always
# 100% and no block is ever abandoned. Give it a realistic duration to rehearse the real thing.
MOCK_SECS="${MOCK_SECS:-0}"; MOCK_JITTER="${MOCK_JITTER:-0}"
MOCK_PER_MB="${MOCK_PER_MB:-0}"; MOCK_DIST="${MOCK_DIST:-uniform}"   # per-MB term · uniform|normal noise
MOCK_PER_MSTEP="${MOCK_PER_MSTEP:-0}"   # seconds per million steps — the actual cost driver
# Speed knob: divides the WORK term only, never the fixed overhead. That is how a real cluster scales —
# 8 -> 16 GPUs took a 410 Mstep block from 44.9 s to 17.9 s while "small blocks stayed ~flat, fixed
# overhead dominates" (infra/zisk-infra/docs/zisk-benchmark.md). >1 = faster prover, <1 = slower.
MOCK_SPEED="${MOCK_SPEED:-1}"
MOCK_EXEC_FALLBACK="${MOCK_EXEC_FALLBACK:-0}"   # no exec-report? emulate the block to get its step count
ETHPROOFS_URL=""; ETHPROOFS_TOKEN="dev"; ETHPROOFS_CLUSTER=""    # cluster defaults to the guest (distinct per prover); --ethproofs-url to also submit
# Passed to ethproofs-submit, which verifies EVERY public value the guest committed before it submits.
# The manifest already carries the two state roots, so this only completes the block hash — and it must
# be passed explicitly for the prover-side POST, where ssh does not carry the environment across.
RPC="${RPC:-}"
BLOCKS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --guest)             GUEST="${2:?}"; shift 2 ;;
    --remote)            REMOTE="${2:?}"; shift 2 ;;
    --port)              PORT="${2:?}"; shift 2 ;;
    --mode)              MODE="${2:?}"; shift 2 ;;
    --num-gpus)          NUM_GPUS="${2:?}"; shift 2 ;;
    --witness-dir)       WITNESS_DIR="${2:?}"; shift 2 ;;
    --chain-id)          CHAIN_ID="${2:?}"; shift 2 ;;
    --max-blocks)        MAX_BLOCKS="${2:?}"; shift 2 ;;
    --watch)             WATCH=1; shift ;;                 # continuous: keep draining the witness queue
    --interval)          INTERVAL="${2:?}"; shift 2 ;;     # watch: idle re-scan (s); default 2
    --prefetch)          PREFETCH=1; shift ;;              # overlap the next transfer with this proof
    --no-prefetch)       PREFETCH=0; shift ;;
    --no-submit)         NO_SUBMIT=1; shift ;;               # prove without delivering, deliberately
    --newest-first)      NEWEST_FIRST=1; shift ;;          # prove nearest the tip first (RTP policy)
    --mock)              MOCK=1; shift ;;                   # mock-cluster: fake the prover (no box) — plumbing test
    --mock-secs)         MOCK_SECS="${2:?}"; shift 2 ;;     # simulated proving time (0 = instant)
    --mock-jitter)       MOCK_JITTER="${2:?}"; shift 2 ;;   # noise: ± bound (uniform) or std dev (normal)
    --mock-per-mb)       MOCK_PER_MB="${2:?}"; shift 2 ;;   # seconds per MB of witness (a proxy for the work)
    --mock-per-mstep)    MOCK_PER_MSTEP="${2:?}"; shift 2 ;; # seconds per Mstep (the real driver, needs an exec-report)
    --mock-dist)         MOCK_DIST="${2:?}"; shift 2 ;;     # uniform (default) | normal
    --mock-speed)        MOCK_SPEED="${2:?}"; shift 2 ;;    # scale the WORK term: >1 faster prover, <1 slower
    --mock-exec-fallback) MOCK_EXEC_FALLBACK=1; shift ;;    # emulate to get steps when no exec-report exists
    --ethproofs-url)     ETHPROOFS_URL="${2:?}"; shift 2 ;;   # also submit each proof to this ethproofs API
    --ethproofs-token)   ETHPROOFS_TOKEN="${2:?}"; shift 2 ;;
    --ethproofs-cluster) ETHPROOFS_CLUSTER="${2:?}"; shift 2 ;;
    --rpc)               RPC="${2:?}"; shift 2 ;;             # completes the public-value check (block hash)
    --list)         echo "guests (guests.registry):"; reg_list; exit 0 ;;
    -h|--help)      usage 0 ;;
    -*)             die "unknown argument '$1' (see --help)" ;;
    *)              BLOCKS+=("$1"); shift ;;
  esac
done

reg_lookup "$GUEST" || die "unknown guest '$GUEST' (run --list to see them)."
[ "$MOCK" = 1 ] || [ -n "$REMOTE" ] || die "--remote user@host required (the cluster box), or --mock for the mock-cluster stand-in (no box)."
INFRA="$ROOT/$REG_INFRA"
# A guest is provable here iff its stack exposes the `prove-cluster` dispatcher. `exec=batch` guests
# (Monad) are fine AS LONG AS their registry row routes to a real infra (monad-zisk → infra/zisk-infra);
# a batch guest still pointing at guests/monad (monad-sp1, no SP1 inputs yet) fails this check clearly.
[ -x "$INFRA/run" ] || die "no stack dispatcher at $INFRA/run for guest '$GUEST' (batch guests must route to a real infra — see guests.registry)."
# zkVM identity (from the stack) — passed to ethproofs-submit so a submission says WHAT proved it.
case "$REG_INFRA" in
  */sp1-infra)    VM=SP1 ;;
  */zisk-infra)   VM=ZisK ;;
  */openvm-infra) VM=OpenVM ;;
  *)              VM="" ;;
esac
# Cluster id = the proving DEPLOYMENT's identity: "<n>gpu-<vm>" (e.g. 16gpu-SP1) on a GPU cluster, or
# "local-<vm>" for the mock/local stand-in. It encodes the zkVM, so SP1 vs ZisK are distinct clusters and
# the (cluster,block) identity separates rsp from zisk. Override with --ethproofs-cluster <your id> for
# real ethproofs (id assigned at registration). Pass --num-gpus to record the GPU count in the label.
if [ -z "$ETHPROOFS_CLUSTER" ]; then
  if   [ "$MOCK" = 1 ];    then ETHPROOFS_CLUSTER="local${VM:+-$VM}"
  elif [ -n "$NUM_GPUS" ]; then ETHPROOFS_CLUSTER="${NUM_GPUS}gpu${VM:+-$VM}"
  else                          ETHPROOFS_CLUSTER="${VM:-cluster}"
  fi
fi

OUT="$RUNDATA/prove-farm.csv"
LOGDIR="$RUNDATA/prove-farm-logs"; mkdir -p "$LOGDIR"
[ -f "$OUT" ] || echo "ts,block,guest,mode,status,prove_secs,total_secs,proof_bytes,run_dir" > "$OUT"
trap 'echo >&2; log "interrupted — stopping…"; exit 130' INT TERM

# Already proven OK for this block+guest? (re-runs skip successes, retry FAILs / new blocks)
is_proven(){ awk -F, -v b="$1" -v g="$GUEST" '$2==b && $3==g && $5=="ok"{f=1} END{exit !f}' "$OUT" 2>/dev/null; }

# report.json (shared prove contract) -> "prove_secs<TAB>total_secs<TAB>proof_bytes" (jq if present, else grep).
parse_report(){
  local f="$1"
  if command -v jq >/dev/null 2>&1; then
    jq -r '[.prove_secs, .total_secs, .proof_bytes] | map(. // "") | @tsv' "$f" 2>/dev/null
  else
    local ps ts pb
    ps=$(grep -oE '"prove_secs"[[:space:]]*:[[:space:]]*[0-9.]+' "$f" 2>/dev/null | grep -oE '[0-9.]+$')
    ts=$(grep -oE '"total_secs"[[:space:]]*:[[:space:]]*[0-9.]+' "$f" 2>/dev/null | grep -oE '[0-9.]+$')
    pb=$(grep -oE '"proof_bytes"[[:space:]]*:[[:space:]]*[0-9]+' "$f" 2>/dev/null | grep -oE '[0-9]+$')
    printf '%s\t%s\t%s\n' "$ps" "$ts" "$pb"
  fi
}

# Witness dir = the queue: witness-farm writes fixtures/, gen-input writes inputs/.
WDIR="$WITNESS_DIR"
if [ -z "$WDIR" ]; then
  for d in "$ROOT/guests/$REG_RUNG/fixtures" "$ROOT/guests/$REG_RUNG/inputs"; do
    [ -d "$d" ] && { WDIR="$d"; break; }
  done
  WDIR="${WDIR:-$ROOT/guests/$REG_RUNG/fixtures}"
fi
SORT="sort -un"; [ "$NEWEST_FIRST" = 1 ] && SORT="sort -urn"   # newest-first = prove nearest the tip

# scan_unproven — echo the blocks still to prove: explicit args (one-shot), else the witness queue;
# ordered (newest-first if asked), with already-proven blocks filtered out via the CSV.
scan_unproven(){
  { if [ "${#BLOCKS[@]}" -gt 0 ] && [ "$WATCH" != 1 ]; then printf '%s\n' "${BLOCKS[@]}"
    else find "$WDIR" -maxdepth 1 -name "$CHAIN_ID-*.bin" 2>/dev/null \
           | sed -E "s|.*/$CHAIN_ID-([0-9]+)\.bin\$|\1|"; fi
  } | grep -E '^[0-9]+$' | $SORT | while IFS= read -r b; do is_proven "$b" || echo "$b"; done
}

# mock_prove — the prover-seam STAND-IN: emit a valid run record locally, no cluster/box. Completes the
# home-made stand-ins (witness=proxy, ethproofs=mock) so the WHOLE decoupled pipeline runs with no
# external dep. The proof is FAKE (random bytes) — tests the pipeline plumbing, not the prover.
# read_steps <exec-report.json> — the "steps" field, without a jq dependency.
read_steps(){
  grep -oE '"steps"[[:space:]]*:[[:space:]]*[0-9]+' "$1" 2>/dev/null | grep -oE '[0-9]+$' | head -1
}

# mock_duration <witness_bytes> — a plausible proving time, echoed with 2 decimals so it can be both slept
# on and written into report.json as prove_secs.
#
#     secs = MOCK_SECS + MOCK_PER_MB × witness_MB   ± noise(MOCK_JITTER, MOCK_DIST)
#
# The size term is where the REAL variance lives. ZisK is near-deterministic for a given block — three
# passes over the same block measured 20.71 / 20.66 / 20.64 s (infra/zisk-infra/docs/zisk-benchmark.md),
# i.e. ~2% — so proving time is essentially a function of the block's work, and the spread across a block
# stream comes from the blocks themselves (right-skewed: median 7.2 MB, p99 13.9 MB on real mainnet
# witnesses). Deriving the duration from the witness size reproduces that correlation, including the fact
# that big blocks arrive in clusters and make the queue spike — which no independent draw can imitate.
#
# The noise term is then either:
#   uniform (default) hard bounds at ±MOCK_JITTER; predictable, good for a controlled rehearsal.
#   normal           MOCK_JITTER is the STANDARD DEVIATION, so ~1 draw in 3 falls outside ±jitter and
#                    rare long proofs do occur. That tail is the point when stress-testing a queue.
mock_duration(){  # $1 = witness bytes, $2 = steps (0 / absent = that term contributes nothing)
  awk -v base="$MOCK_SECS" -v per="$MOCK_PER_MB" -v perstep="$MOCK_PER_MSTEP" \
      -v jit="$MOCK_JITTER" -v dist="$MOCK_DIST" \
      -v speed="$MOCK_SPEED" -v bytes="${1:-0}" -v steps="${2:-0}" -v seed="$RANDOM" 'BEGIN{
    srand(seed)
    if (speed <= 0) speed = 1
    # Prefer the work-unit: proving cost is affine in the instruction count, so steps predict it far better
    # than the witness size ever can. Size stays as the fallback for blocks nobody has profiled yet.
    # Only the work term is divided by speed — the fixed overhead does not shrink with more GPUs.
    if (perstep > 0 && steps > 0) d = base + perstep * (steps / 1000000) / speed
    else                         d = base + per * (bytes / 1048576) / speed
    if (jit > 0) {
      if (dist == "normal") {
        u1 = rand(); if (u1 < 1e-12) u1 = 1e-12; u2 = rand()
        d += jit * sqrt(-2 * log(u1)) * cos(6.283185307179586 * u2)   # Box-Muller
      } else {
        d += (rand() * 2 - 1) * jit
      }
    }
    # A duration is positive by nature; a normal draw with a large sigma is not, and clamping at 0 would
    # hand out instant proofs. Floor it — and note this is the modelling cost of using a normal for a
    # duration: if you want realism rather than stress, put the spread in --mock-per-mb, not in the noise.
    if (d < 0.1) d = 0.1
    printf "%.2f", d }'
}

# mock_plan <block> <log> — echoes "<secs> <emul>": how long the mock should take for this block, and how
# much REAL time we already spent finding that out (emulating for its step count). Shared by BOTH mock
# paths — the local mock-cluster and the mock prover on a real remote — so the cost model lives in exactly
# one place and the remote is handed a single number to sleep.
#
# Everything informational goes to STDERR: stdout is the return value, and a log line leaking into it would
# corrupt the duration.
mock_plan(){  # $3 = dir to write derived artefacts into (the run record)
  local b="$1" plog="$2" rd="$3" xrep nsteps="" emul=0 elf secs bytes
  # A curated exec-report sitting next to the input is used if present (that is the inputs/ convention),
  # but nothing is ever WRITTEN beside a queue entry: fixtures/ holds witnesses — pre-mined or framed — and
  # derived artefacts describe a RUN, so they belong in the run record.
  xrep="$rd/exec-report.json"
  [ -f "$WDIR/$CHAIN_ID-$b.exec-report.json" ] && xrep="$WDIR/$CHAIN_ID-$b.exec-report.json"
  [ -f "$xrep" ] && nsteps="$(read_steps "$xrep")"
  # --mock-exec-fallback: no report, but the cost model wants steps -> emulate the block to get them, and
  # keep the report so nothing pays for it twice. This is the one place emulation belongs in a live run: it
  # stands in for proving, and its cost is deducted by the caller so the mock's occupancy equals the model.
  if [ -z "$nsteps" ] && [ "$MOCK_EXEC_FALLBACK" = 1 ] && awk "BEGIN{exit !($MOCK_PER_MSTEP > 0)}"; then
    # The SAME override the prove path honours ($ELF, read by infra/zisk-infra/run). If these two diverged,
    # the emulation would report steps and public values for one guest while the proof came from another.
    elf="${ELF:-$ROOT/guests/$REG_RUNG/$REG_RUNG.elf}"
    if [ -f "$elf" ]; then
      local t_emul=$SECONDS
      # REPORT/PV override execute_local's "next to the input" default, so the queue stays pure.
      if ( cd "$INFRA" && REPORT="$rd/exec-report.json" PV="$rd/expected_pv.bin" \
           ./run execute ELF="$elf" INPUT="$WDIR/$CHAIN_ID-$b.bin" ) >>"$plog" 2>&1; then
        emul=$((SECONDS - t_emul))
        xrep="$rd/exec-report.json"
        [ -f "$xrep" ] && nsteps="$(read_steps "$xrep")"
        # The deduction can only absorb the emulation while this box emulates FASTER than the modelled
        # prover (1/--mock-per-mstep Msteps/s): above that rate it fits for any block, below it big blocks
        # overshoot. So print both rates and let the caller's check catch the rest.
        if [ -n "$nsteps" ] && [ "$emul" -gt 0 ]; then
          log "   (emulated $b in ${emul}s = $(awk -v s="$nsteps" -v e="$emul" 'BEGIN{printf "%.0f", s/1e6/e}') Msteps/s, model expects $(awk -v p="$MOCK_PER_MSTEP" 'BEGIN{printf "%.0f", (p>0 ? 1/p : 0)}') — deducted)" >&2
        else
          log "   (emulated $b in ${emul}s but found no step count — see $plog)" >&2
        fi
      else
        log "   (emulation failed for $b — falling back to the witness-size model; see $plog)" >&2
      fi
    else
      log "   (no ELF at $elf — cannot emulate; falling back to the witness-size model)" >&2
    fi
  fi
  bytes="$(wc -c < "$WDIR/$CHAIN_ID-$b.bin" 2>/dev/null | tr -dc 0-9)"
  secs="$(mock_duration "${bytes:-0}" "${nsteps:-0}")"
  printf '%s %s' "$secs" "$emul"
}

mock_prove(){  # $1=block $2=plog → writes $INFRA/results/<guest>/<tag>/mock-run/{proof.bin,report.json}
  local b="$1" plog="$2" tag rd pb
  # Guest-scoped, like the real prove-cluster records (core.sh _artifact_rel): a bare results/<tag>/
  # would be shared by every guest, and the identical mock-run subdir would overwrite the other's record.
  tag="$CHAIN_ID-$b"; rd="$INFRA/results/$GUEST/$tag/mock-run"; mkdir -p "$rd" || return 1
  # Self-identifying: the proof bytes BEGIN with a MOCK-PROOF magic, so this fake is unmistakable anywhere
  # it travels (a real proof never starts with this). report.json also marks mode=mock/backend=mock-cluster.
  # Realistic SIZE, from /dev/urandom, constant across blocks — see the same reasoning in zisk-runner's mock
  # branch. The old `300 + b % 700` was doubly wrong: three orders too small, and varying with the block when a
  # real proof does not vary at all (SP1 in this repo: 1.273 MB across 5 blocks, 126 bytes of spread).
  # The size is what everything downstream is sized by, so it is not the mock's to invent.
  { printf 'MOCK-PROOF/mock-cluster NOT-A-REAL-PROOF '
    head -c "${ZISK_MOCK_PROOF_BYTES:-390144}" /dev/urandom; } \
    > "$rd/proof.bin" 2>/dev/null || return 1
  pb=$(wc -c < "$rd/proof.bin"); pb=${pb//[^0-9]/}
  # Burn the simulated proving time BEFORE writing the record, so the record's mtime (what
  # profiling/rtp-latency.py uses as t_proved) lands when the "proof" was actually finished.
  local secs emul
  read -r secs emul < <(mock_plan "$b" "$plog" "$rd")
  # Sleep the modelled duration MINUS whatever real work we just did, so the mock's total occupancy equals
  # the model. If the emulation alone already exceeded the model there is nothing left to deduct: the mock
  # has OVERSHOT its own budget, and that must be loud — a silent overshoot would make every latency number
  # downstream optimistic by an unknown amount.
  local nap; nap="$(awk -v s="$secs" -v e="$emul" 'BEGIN{ d = s - e; if (d < 0) d = 0; printf "%.2f", d }')"
  if [ "$nap" != "0.00" ]; then sleep "$nap"; fi
  local total; total="$(awk -v n="$nap" -v e="$emul" 'BEGIN{ printf "%.2f", n + e }')"
  if awk "BEGIN{exit !($emul > $secs)}"; then
    log "   ⚠️  OVERSHOT: emulation took ${emul}s but the model says ${secs}s — this block occupied the mock \
for ${total}s. Either raise --mock-per-mstep, drop --mock-exec-fallback (use --mock-per-mb), or profile on \
a faster box: the deduction only works while emulation is faster than the modelled prover."
  fi
  # report.json in the shared prove contract (cli/report-schema.md); marked mock so it's never mistaken for real.
  # zkvm/guest are "all"-tier fields in the contract: without them a run record can't say WHAT it proved,
  # which any consumer joining records (e.g. profiling/rtp-latency.py) needs.
  printf '{"mode":"mock","zkvm":"%s","guest":"%s","block":%s,"prove_secs":%s,"total_secs":%s,"proof_bytes":%s,"verified":null,"vkey_hash":"0xmock%s","backend":"mock-cluster"}\n' \
    "${VM:-}" "$GUEST" "$b" "$secs" "${total:-$secs}" "$pb" "$b" > "$rd/report.json" || return 1
  # mock_plan already wrote its exec-report + real public values straight into $rd (no copy, and nothing
  # left behind in the queue). They are what makes a root cross-check possible on a mock run —
  # see `run verify SKIP_PROOF_CHECK=1 EXPECTED_ROOT=…`.
  printf 'mock-cluster: fake run record for block %s (%s B proof, %ss simulated) — pipeline plumbing test, NOT a real proof.\n' "$b" "$pb" "$secs" > "$plog"
  return 0
}

# prove_one — one uniform call to the stack's prove-cluster (resolves its own artifacts + drives ITS
# cluster), then locate the fetched run record, require the PROOF (not just the report), and record it.
# With --mock the prove step is the mock-cluster stand-in (local, no box); everything downstream is identical.
# prefetch_next — ship the NEXT block's witness to the prover WHILE the current one is being proved.
#
# Service time = witness + transport + prove. At ~15.5 s against a 12 s slot the prover is never idle, so it
# always inherits a witness of arbitrary age and `queue` appears (0-12 s, ~6 s mean). Overlapping the transport
# with the proving takes ~5 s out of the service time, which is what puts it back UNDER the slot — and the
# queue then collapses on its own. That is the compounding win: the transport is not merely faster, it stops
# being on the critical path at all.
#
# Not a departure from the ethproofs model: no queueing policy changes, nothing is reordered, the prover still
# takes the newest block when it frees up. This only moves bytes to the machine that is about to want them.
#
# Runs in the background, deliberately best-effort: it holds no lock, and if it ships the wrong block (the tip
# moved) or fails outright, prove_remote simply transfers normally. The only state it leaves is a file in the
# prover's inputs/ — which prove_remote accepts by name and size, and which the next block would overwrite.
prefetch_next(){
  local after="$1" nxt src
  [ "$PREFETCH" = 1 ] && [ -n "$REMOTE" ] || return 0
  # Wait for the next witness to exist. A block lands every ~12 s and a prove takes ~7 s, so a few seconds in
  # there is usually one. Give up rather than linger: a stale prefetch is worthless and holds a connection.
  local waited=0
  while [ "$waited" -lt "${PREFETCH_WAIT:-8}" ]; do
    nxt="$(scan_unproven | awk -v a="$after" '$1+0 > a {print; exit}')"
    [ -n "$nxt" ] && break
    sleep 1; waited=$((waited + 1))
  done
  [ -n "$nxt" ] || return 0
  src="$WDIR/$CHAIN_ID-$nxt.bin"
  [ -f "$src" ] || return 0
  local ws="${REMOTE_WS:-/workspace}" dst="$CHAIN_ID-$nxt.bin" err rc
  # SAY SO WHEN IT FAILS. Logging only on success — `… 2>/dev/null && log "(prefetched …)"` — gives a prefetch
  # that cannot even connect NO line at all, and the farm log then looks exactly like a farm with nothing to
  # prefetch: a box that has lost its key, refusing every fresh ssh, reads as "transport is slow". The proving path
  # never noticed because it rides a multiplexed master authenticated once at startup; the prefetcher is the
  # only component that opens a NEW connection per block, which makes it the canary — but only if it speaks.
  # Best-effort still means best-effort: this never fails the block, it just stops being silent about it.
  err="$(
    if [ -n "${PULL_VIA:-}" ]; then
      ssh -o BatchMode=yes -p "${PORT:-22}" "$REMOTE" \
        "mkdir -p '$ws/inputs' && scp -q -C -o BatchMode=yes '$PULL_VIA:$src' '$ws/inputs/$dst'" 2>&1 >/dev/null
    else
      ssh -o BatchMode=yes -p "${PORT:-22}" "$REMOTE" "mkdir -p '$ws/inputs'" 2>&1 >/dev/null \
        && scp -q -C -o BatchMode=yes -P "${PORT:-22}" "$src" "$REMOTE:$ws/inputs/$dst" 2>&1 >/dev/null
    fi
  )"; rc=$?
  if [ "$rc" = 0 ]; then
    log "   (prefetched $nxt to the prover while $after was proving)"
  else
    # One line, not a stack: this fires once per block and a wall of text would train the reader to skip it.
    log "   (prefetch of $nxt FAILED rc=$rc — transport stays on the critical path: ${err%%$'\n'*})"
  fi
}

prove_one(){
  local b="$1" tag plog ref t0 rc rep run_dir proof ps ts pb reason p
  LAST_OK=0; LAST_RUN_DIR=""            # globals: signal success + run record to the submit step
  # Overlap the next block's transfer with this proof. Left unwaited on purpose: it must not delay this
  # block, and it bounds itself (PREFETCH_WAIT then the transfer), so at most one or two are ever alive.
  prefetch_next "$b" &
  tag="$CHAIN_ID-$b"; plog="$LOGDIR/prove-$GUEST-$b.log"; ref="$LOGDIR/.ref-$b"; : > "$ref"; t0=$SECONDS
  if [ "$MOCK" = 1 ] && [ -z "$REMOTE" ]; then
    log ">> prove $b ($GUEST) → mock-cluster (no box)"
    mock_prove "$b" "$plog"; rc=$?
  elif [ "$MOCK" = 1 ]; then
    # MOCK prover on a REAL remote: the stack's normal prove-cluster path, so every transfer actually
    # happens (witness up, proof/report/log back) and only the far end fakes the proving. This is the one
    # configuration where a mock run's latency includes the transport legs it will really pay for.
    log ">> prove $b ($GUEST) → $REMOTE [MOCK prover on the remote]"
    # Only the MODEL is passed. The witness is uploaded to the prover anyway, so the mock prover emulates it
    # THERE to measure the step count and derives its own duration — the emulation happens where the proof
    # would have happened, and nothing on this side needs an emulator. The transfers stay real and are
    # never absorbed: measuring them is the point.
    log "   (model: ${MOCK_SECS}s + ${MOCK_PER_MSTEP}s/Mstep${MOCK_SPEED:+ ÷$MOCK_SPEED}${MOCK_JITTER:+ ±$MOCK_JITTER $MOCK_DIST} — the remote measures the steps and decides)"
    ( cd "$INFRA" && ZISK_MOCK_SECS="$MOCK_SECS" ZISK_MOCK_PER_MSTEP="$MOCK_PER_MSTEP" \
      ZISK_MOCK_SPEED="$MOCK_SPEED" ZISK_MOCK_JITTER="$MOCK_JITTER" ZISK_MOCK_DIST="$MOCK_DIST" \
      ./run prove-cluster GUEST="$REG_RUNG" BLOCK="$b" CHAIN_ID="$CHAIN_ID" REMOTE="$REMOTE" \
        ${PORT:+PORT="$PORT"} ${MODE:+MODE="$MODE"} ${NUM_GPUS:+NUM_GPUS="$NUM_GPUS"} \
        ${WITNESS_DIR:+WITNESS="$WITNESS_DIR/$tag.bin"} ) > "$plog" 2>&1
    rc=$?
  else
    log ">> prove $b ($GUEST) → $REMOTE"
    ( cd "$INFRA" && ./run prove-cluster GUEST="$REG_RUNG" BLOCK="$b" CHAIN_ID="$CHAIN_ID" REMOTE="$REMOTE" \
        ${PORT:+PORT="$PORT"} ${MODE:+MODE="$MODE"} ${NUM_GPUS:+NUM_GPUS="$NUM_GPUS"} \
        ${WITNESS_DIR:+WITNESS="$WITNESS_DIR/$tag.bin"} ) > "$plog" 2>&1
    rc=$?
  fi
  rep="$(find "$INFRA/results" -path "*$tag*" -name report.json -newer "$ref" 2>/dev/null | head -n1)"
  [ -z "$rep" ] && rep="$(find "$INFRA/results" -name report.json -newer "$ref" 2>/dev/null | head -n1)"
  rm -f "$ref"; run_dir="${rep%/report.json}"
  proof=""; [ -n "$run_dir" ] && for p in "$run_dir/proof.bin" "$run_dir"/segments; do [ -e "$p" ] && { proof="$p"; break; }; done
  if [ "$rc" = 0 ] && [ -n "$rep" ] && [ -n "$proof" ]; then
    IFS=$'\t' read -r ps ts pb < <(parse_report "$rep")
    echo "$(date +%FT%T),$b,$GUEST,${MODE:-},ok,${ps:-},${ts:-},${pb:-},$run_dir" >> "$OUT"
    log "<< $b ok — prove=${ps:-?}s total=${ts:-?}s proof=${pb:-?}B  record=$run_dir  (wall $((SECONDS-t0))s)"
    LAST_OK=1; LAST_RUN_DIR="$run_dir"
  else
    reason="rc=$rc"; [ -n "$rep" ] || reason="$reason no-report"; [ -n "$proof" ] || reason="$reason no-proof"
    echo "$(date +%FT%T),$b,$GUEST,${MODE:-},FAIL,,,,${run_dir:-}" >> "$OUT"
    log "<< $b FAIL ($reason) — see $plog  (wall $((SECONDS-t0))s)"
  fi
}

# submit_one — hand a finished proof to the ethproofs seam (cli/ethproofs-submit → mock/ethproofs.org).
# No-op unless --ethproofs-url was given. Never fatal: a submit failure is logged, proving continues.
# submit_one — hand a finished proof to the ethproofs seam. THE BOX DECIDES; the POST may happen elsewhere.
#
# WHY THE POST CAN MOVE. The proof is produced on the prover, and in the RTP topology the ethproofs endpoint is
# the mock running ON THAT SAME PROVER, reached from here through the reverse tunnel. So posting from the box
# sends the proof back across the tunnel it was just pulled off: base64 inflates 381 KB to 508 KB, and the
# tunnel does 3.8 Mbit/s — about 1.10 s per block for bytes that were already on the destination machine.
# Invisible until the mock stopped faking a 480-byte proof; ~1 ms before that.
#
# What does NOT move: the box invokes, reads the exit status and the output, logs the verdict and writes the CSV.
# Only the HTTP call relocates, so the single-clock discipline is untouched — t_proved is still the run record's
# mtime on this machine (see profiling/rtp-latency.py).
#
# The prover assembles a run-record-shaped directory from the artifacts IT wrote (it has proof.bin, report.json
# and the public values under its own workspace names), plus timing.json passed inline from here — ~180 bytes,
# and the only piece the prover cannot know because this side measured it.
#
# SUBMIT_VIA_PROVER=0 forces the old local POST. It is also the automatic fallback: no remote info in
# timing.json, no REMOTE, or a failed remote invocation all fall back here rather than dropping a submission.
submit_one(){  # $1=block  $2=run_dir
  local b="$1" rd="$2" slog rws rbase
  # The producer's manifest. Function-scope because BOTH submit paths need it: it carries the two state
  # roots ethproofs-submit verifies the guest's commitment against, and the timings it reports.
  local mf="${WITNESS_MANIFEST:-$HOME/witness-manifest.csv}"
  # NOT a silent success. An unconfigured submission used to `return 0` here, so a farm launched without
  # --ethproofs-url proved block after block, marked each one `ok` in the ledger, and posted nothing — 1789
  # proofs produced and none delivered, with every session up and every log healthy. `is_proven()` keys on the
  # block number, so those blocks are never offered again: the output is not delayed, it is LOST.
  # The startup guard below makes this unreachable in a watch loop; this line is what makes it visible anywhere
  # else, once per run rather than per block so it cannot be scrolled away.
  if [ -z "$ETHPROOFS_URL" ]; then
    [ -n "${SUBMIT_WARNED:-}" ] || { log "!! NOT SUBMITTING: no --ethproofs-url. Proofs are being written to run \
records and marked proven, but nothing is posted. Every block proved now is output that will not be delivered."; \
      SUBMIT_WARNED=1; }
    return 0
  fi
  slog="$LOGDIR/submit-$GUEST-$b.log"
  [ -n "$rd" ] || { log "submit $b: no run record — skip"; return 1; }
  # Where the prover keeps its own copies — recorded by prove_remote, which owns the naming convention.
  if [ "${SUBMIT_VIA_PROVER:-1}" = 1 ] && [ -n "$REMOTE" ] && [ -n "$REMOTE_SUBMIT" ] && [ -r "$rd/timing.json" ]; then
    rws="$(sed -n 's/.*"remote_ws":"\([^"]*\)".*/\1/p' "$rd/timing.json")"
    rbase="$(sed -n 's/.*"remote_base":"\([^"]*\)".*/\1/p' "$rd/timing.json")"
  fi
  if [ -n "$rws" ] && [ -n "$rbase" ]; then
    log ">> submit $b → $ETHPROOFS_URL (posted BY the prover — the proof never crosses the tunnel)"
    # TWO inputs travel, not one. ethproofs-submit derives node_secs / witness_secs / e2e_secs / queued from the
    # PRODUCER'S MANIFEST, which it finds via $WITNESS_MANIFEST — an environment variable it inherited for free
    # while it ran here, and that the prover has neither the variable nor the file for. Missing it does not fail
    # the submission: those fields are simply dropped, and the leaderboard shows a row with only transport and
    # prove filled. That is exactly how this broke, and it broke silently.
    #
    # So both small inputs are shipped explicitly: timing.json (~250 B, measured on this side) and the
    # manifest rows for this block AND ITS PARENT plus the header (~450 B). base64 so no quoting or newline
    # survives to bite — the alphabet is shell-safe, which a CSV row with a 0x-prefixed state root is not.
    #
    # The parent's row is there for the public-value check: the pre-state root the guest commits IS the
    # parent's post-state root, so one extra line makes two of the three values verifiable on the prover with
    # no RPC call at all — and the check stays armed on a prover that cannot reach the chain.
    local p_tim p_man
    p_tim="$(base64 < "$rd/timing.json" 2>/dev/null | tr -d '\n')"
    p_man=""
    [ -r "$mf" ] && p_man="$({ head -1 "$mf"; grep -m1 "^$((b - 1))," "$mf"; grep -m1 "^$b," "$mf"; } \
                               2>/dev/null | base64 | tr -d '\n')"
    # One exchange: build the shaped dir, drop the two inputs in, submit, clean up. `cp` not `ln`, because
    # the workspace really does prune under it — core.sh sweeps anything stale on every block, and `ln` would
    # hand ethproofs-submit a name that can vanish mid-submission.
    #
    # AND THIS IS WHERE THE PROVER'S ARTIFACTS DIE. core.sh deletes the input right after the prove but keeps
    # proof/report/log when REMOTE_SUBMIT is set, precisely because this exchange still needs them; nothing else
    # ever reads them again, so the same exchange takes them out. The `rm` runs on the failure path too (rc is
    # captured before it), which is safe: the box already holds all four artifacts in its own run record and
    # core.sh fails the block outright if the proof did not come back, so these are never the last copy. The
    # fallback below then submits from the box's copy without needing the prover at all.
    if ssh -o BatchMode=yes -p "${PORT:-22}" "$REMOTE" \
        "d=\$(mktemp -d) && cp '$rws/proofs/$rbase.proof.bin' \"\$d/proof.bin\" \
         && cp '$rws/reports/$rbase.json' \"\$d/report.json\" \
         && { cp '$rws/proofs/$rbase.pv.bin' \"\$d/$rbase.pv.bin\" 2>/dev/null || true; } \
         && printf %s '$p_tim' | { base64 -d 2>/dev/null || base64 -D; } > \"\$d/timing.json\" \
         && { [ -n '$p_man' ] && printf %s '$p_man' | { base64 -d 2>/dev/null || base64 -D; } > \"\$d/manifest.csv\" || true; } \
         && '$REMOTE_SUBMIT' --run-dir \"\$d\" --block '$b' ${VM:+--vm '$VM'} --guest '$GUEST' \
              --manifest \"\$d/manifest.csv\" ${RPC:+--rpc '$RPC'} \
              --ethproofs-url '$ETHPROOFS_URL' --token '$ETHPROOFS_TOKEN' --cluster '$ETHPROOFS_CLUSTER'; \
         rc=\$?; rm -rf \"\$d\" '$rws/proofs/$rbase.proof.bin' '$rws/proofs/$rbase.pv.bin' \
              '$rws/reports/$rbase.json' '$rws/reports/$rbase.log'; exit \$rc" > "$slog" 2>&1; then
      log "<< submit $b ok  ($(tail -n1 "$slog"))"
      # Reset HERE, on a real success, so the counter measures a RUN of consecutive failures. Resetting
      # anywhere else understates it: an intermittent failure must not accumulate into "not intermittent",
      # and a genuine run must not be broken by a block that simply never attempted the prover path.
      SUBMIT_VIA_PROVER_FAILS=0
      return 0
    fi
    # A PATH THAT FAILS EVERY TIME MUST NOT READ AS A PER-BLOCK HICCUP. This line used to be the whole
    # report: one scrolling notice per block, while the fallback succeeded and every summary stayed green.
    # Measured consequence: 355 consecutive failures across 507 blocks went unnoticed, and the 508 KB proof
    # crossed the slow link on every one of them — which is exactly what posting from the prover exists to
    # avoid. So count them, and escalate the wording once the count proves it is not intermittent.
    SUBMIT_VIA_PROVER_FAILS=$((${SUBMIT_VIA_PROVER_FAILS:-0} + 1))
    if [ "$SUBMIT_VIA_PROVER_FAILS" = 1 ]; then
      log "   (prover-side submit failed — falling back to posting from here; see $slog)"
    elif [ "$SUBMIT_VIA_PROVER_FAILS" = 3 ]; then
      # Three in a row is no longer chance. Name the two causes that produce it and how to tell them apart:
      # both are box->Mac ssh, the one direction nothing else in the pipeline uses (the prover always opens
      # the connection to the box), which is why everything else keeps working while this rots.
      log "   ⚠️  prover-side submit has now failed $SUBMIT_VIA_PROVER_FAILS times IN A ROW — this is not intermittent."
      log "       Every proof is crossing the slow link from here instead of being posted by the prover."
      log "       It is box->Mac ssh, and there are two usual causes:"
      log "         · the box's private key was deleted (an hourly cron on the devcore box does exactly that:"
      log "           0 * * * * find ~/.ssh -type f -name 'id_*' -delete) — check: ssh $REMOTE 'ls ~/.ssh'"
      log "         · the reverse tunnel is down — check: ssh $REMOTE 'ss -ltn | grep :2222' and ~/tunnel.log"
      log "       Look for 'Permission denied (publickey' vs 'Connection refused' in $slog to tell which."
      log "       Re-running rtp-up resets both; the key comes back only until the cron next fires."
    elif [ $((SUBMIT_VIA_PROVER_FAILS % 50)) = 0 ]; then
      log "   ⚠️  prover-side submit still failing ($SUBMIT_VIA_PROVER_FAILS in a row) — see the note above."
    fi
  fi
  log ">> submit $b → $ETHPROOFS_URL"
  if "$HERE/ethproofs-submit" --run-dir "$rd" --block "$b" ${VM:+--vm "$VM"} --guest "$GUEST" \
        --ethproofs-url "$ETHPROOFS_URL" --token "$ETHPROOFS_TOKEN" --cluster "$ETHPROOFS_CLUSTER" \
        ${mf:+--manifest "$mf"} ${RPC:+--rpc "$RPC"} \
        >> "$slog" 2>&1; then
    log "<< submit $b ok  ($(tail -n1 "$slog"))"
  else
    log "<< submit $b FAILED — see $slog"
  fi
}

# A WATCH LOOP THAT CANNOT SUBMIT IS PURE WASTE, and the failure is invisible: it proves forever, marks every
# block proven, and delivers nothing. Refusing here is the difference between a typo and a lost night. Batch
# runs (no --watch) are exempt: proving a fixed list to inspect the records is a legitimate use, and so is
# --no-submit, which makes the intent explicit rather than inferred from an absent flag.
if [ "$WATCH" = 1 ] && [ -z "$ETHPROOFS_URL" ] && [ "${NO_SUBMIT:-0}" != 1 ]; then
  echo "prove-farm: --watch without --ethproofs-url would prove blocks forever and submit none of them, and \
mark them proven so they are never retried. Pass --ethproofs-url <url>, or --no-submit if you really mean to \
prove without delivering." >&2
  exit 2
fi

# ONE WATCHER, and the reason is not tidiness. Two --watch farms against the same prover workspace destroy
# each other's work: both pick the same head of the same queue, both stage the input into the same
# $REMOTE_WS/inputs/, and whichever finishes first DELETES that input as part of its retention — so the other
# one's emulation opens a file that is no longer there. It does not crash: the runner reports "Could not read
# inputs file", falls back to the fixed term of the cost model, and every block after that carries a fabricated
# duration and NO public values. Nothing else in the pipeline notices.
#
# That is not hypothetical. A farm orphaned on 2026-08-17 (its tmux session died, init adopted the process)
# was still running 36 h later beside the real one, and had turned every proof into a measurement of nothing.
# It also predated the --ethproofs-url guard above, so it proved and submitted nothing for a day and a half.
#
# Killing the tmux session is NOT enough to prevent this — a reparented child survives it, which is exactly how
# that one lasted. So the exclusion has to live here, held by the process itself for as long as it runs.
# Keyed on $RUNDATA: both farms write the same ledger and both drive the same workspace, so one per run-data is
# the right granularity. Batch runs are exempt, like the guard above — a one-shot re-prove of a fixed list is a
# legitimate thing to do while a watcher runs.
if [ "$WATCH" = 1 ]; then
  LOCKF="${PROVE_FARM_LOCK:-$RUNDATA/prove-farm.watch.lock}"
  mkdir -p "$(dirname "$LOCKF")"
  if command -v flock >/dev/null 2>&1; then
    exec 8>>"$LOCKF" || die "cannot open the watch lock $LOCKF"
    if flock -n 8; then
      # Truncate and stamp only AFTER the lock is ours, so a refused start never erases the holder's identity.
      : > "$LOCKF"; printf 'pid %s started %s
' "$$" "$(date +%FT%T)" >&8
    else
      echo "prove-farm: REFUSING to start — another prove-farm --watch already holds $LOCKF:" >&2
      sed "s/^/  /" "$LOCKF" >&2 2>/dev/null
      echo "  Two watchers on one prover workspace delete each other's staged inputs, and the loser's proofs silently become fabricated timings with no public values. Stop the other one first:" >&2
      echo "    pgrep -af 'prove-farm .*--watch'   then   kill <pid>" >&2
      echo "  (a farm whose tmux session died is reparented to init and keeps running — check for that too)" >&2
      exit 2
    fi
  else
    echo "prove-farm: WARNING no flock available — cannot guarantee a single watcher. Check by hand that no other 'prove-farm --watch' is running against $RUNDATA." >&2
  fi
fi

log "prove-farm: guest=$GUEST ($REG_DESC) stack=$REG_INFRA remote=$([ "$MOCK" = 1 ] && { [ -n "$REMOTE" ] && echo "$REMOTE (mock prover)" || echo mock-cluster; } || echo "$REMOTE") mode=${MODE:-<default>}$([ "$WATCH" = 1 ] && echo ' [watch]')$([ "$NEWEST_FIRST" = 1 ] && echo ' [newest-first]')$([ "$MOCK" = 1 ] && { [ -n "$REMOTE" ] && echo ' [mock prover on a real remote — transfers are real]' || echo ' [mock-cluster, no box]'; })${ETHPROOFS_URL:+ [submit→$ETHPROOFS_URL cluster=$ETHPROOFS_CLUSTER]}  (out=$OUT)"

if [ "$WATCH" = 1 ]; then
  # Continuous consumer. Always prove the HEAD of the un-proven queue and re-scan after each proof —
  # with --newest-first that's "prove-latest" (the RTP policy: stay nearest the tip; older un-proven
  # blocks starve until caught up — batch-prove those with a plain run). One proof at a time = the
  # natural backpressure for a single cluster. Idle-sleep only when the queue is empty.
  log "watch: draining $WDIR (idle sleep ${INTERVAL}s). Ctrl-C to stop."
  while :; do
    q="$(scan_unproven)"
    b="$(printf '%s\n' "$q" | head -n1)"
    if [ -z "$b" ]; then log "idle — queue empty; sleeping ${INTERVAL}s"; sleep "$INTERVAL"; continue; fi
    log "backlog=$(printf '%s\n' "$q" | grep -c .) — next=$b"
    prove_one "$b"
    [ "$LAST_OK" = 1 ] && submit_one "$b" "$LAST_RUN_DIR"
  done
else
  [ -n "$(scan_unproven | head -n1)" ] || die "nothing to prove (no un-proven $CHAIN_ID-<block>.bin in $WDIR, or all already proven)."
  count=0
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    prove_one "$b"; count=$((count+1))
    [ "$LAST_OK" = 1 ] && submit_one "$b" "$LAST_RUN_DIR"
    [ "$MAX_BLOCKS" -gt 0 ] && [ "$count" -ge "$MAX_BLOCKS" ] && { log "reached --max-blocks=$MAX_BLOCKS"; break; }
  done < <(scan_unproven)
  log "prove-farm: done ($count block(s) this run)."
fi
