#!/usr/bin/env bash
# use-gen — select which Monad guest GENERATION the tooling sees.
#
# A generation is a guest ELF pair together with a witness set it is known to read: two artefacts that are only
# valid AS A PAIR, which is why they live in one directory and why this script is the only way to switch.
# Witness FILENAMES carry no format marker, so a mismatched pair is undetectable by inspection and fails by
# producing a wrong post-state root with a zero exit — never by refusing to run.
#
# The two halves do not have to move together, and the layout should not imply they do. A change of WIRE FORMAT
# moves both (PartialTrieDb + RLP node list -> OffsetTrieDb + offset blob, one witness set per format), while a
# change of GUEST LINEAGE on an unchanged format moves only the ELFs — an optimised build of the same reader.
# That second case shares its witness set rather than copying gigabytes: point the generation's `witnesses` at
# the one it reads, and the format checks below still see the real bytes through the link.
#
#   ./use-gen                 list generations, mark the current one, and show what is installed
#   ./use-gen <generation>    point `current` at it and install whichever ELFs it ships
#
# A generation may ship ONE backend. The ZisK and SP1 halves come from the same source but different
# toolchains and land at different times, and refusing to select the built half only invites copying another
# generation's binary in — which credits it to a source that never produced it. Selecting a one-backend
# generation therefore leaves the other top-level ELF alone, and `current-<backend>` records where each
# installed ELF came from so that mixed state is visible instead of implied.
#
# `current`, `current-zisk`, `current-sp1` and `fixtures` are symlinks (gitignored, local state). The
# top-level ELFs are the paths guests/monad-{zisk,sp1}/*.elf link to and ARE tracked, so switching shows up
# as a modification to commit — that is deliberate: the ELF is what produced the numbers.
set -eu
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"

# Delegated to ./witness-fmt, which rtp-up's compatibility guard also calls: one RLP walk, one place to keep it
# right. It reads the framed shape too — the same witness reaches the prover behind an LE64 length prefix — so
# both ends of the pipeline are checked by the same detector.
fmt() { ./witness-fmt "$1" | awk '{print $1, $2}'; }

# report_installed [<generation just selected>] — what is installed per backend, and where it came from.
# One definition, called by the listing and by the switch: a mixed pair reported in one place and not the
# other is how it gets missed.
report_installed() {
  local sel="${1:-}" b e from zg="" sg=""
  for b in zisk sp1; do
    e="monad-zkvm-guest-$b.elf"
    from="$(readlink "current-$b" 2>/dev/null || true)"; from="${from#gen/}"
    [ "$b" = zisk ] && zg="$from" || sg="$from"
    if [ -f "$e" ]; then
      printf "  %-26s %s…  from %s\n" "$e" "$(shasum -a 256 "$e" | cut -c1-16)" "${from:-<unrecorded>}"
    else
      printf "  %-26s (not installed)\n" "$e"
    fi
  done
  # A MIXED PAIR IS THE FAILURE THIS RECORD EXISTS FOR. Two ELFs from different generations compare two
  # different guests, and every number taken from them compares the wrong thing. Selecting a one-backend
  # generation is exactly how the state arises, so it is stated loudly instead of left to be noticed.
  if [ -f monad-zkvm-guest-zisk.elf ] && [ -f monad-zkvm-guest-sp1.elf ] && [ "$zg" != "$sg" ]; then
    echo
    echo "!! MIXED PAIR — the two backends come from DIFFERENT generations:"
    echo "     zisk <- ${zg:-<unrecorded>}"
    echo "     sp1  <- ${sg:-<unrecorded>}"
    echo "   Anything that reads both is comparing two guests."
    [ -n "$sel" ] && echo "   Build the missing half from $sel's source and re-select, or select one that ships both." \
                  || echo "   Build the missing half and re-select, or select a generation that ships both."
  fi
}

if [ $# -eq 0 ]; then
  cur="$(readlink current 2>/dev/null || echo '(none)')"
  printf "current: %s\n\n" "$cur"
  for d in gen/*/; do
    g="${d#gen/}"; g="${g%/}"
    n=$(ls "$d/witnesses"/*.witness 2>/dev/null | wc -l | tr -d ' ')
    e=$(ls "$d/elf"/*.elf 2>/dev/null | wc -l | tr -d ' ')
    f="-"; [ "$n" -gt 0 ] && f=$(fmt "$(ls "$d/witnesses"/*.witness | head -1)")
    printf "  %s %-26s %4s witnesses  %s elf  %s\n" \
           "$([ "gen/$g" = "$cur" ] && echo '*' || echo ' ')" "$g" "$n" "$e" "$f"
  done
  echo
  echo "installed:"
  report_installed
  exit 0
fi

G="$1"; D="gen/$G"
[ -d "$D" ] || { echo "no such generation: $D"; exit 1; }
n=$(ls "$D/witnesses"/*.witness 2>/dev/null | wc -l | tr -d ' ')
[ "$n" -gt 0 ] || { echo "$D/witnesses is empty — nothing to select"; exit 1; }
# WHICH BACKENDS this generation ships. One is allowed. The two sides are built from the same source but by
# different toolchains and they land at different times, so demanding both to select either one has a
# predictable outcome: someone copies another generation's binary in to satisfy the check, and that binary is
# then attributed to a source which never produced it. A half-built generation is an honest state; a forged
# pair is not.
have=""
for b in zisk sp1; do
  [ -f "$D/elf/monad-zkvm-guest-$b.elf" ] && have="$have $b"
done
[ -n "$have" ] || { echo "no ELF in $D/elf — expected monad-zkvm-guest-zisk.elf and/or -sp1.elf"; exit 1; }

# Refuse a set that is not one format throughout: that is the failure this layout exists to prevent,
# and it is invisible in a directory listing.
first=$(ls "$D/witnesses"/*.witness | head -1)
mid=$(ls "$D/witnesses"/*.witness | awk -v n="$n" 'NR==int(n/2)+1')
last=$(ls "$D/witnesses"/*.witness | tail -1)
f1=$(fmt "$first"); f2=$(fmt "$mid"); f3=$(fmt "$last")
if [ "$f1" != "$f2" ] || [ "$f2" != "$f3" ]; then
  echo "MIXED witness formats in $D/witnesses — refusing:"
  printf "  %s  %s\n  %s  %s\n  %s  %s\n" \
    "$(basename "$first")" "$f1" "$(basename "$mid")" "$f2" "$(basename "$last")" "$f3"
  exit 1
fi

ln -sfn "$D" current
[ -L fixtures ] || ln -s current/witnesses fixtures
# current-<backend> records WHICH GENERATION each installed ELF came from. Without it, selecting a one-backend
# generation leaves the other top-level ELF in place with nothing saying where it is from — and the two then
# read as a matched pair to every tool that loads them. Local state, like `current` and `fixtures`.
for b in $have; do
  cp "$D/elf/monad-zkvm-guest-$b.elf" .
  ln -sfn "$D" "current-$b"
done

echo "now using $G"
echo "  witnesses  $n · format $f1"
echo "  fixtures   -> $(readlink fixtures) -> $D/witnesses"
report_installed "$G"
echo
echo "the installed ELFs are tracked — 'git status' will show them modified; that is the record of the switch"
